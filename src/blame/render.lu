use blamerange
use commit_format
use difftext
use history
use object
use oid
use worktree

fn add(mut out: List[byte], data: List[byte]) { for b in data { (mut out).push(b) } }

fn text(mut out: List[byte], value: str) { add(mut out, value.bytes()) }

fn line(mut out: List[byte], key: str, value: List[byte]) {
    text(mut out, key)
    add(mut out, value)
    text(mut out, "\n")
}

fn pad(mut out: List[byte], n: int) { for _ in 0..n { (mut out).push(32 as byte) } }

// vc26: an identity as Git's blame shows it, from the stored bytes. A line
// Git cannot split is `(unknown)` with time 0; a date it cannot read is
// time 0 and zone `(unknown)`.
struct Person {
    name: List[byte],
    mail: List[byte],
    time: str,
    zone: str,
    raw: commit_format.RawIdentity,
}

fn person(value: List[byte]) -> Person {
    let raw = commit_format.raw_identity(value)
    if !raw.split {
        return Person {
            name: "(unknown)".bytes(),
            mail: "(unknown)".bytes(),
            time: "0",
            zone: "(unknown)",
            raw: raw,
        }
    }
    var mail = List[byte]()
    (mut mail).push(60 as byte)
    add(mut mail, raw.email)
    (mut mail).push(62 as byte)
    if !raw.dated {
        return Person { name: copy raw.name, mail: mail, time: "0", zone: "(unknown)", raw: raw }
    }
    let zone = str_from_utf8(raw.zone_text) else ""
    Person { name: copy raw.name, mail: mail, time: copy raw.seconds_text, zone: zone, raw: raw }
}

fn identity(source: Source, key: str) -> Person ! worktree.WorkErrors {
    for field in source.value.headers.fields { if field.key == key { return person(field.value) } }
    invalid_header
}

// A name's display width as Git pads it: one column a byte when the bytes
// are not UTF-8 (measured with Latin-1 names), else one a character; -1
// (a named refusal) for a control byte or a character past U+02FF, whose
// width this renderer does not know.
fn display_width(name: List[byte]) -> int {
    for b in name { if b < 32 as byte || b == 127 as byte { return -1 } }
    let text = str_from_utf8(name) else |_| { return name.len }
    var width = 0
    for b in name {
        if b < 128 as byte {
            width += 1
        } else if b >= 192 as byte {
            if b >= 204 as byte { return -1 }
            width += 1
        }
    }
    let _ = text
    width
}

// True when canonical decimal `left` is greater than `right`.
fn decimal_greater(left: str, right: str) -> bool {
    if left.len != right.len { return left.len > right.len }
    let a = left.bytes(), b = right.bytes()
    for i in 0..a.len { if a[i] != b[i] { return a[i] > b[i] } }
    false
}

// The sum of a decimal of at most twenty digits and a small signed number,
// in decimal (Git's blame adds the zone before it checks the range).
fn decimal_sum(text: str, delta: int) -> str {
    var digits = List[int]()
    for b in text.bytes() { (mut digits).push(b as int - 48) }
    var carry = delta, i = digits.len - 1
    while carry != 0 && i >= 0 {
        let v = digits[i] + carry % 10
        carry = carry / 10
        if v < 0 {
            digits[i] = v + 10
            carry -= 1
        } else if v > 9 {
            digits[i] = v - 10
            carry += 1
        } else {
            digits[i] = v
        }
        i -= 1
    }
    var out = "", leading = true
    for d in digits {
        if leading && d == 0 { continue }
        leading = false
        out = "{out}{d}"
    }
    if out == "" then "0" else out
}

// The default display's date: Git's iso style, its fatal when the local time
// is before the epoch, and its own fatal when seconds plus the zone exceed
// 9223372036854775807.
fn blame_date(who: Person) -> commit_format.ShownDate ! worktree.WorkErrors {
    let raw = who.raw
    if !raw.split || !raw.dated { return commit_format.shown_date(0, 0, "iso")? }
    if !raw.zone_fits { return Unsupported("blame timezone with more than nine digits") }
    let offset = commit_format.zone_seconds(raw.zone)
    if !raw.fits || offset > 0 && raw.seconds > 9223372036854775807 - offset {
        let sum = decimal_sum(raw.seconds_text, offset)
        if !decimal_greater(sum, "9223372036854775807") {
            return Unsupported("blame date near the 64-bit range")
        }
        if decimal_greater(sum, "18446744073709551615") {
            return Unsupported("blame date past the 64-bit range")
        }
        return commit_format.ShownDate {
            text: "",
            fatal: "Timestamp too large for this system: {sum}",
        }
    }
    commit_format.shown_date(raw.seconds, raw.zone, "iso")?
}

fn metadata(
    mut out: List[byte],
    source: Source,
    root: bool,
    quote: bool,
) -> () ! worktree.WorkErrors {
    for key in ["author", "committer"] {
        let who = identity(source, key)?
        line(mut out, "{key} ", who.name)
        line(mut out, "{key}-mail ", who.mail)
        text(mut out, "{key}-time {who.time}\n{key}-tz {who.zone}\n")
    }
    line(mut out, "summary ", object.subject(source.value.headers.message)?)
    if source.value.parents.len == 0 && !root { text(mut out, "boundary\n") }
    if source.previous.len > 0 {
        let prior = source.previous[0]
        text(mut out, "previous {oid.hex(prior.id)?} ")
        add(mut out, worktree.quote(prior.path, quote, false))
        text(mut out, "\n")
    }
    line(mut out, "filename ", worktree.quote(source.path, quote, false))
}

fn contiguous(result: Result, selected: List[bool], before: int, after: int) -> bool {
    if !selected[before] || !selected[after] { return false }
    let a = copy result.rows[before], b = copy result.rows[after]
    oid.equal(result.sources[a.source].value.id, result.sources[b.source].value.id) &&
        difftext.identical(result.sources[a.source].path, result.sources[b.source].path) &&
        a.original + 1 == b.original
}

/// Pure byte renderer with validated owned result indices. It never changes the
/// index or object namespace. Porcelain preserves raw identity/content bytes.
/// Rendered bytes, or the bytes Git writes before its fatal line and that
/// line's text (a date it cannot show).
pub struct Rendered { out: List[byte], fatal: str }

/// The renderer without the partial output of a fatal date: Fatal.
pub fn render(
    ctx: worktree.Context,
    result: Result,
    options: Options,
) -> List[byte] ! worktree.WorkErrors {
    let value = render_checked(ctx, result, options)?
    if value.fatal != "" { return Fatal(value.fatal) }
    value.out
}

/// Pure byte renderer with validated owned result indices. It never changes the
/// index or object namespace. Porcelain preserves raw identity/content bytes.
pub fn render_checked(
    ctx: worktree.Context,
    result: Result,
    options: Options,
) -> Rendered ! worktree.WorkErrors {
    let lines = difftext.lines(result.data)?
    if result.rows.len != lines.len || result.sources.len > 10000 { return invalid }
    for row in result.rows {
        if row.source < 0 ||
            row.source >= result.sources.len ||
            row.original < 0 ||
            row.original >= 200000 {
            return invalid
        }
        let _ = oid.hex(result.sources[row.source].value.id)?
    }
    if options.line_porcelain && !options.porcelain { return invalid }
    var keys = List[str](), first_source = Map[str, int]()
    for i in 0..result.sources.len {
        let source = copy result.sources[i]
        if source.path.len == 0 || source.path.len > 4096 || source.previous.len > 1 {
            return invalid
        }
        for field in source.value.headers.fields {
            if field.key == "encoding" && str_from_utf8(field.value)?.lower() != "utf-8" {
                return Unsupported("blame message encoding")
            }
        }
        let full = oid.hex(source.value.id)?
        let first = first_source[full] else i
        if !difftext.identical(result.sources[first].path, source.path) {
            return Unsupported("blame multiple origin paths per commit")
        }
        first_source[full] = i
        (mut keys).push(full)
    }
    let selected = blamerange.selection(lines.len, options.ranges, result.path)?
    let quote = worktree.config_bool(ctx, "core.quotepath", true)?
    var name_width = 0,
        path_width = 0,
        number_width = 1,
        original_width = 1,
        id_width = if options.long_ids then 40 else 7
    var show_name = options.show_name, boundary = false
    var measured_ids = Map[int, bool](), unsupported_width = false
    for i in 0..lines.len {
        if !selected[i] { continue }
        region width_scratch {
            let row = copy result.rows[i], source = copy result.sources[row.source]
            if !difftext.identical(source.path, result.path) { show_name = true }
            if source.value.parents.len == 0 && !options.root { boundary = true }
            let path = worktree.quote(source.path, quote, false)
            if path.len > path_width { path_width = path.len }
            let who = identity(source, "author")?
            let name = if options.email then copy who.mail else copy who.name
            let width = display_width(name)
            if !options.porcelain && !options.suppress && width < 0 { unsupported_width = true }
            if width > name_width { name_width = width }
            let number = "{i + 1}", original = "{row.original + 1}"
            if number.len > number_width { number_width = number.len }
            if original.len > original_width { original_width = original.len }
            if !(measured_ids[row.source] else false) {
                let id = history.abbreviate(
                    ctx.repo,
                    source.value.id,
                    if options.long_ids then 40 else 7,
                )?
                if id.len > id_width { id_width = id.len }
                measured_ids[row.source] = true
            }
        }
    }
    if unsupported_width { return Unsupported("blame author display width") }
    if boundary && !options.long_ids && id_width < 40 { id_width += 1 }
    // vc26: each source's date as the default display shows it, or Git's
    // fatal line, computed before any row is written.
    var dates = List[str](), fatals = List[str]()
    for source in result.sources {
        if options.porcelain || options.suppress {
            (mut dates).push("")
            (mut fatals).push("")
            continue
        }
        let shown = blame_date(identity(source, "author")?)?
        (mut dates).push(copy shown.text)
        (mut fatals).push(copy shown.fatal)
    }
    for fatal in fatals {
        if fatal != "" && (show_name || options.show_number) {
            return Unsupported("blame fatal date beside names or numbers")
        }
    }
    var seen = Map[str, bool](), out = List[byte](), stopped = -1
    for i in 0..lines.len {
        if !selected[i] || stopped >= 0 { continue }
        region row_scratch {
            let row = copy result.rows[i], source = copy result.sources[row.source]
            let full = keys[row.source]
            if options.porcelain {
                text(mut out, "{full} {row.original + 1} {i + 1}")
                if i == 0 || !contiguous(result, selected, i - 1, i) {
                    var end = i + 1
                    while end < lines.len && contiguous(result, selected, end - 1, end) { end += 1 }
                    text(mut out, " {end - i}")
                }
                text(mut out, "\n")
                if options.line_porcelain || !(seen[full] else false) {
                    metadata(mut out, source, options.root, quote)?
                }
                seen[full] = true
                text(mut out, "\t")
            } else {
                if source.value.parents.len == 0 && !options.root {
                    text(mut out, "^{full[0..id_width - 1]}")
                } else {
                    text(mut out, full[0..id_width])
                }
                if !options.suppress && fatals[row.source] != "" {
                    // Git writes the id, then its fatal line.
                    stopped = row.source
                    continue
                }
                text(mut out, " ")
                if show_name {
                    let path = worktree.quote(source.path, quote, false)
                    add(mut out, path)
                    pad(mut out, path_width - path.len + 1)
                }
                if options.show_number {
                    let number = "{row.original + 1}"
                    pad(mut out, original_width - number.len)
                    text(mut out, "{number} ")
                }
                if !options.suppress {
                    let author = identity(source, "author")?
                    text(mut out, "(")
                    let name = if options.email then copy author.mail else copy author.name
                    add(mut out, name)
                    pad(mut out, name_width - display_width(name) + 1)
                    text(mut out, "{dates[row.source]} ")
                }
                let number = "{i + 1}"
                pad(mut out, number_width - number.len)
                text(mut out, "{number}) ")
            }
            var end = lines[i].end
            if end > lines[i].start && result.data[end - 1] == 10 as byte { end -= 1 }
            add(mut out, result.data[lines[i].start..end])
            text(mut out, "\n")
            if out.len > 134217728 { return limit }
        }
    }
    if stopped >= 0 { return Rendered { out: out, fatal: copy fatals[stopped] } }
    Rendered { out: out, fatal: "" }
}
