// Original implementation of Myers (1986), sections 2-3, Figure 2 and trace
// recovery. Inputs are byte lines, including their LF when present. No VCS or
// diff-library implementation was consulted. Heuristic alignment is separate.

/// Half-open byte span, with a fast reject hash; equality still checks bytes.
pub struct Line { start: int, end: int, hash: int }

/// A changed rectangle in line coordinates; zero counts denote insertion/deletion.
pub struct Edit { old_start: int, old_count: int, new_start: int, new_count: int }

/// Owned line offsets. Empty input has no lines; a final non-LF span is a line.
pub fn lines(data: List[byte]) -> List[Line] ! DeltaErrors {
    if data.len > 16777216 { return limit }
    var result = List[Line]()
    var start = 0, pos = 0
    var hash: int = 0
    while pos < data.len {
        hash = hash * 33 + data[pos] as int & 0xffffffff
        pos += 1
        if data[pos - 1] == 10 as byte || pos == data.len {
            (mut result).push(Line { start: start, end: pos, hash: hash })
            if result.len > 200000 { return limit }
            start = pos
            hash = 0
        }
    }
    result
}

fn equal_line(a: List[byte], x: Line, b: List[byte], y: Line) -> bool {
    if x.hash != y.hash || x.end - x.start != y.end - y.start { return false }
    for i in 0..x.end - x.start { if a[x.start + i] != b[y.start + i] { return false } }
    true
}

struct Match { old_line: int, new_line: int }

fn trace_matches(
    a: List[byte],
    left: List[Line],
    b: List[byte],
    right: List[Line],
) -> List[Match] ! DeltaErrors {
    let maximum = left.len + right.len
    let bound = if maximum < 2000 then maximum else 2000
    let offset = bound + 1
    var v = List[int]()
    for _ in 0..2 * bound + 3 { (mut v).push(0) }
    var trace = List[List[int]]()
    var distance = 0
    var found = false
    while distance <= bound {
        var k = -distance
        while k <= distance {
            var x = if k == -distance || k != distance && v[offset + k - 1] < v[offset + k + 1] {
                v[offset + k + 1]
            } else {
                v[offset + k - 1] + 1
            }
            var y = x - k
            while x < left.len && y < right.len && equal_line(a, left[x], b, right[y]) {
                x += 1
                y += 1
            }
            v[offset + k] = x
            if x >= left.len && y >= right.len { found = true; break }
            k += 2
        }
        // Only reachable diagonals are retained, giving O(D^2) trace storage.
        (mut trace).push(v[offset - distance..offset + distance + 1])
        if found { break }
        distance += 1
    }
    if !found { return limit }
    var matches = List[Match]()
    var x = left.len, y = right.len
    while distance > 0 {
        let k = x - y
        let previous = distance - 1
        let prior = copy trace[previous]
        let vertical = k == -distance ||
            k != distance && prior[previous + k - 1] < prior[previous + k + 1]
        let pk = if vertical then k + 1 else k - 1
        let px = prior[previous + pk]
        let py = px - pk
        while x > px && y > py {
            x -= 1
            y -= 1
            (mut matches).push(Match { old_line: x, new_line: y })
        }
        x = px
        y = py
        distance -= 1
    }
    while x > 0 && y > 0 {
        x -= 1
        y -= 1
        (mut matches).push(Match { old_line: x, new_line: y })
    }
    matches
}

/// Minimal insertion/deletion script, at most 2,000 changed lines and 200,000
/// lines per input. Exhausting these explicit budgets returns limit, not an
/// approximate script. Counts are not affected by byte-level similarity hashes.
pub fn edits(before: List[byte], after: List[byte]) -> List[Edit] ! DeltaErrors {
    let left = lines(before)?
    let right = lines(after)?
    if left.len == 0 || right.len == 0 {
        if left.len == 0 && right.len == 0 { return List[Edit]() }
        return [Edit { old_start: 0, old_count: left.len, new_start: 0, new_count: right.len }]
    }
    let matches = trace_matches(before, left, after, right)?
    var out = List[Edit]()
    var x = 0, y = 0
    var pos = matches.len
    while pos > 0 {
        pos -= 1
        let matched = copy matches[pos]
        if x < matched.old_line || y < matched.new_line {
            (mut out).push(Edit {
                old_start: x,
                old_count: matched.old_line - x,
                new_start: y,
                new_count: matched.new_line - y,
            })
        }
        x = matched.old_line + 1
        y = matched.new_line + 1
    }
    if x < left.len || y < right.len {
        (mut out).push(Edit {
            old_start: x,
            old_count: left.len - x,
            new_start: y,
            new_count: right.len - y,
        })
    }
    out
}

fn can_up(a: List[byte], left: List[Line], b: List[byte], right: List[Line], change: Edit) -> bool {
    if change.old_start == 0 || change.new_start == 0 { return false }
    if change.old_count > 0 &&
        !equal_line(
            a,
            left[change.old_start - 1],
            a,
            left[change.old_start + change.old_count - 1],
        ) {
        return false
    }
    if change.new_count > 0 &&
        !equal_line(
            b,
            right[change.new_start - 1],
            b,
            right[change.new_start + change.new_count - 1],
        ) {
        return false
    }
    true
}

fn can_down(
    a: List[byte],
    left: List[Line],
    b: List[byte],
    right: List[Line],
    change: Edit,
) -> bool {
    if change.old_start + change.old_count >= left.len ||
        change.new_start + change.new_count >= right.len {
        return false
    }
    if change.old_count > 0 &&
        !equal_line(a, left[change.old_start], a, left[change.old_start + change.old_count]) {
        return false
    }
    if change.new_count > 0 &&
        !equal_line(b, right[change.new_start], b, right[change.new_start + change.new_count]) {
        return false
    }
    true
}

fn erase(mut changes: List[Edit], at: int) {
    for i in at..changes.len - 1 { changes[i] = copy changes[i + 1] }
    let _ = (mut changes).pop() else Edit { old_start: 0, old_count: 0, new_start: 0, new_count: 0 }
}

/// Slide equivalent boundaries to join adjacent changed rectangles; otherwise
/// choose their latest equivalent location. This is measured separately from
/// the default indent heuristic and does not claim that heuristic's policy.
pub fn compact(before: List[byte], after: List[byte]) -> List[Edit] ! DeltaErrors {
    let left = lines(before)?
    let right = lines(after)?
    var changes = edits(before, after)?
    var at = 0
    while at < changes.len {
        var change = copy changes[at]
        let old_low = if at == 0 then 0 else changes[at - 1].old_start + changes[at - 1].old_count
        let new_low = if at == 0 then 0 else changes[at - 1].new_start + changes[at - 1].new_count
        while change.old_start > old_low &&
            change.new_start > new_low &&
            can_up(before, left, after, right, change) {
            change.old_start -= 1
            change.new_start -= 1
        }
        if at > 0 && change.old_start == old_low && change.new_start == new_low {
            changes[at - 1].old_count += change.old_count
            changes[at - 1].new_count += change.new_count
            erase(mut changes, at)
            at -= 1
            continue
        }
        let old_high = if at + 1 == changes.len then left.len else changes[at + 1].old_start
        let new_high = if at + 1 == changes.len then right.len else changes[at + 1].new_start
        while change.old_start + change.old_count < old_high &&
            change.new_start + change.new_count < new_high &&
            can_down(before, left, after, right, change) {
            change.old_start += 1
            change.new_start += 1
        }
        changes[at] = copy change
        if at + 1 < changes.len &&
            change.old_start + change.old_count == old_high &&
            change.new_start + change.new_count == new_high {
            changes[at].old_count += changes[at + 1].old_count
            changes[at].new_count += changes[at + 1].new_count
            erase(mut changes, at + 1)
            continue
        }
        at += 1
    }
    changes
}

fn indentation(data: List[byte], row: Line) -> int {
    var column = 0
    for i in row.start..row.end {
        let b = data[i] as int
        if b == 32 {
            column += 1
        } else if b == 9 {
            column += 8 - column % 8
        } else if b == 10 || b == 13 {
            continue
        } else {
            return column
        }
    }
    -1
}

fn boundary_score(data: List[byte], rows: List[Line], at: int) -> int {
    if at == 0 || at == rows.len { return 0 }
    let previous = indentation(data, rows[at - 1])
    let next = indentation(data, rows[at])
    if previous < 0 { return if next > 0 then 0 else 2 }
    if next < 0 { return if previous > 0 then 0 else 2 }
    if next > previous { return -1 }
    0
}

fn change_score(
    a: List[byte],
    left: List[Line],
    b: List[byte],
    right: List[Line],
    change: Edit,
) -> int {
    var score = 0
    if change.old_count > 0 {
        score += boundary_score(a, left, change.old_start)
        score += boundary_score(a, left, change.old_start + change.old_count)
    }
    if change.new_count > 0 {
        score += boundary_score(b, right, change.new_start)
        score += boundary_score(b, right, change.new_start + change.new_count)
    }
    score
}

/// Measured readability ranking of equivalent boundaries, never content changes.
pub fn aligned(before: List[byte], after: List[byte]) -> List[Edit] ! DeltaErrors {
    let left = lines(before)?
    let right = lines(after)?
    var changes = compact(before, after)?
    for at in 0..changes.len {
        var candidate = copy changes[at]
        var blank_only = true
        for i in candidate.old_start..candidate.old_start + candidate.old_count {
            if indentation(before, left[i]) >= 0 { blank_only = false }
        }
        for i in candidate.new_start..candidate.new_start + candidate.new_count {
            if indentation(after, right[i]) >= 0 { blank_only = false }
        }
        if blank_only { continue }
        let old_low = if at == 0 then 0 else changes[at - 1].old_start + changes[at - 1].old_count
        let new_low = if at == 0 then 0 else changes[at - 1].new_start + changes[at - 1].new_count
        while candidate.old_start > old_low &&
            candidate.new_start > new_low &&
            can_up(before, left, after, right, candidate) {
            candidate.old_start -= 1
            candidate.new_start -= 1
        }
        var best = copy candidate
        var best_score = change_score(before, left, after, right, candidate)
        let old_high = if at + 1 == changes.len then left.len else changes[at + 1].old_start
        let new_high = if at + 1 == changes.len then right.len else changes[at + 1].new_start
        while candidate.old_start + candidate.old_count < old_high &&
            candidate.new_start + candidate.new_count < new_high &&
            can_down(before, left, after, right, candidate) {
            candidate.old_start += 1
            candidate.new_start += 1
            let score = change_score(before, left, after, right, candidate)
            if score >= best_score { best = copy candidate; best_score = score }
        }
        changes[at] = best
    }
    changes
}
