// Pack inspection reuses the reader's checksum, CRC, identity and delta checks.
use oid

/// Physical entry metadata; size is delta instruction bytes for a delta.
pub struct PackedEntry {
    name: str,
    kind: str,
    size: int,
    stored: int,
    offset: int,
    depth: int,
    base: str,
}

/// Owned physical rows and the complete pack's logical byte count.
pub struct Inspection { objects: List[PackedEntry], bytes: int }

fn entry_meta(fd: int, end: int, index: Index, slot: int, depth: int) -> (
    int,
    int,
    str,
    int,
) ! PackErrors {
    if depth > 64 { return Unsupported("limit: a delta chain deeper than 64") }
    let offset = slot_offset(index, slot, end)?
    let next = next_offset(index, offset, end)
    let bytes = range_bytes(fd, offset, if next - offset > 40 then 40 else next - offset)?
    var b = bytes[0] as int, pos = 1, size = b & 15, scale = 16
    let kind = b >> 4 & 7
    while b >= 128 {
        if pos >= bytes.len { return Unsupported("pack entry header") }
        b = bytes[pos] as int
        pos += 1
        if b & 127 > (16777216 - size) / scale {
            return Unsupported("limit: a pack object larger than 16777216 bytes")
        }
        size += (b & 127) * scale
        if b >= 128 {
            if scale > 16777216 / 128 {
                return Unsupported("limit: a pack object larger than 16777216 bytes")
            }
            scale *= 128
        }
    }
    var base = -1
    if kind == 6 {
        if pos >= bytes.len { return Unsupported("pack OFS_DELTA offset") }
        b = bytes[pos] as int
        pos += 1
        var distance = b & 127
        while b >= 128 {
            if pos >= bytes.len || distance >= offset / 128 {
                return Unsupported("pack OFS_DELTA offset")
            }
            b = bytes[pos] as int
            pos += 1
            distance = (distance + 1) * 128 + (b & 127)
        }
        base = slot_at(index, offset - distance)
    } else if kind == 7 {
        if bytes.len - pos < 20 { return Unsupported("pack REF_DELTA name") }
        let id = oid.from_bytes("sha1", bytes[pos..pos + 20]) else |_| {
            return Unsupported("pack REF_DELTA name")
        }
        base = slot_named(index, oid.hex(id) else "")
    }
    if kind == 6 || kind == 7 {
        if base < 0 { return Unsupported("thin pack REF_DELTA base") }
        let (_, _, _, links) = entry_meta(fd, end, index, base, depth + 1)?
        return (size, next - offset, name_hex(index, base), links + 1)
    }
    (size, next - offset, "", 0)
}

/// Inspect a named idx and validate every canonical body, even when loose copies
/// exist. Returned rows are in physical pack order, not object-name order.
/// verify-pack's and fsck's: every index entry is checked first (load_index).
pub fn inspect(path: str) -> Inspection ! PackErrors {
    let index = load_index(path)?
    if !path.ends_with(".idx") { return Unsupported("pack index pathname") }
    let fd = open_pack("{path[0..path.len - 4]}.pack")?
    defer fs_close(fd) else |_| {}
    let end = verify(fd, index)?
    var objects = List[PackedEntry]()
    // An object's diagnostic is built in object_check: it is copied out and
    // raised once the region is freed.
    var error_payload = "", failed = false
    for slot in 0..index.count {
        var row = PackedEntry {
            name: name_hex(index, slot),
            kind: "",
            size: 0,
            stored: 0,
            offset: index.offsets[slot],
            depth: 0,
            base: "",
        }
        region object_check {
            var seen = Map[int, bool](), total = 0, none = no_cache(), read_n = 0, reserved_n = 0
            let body = unpack(
                fd,
                end,
                index,
                slot,
                mut seen,
                mut total,
                mut read_n,
                mut reserved_n,
                0,
                mut none,
                0,
            ) else |e| match e {
                Unsupported(message) => {
                    error_payload = copy message
                    failed = true
                    break
                },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
            }
            let (size, stored, base, depth) = entry_meta(fd, end, index, slot, 0)?
            row.kind = copy body.kind
            row.size = size
            row.stored = stored
            row.base = copy base
            row.depth = depth
        }
        (mut objects).push(row)
        var j = objects.len - 1
        while j > 0 && objects[j].offset < objects[j - 1].offset {
            let saved = copy objects[j]
            objects[j] = copy objects[j - 1]
            objects[j - 1] = saved
            j -= 1
        }
    }
    if failed { return Unsupported(error_payload) }
    Inspection { objects: objects, bytes: end + 20 }
}

/// Validated pack-index paths. No partial or unsupported pack metadata is hidden.
pub fn paths(gitdir: str) -> List[str] ! PackErrors { indexes(gitdir)? }

/// Check an index even after its pack was retired. This is ONLY metadata for
/// recovery; it never certifies readable object bodies or ordinary inventory.
pub fn retirement_names(path: str, expected: str) -> List[str] ! PackErrors {
    let index = load_index(path)?
    let id = oid.from_bytes("sha1", index.pack_sum) else |_| {
        return Unsupported("retirement checksum")
    }
    if (oid.hex(id) else "") != expected { return Unsupported("retirement pack binding") }
    var names = List[str]()
    for slot in 0..index.count { (mut names).push(name_hex(index, slot)) }
    names
}

/// Validated object-name inventory, including duplicate names in separate packs.
pub fn names(path: str) -> List[str] ! PackErrors {
    if !path.ends_with(".idx") { return Unsupported("pack index pathname") }
    let index = load_index(path)?
    let fd = open_pack("{path[0..path.len - 4]}.pack")?
    defer fs_close(fd) else |_| {}
    let _ = verify(fd, index)?
    var out = List[str]()
    for slot in 0..index.count { (mut out).push(name_hex(index, slot)) }
    out
}
