// Git 2.56.0 gitformat-pack, Version 2 pack-*.idx files and Checksums.
use hash
use oid

struct Entry {
    name: str,
    offset: int,
    crc: int,
}

/// entries are in the idx's validated name order; by_offset holds the same
/// slots in increasing offset order. Lookups are binary searches (the
/// runtime Map is a linear scan, which made every idx parse quadratic).
struct Index {
    entries: List[Entry],
    by_offset: List[int],
    pack_sum: List[byte],
}

/// The slot named name, or -1.
fn slot_named(index: Index, name: str) -> int {
    var lo = 0, hi = index.entries.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if index.entries[mid].name < name { lo = mid + 1 } else { hi = mid }
    }
    if lo < index.entries.len && index.entries[lo].name == name { return lo }
    -1
}

/// The first rank in by_offset whose entry starts at or after offset.
fn offset_rank(index: Index, offset: int) -> int {
    var lo = 0, hi = index.by_offset.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if index.entries[index.by_offset[mid]].offset < offset { lo = mid + 1 } else { hi = mid }
    }
    lo
}

/// The slot whose entry starts exactly at offset, or -1.
fn slot_at(index: Index, offset: int) -> int {
    let rank = offset_rank(index, offset)
    if rank < index.by_offset.len && index.entries[index.by_offset[rank]].offset == offset {
        return index.by_offset[rank]
    }
    -1
}

/// The next entry's offset after offset, or end when none follows.
fn next_offset(index: Index, offset: int, end: int) -> int {
    let rank = offset_rank(index, offset + 1)
    if rank < index.by_offset.len && index.entries[index.by_offset[rank]].offset < end {
        return index.entries[index.by_offset[rank]].offset
    }
    end
}

/// Slots ordered by offset: a stable bottom-up merge sort.
fn offset_order(entries: List[Entry]) -> List[int] {
    var order = List[int]()
    for i in 0..entries.len { (mut order).push(i) }
    var scratch = copy order
    var width = 1
    while width < order.len {
        var lo = 0
        while lo < order.len {
            let mid = if lo + width < order.len then lo + width else order.len
            let hi = if lo + 2 * width < order.len then lo + 2 * width else order.len
            var i = lo, j = mid, k = lo
            while i < mid && j < hi {
                if entries[order[j]].offset < entries[order[i]].offset {
                    scratch[k] = order[j]
                    j += 1
                } else {
                    scratch[k] = order[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                scratch[k] = order[i]
                i += 1
                k += 1
            }
            while j < hi {
                scratch[k] = order[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        order = copy scratch
        width *= 2
    }
    order
}

fn be32(data: List[byte], pos: int) -> int {
    var n: int = 0
    for i in 0..4 { n = n * 256 + data[pos + i] as int }
    n
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn parse_index(data: List[byte]) -> Index ! PackErrors {
    if data.len < 1072 { return Unsupported("pack index truncated") }
    if !same(data[0..4], [255 as byte, 116 as byte, 79 as byte, 99 as byte]) || be32(data, 4) != 2 {
        return Unsupported("pack index version (requires v2)")
    }
    if !same(hash.sum1(data[0..data.len - 20]), data[data.len - 20..]) {
        return Unsupported("pack index checksum")
    }
    let count = be32(data, 1028)
    if count > 400000 { return Unsupported("pack index object count limit") }
    let fixed = 1032 + count * 28 + 40
    if fixed > data.len || (data.len - fixed) % 8 != 0 { return Unsupported("pack index length") }
    let large_count = (data.len - fixed) / 8
    var previous: int = 0
    for i in 0..256 {
        let n = be32(data, 8 + 4 * i)
        if n < previous || n > count { return Unsupported("pack index fanout") }
        previous = n
    }
    var entries = List[Entry]()
    var bucket = 0, name_before = ""
    var large_used = Map[int, bool]()
    for i in 0..count {
        let pos = 1032 + 20 * i
        let first = data[pos] as int
        while bucket < first {
            if be32(data, 8 + bucket * 4) != i { return Unsupported("pack index fanout") }
            bucket += 1
        }
        let id = oid.from_bytes("sha1", data[pos..pos + 20]) else |_| {
            return Unsupported("pack index name")
        }
        let name = oid.hex(id) else |_| { return Unsupported("pack index name") }
        if i > 0 && name <= name_before { return Unsupported("pack index name order") }
        name_before = name
        var offset = be32(data, 1032 + count * 24 + i * 4)
        if offset >= 2147483648 {
            let slot = offset - 2147483648
            if slot >= large_count || (large_used[slot] else false) {
                return Unsupported("pack index large offsets")
            }
            large_used[slot] = true
            let start = 1032 + count * 28 + slot * 8
            let high = be32(data, start)
            if high > 2147483647 { return Unsupported("pack offset range") }
            offset = high * 4294967296 + be32(data, start + 4)
        }
        if offset < 12 { return Unsupported("pack index offsets") }
        (mut entries).push(Entry {
            name: name,
            offset: offset,
            crc: be32(data, 1032 + count * 20 + i * 4),
        })
    }
    while bucket < 256 {
        if be32(data, 8 + bucket * 4) != count { return Unsupported("pack index fanout") }
        bucket += 1
    }
    if large_used.len != large_count { return Unsupported("pack index large offsets") }
    // Two entries at one offset: the former per-entry duplicate check, once.
    let by_offset = offset_order(entries)
    for rank in 1..by_offset.len {
        if entries[by_offset[rank]].offset == entries[by_offset[rank - 1]].offset {
            return Unsupported("pack index offsets")
        }
    }
    Index {
        entries: entries,
        by_offset: by_offset,
        pack_sum: data[data.len - 40..data.len - 20],
    }
}
