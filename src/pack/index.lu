// Git 2.56.0 gitformat-pack, Version 2 pack-*.idx files and Checksums.
use hash

struct Entry {
    offset: int,
    crc: int,
}

/// entries are in the idx's validated name order; by_offset holds the same
/// slots in increasing offset order. Lookups are binary searches (the
/// runtime Map is a linear scan, which made every idx parse quadratic).
/// names holds the idx's own name table, 20 raw bytes a slot: a name is
/// spelled in hex only when one is printed or matched by a prefix. reads and
/// pushed are what loading it cost: the positional reads of the file, and the
/// bytes copied one at a time (pack.Session sums them for the probe surface).
struct Index {
    entries: List[Entry],
    by_offset: List[int],
    pack_sum: List[byte],
    names: List[byte],
    reads: int,
    pushed: int,
}

/// The 20 raw bytes a 40-digit lowercase or uppercase hex name spells, or an
/// empty list when it is not one.
fn raw_name(name: str) -> List[byte] {
    var out = List[byte]()
    if name.len != 40 { return out }
    (mut out).reserve(20)
    for k in 0..20 {
        let hi = hex_digit(name.bytes()[2 * k] as int)
        let lo = hex_digit(name.bytes()[2 * k + 1] as int)
        if hi < 0 || lo < 0 { return List[byte]() }
        (mut out).push((hi * 16 + lo) as byte)
    }
    out
}

// A hex digit's value, or -1 (nameset's nibble folds every byte into 0-15).
fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    -1
}

/// How slot's raw name compares with raw (20 bytes): negative, zero or positive.
fn name_cmp(index: Index, slot: int, raw: List[byte]) -> int {
    let at = 20 * slot
    for k in 0..20 {
        let a = index.names[at + k] as int, b = raw[k] as int
        if a != b { return a - b }
    }
    0
}

/// slot's name in lowercase hex.
fn name_hex(index: Index, slot: int) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    (mut out).reserve(40)
    let at = 20 * slot
    for k in 0..20 {
        let b = index.names[at + k] as int
        (mut out).push(digits.bytes()[b / 16])
        (mut out).push(digits.bytes()[b % 16])
    }
    str_from_utf8(out) else ""
}

/// The slot named name (hex), or -1.
fn slot_named(index: Index, name: str) -> int {
    let raw = raw_name(name)
    if raw.len != 20 { return -1 }
    var lo = 0, hi = index.entries.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if name_cmp(index, mid, raw) < 0 { lo = mid + 1 } else { hi = mid }
    }
    if lo < index.entries.len && name_cmp(index, lo, raw) == 0 { return lo }
    -1
}

/// The first rank in by_offset whose entry starts at or after offset.
fn offset_rank(index: Index, offset: int) -> int {
    var lo = 0, hi = index.by_offset.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if index.entries[index.by_offset[mid]].offset < offset { lo = mid + 1 } else { hi = mid }
    }
    lo
}

/// The slot whose entry starts exactly at offset, or -1.
fn slot_at(index: Index, offset: int) -> int {
    let rank = offset_rank(index, offset)
    if rank < index.by_offset.len && index.entries[index.by_offset[rank]].offset == offset {
        return index.by_offset[rank]
    }
    -1
}

/// The next entry's offset after offset, or end when none follows.
fn next_offset(index: Index, offset: int, end: int) -> int {
    let rank = offset_rank(index, offset + 1)
    if rank < index.by_offset.len && index.entries[index.by_offset[rank]].offset < end {
        return index.entries[index.by_offset[rank]].offset
    }
    end
}

// Whether the 20 raw bytes at a sort before those at b (unsigned).
fn name_before(data: List[byte], a: int, b: int) -> bool {
    for k in 0..20 {
        if data[a + k] != data[b + k] { return data[a + k] < data[b + k] }
    }
    false
}

/// Slots ordered by offset: a stable bottom-up merge sort. Each pass merges
/// into scratch and copies back element by element, so no pass allocates
/// (den#63: a copied list a pass was 17 lists for 80,000 objects).
fn offset_order(entries: List[Entry]) -> List[int] {
    var order = List[int](), scratch = List[int]()
    (mut order).reserve(entries.len)
    (mut scratch).reserve(entries.len)
    for i in 0..entries.len {
        (mut order).push(i)
        (mut scratch).push(i)
    }
    var width = 1
    while width < order.len {
        var lo = 0
        while lo < order.len {
            let mid = if lo + width < order.len then lo + width else order.len
            let hi = if lo + 2 * width < order.len then lo + 2 * width else order.len
            var i = lo, j = mid, k = lo
            while i < mid && j < hi {
                if entries[order[j]].offset < entries[order[i]].offset {
                    scratch[k] = order[j]
                    j += 1
                } else {
                    scratch[k] = order[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                scratch[k] = order[i]
                i += 1
                k += 1
            }
            while j < hi {
                scratch[k] = order[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        for i in 0..order.len { order[i] = scratch[i] }
        width *= 2
    }
    order
}

fn be32(data: List[byte], pos: int) -> int {
    var n: int = 0
    for i in 0..4 { n = n * 256 + data[pos + i] as int }
    n
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

/// summed: the idx's own trailing SHA-1 is checked, as verify-pack, fsck and
/// installation check it. An object read does not check it, as the pinned Git
/// does not (measured): what a read relies on is checked whatever summed says
/// (the fanout, name order and offsets here, the idx-to-pack trailer binding,
/// and the read entry's CRC32 and reconstructed identity).
fn parse_index(data: List[byte], summed: bool) -> Index ! PackErrors {
    if data.len < 1072 { return Unsupported("pack index truncated") }
    if !same(data[0..4], [255 as byte, 116 as byte, 79 as byte, 99 as byte]) || be32(data, 4) != 2 {
        return Unsupported("pack index version (requires v2)")
    }
    if summed && !same(hash.sum1(data[0..data.len - 20]), data[data.len - 20..]) {
        return Unsupported("pack index checksum")
    }
    let count = be32(data, 1028)
    if count > 400000 { return Unsupported("limit: more than 400000 objects in one pack index") }
    let fixed = 1032 + count * 28 + 40
    if fixed > data.len || (data.len - fixed) % 8 != 0 { return Unsupported("pack index length") }
    let large_count = (data.len - fixed) / 8
    var previous: int = 0
    for i in 0..256 {
        let n = be32(data, 8 + 4 * i)
        if n < previous || n > count { return Unsupported("pack index fanout") }
        previous = n
    }
    // den#63: the entries are reserved to the count, and a parse keeps two
    // ints an object and the name table as the idx holds it; names are
    // ordered by their raw bytes, as their hex orders them.
    var entries = List[Entry]()
    (mut entries).reserve(count)
    var bucket = 0
    var large_used = Map[int, bool]()
    for i in 0..count {
        let pos = 1032 + 20 * i
        let first = data[pos] as int
        while bucket < first {
            if be32(data, 8 + bucket * 4) != i { return Unsupported("pack index fanout") }
            bucket += 1
        }
        if i > 0 && !name_before(data, pos - 20, pos) {
            return Unsupported("pack index name order")
        }
        var offset = be32(data, 1032 + count * 24 + i * 4)
        if offset >= 2147483648 {
            let slot = offset - 2147483648
            if slot >= large_count || (large_used[slot] else false) {
                return Unsupported("pack index large offsets")
            }
            large_used[slot] = true
            let start = 1032 + count * 28 + slot * 8
            let high = be32(data, start)
            if high > 2147483647 { return Unsupported("pack offset range") }
            offset = high * 4294967296 + be32(data, start + 4)
        }
        if offset < 12 { return Unsupported("pack index offsets") }
        (mut entries).push(Entry {
            offset: offset,
            crc: be32(data, 1032 + count * 20 + i * 4),
        })
    }
    while bucket < 256 {
        if be32(data, 8 + bucket * 4) != count { return Unsupported("pack index fanout") }
        bucket += 1
    }
    if large_used.len != large_count { return Unsupported("pack index large offsets") }
    // Two entries at one offset: the former per-entry duplicate check, once.
    let by_offset = offset_order(entries)
    for rank in 1..by_offset.len {
        if entries[by_offset[rank]].offset == entries[by_offset[rank - 1]].offset {
            return Unsupported("pack index offsets")
        }
    }
    Index {
        entries: entries,
        by_offset: by_offset,
        pack_sum: data[data.len - 40..data.len - 20],
        names: data[1032..1032 + 20 * count],
        reads: 0,
        pushed: 0,
    }
}
