// Git 2.56.0 gitformat-pack, Version 2 pack-*.idx files and Checksums.
use hash

/// A pack index as loaded. data is the idx file as read (read.lu's
/// load_index_summed): one list a positional read made, a MiB each, since the
/// runtime's read returns at most a MiB and a list is joined only by copying
/// it a byte at a time. A name or a word is read where the file holds it:
/// slot's name at 1032 + 20 * slot, its CRC32 at 1032 + 20 * count + 4 *
/// slot; a name is spelled in hex only when one is printed or matched by a
/// prefix. Once the index is ordered (order: the first read that needs a
/// slot by its offset, an offset delta's base, or a check of every entry),
/// offsets holds each slot's pack offset, the large-offset table followed, or
/// -1 where it cannot be followed, and by_offset holds the slots with an
/// offset in increasing offset order; before that both are empty and a slot's
/// offset is read from the file where it is used (slot_pack_offset). A read of an
/// object with no delta orders nothing. Lookups are binary searches within a
/// name's fanout bucket (the runtime Map is a linear scan, which made every
/// idx parse quadratic). The open checks what any use of the index needs; an
/// entry is checked where a read uses it (slot_offset), and every entry by
/// verify-pack, fsck and installation (validate_entries). reads and pushed
/// are what loading it cost: the positional reads of the file, and the bytes
/// copied one at a time; sorted is the work ordering the offsets took (list
/// slots set up, counters zeroed and summed, keys counted and moved), and
/// resolved the offsets resolved. pack.Session sums them for the probe
/// surface.
struct Index {
    data: List[List[byte]],
    size: int,
    count: int,
    offsets: List[int],
    by_offset: List[int],
    ordered: bool,
    pack_sum: List[byte],
    reads: int,
    pushed: int,
    sorted: int,
    resolved: int,
}

/// The loaded file's byte at pos.
fn at(data: List[List[byte]], pos: int) -> int { data[pos >> 20][pos & 1048575] as int }

/// The loaded file's big-endian 32-bit word at pos.
fn word(data: List[List[byte]], pos: int) -> int {
    let c = pos >> 20, o = pos & 1048575
    if o <= 1048572 {
        return ((data[c][o] as int * 256 + data[c][o + 1] as int) * 256 + data[c][o + 2] as int) *
            256 +
            data[c][o + 3] as int
    }
    ((at(data, pos) * 256 + at(data, pos + 1)) * 256 + at(data, pos + 2)) * 256 + at(data, pos + 3)
}

/// The 20 raw bytes a 40-digit lowercase or uppercase hex name spells, or an
/// empty list when it is not one.
fn raw_name(name: str) -> List[byte] {
    var out = List[byte]()
    if name.len != 40 { return out }
    (mut out).reserve(20)
    for k in 0..20 {
        let hi = hex_digit(name.bytes()[2 * k] as int)
        let lo = hex_digit(name.bytes()[2 * k + 1] as int)
        if hi < 0 || lo < 0 { return List[byte]() }
        (mut out).push((hi * 16 + lo) as byte)
    }
    out
}

// A hex digit's value, or -1 (nameset's nibble folds every byte into 0-15).
fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    -1
}

/// How slot's raw name compares with raw (20 bytes): negative, zero or positive.
fn name_cmp(index: Index, slot: int, raw: List[byte]) -> int {
    let start = 1032 + 20 * slot
    for k in 0..20 {
        let a = at(index.data, start + k), b = raw[k] as int
        if a != b { return a - b }
    }
    0
}

/// slot's name in lowercase hex.
fn name_hex(index: Index, slot: int) -> str {
    let digits = "0123456789abcdef"
    var out = List[byte]()
    (mut out).reserve(40)
    let start = 1032 + 20 * slot
    for k in 0..20 {
        let b = at(index.data, start + k)
        (mut out).push(digits.bytes()[b / 16])
        (mut out).push(digits.bytes()[b % 16])
    }
    str_from_utf8(out) else ""
}

/// slot's CRC32, as the idx records it.
fn slot_crc(index: Index, slot: int) -> int { word(index.data, 1032 + 20 * index.count + 4 * slot) }

/// The slot named name (hex), or -1.
fn slot_named(index: Index, name: str) -> int {
    let raw = raw_name(name)
    if raw.len != 20 { return -1 }
    // Within the name's fanout bucket, as Git looks: a name the idx holds
    // outside its bucket is not found, as Git does not find it.
    let first = raw[0] as int
    var lo = if first == 0 then 0 else word(index.data, 8 + 4 * (first - 1))
    let end = word(index.data, 8 + 4 * first)
    var hi = end
    while lo < hi {
        let mid = (lo + hi) / 2
        if name_cmp(index, mid, raw) < 0 { lo = mid + 1 } else { hi = mid }
    }
    if lo < end && name_cmp(index, lo, raw) == 0 { return lo }
    -1
}

/// slot's offset as the file holds it, the large-offset table followed, or
/// -1 where it cannot be followed: a reference past the table, or an offset of
/// 2^44 or more, past any pack den reads.
fn offset_in_file(data: List[List[byte]], size: int, count: int, slot: int) -> int {
    let offset = word(data, 1032 + count * 24 + slot * 4)
    if offset < 2147483648 { return offset }
    let large = offset - 2147483648
    if large >= (size - (1032 + count * 28 + 40)) / 8 { return -1 }
    let high = word(data, 1032 + count * 28 + large * 8)
    if high >= 4096 { return -1 }
    high * 4294967296 + word(data, 1032 + count * 28 + large * 8 + 4)
}

/// slot's pack offset (offset_in_file), from offsets once the index is ordered.
fn slot_pack_offset(index: Index, slot: int) -> int {
    if index.ordered { return index.offsets[slot] }
    offset_in_file(index.data, index.size, index.count, slot)
}

/// The refusal a cached read raises when it needs a slot by its offset from an
/// index not yet ordered: its caller orders the index and reads again
/// (read.lu's unpack_ordered).
fn order_needed() -> str { "pack index order" }

/// Orders index once: every offset resolved into offsets, and by_offset in
/// offset order (offset_order). resolved and sorted count it.
fn order(mut index: Index) {
    if index.ordered { return }
    var steps: int = 0
    offset_order(
        index.data,
        index.size,
        index.count,
        mut index.offsets,
        mut index.by_offset,
        mut steps,
    )
    index.resolved += index.count
    index.sorted += steps
    index.ordered = true
}

/// slot's pack offset for a read of it, below end (the pack's entries end):
/// the entry's own checks, made where it is used as Git makes them.
fn slot_offset(index: Index, slot: int, end: int) -> int ! PackErrors {
    let offset = slot_pack_offset(index, slot)
    if offset < 0 { return Unsupported("pack index large offsets") }
    if offset < 12 || offset >= end { return Unsupported("pack index offsets") }
    offset
}

/// The first rank in by_offset whose entry starts at or after offset.
fn offset_rank(index: Index, offset: int) -> int {
    var lo = 0, hi = index.by_offset.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if index.offsets[index.by_offset[mid]] < offset { lo = mid + 1 } else { hi = mid }
    }
    lo
}

/// The slot whose entry starts exactly at offset, or -1.
fn slot_at(index: Index, offset: int) -> int {
    let rank = offset_rank(index, offset)
    if rank < index.by_offset.len && index.offsets[index.by_offset[rank]] == offset {
        return index.by_offset[rank]
    }
    -1
}

/// The next entry's offset after offset, or end when none follows.
fn next_offset(index: Index, offset: int, end: int) -> int {
    let rank = offset_rank(index, offset + 1)
    if rank < index.by_offset.len && index.offsets[index.by_offset[rank]] < end {
        return index.offsets[index.by_offset[rank]]
    }
    end
}

/// The largest offset, or -1 for an index with no entries.
fn last_offset(index: Index) -> int {
    if index.by_offset.len == 0 { return -1 }
    index.offsets[index.by_offset[index.by_offset.len - 1]]
}

// Whether the 20 raw bytes at a sort before those at b (unsigned).
fn name_before(data: List[List[byte]], a: int, b: int) -> bool {
    for k in 0..20 {
        let x = at(data, a + k), y = at(data, b + k)
        if x != y { return x < y }
    }
    false
}

/// Slots in increasing offset order, ties in slot order: a least-significant-
/// digit radix sort over keys that carry their slot (offset * 2^19 + slot; an
/// idx holds at most 400,000 objects, under 2^19), so one list moves each
/// pass, not two. The digit is 16 bits for an index of 65,536 entries or more
/// and 8 bits under that: a small index pays 257 counters a pass, not 65,537,
/// and a pull opens about a thousand of them. A pass is skipped where every
/// offset has the same digit. The second list and the counters are the
/// region's; only the order is kept. steps counts the work: the list slots
/// set up and the order copied out here, the rest in radix_pass. Each slot's
/// offset is resolved into offsets (offset_in_file) on the way; a slot with no offset
/// (-1) is left out of the order.
fn offset_order(
    data: List[List[byte]],
    size: int,
    count: int,
    mut offsets: List[int],
    mut order: List[int],
    mut steps: int,
) {
    var n = 0
    var top: int = 0
    (mut offsets).reserve(count)
    for slot in 0..count {
        let o = offset_in_file(data, size, count, slot)
        (mut offsets).push(o)
        if o >= 0 { n += 1 }
        if o > top { top = o }
    }
    (mut order).reserve(n)
    let bits = if n >= 65536 then 16 else 8
    let buckets = if n >= 65536 then 65536 else 256
    region sort {
        var keys_a = List[int](), keys_b = List[int](), counts = List[int]()
        (mut keys_a).reserve(n)
        (mut keys_b).reserve(n)
        (mut counts).reserve(buckets + 1)
        for i in 0..offsets.len {
            if offsets[i] < 0 { continue }
            (mut keys_a).push(offsets[i] * 524288 + i)
            (mut keys_b).push(0)
        }
        for _ in 0..buckets + 1 { (mut counts).push(0) }
        steps += 2 * n + buckets + 1
        var shift = 0, in_b = false
        while shift < 44 && top >> shift > 0 {
            var moved = false
            if in_b {
                moved = radix_pass(keys_b, mut keys_a, 19 + shift, buckets, mut counts, mut steps)
            } else {
                moved = radix_pass(keys_a, mut keys_b, 19 + shift, buckets, mut counts, mut steps)
            }
            if moved { in_b = !in_b }
            shift += bits
        }
        if in_b {
            for k in keys_b { (mut order).push(k & 524287) }
        } else {
            for k in keys_a { (mut order).push(k & 524287) }
        }
        steps += n
    }
}

/// One stable pass on the digit of buckets values at shift, from keys into to.
/// Answers false, moving nothing, when every key has the same digit there.
/// steps counts the counters zeroed and summed and the keys counted and moved.
fn radix_pass(
    keys: List[int],
    mut to: List[int],
    shift: int,
    buckets: int,
    mut counts: List[int],
    mut steps: int,
) -> bool {
    let mask = buckets - 1
    for d in 0..buckets + 1 { counts[d] = 0 }
    for k in keys { counts[(k >> shift & mask) + 1] += 1 }
    steps += buckets + 1 + keys.len
    for d in 1..buckets + 1 {
        steps += 1
        if counts[d] == keys.len { return false }
        counts[d] += counts[d - 1]
    }
    for k in keys {
        let digit = k >> shift & mask
        to[counts[digit]] = k
        counts[digit] += 1
    }
    steps += keys.len
    true
}

fn be32(data: List[byte], pos: int) -> int {
    var n: int = 0
    for i in 0..4 { n = n * 256 + data[pos + i] as int }
    n
}

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

/// Whether the loaded file's last 20 bytes are the SHA-1 of the rest, taken
/// over the chunks in place.
fn summed_ok(data: List[List[byte]], size: int) -> bool {
    let end = size - 20
    var state = hash.new1()
    for c in 0..data.len {
        let start = c * 1048576
        if start >= end { break }
        if end - start >= data[c].len {
            hash.update1(mut state, data[c])
        } else {
            hash.update1_prefix(mut state, data[c], end - start)
        }
    }
    let digest = hash.final1(take state)
    for k in 0..20 { if digest[k] as int != at(data, end + k) { return false } }
    true
}

/// Every entry of index checked, as verify-pack, fsck and installation check
/// them, in the order the open once checked them: the fanout against the names,
/// the names' order, the large-offset table (each reference inside it, each of
/// its entries used once, none past 2^63), each offset at least 12, and no two
/// entries at one offset.
fn validate_entries(index: Index) -> () ! PackErrors {
    let count = index.count
    let large_count = (index.size - (1032 + count * 28 + 40)) / 8
    var bucket = 0
    var large_used = Map[int, bool]()
    let offset_table = 1032 + count * 24
    for i in 0..count {
        let pos = 1032 + 20 * i
        let first = at(index.data, pos)
        while bucket < first {
            if word(index.data, 8 + bucket * 4) != i { return Unsupported("pack index fanout") }
            bucket += 1
        }
        if i > 0 && !name_before(index.data, pos - 20, pos) {
            return Unsupported("pack index name order")
        }
        var offset = word(index.data, offset_table + i * 4)
        if offset >= 2147483648 {
            let slot = offset - 2147483648
            if slot >= large_count || (large_used[slot] else false) {
                return Unsupported("pack index large offsets")
            }
            large_used[slot] = true
            let start = 1032 + count * 28 + slot * 8
            let high = word(index.data, start)
            if high > 2147483647 { return Unsupported("pack offset range") }
            offset = high * 4294967296 + word(index.data, start + 4)
        }
        if offset < 12 { return Unsupported("pack index offsets") }
    }
    while bucket < 256 {
        if word(index.data, 8 + bucket * 4) != count { return Unsupported("pack index fanout") }
        bucket += 1
    }
    if large_used.len != large_count { return Unsupported("pack index large offsets") }
    if index.by_offset.len != count { return Unsupported("pack index offsets") }
    for rank in 1..index.by_offset.len {
        if index.offsets[index.by_offset[rank]] == index.offsets[index.by_offset[rank - 1]] {
            return Unsupported("pack index offsets")
        }
    }
}

/// summed: the idx's own trailing SHA-1 is checked, as verify-pack, fsck and
/// installation check it. An object read does not check it, as the pinned Git
/// does not (measured). The open checks what any use needs, as Git's open does
/// (header, version, a monotonic and bounded fanout, length); what a read
/// relies on beyond that is checked where it reads (slot_offset, the
/// idx-to-pack trailer binding, the entry's CRC32 and reconstructed identity).
/// data is the file as load_index_summed read it, size bytes in all.
fn parse_index(take data: List[List[byte]], size: int, summed: bool) -> Index ! PackErrors {
    if size < 1072 { return Unsupported("pack index truncated") }
    if at(data, 0) != 255 ||
        at(data, 1) != 116 ||
        at(data, 2) != 79 ||
        at(data, 3) != 99 ||
        word(data, 4) != 2 {
        return Unsupported("pack index version (requires v2)")
    }
    if summed && !summed_ok(data, size) { return Unsupported("pack index checksum") }
    let count = word(data, 1028)
    if count > 400000 { return Unsupported("limit: more than 400000 objects in one pack index") }
    let fixed = 1032 + count * 28 + 40
    if fixed > size || (size - fixed) % 8 != 0 { return Unsupported("pack index length") }
    var previous: int = 0
    for i in 0..256 {
        let n = word(data, 8 + 4 * i)
        if n < previous || n > count { return Unsupported("pack index fanout") }
        previous = n
    }
    // Nothing an entry holds is resolved or ordered here: a read reads the
    // offset of the entry it reads (slot_pack_offset), and the index is ordered only
    // when a read or a check needs it (order). den#63: an ordered index keeps
    // one int an object for its offsets and one for its order.
    var pack_sum = List[byte]()
    (mut pack_sum).reserve(20)
    for k in 0..20 { (mut pack_sum).push(at(data, size - 40 + k) as byte) }
    Index {
        data: data,
        size: size,
        count: count,
        offsets: List[int](),
        by_offset: List[int](),
        ordered: false,
        pack_sum: pack_sum,
        reads: 0,
        pushed: 0,
        sorted: 0,
        resolved: 0,
    }
}
