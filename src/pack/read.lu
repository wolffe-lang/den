// Bounded offset reads; no mmap, whole-pack buffer or persistent cache. A
// command may load its packs' indexes once and carry them (session_find,
// den#101); no object body outlives a read unless a batch reader keeps it.
use std.fs
use hash
use oid
use zlib

/// Owned canonical object body. The object module supplies the public adapter.
pub struct Body { kind: str, data: List[byte] }

fn read_window(fd: int, start: int, count: int) -> List[byte] ! PackErrors {
    let bytes = fs_read_at(fd, start, count) else |e| match e {
        eof => { return Unsupported("pack truncated") },
        _ => { return io },
    }
    if bytes.len == 0 { return Unsupported("pack truncated") }
    bytes
}

fn range_bytes(fd: int, start: int, count: int) -> List[byte] ! PackErrors {
    if start < 0 || count < 0 || start > 9223372036854775807 - count {
        return Unsupported("pack offset range")
    }
    // One buffer of the range's size: growing it a byte at a time kept every
    // smaller buffer it outgrew (an 11 MB index cost 32 MB).
    var out = List[byte](), pos: int = 0
    (mut out).reserve(count)
    while pos < count {
        region window {
            let want = if count - pos > 65536 then 65536 else count - pos
            let bytes = read_window(fd, start + pos, want)?
            for b in bytes { (mut out).push(b) }
            pos += bytes.len
        }
    }
    out
}

fn file_size(fd: int) -> int ! PackErrors {
    let info = fs_fstat_record(fd) else |_| { return io }
    if info[1] < 0 { return Unsupported("pack file size") }
    info[1]
}

fn open_pack(path: str) -> int ! PackErrors {
    fs_open(path) else |e| match e {
        not_found => { return Unsupported("pack missing companion") },
        denied => { return denied },
        io => { return io },
    }
}

/// A pack index for verify-pack, fsck, installation and housekeeping: its own
/// checksum included, and every entry checked (validate_entries).
fn load_index(path: str) -> Index ! PackErrors {
    var index = load_index_summed(path, true)?
    order(mut index)
    validate_entries(index)?
    index
}

/// A pack index for object reads and lookups: its own checksum is not read, as
/// the pinned Git reads one (parse_index).
fn load_read_index(path: str) -> Index ! PackErrors { load_index_summed(path, false)? }

fn load_index_summed(path: str, summed: bool) -> Index ! PackErrors {
    let fd = fs_open(path)?
    defer fs_close(fd) else |_| {}
    let size = file_size(fd)?
    if size > 16777216 { return Unsupported("limit: a pack index larger than 16777216 bytes") }
    // A MiB a read, each kept as the list the read made (index.lu's Index):
    // the file is copied a byte at a time only to finish a short read.
    var chunks = List[List[byte]](), pos: int = 0, reads: int = 0, pushed: int = 0
    while pos < size {
        let want = if size - pos > 1048576 then 1048576 else size - pos
        var chunk = read_window(fd, pos, want)?
        reads += 1
        while chunk.len < want {
            let more = read_window(fd, pos + chunk.len, want - chunk.len)?
            reads += 1
            pushed += more.len
            for b in more { (mut chunk).push(b) }
        }
        (mut chunks).push(take chunk)
        pos += want
    }
    if file_size(fd)? != size { return Unsupported("pack index changed") }
    var index = parse_index(take chunks, size, summed)?
    index.reads = reads
    index.pushed = pushed
    index
}

/// Header and object count against the parsed index, and with strict (verify-
/// pack, fsck, installation) the offset bounds of every entry; the size. A read
/// checks the entry it reads (slot_offset), as Git's reads do.
fn structure(fd: int, index: Index, strict: bool) -> int ! PackErrors {
    let size = file_size(fd)?
    if size < 32 { return Unsupported("pack truncated") }
    let header = range_bytes(fd, 0, 12)?
    if !same(header[0..4], "PACK".bytes()) || be32(header, 4) != 2 {
        return Unsupported("pack version (requires v2)")
    }
    if be32(header, 8) != index.count { return Unsupported("pack object count") }
    if !strict { return size }
    if index.count > 0 && slot_at(index, 12) == -1 {
        return Unsupported("pack index offsets")
    }
    if index.count == 0 && size != 32 { return Unsupported("pack index offsets") }
    if last_offset(index) >= size - 20 { return Unsupported("pack index offsets") }
    size
}

/// The read path's check (R-vc18-3): structure plus the idx-to-pack trailer
/// binding, never a whole-pack hash. Every object read is still bounded by
/// its entry CRC32 and its reconstructed identity; verify-pack, fsck and
/// installation keep the whole-pack checksum through verify below.
fn bounds(fd: int, index: Index) -> int ! PackErrors {
    let size = structure(fd, index, false)?
    let trailer = range_bytes(fd, size - 20, 20)?
    if !same(trailer, index.pack_sum) { return Unsupported("pack index binding") }
    if file_size(fd)? != size { return Unsupported("pack changed") }
    size - 20
}

/// bounds' answer for a pack whose bounds answered end when its session
/// loaded. The offset scan depends only on the index and the pack's size, so
/// while the size is unchanged only the header and the trailer binding are
/// read again; a changed size takes bounds' full check and its errors.
fn rebound(fd: int, index: Index, end: int) -> int ! PackErrors {
    let size = file_size(fd)?
    if size != end + 20 { return bounds(fd, index)? }
    let header = range_bytes(fd, 0, 12)?
    if !same(header[0..4], "PACK".bytes()) || be32(header, 4) != 2 {
        return Unsupported("pack version (requires v2)")
    }
    if be32(header, 8) != index.count { return Unsupported("pack object count") }
    let trailer = range_bytes(fd, size - 20, 20)?
    if !same(trailer, index.pack_sum) { return Unsupported("pack index binding") }
    if file_size(fd)? != size { return Unsupported("pack changed") }
    end
}

fn verify(fd: int, index: Index) -> int ! PackErrors {
    let size = structure(fd, index, true)?
    var state = hash.new1(), pos: int = 0
    while pos < size - 20 {
        region window {
            let count = if size - 20 - pos > 65536 then 65536 else size - 20 - pos
            let bytes = range_bytes(fd, pos, count)?
            hash.update1(mut state, bytes)
            pos += count
        }
    }
    let trailer = range_bytes(fd, size - 20, 20)?
    if !same(hash.final1(take state), trailer) { return Unsupported("pack checksum") }
    if !same(trailer, index.pack_sum) { return Unsupported("pack index binding") }
    if file_size(fd)? != size { return Unsupported("pack changed") }
    size - 20
}

// R-vc23-2: a read reconstructs at most three objects' worth along a chain.
fn reconstruction_limit() -> int { 3 * object_limit() }

/// A capped read's bound, named as the object store names it.
// A bound's message is a literal: an error can leave the region the read
// that raised it ran in, and a message built at run time would leave with it.
fn capped(cap: int) -> str {
    if cap == 16777216 { return "limit: an object larger than 16777216 bytes" }
    if cap == 67108864 { return "limit: an object larger than 67108864 bytes" }
    if cap == 1000000000 { return "limit: an object larger than 1000000000 bytes" }
    "limit: an object larger than its read allows"
}

fn charge(mut total: int, count: int) -> () ! PackErrors {
    if count < 0 || count > reconstruction_limit() - total {
        return Unsupported(
            "limit: more than 1610612736 bytes rebuilding one object from its delta chain",
        )
    }
    total += count
}

/// An entry's CRC-32, crc32's value: bit by bit for a short entry, a byte a
/// step through the 256-entry table for a long one, where building the table
/// costs less than the eight steps a byte it saves (a 40 KB blob's check
/// took most of its read).
// The read's refusal for the inflater's error, by the number its window gave it.
fn zlib_refusal(code: int) -> str {
    match code {
        1 => "pack zlib truncated",
        2 => "pack zlib bad_header",
        3 => "pack zlib dictionary",
        4 => "pack zlib checksum",
        5 => "pack zlib invalid",
        _ => "pack zlib limit",
    }
}

// CRC-32 continued over data[from..to] (start from 0; the value after the last
// part is the finished CRC): by table from 2 KiB, a bit at a time below, where
// building the table would cost more than it saves.
fn crc_part(crc: int, data: List[byte], from: int, to: int) -> int {
    var c = crc ^ 4294967295
    if to - from >= 2048 {
        let table = crc32_table()
        for i in from..to { c = table[(c ^ data[i] as int) & 255] ^ c >> 8 }
    } else {
        for i in from..to {
            c ^= data[i] as int
            for _ in 0..8 { c = if c & 1 != 0 then c >> 1 ^ 3988292384 else c >> 1 }
        }
    }
    c ^ 4294967295
}

fn unpack(
    fd: int,
    end: int,
    index: Index,
    slot: int,
    mut seen: Map[int, bool],
    mut total: int,
    mut read_bytes: int,
    mut reserved: int,
    mut window: int,
    mut span: int,
    depth: int,
    mut cache: Cache,
    pack_no: int,
    at: int,
) -> Body ! PackErrors {
    if depth > 64 { return Unsupported("limit: a delta chain deeper than 64") }
    // slot is the entry's, or -1 for an offset delta's base found by its
    // offset alone (at) in an index not ordered: its slot is the one its
    // rebuilt identity names (below), so no read orders an index to find one.
    var offset = at
    if slot >= 0 {
        offset = slot_offset(index, slot, end)?
    } else if at < 12 || at >= end {
        return Unsupported("pack OFS_DELTA base boundary")
    }
    if seen[offset] else false { return Unsupported("pack delta cycle") }
    seen[offset] = true
    // The entry's end is found from its own stream, as Git finds it, so no
    // read needs the entries in offset order. The header comes in a first
    // read of 4 KiB at most (a small entry whole); the stream in a window of
    // the least of the bytes left, the size hint (the declared size, a
    // sixteenth more and 64 bytes) and a MiB, read once, extended once to the
    // hint only when the stream runs past it. The CRC is checked after the
    // inflate, over the bytes the stream used (the owner's ruling).
    let avail = end - offset
    var bytes = read_window(fd, offset, if avail > 4096 then 4096 else avail)?
    if bytes.len > window { window = bytes.len }
    read_bytes += bytes.len
    if bytes.len == 0 { return Unsupported("pack entry header") }
    var byte0 = bytes[0] as int, pos: int = 1, size: int = byte0 & 15, scale: int = 16
    let kind = byte0 >> 4 & 7
    while byte0 >= 128 {
        if pos == bytes.len { return Unsupported("pack entry header") }
        byte0 = bytes[pos] as int
        pos += 1
        if byte0 & 127 > (object_limit() - size) / scale {
            return Unsupported("limit: a pack object larger than 536870912 bytes")
        }
        size += (byte0 & 127) * scale
        if byte0 >= 128 {
            if scale > object_limit() / 128 {
                return Unsupported("limit: a pack object larger than 536870912 bytes")
            }
            scale *= 128
        }
    }
    if size > object_limit() {
        return Unsupported("limit: a pack object larger than 536870912 bytes")
    }
    var base_slot: int = -1, base_at: int = -1, has_base = false
    if kind == 6 {
        if pos == bytes.len { return Unsupported("pack OFS_DELTA offset") }
        var b = bytes[pos] as int, distance: int = b & 127
        pos += 1
        while b >= 128 {
            if pos == bytes.len || distance >= offset / 128 {
                return Unsupported("pack OFS_DELTA offset")
            }
            b = bytes[pos] as int
            pos += 1
            distance = (distance + 1) * 128 + (b & 127)
        }
        if distance <= 0 || distance > offset - 12 { return Unsupported("pack OFS_DELTA offset") }
        base_at = offset - distance
        has_base = true
        if index.ordered {
            base_slot = slot_at(index, base_at)
            if base_slot < 0 { return Unsupported("pack OFS_DELTA base boundary") }
        } else if cache.keys.len > 0 {
            // A cached read keeps its bases unhashed, so it finds a base's
            // slot by its offset: its index is ordered first (unpack_ordered).
            return Unsupported(order_needed())
        }
    } else if kind == 7 {
        if bytes.len - pos < 20 { return Unsupported("pack REF_DELTA name") }
        let id = oid.from_bytes("sha1", bytes[pos..pos + 20]) else |_| {
            return Unsupported("pack REF_DELTA name")
        }
        let name = oid.hex(id) else |_| { return Unsupported("pack REF_DELTA name") }
        base_slot = slot_named(index, name)
        if base_slot < 0 { return Unsupported("thin pack REF_DELTA base") }
        base_at = slot_pack_offset(index, base_slot)
        has_base = true
        pos += 20
    } else if kind < 1 || kind > 4 {
        return Unsupported("pack object type")
    }
    charge(mut total, size)?
    // The stream may run no further than its limit: the least of the bytes
    // left before the trailer and the size hint (the declared size, a
    // sixteenth more and 64 bytes); there, truncated is a refusal.
    let hint = pos + size + size / 16 + 64
    let most = if hint < avail then hint else avail
    var out = List[byte]()
    var st = zlib.resume_start()
    var consumed: int = -1, crc: int = 0
    if most <= bytes.len {
        // The header's read holds the whole limit, so the stream is inflated
        // there.
        consumed = zlib.inflate_resume(
            bytes,
            pos,
            0,
            size,
            mut st,
            mut out,
            mut reserved,
        ) else |e| match e {
            truncated => { return Unsupported("pack zlib truncated") },
            // Each tag by name: the pinned compiler's checked machine renders an
            // error a match examined, read again in a wildcard arm, as <value>.
            bad_header => { return Unsupported("pack zlib bad_header") },
            dictionary => { return Unsupported("pack zlib dictionary") },
            checksum => { return Unsupported("pack zlib checksum") },
            invalid => { return Unsupported("pack zlib invalid") },
            limit => { return Unsupported("pack zlib limit") },
        }
        crc = crc_part(0, bytes, 0, pos + consumed)
    } else {
        // Windows of at most a MiB, each read and inflated in its own region
        // into the one output list made before them (reserved there once, and
        // grown only as bytes are made): each starts at the stream's last whole
        // block (zlib.inflate_resume), so a window reads again at most the block
        // it stopped in, and no window outlives the next. A window in which the
        // stream makes no progress (a block longer than the window) doubles the
        // next. The CRC is taken window by window, over each window's bytes up
        // to the resume point or the stream's end, and compared, as before, only
        // once the stream has ended and its size holds.
        // A refusal is named after the window's region has ended (zlib_refusal):
        // a message made in the region would be freed with it.
        var start: int = 0, size_w: int = 1048576, refused: int = 0
        while consumed < 0 && refused == 0 {
            let at0 = st.at
            let bit0 = st.bit
            region slide {
                let n = if most - start < size_w then most - start else size_w
                let w = if n > 1048576 {
                    range_bytes(fd, offset + start, n)?
                } else {
                    read_window(fd, offset + start, n)?
                }
                read_bytes += w.len
                if w.len > window { window = w.len }
                let skip = if start < pos then pos - start else 0
                consumed = zlib.inflate_resume(
                    w,
                    skip,
                    start + skip - pos,
                    size,
                    mut st,
                    mut out,
                    mut reserved,
                ) else |e| match e {
                    truncated => {
                        if start + w.len >= most { refused = 1 }
                        -1
                    },
                    bad_header => {
                        refused = 2
                        -1
                    },
                    dictionary => {
                        refused = 3
                        -1
                    },
                    checksum => {
                        refused = 4
                        -1
                    },
                    invalid => {
                        refused = 5
                        -1
                    },
                    limit => {
                        refused = 6
                        -1
                    },
                }
                if refused == 0 {
                    let edge = if consumed >= 0 then pos + consumed else pos + st.at
                    crc = crc_part(crc, w, 0, edge - start)
                    start = edge
                }
            }
            if consumed < 0 && st.at == at0 && st.bit == bit0 { size_w = 2 * size_w }
        }
        if refused != 0 { return Unsupported(zlib_refusal(refused)) }
    }
    if out.len != size { return Unsupported("pack entry size or trailing bytes") }
    let used = pos + consumed
    span = used
    charge(mut total, used)?
    var result = Body { kind: "", data: List[byte]() }
    let hit = if has_base then cache_find(cache, pack_no, base_at) else -1
    if hit >= 0 {
        // A base rebuilt and checked by an earlier read (cache_keep).
        var delta_pos: int = 0
        let _ = variable(out, mut delta_pos) else |_| {
            return Unsupported("pack delta invalid")
        }
        let target_size = variable(out, mut delta_pos) else |_| {
            return Unsupported("pack delta invalid")
        }
        if target_size > object_limit() {
            return Unsupported("limit: a pack object larger than 536870912 bytes")
        }
        charge(mut total, cache.data[hit].len)?
        charge(mut total, target_size)?
        let data = apply_delta(cache.data[hit], out, object_limit()) else |e| {
            return Unsupported("pack delta {e}")
        }
        result = Body { kind: kind_label(cache.kinds[hit]), data: data }
    } else if has_base {
        var base_span: int = 0
        let base = unpack(
            fd,
            end,
            index,
            base_slot,
            mut seen,
            mut total,
            mut read_bytes,
            mut reserved,
            mut window,
            mut base_span,
            depth + 1,
            mut cache,
            pack_no,
            base_at,
        )?
        var delta_pos: int = 0
        let _ = variable(out, mut delta_pos) else |_| {
            return Unsupported("pack delta invalid")
        }
        let target_size = variable(out, mut delta_pos) else |_| {
            return Unsupported("pack delta invalid")
        }
        if target_size > object_limit() {
            return Unsupported("limit: a pack object larger than 536870912 bytes")
        }
        charge(mut total, target_size)?
        let data = apply_delta(base.data, out, object_limit()) else |e| {
            return Unsupported("pack delta {e}")
        }
        result = Body { kind: base.kind, data: data }
    } else {
        let name = match kind {
            1 => "commit",
            2 => "tree",
            3 => "blob",
            _ => "tag",
        }
        result = Body { kind: name, data: copy out }
    }
    // A cached read checks the identity of the object asked for, not of each
    // base on the way (den#73: on a real history most of a read was hashing
    // each version of a large blob along its chain). A base is cached as it
    // was rebuilt, exactly what a rebuild from the pack gives at its offset,
    // and every object returned is still checked, so a bad base fails the
    // read that reaches it. An uncached read checks every level, as before.
    if depth > 0 && cache.keys.len > 0 {
        cache_keep(mut cache, pack_no, offset, result)
        return result
    }
    var digest = hash.new1()
    hash.update1(mut digest, "{result.kind} {result.data.len}\0".bytes())
    hash.update1(mut digest, result.data)
    let id = oid.from_bytes("sha1", hash.final1(take digest)) else |_| {
        return Unsupported("pack object identity")
    }
    if id.bytes.len != 20 { return Unsupported("pack object identity") }
    var named = slot
    if slot < 0 {
        // An offset delta's base found by its offset alone: its slot is the
        // one its rebuilt identity names, at that offset, and its CRC is that
        // slot's. An entry no slot names at its offset is refused, as before.
        let hex = oid.hex(id) else |_| { return Unsupported("pack object identity") }
        named = slot_named(index, hex)
        if named < 0 || slot_pack_offset(index, named) != offset {
            return Unsupported("pack OFS_DELTA base boundary")
        }
        if crc != slot_crc(index, named) { return Unsupported("pack entry CRC") }
    }
    if name_cmp(index, named, id.bytes) != 0 { return Unsupported("pack object identity") }
    cache_keep(mut cache, pack_no, offset, result)
    result
}

/// unpack for a read that may order its index: a read that needs a slot by
/// its offset (an offset delta's base) from an index not yet ordered orders it
/// (index.lu's order) and reads again. sorted and resolved count the order.
fn unpack_ordered(
    fd: int,
    end: int,
    mut index: Index,
    slot: int,
    mut seen: Map[int, bool],
    mut total: int,
    mut read_bytes: int,
    mut reserved: int,
    mut window: int,
    mut cache: Cache,
    pack_no: int,
    mut sorted: int,
    mut resolved: int,
) -> Body ! PackErrors {
    var again = false, span: int = 0
    let first = unpack(
        fd,
        end,
        index,
        slot,
        mut seen,
        mut total,
        mut read_bytes,
        mut reserved,
        mut window,
        mut span,
        0,
        mut cache,
        pack_no,
        0,
    ) else |e| match e {
        Unsupported(message) => {
            if message != order_needed() { return Unsupported(message) }
            again = true
            Body { kind: "", data: List[byte]() }
        },
        not_found => { return not_found },
        denied => { return denied },
        io => { return io },
    }
    if !again { return first }
    let sorted_before = index.sorted, resolved_before = index.resolved
    order(mut index)
    sorted += index.sorted - sorted_before
    resolved += index.resolved - resolved_before
    seen = Map[int, bool]()
    total = 0
    unpack(
        fd,
        end,
        index,
        slot,
        mut seen,
        mut total,
        mut read_bytes,
        mut reserved,
        mut window,
        mut span,
        0,
        mut cache,
        pack_no,
        0,
    )?
}

/// The type code (1 commit, 2 tree, 3 blob, 4 tag) of the entry at slot from
/// its header alone, a delta's from its base's header in turn: for a check
/// that needs an object's presence and type and not its body (a fetch's
/// closure check of an object the repository held before it). The header,
/// size and delta-base checks are unpack's; nothing is inflated, CRC-checked
/// or hashed, so a damaged body is found by the read that needs it.
fn entry_kind(
    fd: int,
    end: int,
    index: Index,
    slot: int,
    mut seen: Map[int, bool],
    depth: int,
    at: int,
) -> int ! PackErrors {
    if depth > 64 { return Unsupported("limit: a delta chain deeper than 64") }
    // slot is the entry's, or -1 for an offset delta's base, read at its
    // offset (at): a type needs no CRC, so no slot and no order.
    var offset = at
    if slot >= 0 {
        offset = slot_offset(index, slot, end)?
    } else if at < 12 || at >= end {
        return Unsupported("pack OFS_DELTA base boundary")
    }
    if seen[offset] else false { return Unsupported("pack delta cycle") }
    seen[offset] = true
    // The longest header: ten size bytes, then a 20-byte base name.
    let bytes = range_bytes(fd, offset, if end - offset > 32 then 32 else end - offset)?
    if bytes.len == 0 { return Unsupported("pack entry header") }
    var byte0 = bytes[0] as int, pos: int = 1, size: int = byte0 & 15, scale: int = 16
    let kind = byte0 >> 4 & 7
    while byte0 >= 128 {
        if pos == bytes.len { return Unsupported("pack entry header") }
        byte0 = bytes[pos] as int
        pos += 1
        if byte0 & 127 > (object_limit() - size) / scale {
            return Unsupported("limit: a pack object larger than 536870912 bytes")
        }
        size += (byte0 & 127) * scale
        if byte0 >= 128 {
            if scale > object_limit() / 128 {
                return Unsupported("limit: a pack object larger than 536870912 bytes")
            }
            scale *= 128
        }
    }
    if size > object_limit() {
        return Unsupported("limit: a pack object larger than 536870912 bytes")
    }
    if kind == 6 {
        if pos == bytes.len { return Unsupported("pack OFS_DELTA offset") }
        var b = bytes[pos] as int, distance: int = b & 127
        pos += 1
        while b >= 128 {
            if pos == bytes.len || distance >= offset / 128 {
                return Unsupported("pack OFS_DELTA offset")
            }
            b = bytes[pos] as int
            pos += 1
            distance = (distance + 1) * 128 + (b & 127)
        }
        if distance <= 0 || distance > offset - 12 { return Unsupported("pack OFS_DELTA offset") }
        return entry_kind(fd, end, index, -1, mut seen, depth + 1, offset - distance)?
    }
    if kind == 7 {
        if bytes.len - pos < 20 { return Unsupported("pack REF_DELTA name") }
        let id = oid.from_bytes("sha1", bytes[pos..pos + 20]) else |_| {
            return Unsupported("pack REF_DELTA name")
        }
        let name = oid.hex(id) else |_| { return Unsupported("pack REF_DELTA name") }
        let base_slot = slot_named(index, name)
        if base_slot < 0 { return Unsupported("thin pack REF_DELTA base") }
        return entry_kind(fd, end, index, base_slot, mut seen, depth + 1, 0)?
    }
    if kind < 1 || kind > 4 { return Unsupported("pack object type") }
    kind
}

/// den#73: objects rebuilt along delta chains, by pack and offset, so reads
/// in walk order rebuild each base once rather than once for every object
/// above it in its chain (git-config(1)'s core.deltaBaseCacheLimit describes
/// Git's form of the idea). Direct-mapped slots, each holding an object of
/// at most cache_object_limit() bytes, each as its rebuild from the pack gave
/// it (only the object a read returns has its identity checked). Without
/// slots (no_cache) nothing is kept.
pub struct Cache {
    keys: List[int],
    kinds: List[int],
    data: List[List[byte]],
}

/// 256 slots of at most 16 KiB: the slots never hold more than 4 MiB.
pub fn base_cache() -> Cache {
    var keys = List[int](), kinds = List[int](), data = List[List[byte]]()
    for _ in 0..256 {
        (mut keys).push(-1)
        (mut kinds).push(0)
        let slot = List[byte]()
        (mut data).push(take slot)
    }
    Cache { keys: keys, kinds: kinds, data: data }
}

fn no_cache() -> Cache { Cache { keys: List[int](), kinds: List[int](), data: List[List[byte]]() } }

fn cache_object_limit() -> int { 16384 }

fn cache_slot(c: Cache, pack_no: int, offset: int) -> int {
    (offset / 16 + pack_no * 31) % c.keys.len
}

fn cache_key(pack_no: int, offset: int) -> int { pack_no * 1099511627776 + offset }

fn cache_find(c: Cache, pack_no: int, offset: int) -> int {
    if c.keys.len == 0 { return -1 }
    let slot = cache_slot(c, pack_no, offset)
    if c.keys[slot] == cache_key(pack_no, offset) { return slot }
    -1
}

fn kind_label(code: int) -> str {
    match code {
        1 => "commit",
        2 => "tree",
        3 => "blob",
        _ => "tag",
    }
}

fn kind_code(kind: str) -> int {
    match kind {
        "commit" => 1,
        "tree" => 2,
        "blob" => 3,
        _ => 4,
    }
}

fn cache_keep(mut c: Cache, pack_no: int, offset: int, body: Body) {
    if c.keys.len == 0 || body.data.len > cache_object_limit() { return }
    let slot = cache_slot(c, pack_no, offset)
    c.keys[slot] = cache_key(pack_no, offset)
    c.kinds[slot] = kind_code(body.kind)
    (mut c.data[slot]).clear()
    for b in body.data { (mut c.data[slot]).push(b) }
}

fn indexes(gitdir: str) -> List[str] ! PackErrors {
    let dir = "{gitdir}/objects/pack"
    let entries = fs.entries(dir) else |e| match e {
        not_found => { return List[str]() },
        denied => { return denied },
        io => { return io },
    }
    var out = List[str]()
    if entries.len > 8192 { return Unsupported("limit: more than 8192 entries in objects/pack") }
    for entry in entries {
        let name = str_from_utf8(entry.name) else |_| { return Unsupported("non-UTF-8 pack path") }
        if name == "multi-pack-index" || name == "multi-pack-index.d" {
            return Unsupported("multi-pack-index")
        }
        if name.ends_with(".bitmap") { return Unsupported("pack bitmap") }
        if name.starts_with("pack-") &&
            name.ends_with(".pack") &&
            !fs.exists("{dir}/{name[0..name.len - 5]}.idx") {
            return Unsupported("pack missing index")
        }
        if name.starts_with("pack-") && name.ends_with(".idx") {
            if entry.kind != 0 { return Unsupported("pack index file type") }
            if out.len >= 256 { return Unsupported("limit: more than 256 packs in objects/pack") }
            (mut out).push("{dir}/{name}")
        }
    }
    out
}

/// Full-width lookup. Loose precedence is the caller's responsibility.
pub fn read_object(gitdir: str, name: str, cap: int) -> Body ! PackErrors {
    // A read's diagnostic is built in candidate: it is copied out and raised
    // once the region is freed.
    var error_payload = "", failed = false
    for path in indexes(gitdir)? {
        // Per-pack scratch is reclaimed; the returned body is explicitly owned.
        var result = Body { kind: "", data: List[byte]() }, found = false
        region candidate {
            var index = load_read_index(path)?
            let fd = open_pack("{path[0..path.len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let end = bounds(fd, index)?
            let slot = slot_named(index, name)
            if slot >= 0 {
                var seen = Map[int, bool](),
                    total: int = 0,
                    none = no_cache(),
                    read_n: int = 0,
                    reserved_n: int = 0,
                    window_n: int = 0
                var sorted_n: int = 0, resolved_n: int = 0
                let value = unpack_ordered(
                    fd,
                    end,
                    mut index,
                    slot,
                    mut seen,
                    mut total,
                    mut read_n,
                    mut reserved_n,
                    mut window_n,
                    mut none,
                    0,
                    mut sorted_n,
                    mut resolved_n,
                ) else |e| match e {
                    Unsupported(message) => {
                        error_payload = copy message
                        failed = true
                        break
                    },
                    not_found => { return not_found },
                    denied => { return denied },
                    io => { return io },
                }
                result = copy value
                found = true
            }
        }
        if found {
            if result.data.len > cap {
                return Unsupported(capped(cap))
            }
            return result
        }
    }
    if failed { return Unsupported(error_payload) }
    not_found
}

/// The objects every pack index lists, summed, read from each index's header
/// alone: the count Git sizes its default short names by (it counts no loose
/// object).
pub fn packed_count(gitdir: str) -> int ! PackErrors {
    var total = 0
    for path in indexes(gitdir)? {
        let fd = fs_open(path)?
        defer fs_close(fd) else |_| {}
        let head = range_bytes(fd, 0, 1032)?
        if !same(head[0..4], [255 as byte, 116 as byte, 79 as byte, 99 as byte]) ||
            be32(head, 4) != 2 {
            return Unsupported("pack index version (requires v2)")
        }
        total += be32(head, 1028)
    }
    total
}

/// Return at most two distinct matching names, sufficient for ambiguity checks.
/// Validate the trailer binding even for prefix-only reads.
pub fn prefix(gitdir: str, prefix: str) -> List[str] ! PackErrors {
    var out = List[str]()
    for path in indexes(gitdir)? {
        region candidate {
            let index = load_read_index(path)?
            let fd = open_pack("{path[0..path.len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let _ = bounds(fd, index)?
            for slot in 0..index.count {
                let name = name_hex(index, slot)
                if name.starts_with(prefix) {
                    var duplicate = false
                    for seen in out { if seen == name { duplicate = true } }
                    if !duplicate && out.len < 2 { (mut out).push(copy name) }
                }
            }
        }
    }
    out
}

/// Indexes parsed once for a batch of reads (a tree walk, a history walk).
/// Every pack is structure- and binding-checked when the session loads, as
/// read_object checks each pack it passes; each read reopens its pack and
/// re-checks those bounds (rebound), so a replaced or truncated pack is never
/// misread. ends holds each pack's bounds answer at load. opens, reads, pushed,
/// sorted and resolved count what loading cost (the probe surface:
/// probes/pack-client --open-counts and --read-counts): the indexes loaded,
/// their positional reads, the bytes copied one at a time, the work ordering
/// their offsets took and the offsets resolved. read and reserved count what
/// the session's reads cost: the pack bytes read for their entries and the
/// output bytes reserved for them, outgrown buffers included; window is the
/// largest window of pack bytes a read held at once.
pub struct Session {
    gitdir: str,
    paths: List[str],
    indexes: List[Index],
    ends: List[int],
    loaded: bool,
    cache: Cache,
    opens: int,
    reads: int,
    pushed: int,
    sorted: int,
    resolved: int,
    read: int,
    reserved: int,
    window: int,
}

/// An unloaded session; indexes are listed and checked on the first read.
pub fn session(gitdir: str) -> Session {
    Session {
        gitdir: copy gitdir,
        paths: List[str](),
        indexes: List[Index](),
        ends: List[int](),
        loaded: false,
        cache: base_cache(),
        opens: 0,
        reads: 0,
        pushed: 0,
        sorted: 0,
        resolved: 0,
        read: 0,
        reserved: 0,
        window: 0,
    }
}

fn load_session(mut s: Session) -> () ! PackErrors {
    for path in indexes(s.gitdir)? {
        let index = load_read_index(path)?
        let fd = open_pack("{path[0..path.len - 4]}.pack")?
        defer fs_close(fd) else |_| {}
        let end = bounds(fd, index)?
        s.opens += 1
        s.reads += index.reads
        s.pushed += index.pushed
        s.sorted += index.sorted
        s.resolved += index.resolved
        (mut s.paths).push(copy path)
        // The index moves into the session: a plain push would copy it whole.
        (mut s.indexes).push(take index)
        (mut s.ends).push(end)
    }
    s.loaded = true
}

/// A session whose indexes are listed and checked now, for reads that must
/// not grow it (session_peek), such as reads inside a caller's region.
pub fn session_open(gitdir: str) -> Session ! PackErrors {
    var s = session(gitdir)
    load_session(mut s)?
    s
}

/// read_object's answer through an opened session's indexes, unchanged; an
/// unopened session answers through read_object itself.
pub fn session_peek(s: Session, name: str, cap: int) -> Body ! PackErrors {
    if !s.loaded { return read_object(s.gitdir, name, cap)? }
    // A read's diagnostic is built in candidate: it is copied out and raised
    // once the region is freed.
    var error_payload = "", failed = false
    for i in 0..s.paths.len {
        let slot = slot_named(s.indexes[i], name)
        if slot < 0 { continue }
        var result = Body { kind: "", data: List[byte]() }
        region candidate {
            let fd = open_pack("{s.paths[i][0..s.paths[i].len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let end = rebound(fd, s.indexes[i], s.ends[i])?
            var seen = Map[int, bool](),
                total: int = 0,
                none = no_cache(),
                read_n: int = 0,
                reserved_n: int = 0,
                window_n: int = 0,
                span_n: int = 0
            let value = unpack(
                fd,
                end,
                s.indexes[i],
                slot,
                mut seen,
                mut total,
                mut read_n,
                mut reserved_n,
                mut window_n,
                mut span_n,
                0,
                mut none,
                0,
                0,
            ) else |e| match e {
                Unsupported(message) => {
                    error_payload = copy message
                    failed = true
                    break
                },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
            }
            result = copy value
        }
        if result.data.len > cap {
            return Unsupported(capped(cap))
        }
        return result
    }
    if failed { return Unsupported(error_payload) }
    not_found
}

/// session_peek's answer for an opened session, with its bases rebuilt
/// through the session's cache (Cache): a batch reading many objects of a
/// delta chain, as a pack writer or a closure walk does, rebuilds each base
/// once. The cache changes only bytes and ints, so a caller may read inside
/// its own region. Bases the cache serves are not read from the pack again.
pub fn session_cached(mut s: Session, name: str, cap: int) -> Body ! PackErrors {
    if !s.loaded { return read_object(s.gitdir, name, cap)? }
    // A read's diagnostic is built in candidate: it is copied out and raised
    // once the region is freed.
    var error_payload = "", failed = false
    for i in 0..s.paths.len {
        let slot = slot_named(s.indexes[i], name)
        if slot < 0 { continue }
        var result = Body { kind: "", data: List[byte]() }
        region candidate {
            let fd = open_pack("{s.paths[i][0..s.paths[i].len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let end = rebound(fd, s.indexes[i], s.ends[i])?
            var seen = Map[int, bool](), total: int = 0
            let value = unpack_ordered(
                fd,
                end,
                mut s.indexes[i],
                slot,
                mut seen,
                mut total,
                mut s.read,
                mut s.reserved,
                mut s.window,
                mut s.cache,
                i,
                mut s.sorted,
                mut s.resolved,
            ) else |e| match e {
                Unsupported(message) => {
                    error_payload = copy message
                    failed = true
                    break
                },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
            }
            result = copy value
        }
        if result.data.len > cap {
            return Unsupported(capped(cap))
        }
        return result
    }
    if failed { return Unsupported(error_payload) }
    not_found
}

/// The type of the object name ("commit", "tree", "blob" or "tag") from its
/// entry header (entry_kind), through the session's indexes, each pack's
/// header and trailer binding checked again (rebound) as a read checks it;
/// not_found when no loaded pack holds it. Its body is never rebuilt. An
/// unopened session answers through read_object, as session_cached does, and
/// is never loaded here: nothing in the session changes, so a caller may type
/// objects inside its own region ([mem.region.outer-write]); a load there
/// would leave the session holding indexes the region frees.
pub fn session_kind(s: Session, name: str) -> str ! PackErrors {
    if !s.loaded { return read_object(s.gitdir, name, object_limit())?.kind }
    for i in 0..s.paths.len {
        let slot = slot_named(s.indexes[i], name)
        if slot < 0 { continue }
        var code = 0
        region candidate {
            let fd = open_pack("{s.paths[i][0..s.paths[i].len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let end = rebound(fd, s.indexes[i], s.ends[i])?
            var seen = Map[int, bool]()
            code = entry_kind(fd, end, s.indexes[i], slot, mut seen, 0, 0)?
        }
        return kind_label(code)
    }
    not_found
}

/// An unloaded session with no base cache: what a repository carries until
/// its packs are opened (den#101). Listing nothing and reading nothing, it
/// costs a command that never reads a packed object nothing.
pub fn unloaded(gitdir: str) -> Session {
    Session {
        gitdir: copy gitdir,
        paths: List[str](),
        indexes: List[Index](),
        ends: List[int](),
        loaded: false,
        cache: no_cache(),
        opens: 0,
        reads: 0,
        pushed: 0,
        sorted: 0,
        resolved: 0,
        read: 0,
        reserved: 0,
        window: 0,
    }
}

/// s's indexes with a base cache of their own, for a batch reader's
/// session_cached: the indexes are not parsed again.
pub fn with_cache(s: Session) -> Session {
    var out = copy s
    out.cache = base_cache()
    out
}

/// One loaded pack's object at slot, its pack reopened and its header and
/// trailer binding checked again (rebound), as session_peek reads it.
fn read_slot(s: Session, i: int, slot: int) -> Body ! PackErrors {
    var result = Body { kind: "", data: List[byte]() }
    // A read's diagnostic is built in candidate: it is copied out and raised
    // once the region is freed.
    var error_payload = "", failed = false
    region candidate {
        let fd = open_pack("{s.paths[i][0..s.paths[i].len - 4]}.pack")?
        defer fs_close(fd) else |_| {}
        let end = rebound(fd, s.indexes[i], s.ends[i])?
        var seen = Map[int, bool](),
            total: int = 0,
            none = no_cache(),
            read_n: int = 0,
            reserved_n: int = 0,
            window_n: int = 0,
            span_n: int = 0
        let value = unpack(
            fd,
            end,
            s.indexes[i],
            slot,
            mut seen,
            mut total,
            mut read_n,
            mut reserved_n,
            mut window_n,
            mut span_n,
            0,
            mut none,
            0,
            0,
        ) else |e| match e {
            Unsupported(message) => {
                error_payload = copy message
                failed = true
                Body { kind: "", data: List[byte]() }
            },
            not_found => { return not_found },
            denied => { return denied },
            io => { return io },
        }
        result = copy value
    }
    if failed { return Unsupported(error_payload) }
    result
}

/// read_object's answer through a session loaded once (den#101), never a
/// different one. A name a loaded index holds is read from its pack, the
/// pack's header and trailer binding checked again. Any other outcome is
/// read_object's own: a read through the session that fails for any reason
/// (a pack removed, replaced or damaged since the load), or a name none of
/// the loaded indexes holds while objects/pack lists a pack the session has
/// not loaded (one written since), is answered by read_object itself, every
/// error included. A name absent from every listed pack, while objects/pack
/// lists exactly the loaded packs, is not_found, as read_object answers it,
/// without parsing an index again.
pub fn session_find(s: Session, name: str, cap: int) -> Body ! PackErrors {
    if !s.loaded { return read_object(s.gitdir, name, cap)? }
    for i in 0..s.paths.len {
        let slot = slot_named(s.indexes[i], name)
        if slot < 0 { continue }
        let body = read_slot(s, i, slot) else |_| { return read_object(s.gitdir, name, cap)? }
        if body.data.len > cap { return Unsupported(capped(cap)) }
        return body
    }
    if !same_listing(s)? { return read_object(s.gitdir, name, cap)? }
    not_found
}

/// Whether objects/pack lists exactly the packs s loaded, in the same order.
fn same_listing(s: Session) -> bool ! PackErrors {
    let listed = indexes(s.gitdir)?
    if listed.len != s.paths.len { return false }
    for i in 0..listed.len { if listed[i] != s.paths[i] { return false } }
    true
}

/// prefix's answer through a session loaded once (den#101): each loaded
/// index's names that start with prefix are found by binary search, at most
/// two distinct, as prefix collects them. While objects/pack lists anything
/// but the packs the session loaded, prefix itself answers.
pub fn session_prefix(s: Session, prefix_text: str) -> List[str] ! PackErrors {
    if !s.loaded || !same_listing(s)? { return prefix(s.gitdir, prefix_text)? }
    var out = List[str]()
    for index in s.indexes {
        var lo = 0, hi = index.count
        while lo < hi {
            let mid = (lo + hi) / 2
            if name_hex(index, mid) < prefix_text { lo = mid + 1 } else { hi = mid }
        }
        while lo < index.count && name_hex(index, lo).starts_with(prefix_text) {
            let name = name_hex(index, lo)
            var duplicate = false
            for seen in out { if seen == name { duplicate = true } }
            if !duplicate && out.len < 2 { (mut out).push(copy name) }
            if out.len == 2 { break }
            lo += 1
        }
    }
    out
}

/// read_object's answer through the session's parsed indexes.
pub fn session_read(mut s: Session, name: str, cap: int) -> Body ! PackErrors {
    if !s.loaded { load_session(mut s)? }
    // A read's diagnostic is built in candidate: it is copied out and raised
    // once the region is freed.
    var error_payload = "", failed = false
    for i in 0..s.paths.len {
        let slot = slot_named(s.indexes[i], name)
        if slot < 0 { continue }
        var result = Body { kind: "", data: List[byte]() }
        region candidate {
            let fd = open_pack("{s.paths[i][0..s.paths[i].len - 4]}.pack")?
            defer fs_close(fd) else |_| {}
            let end = rebound(fd, s.indexes[i], s.ends[i])?
            var seen = Map[int, bool](), total: int = 0, none = no_cache()
            let value = unpack_ordered(
                fd,
                end,
                mut s.indexes[i],
                slot,
                mut seen,
                mut total,
                mut s.read,
                mut s.reserved,
                mut s.window,
                mut none,
                0,
                mut s.sorted,
                mut s.resolved,
            ) else |e| match e {
                Unsupported(message) => {
                    error_payload = copy message
                    failed = true
                    break
                },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
            }
            result = copy value
        }
        if result.data.len > cap {
            return Unsupported(capped(cap))
        }
        return result
    }
    if failed { return Unsupported(error_payload) }
    not_found
}
