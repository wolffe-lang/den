// Original pack-v2/idx-v2 writer from gitformat-pack(5). R4c: representation
// is not byte parity. No object-store dependency, subprocess or pruning here.
use std.fs
use hash
use oid
use zlib

/// Owned pair; install validates the public bytes before publishing either file.
pub struct Encoded { data: List[byte], index: List[byte], name: str }

fn append_write(mut out: List[byte], bytes: List[byte]) {
    for b in bytes { (mut out).push(b) }
}

fn put32(mut out: List[byte], n: int) {
    for i in 0..4 { (mut out).push((n >> (3 - i) * 8 & 255) as byte) }
}

fn entry_header(kind: int, size: int) -> List[byte] {
    var n = size >> 4
    var out = [(kind << 4 | size & 15 | (if n > 0 then 128 else 0)) as byte]
    while n > 0 {
        let b = n & 127
        n = n >> 7
        (mut out).push((b | (if n > 0 then 128 else 0)) as byte)
    }
    out
}

fn offset_bytes(distance: int) -> List[byte] {
    var n = distance
    var reverse = [(n & 127) as byte]
    while n >= 128 {
        n = (n >> 7) - 1
        (mut reverse).push((n & 127 | 128) as byte)
    }
    var out = List[byte]()
    for i in 0..reverse.len { (mut out).push(reverse[reverse.len - 1 - i]) }
    out
}

fn kind_number(kind: str) -> int ! PackErrors {
    match kind {
        "commit" => 1,
        "tree" => 2,
        "blob" => 3,
        "tag" => 4,
        _ => { return Unsupported("pack writer object type") },
    }
}

fn body_name(body: Body) -> str ! PackErrors {
    var h = hash.new1()
    hash.update1(mut h, "{body.kind} {body.data.len}\0".bytes())
    hash.update1(mut h, body.data)
    let id = oid.from_bytes("sha1", hash.final1(take h)) else |_| {
        return Unsupported("pack writer identity")
    }
    oid.hex(id) else |_| { return Unsupported("pack writer identity") }
}

fn instructions(before: List[byte], after: List[byte]) -> List[byte] ! PackErrors {
    encode_delta(before, after) else |e| { return Unsupported("pack writer delta {e}") }
}

fn instructions_within(
    before: List[byte],
    after: List[byte],
    within: int,
) -> List[byte] ! PackErrors {
    encode_delta_within(before, after, within) else |e| {
        return Unsupported("pack writer delta {e}")
    }
}

fn raw_id(name: str) -> List[byte] ! PackErrors {
    let id = oid.parse("sha1", name) else |_| { return Unsupported("pack writer identity") }
    copy id.bytes
}

fn check_output(size: int, addition: int) -> () ! PackErrors {
    if addition > 134217708 - size { return Unsupported("pack writer output limit") }
}

fn deflated(data: List[byte]) -> List[byte] ! PackErrors {
    zlib.deflate(data, 1, 17000000) else |e| { return Unsupported("pack writer compression {e}") }
}

/// Encode an owned pack/idx pair. mode is none, ofs or ref. Candidate window 10,
/// depth 50; 16 MiB/body, 128 MiB aggregate input and output, 10,000 objects.
/// Duplicate identities are emitted once. Ordering is type then descending size.
pub fn encode(bodies: List[Body], mode: str) -> Encoded ! PackErrors {
    if mode != "none" && mode != "ofs" && mode != "ref" {
        return Unsupported("pack writer delta mode")
    }
    if bodies.len > 10000 { return Unsupported("pack writer object count limit") }
    var total = 0, order = List[int](), names = List[str](), seen = Map[str, bool]()
    for i in 0..bodies.len {
        let _ = kind_number(bodies[i].kind)?
        if bodies[i].data.len > 16777216 { return Unsupported("pack writer object size limit") }
        if bodies[i].data.len > 134217728 - total {
            return Unsupported("pack writer payload limit")
        }
        total += bodies[i].data.len
        let name = body_name(bodies[i])?
        (mut names).push(copy name)
        if seen[name] else false { continue }
        seen[name] = true
        (mut order).push(i)
        var j = order.len - 1
        while j > 0 {
            let a = order[j - 1], b = order[j]
            if bodies[a].kind < bodies[b].kind ||
                bodies[a].kind == bodies[b].kind && bodies[a].data.len >= bodies[b].data.len {
                break
            }
            order[j - 1] = b
            order[j] = a
            j -= 1
        }
    }
    var data = List[byte]()
    append_write(mut data, "PACK".bytes())
    put32(mut data, 2)
    put32(mut data, order.len)
    var entries = List[Entry](), depths = List[int]()
    for slot in 0..order.len {
        let b = order[slot]
        let offset = data.len
        var record = Entry { name: copy names[b], offset: offset, crc: 0 }
        region candidate {
            var encoded = entry_header(kind_number(bodies[b].kind)?, bodies[b].data.len)
            append_write(mut encoded, deflated(bodies[b].data)?)
            var depth = 0
            if mode != "none" {
                let start = if slot > 10 then slot - 10 else 0
                for prior in start..slot {
                    region delta_candidate {
                        let a = order[prior]
                        if bodies[a].kind != bodies[b].kind || depths[prior] >= 50 { continue }
                        let delta = instructions(bodies[a].data, bodies[b].data)?
                        if delta.len > 16777216 { continue }
                        var trial = entry_header(if mode == "ofs" then 6 else 7, delta.len)
                        if mode == "ofs" {
                            append_write(mut trial, offset_bytes(offset - entries[prior].offset))
                        } else {
                            append_write(mut trial, raw_id(names[a])?)
                        }
                        append_write(mut trial, deflated(delta)?)
                        if trial.len < encoded.len {
                            encoded = copy trial
                            depth = depths[prior] + 1
                        }
                    }
                }
            }
            check_output(data.len, encoded.len)?
            record.crc = crc32(encoded)
            (mut depths).push(depth)
            append_write(mut data, encoded)
        }
        (mut entries).push(record)
    }
    let sum = hash.sum1(data)
    append_write(mut data, sum)
    let id = oid.from_bytes("sha1", sum) else |_| { return Unsupported("pack writer identity") }
    let name = oid.hex(id) else |_| { return Unsupported("pack writer identity") }
    for i in 1..entries.len {
        var j = i
        while j > 0 && entries[j].name < entries[j - 1].name {
            let saved = copy entries[j]
            entries[j] = copy entries[j - 1]
            entries[j - 1] = saved
            j -= 1
        }
    }
    var index = [255 as byte, 116 as byte, 79 as byte, 99 as byte]
    put32(mut index, 2)
    var count = 0
    for bucket in 0..256 {
        while count < entries.len {
            let id = oid.parse("sha1", entries[count].name) else |_| {
                return Unsupported("pack writer identity")
            }
            if id.bytes[0] as int > bucket { break }
            count += 1
        }
        put32(mut index, count)
    }
    for entry in entries {
        let id = oid.parse("sha1", entry.name) else |_| {
            return Unsupported("pack writer identity")
        }
        append_write(mut index, id.bytes)
    }
    for entry in entries { put32(mut index, entry.crc) }
    for entry in entries { put32(mut index, entry.offset) }
    append_write(mut index, sum)
    let index_sum = hash.sum1(index)
    append_write(mut index, index_sum)
    Encoded { data: data, index: index, name: name }
}

/// den#73: a pack written to a file as its objects come, one body at a
/// time, for serving and push: no object count or aggregate cap, the
/// per-object cap (object_limit) kept. Deltas are tried against the
/// previous 10 objects of the same type (depth 50, as encode does), whose
/// bodies are the only ones held, in buffers the writer owns (a caller adds
/// from inside its own region). finish appends the trailer.
pub struct Writer {
    path: str,
    fd: int,
    mode: str,
    count: int,
    written: int,
    offset: int,
    kind: int,
    names: List[byte],
    data: List[List[byte]],
    offsets: List[int],
    depths: List[int],
    filled: int,
    next: int,
    tables: zlib.Tables,
}

/// An exclusive temporary in dir for a pack of count objects; mode is none,
/// ofs or ref.
pub fn writer_begin(dir: str, count: int, mode: str) -> Writer ! PackErrors {
    if mode != "none" && mode != "ofs" && mode != "ref" {
        return Unsupported("pack writer delta mode")
    }
    if count < 0 || count > 4294967295 { return Unsupported("pack writer object count") }
    fs.create_dir_all(dir) else |_| { return io }
    var names = List[byte](), data = List[List[byte]](), offsets = List[int](), depths = List[int]()
    for _ in 0..400 { (mut names).push(0 as byte) }
    for _ in 0..10 {
        (mut data).push(List[byte]())
        (mut offsets).push(0)
        (mut depths).push(0)
    }
    for serial in 0..1024 {
        let path = "{dir}/den-out-{serial}.pack"
        let file = fs.create_new_with_mode(path, 0o600) else |e| match e {
            exists => { continue },
            _ => { return Unsupported("pack writer temporary") },
        }
        var header = List[byte]()
        append_write(mut header, "PACK".bytes())
        put32(mut header, 2)
        put32(mut header, count)
        fs_write_chunk(file.fd, header) else |_| { return Unsupported("pack write failed") }
        return Writer {
            path: path,
            fd: file.fd,
            mode: copy mode,
            count: count,
            written: 0,
            offset: 12,
            kind: 0,
            names: names,
            data: data,
            offsets: offsets,
            depths: depths,
            filled: 0,
            next: 0,
            tables: zlib.tables(),
        }
    }
    Unsupported("pack writer temporary")
}

fn deflated_any(mut t: zlib.Tables, data: List[byte]) -> List[byte] ! PackErrors {
    zlib.deflate_with(mut t, data, 1, data.len + data.len / 8 + 65536) else |e| {
        return Unsupported("pack writer compression {e}")
    }
}

// The window slot's name, from its 40 hex bytes.
fn window_name(w: Writer, k: int) -> str ! PackErrors {
    str_from_utf8(w.names[k * 40..k * 40 + 40]) else |_| {
        return Unsupported("pack writer identity")
    }
}

/// Append one object, named name (its identity, which the caller read).
pub fn writer_add(mut w: Writer, body: Body, name: str) -> () ! PackErrors {
    if w.fd < 0 { return Unsupported("pack writer closed") }
    if w.written >= w.count { return Unsupported("pack writer object count") }
    let code = kind_number(body.kind)?
    if body.data.len > object_limit() { return Unsupported("pack writer object size limit") }
    let raw = name.bytes()
    if raw.len != 40 { return Unsupported("pack writer identity") }
    if code != w.kind {
        w.kind = code
        w.filled = 0
        w.next = 0
    }
    var depth = 0
    let start = w.offset
    region entry {
        var encoded = List[byte](), whole = false
        if w.mode == "none" || w.filled == 0 {
            encoded = entry_header(code, body.data.len)
            append_write(mut encoded, deflated_any(mut w.tables, body.data)?)
            whole = true
        }
        if !whole {
            // The candidate with the shortest raw delta is the one deflated
            // and weighed against the whole object (den#73: deflating every
            // candidate was most of a serve's CPU).
            var best = -1, best_len = body.data.len
            for prior in 0..w.filled {
                region delta_candidate {
                    if w.depths[prior] >= 50 { continue }
                    // Empty once it cannot beat best_len: never chosen.
                    let delta = instructions_within(w.data[prior], body.data, best_len)?
                    if delta.len > 0 && delta.len < best_len {
                        best = prior
                        best_len = delta.len
                    }
                }
            }
            if best >= 0 {
                let delta = instructions(w.data[best], body.data)?
                var trial = entry_header(if w.mode == "ofs" then 6 else 7, delta.len)
                if w.mode == "ofs" {
                    append_write(mut trial, offset_bytes(start - w.offsets[best]))
                } else {
                    append_write(mut trial, raw_id(window_name(w, best)?)?)
                }
                append_write(mut trial, deflated_any(mut w.tables, delta)?)
                encoded = copy trial
                depth = w.depths[best] + 1
            }
            // A delta under half the object is taken unweighed; otherwise
            // the whole object is deflated too and the smaller one kept.
            if best < 0 || best_len * 2 >= body.data.len {
                var plain = entry_header(code, body.data.len)
                append_write(mut plain, deflated_any(mut w.tables, body.data)?)
                if best < 0 || plain.len <= encoded.len {
                    encoded = copy plain
                    depth = 0
                }
            }
        }
        fs_write_chunk(w.fd, encoded) else |_| { return Unsupported("pack write failed") }
        w.offset += encoded.len
    }
    // The window keeps the last 10 objects of this type, as a ring of
    // buffers the writer owns.
    let k = w.next
    (mut w.data[k]).clear()
    for b in body.data { (mut w.data[k]).push(b) }
    for i in 0..40 { w.names[k * 40 + i] = raw[i] }
    w.offsets[k] = start
    w.depths[k] = depth
    if w.filled < 10 { w.filled += 1 }
    w.next = (k + 1) % 10
    w.written += 1
}

/// Close the pack: check its count, append the SHA-1 of what was written
/// (read back in windows) and return its path and size.
pub fn writer_finish(mut w: Writer) -> (str, int) ! PackErrors {
    if w.fd < 0 { return Unsupported("pack writer closed") }
    if w.written != w.count { return Unsupported("pack writer object count") }
    fs_close(w.fd) else |_| { return Unsupported("pack write failed") }
    w.fd = -1
    let fd = fs_open(w.path) else |_| { return Unsupported("pack writer temporary") }
    var state = hash.new1(), pos = 0, failed = false
    while pos < w.offset {
        region window {
            let want = if w.offset - pos > 65536 then 65536 else w.offset - pos
            let bytes = fs_read_at(fd, pos, want) else |_| { failed = true; List[byte]() }
            if bytes.len == 0 { failed = true }
            hash.update1(mut state, bytes)
            pos += bytes.len
        }
        if failed { break }
    }
    fs_close(fd) else |_| {}
    if failed { return Unsupported("pack writer temporary") }
    let sum = hash.final1(take state)
    let out = fs.open_append(w.path) else |_| { return Unsupported("pack writer temporary") }
    fs_write_chunk(out.fd, sum) else |_| { return Unsupported("pack write failed") }
    fs_close(out.fd) else |_| { return Unsupported("pack write failed") }
    (copy w.path, w.offset + 20)
}

/// Remove the temporary; safe on any path.
pub fn writer_discard(mut w: Writer) {
    if w.fd >= 0 { fs_close(w.fd) else |_| {} }
    w.fd = -1
    if w.path != "" { fs.remove(w.path) else |_| {} }
    w.path = ""
}
