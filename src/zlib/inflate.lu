// Original codec derived from RFC 1950 §§2.1–2.3 and RFC 1951 §§3.1–3.2.7.
// No implementation source or RFC sample C copied. See docs/SOURCES.md.

/// Malformed/truncated data, unsupported dictionary, checksum or output cap.
pub error InflateErrors = {truncated, bad_header, dictionary, checksum, invalid, limit}

/// Owned decoded bytes and whole source bytes through this stream's last byte;
/// reserved is the output bytes reserved up front, before any were decoded.
pub struct Inflated {
    data: List[byte],
    consumed: int,
    reserved: int,
}

struct Bits {
    pos: int,
    bit: int,
}

// Never reads ahead into a following stream or the zlib checksum. Takes as
// many bits from each byte as the width still wants (den#73: a bit at a time
// was a large part of every read), least significant first, as before.
fn bits(src: List[byte], mut r: Bits, width: int) -> int ! {truncated} {
    var value: int = 0
    var shift: int = 0
    while shift < width {
        if r.pos >= src.len { return truncated }
        let avail = 8 - r.bit
        let n = if width - shift < avail then width - shift else avail
        value = value | (src[r.pos] as int >> r.bit & (1 << n) - 1) << shift
        r.bit += n
        if r.bit == 8 { r.pos += 1; r.bit = 0 }
        shift += n
    }
    value
}

fn bit(src: List[byte], mut r: Bits) -> int ! {truncated} {
    if r.pos >= src.len { return truncated }
    let value = src[r.pos] as int >> r.bit & 1
    r.bit += 1
    if r.bit == 8 { r.pos += 1; r.bit = 0 }
    value
}

fn align(mut r: Bits) {
    if r.bit != 0 { r.pos += 1; r.bit = 0 }
}

struct Tree {
    counts: List[int],
    symbols: List[int],
}

fn zeros(n: int) -> List[int] {
    var result = List[int]()
    for _ in 0..n { (mut result).push(0) }
    result
}

// Code-space accounting detects oversubscription before any table index.
// Incomplete trees are only legal for a single one-bit data symbol, or an
// empty distance alphabet. The code-length alphabet must be complete.
fn tree(lengths: List[int], alphabet: int) -> Tree ! {invalid} {
    var counts = zeros(16)
    var used = 0
    for n in lengths {
        if n < 0 || n > 15 { return invalid }
        if n != 0 { counts[n] += 1; used += 1 }
    }
    var remaining = 1
    for n in 1..16 {
        remaining = remaining * 2 - counts[n]
        if remaining < 0 { return invalid }
    }
    if remaining != 0 {
        if !(alphabet == 2 && used == 0) && !(alphabet != 0 && used == 1 && counts[1] == 1) {
            return invalid
        }
    }
    // Symbols by code length, then by value: each length's run starts after
    // the shorter ones, and one pass over the lengths places every symbol.
    var next = zeros(16)
    for n in 2..16 { next[n] = next[n - 1] + counts[n - 1] }
    var symbols = zeros(used)
    for i in 0..lengths.len {
        let n = lengths[i]
        if n != 0 { symbols[next[n]] = i; next[n] += 1 }
    }
    Tree { counts: counts, symbols: symbols }
}

fn symbol(src: List[byte], mut r: Bits, t: Tree) -> int ! {truncated, invalid} {
    if t.symbols.len == 0 { return invalid }
    var code = 0
    var first = 0
    var offset = 0
    for n in 1..16 {
        code = code * 2 + bit(src, mut r)?
        let delta = code - first
        if delta >= 0 && delta < t.counts[n] {
            return t.symbols[offset + delta]
        }
        offset += t.counts[n]
        first = (first + t.counts[n]) * 2
    }
    invalid
}

// RFC 1951 §3.2.6's fixed literal/length code, read a bit at a time as
// symbol reads it, without building its table for every block: 7-bit codes
// 0-23 are 256-279, 8-bit 48-191 are 0-143 and 192-199 are 280-287, 9-bit
// 400-511 are 144-255. Every 9-bit code is used, so no code is invalid here.
fn fixed_symbol(src: List[byte], mut r: Bits) -> int ! {truncated, invalid} {
    var code = 0
    for _ in 0..7 { code = code * 2 + bit(src, mut r)? }
    if code < 24 { return code + 256 }
    code = code * 2 + bit(src, mut r)?
    if code >= 48 && code < 192 { return code - 48 }
    if code >= 192 && code < 200 { return code - 192 + 280 }
    code = code * 2 + bit(src, mut r)?
    code - 400 + 144
}

// The fixed distance code: five bits, the code itself (30 and 31 decode and
// are refused by the caller, as through the table).
fn fixed_distance(src: List[byte], mut r: Bits) -> int ! {truncated, invalid} {
    var code = 0
    for _ in 0..5 { code = code * 2 + bit(src, mut r)? }
    code
}

fn code_order() -> List[int] {
    [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
}

fn dynamic(src: List[byte], mut r: Bits) -> (Tree, Tree) ! {truncated, invalid} {
    let nl = bits(src, mut r, 5)? + 257
    let nd = bits(src, mut r, 5)? + 1
    let nc = bits(src, mut r, 4)? + 4
    if nl > 286 { return invalid }
    let order = code_order()
    var code_lengths = zeros(19)
    for i in 0..nc { code_lengths[order[i]] = bits(src, mut r, 3)? }
    let code_tree = tree(code_lengths, 0)?
    var lengths = List[int]()
    while lengths.len < nl + nd {
        let s = symbol(src, mut r, code_tree)?
        var value = s
        var count = 1
        if s == 16 {
            if lengths.len == 0 { return invalid }
            value = lengths[lengths.len - 1]
            count = bits(src, mut r, 2)? + 3
        } else if s == 17 {
            value = 0
            count = bits(src, mut r, 3)? + 3
        } else if s == 18 {
            value = 0
            count = bits(src, mut r, 7)? + 11
        }
        if count > nl + nd - lengths.len { return invalid }
        for _ in 0..count { (mut lengths).push(value) }
    }
    if lengths[256] == 0 { return invalid }
    (tree(lengths[0..nl], 1)?, tree(lengths[nl..nl + nd], 2)?)
}

fn length_base() -> List[int] {
    [
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10,
        11,
        13,
        15,
        17,
        19,
        23,
        27,
        31,
        35,
        43,
        51,
        59,
        67,
        83,
        99,
        115,
        131,
        163,
        195,
        227,
        258,
    ]
}

fn length_extra(code: int) -> int {
    if code < 8 || code == 28 { return 0 }
    (code - 4) / 4
}

fn distance_extra(code: int) -> int {
    if code < 4 then 0 else code / 2 - 1
}

fn distance_base(code: int) -> int {
    if code < 4 { return code + 1 }
    (2 + code % 2) * (1 << distance_extra(code)) + 1
}

/// Room for need more bytes of out past room: the next reservation doubles
/// room up to an eighth of cap, then jumps to cap itself, and is at least
/// what need asks (the caller has checked need against cap). total counts
/// every reservation, the outgrown ones included.
fn grow(mut out: List[byte], mut room: int, cap: int, need: int, mut total: int) {
    var next = if room < cap / 8 then (if 2 * room < cap / 8 then 2 * room else cap / 8) else cap
    if next < out.len + need { next = out.len + need }
    (mut out).reserve(next)
    total += next
    room = next
}

fn compressed(
    src: List[byte],
    mut r: Bits,
    mut out: List[byte],
    lt: Tree,
    dt: Tree,
    fixed: bool,
    cap: int,
    window: int,
    mut room: int,
    mut total: int,
) -> () ! {invalid, truncated, limit} {
    let bases = length_base()
    loop {
        let s = if fixed then fixed_symbol(src, mut r)? else symbol(src, mut r, lt)?
        if s < 256 {
            if out.len == room {
                if room == cap { return limit }
                grow(mut out, mut room, cap, 1, mut total)
            }
            (mut out).push(s as byte)
        } else if s == 256 {
            return
        } else {
            if s > 285 { return invalid }
            let li = s - 257
            let length = bases[li] + bits(src, mut r, length_extra(li))?
            let dc = if fixed then fixed_distance(src, mut r)? else symbol(src, mut r, dt)?
            if dc > 29 { return invalid }
            let distance = distance_base(dc) + bits(src, mut r, distance_extra(dc))?
            if distance > out.len || distance > window { return invalid }
            if length > room - out.len {
                if length > cap - out.len { return limit }
                grow(mut out, mut room, cap, length, mut total)
            }
            for _ in 0..length {
                let b = out[out.len - distance]
                (mut out).push(b)
            }
        }
    }
}

/// Where a resumable inflate stands between its calls (inflate_resume): at
/// and bit, counted from the stream's first byte, are where its next whole
/// block begins (once the blocks have ended, its Adler-32), and made is the
/// output made before it. room is the output reserved so far and window the
/// header's window size. phase is 0 before the header, 1 in the blocks, 2 at
/// the Adler-32 and 3 once the stream has been checked.
pub struct Resume {
    at: int,
    bit: int,
    made: int,
    room: int,
    window: int,
    phase: int,
}

/// A resumable inflate's place before its first call.
pub fn resume_start() -> Resume {
    Resume { at: 0, bit: 0, made: 0, room: 0, window: 0, phase: 0 }
}

// Back to n bytes of output: a block met the input's end, and is decoded
// again from its start once more input is there.
fn cut(mut out: List[byte], n: int) {
    while out.len > n {
        let _ = (mut out).pop() else |_| { return }
    }
}

// One block at r, its output pushed to out; returns its BFINAL bit.
fn block(
    src: List[byte],
    mut r: Bits,
    mut out: List[byte],
    cap: int,
    window: int,
    mut room: int,
    mut total: int,
) -> int ! InflateErrors {
    let final_block = bits(src, mut r, 1)?
    let kind = bits(src, mut r, 2)?
    if kind == 0 {
        align(mut r)
        let length = bits(src, mut r, 16)?
        let inverse = bits(src, mut r, 16)?
        if length + inverse != 65535 { return invalid }
        if length > src.len - r.pos { return truncated }
        if length > room - out.len {
            if length > cap - out.len { return limit }
            grow(mut out, mut room, cap, length, mut total)
        }
        for i in 0..length { (mut out).push(src[r.pos + i]) }
        r.pos += length
    } else if kind == 3 {
        return invalid
    } else {
        region block_tables {
            if kind == 1 {
                let none = Tree { counts: List[int](), symbols: List[int]() }
                compressed(src, mut r, mut out, none, none, true, cap, window, mut room, mut total)?
            } else {
                let (lt, dt) = dynamic(src, mut r)?
                compressed(src, mut r, mut out, lt, dt, false, cap, window, mut room, mut total)?
            }
        }
    }
    final_block
}

// The blocks from st on, then, for a zlib stream (checked), its Adler-32;
// src[delta + k] is the stream's byte k. Before each block st records where it
// begins and the output made before it, so on truncated out is cut back to
// that and the next call decodes the block again from there. A sized caller
// has reserved the output once (st.room: the declared size, at most a MiB and
// what the input can make), and the output grows past it only as it is made
// (grow: doubling to an eighth of cap, then cap); an unsized caller reserves
// nothing (st.room is cap) and its output grows as lists do. Each regrowth
// leaves its old buffer in the caller's region until it ends; total counts
// each reservation as it is made. Returns the stream's length once checked.
fn run(
    src: List[byte],
    delta: int,
    cap: int,
    checked: bool,
    mut st: Resume,
    mut out: List[byte],
    mut total: int,
) -> int ! InflateErrors {
    if cap < 0 { return invalid }
    if st.phase == 1 {
        var r = Bits { pos: delta + st.at, bit: st.bit }
        var last = 0
        while last == 0 {
            st.at = r.pos - delta
            st.bit = r.bit
            st.made = out.len
            // Each tag by name: the pinned compiler's checked machine renders an
            // error a match examined, read again in a wildcard arm, as <value>.
            last = block(
                src,
                mut r,
                mut out,
                cap,
                st.window,
                mut st.room,
                mut total,
            ) else |e| match e {
                truncated => {
                    cut(mut out, st.made)
                    return truncated
                },
                bad_header => { return bad_header },
                dictionary => { return dictionary },
                checksum => { return checksum },
                invalid => { return invalid },
                limit => { return limit },
            }
        }
        align(mut r)
        st.at = r.pos - delta
        st.bit = 0
        st.made = out.len
        st.phase = if checked then 2 else 3
    }
    if st.phase == 2 {
        let p = delta + st.at
        if src.len - p < 4 { return truncated }
        var expected: int = 0
        for i in 0..4 { expected = expected * 256 + src[p + i] as int }
        if expected != adler32(out) { return checksum }
        st.at += 4
        st.phase = 3
    }
    st.at
}

/// Decode one RFC 1951 stream, leaving following whole bytes untouched.
/// max_output is inclusive; negative is invalid. All output owns storage.
pub fn inflate_raw(src: List[byte], max_output: int) -> Inflated ! InflateErrors {
    var st = Resume { at: 0, bit: 0, made: 0, room: max_output, window: 32768, phase: 1 }
    var out = List[byte](), total: int = 0
    let consumed = run(src, 0, max_output, false, mut st, mut out, mut total)?
    Inflated { data: out, consumed: consumed, reserved: total }
}

/// Decode one RFC 1950 stream; refuse dictionaries and validate Adler-32.
/// consumed includes header, last deflate byte and four checksum bytes.
pub fn inflate(src: List[byte], max_output: int) -> Inflated ! InflateErrors {
    if max_output < 0 { return invalid }
    if src.len < 2 { return truncated }
    let cmf = src[0] as int
    let flg = src[1] as int
    if cmf & 15 != 8 || cmf >> 4 > 7 || (cmf * 256 + flg) % 31 != 0 { return bad_header }
    if flg & 32 != 0 { return dictionary }
    var st = Resume {
        at: 2,
        bit: 0,
        made: 0,
        room: max_output,
        window: 1 << (cmf >> 4) + 8,
        phase: 1,
    }
    var out = List[byte](), total: int = 0
    let consumed = run(src, 0, max_output, true, mut st, mut out, mut total)?
    Inflated { data: out, consumed: consumed, reserved: total }
}

/// One RFC 1950 stream of at most size bytes that begins at src[start]. Its
/// output is reserved once to the least of size, a MiB and what the bytes
/// after start can make, and grows past that only as bytes are made (run);
/// the caller compares the length it expects, and reserved counts what was
/// reserved, outgrown buffers included. consumed counts from start through the
/// checksum. Truncated means the stream runs past src's end: a caller reading
/// a window may extend it, or resume it (inflate_resume).
pub fn inflate_sized(src: List[byte], start: int, size: int) -> Inflated ! InflateErrors {
    var reserved: int = 0
    inflate_sized_counted(src, start, size, mut reserved)?
}

/// inflate_sized, adding every byte it reserves to reserved as it reserves it,
/// so a caller counts what an attempt that fails reserved as well.
pub fn inflate_sized_counted(
    src: List[byte],
    start: int,
    size: int,
    mut reserved: int,
) -> Inflated ! InflateErrors {
    var st = resume_start()
    var out = List[byte]()
    let before = reserved
    let consumed = inflate_resume(src, start, 0, size, mut st, mut out, mut reserved)?
    Inflated { data: out, consumed: consumed, reserved: reserved - before }
}

/// One RFC 1950 stream of at most size bytes, inflated as its bytes arrive.
/// src[start] is the stream's byte base, at or before st.at; before the first
/// call st is resume_start(), and src holds the stream's first byte at start.
/// The first call reads the header and reserves the output once, to the least
/// of size, a MiB and what the bytes after start can make; past that the
/// output grows only as bytes are made, in out, which the caller keeps from
/// call to call, as it keeps st. Each call decodes whole blocks from st on. On
/// truncated the stream runs past src's end: out holds the output of the
/// blocks before st.at, and the next call, given src from st.at on (its byte
/// st.at with bit st.bit next), decodes from there. Returns the stream's
/// length, header through checksum, once the checksum holds; reserved counts
/// each reservation as it is made.
pub fn inflate_resume(
    src: List[byte],
    start: int,
    base: int,
    size: int,
    mut st: Resume,
    mut out: List[byte],
    mut reserved: int,
) -> int ! InflateErrors {
    if size < 0 || start < 0 || base < 0 || base > st.at { return invalid }
    if st.phase == 0 {
        if src.len - start < 2 { return truncated }
        let cmf = src[start] as int
        let flg = src[start + 1] as int
        if cmf & 15 != 8 || cmf >> 4 > 7 || (cmf * 256 + flg) % 31 != 0 { return bad_header }
        if flg & 32 != 0 { return dictionary }
        // A declared size is the entry's own claim, read before any check of
        // its bytes: a damaged one must not reserve what its stream cannot
        // make. A deflate stream makes at most 1,032 bytes a byte (a 258-byte
        // copy in two bits), so the bytes after start bound the output, and no
        // more than a MiB is reserved before any byte is made; past that the
        // output grows as it is made (run). A sound entry up to a MiB is
        // reserved exactly, and nothing is reserved again on a later call.
        let first = size
        st.room = size
        if first > 0 {
            (mut out).reserve(first)
            st.room = first
            reserved += first
        }
        st.window = 1 << (cmf >> 4) + 8
        st.at = 2
        st.bit = 0
        st.made = 0
        st.phase = 1
    }
    if st.phase == 3 { return st.at }
    run(src, start - base, size, true, mut st, mut out, mut reserved)
}

/// Unsigned Adler-32 represented in int; derived from RFC 1950 §2.2 sums.
pub fn adler32(src: List[byte]) -> int {
    var a: int = 1
    var b: int = 0
    for value in src {
        a = (a + value as int) % 65521
        b = (b + a) % 65521
    }
    b * 65536 + a
}
