//! member: false

// White-box invariants for the original bounded table builder.

// The join as first written: scan every node for the two lightest, the lower
// index first on equal weights. lengths must give the same widths.
fn scan_lengths(freq: List[int], maximum: int, complete: bool) -> List[int] {
    var weights = copy freq
    var used = 0
    for f in weights { if f != 0 { used += 1 } }
    if used == 0 { weights[0] = 1; used = 1 }
    if used == 1 && complete {
        var i = 0
        while weights[i] != 0 { i += 1 }
        weights[i] = 1
        used += 1
    }
    var result = zeros(freq.len)
    loop {
        var deepest = 0
        var nodes = copy weights
        var parent = List[int]()
        for _ in weights { (mut parent).push(-1) }
        for _ in 1..used {
            var a = -1
            var b = -1
            for i in 0..nodes.len {
                if parent[i] < 0 && nodes[i] != 0 {
                    if a < 0 || nodes[i] < nodes[a] {
                        b = a
                        a = i
                    } else if b < 0 || nodes[i] < nodes[b] {
                        b = i
                    }
                }
            }
            let sum = nodes[a] + nodes[b]
            parent[a] = nodes.len
            parent[b] = nodes.len
            (mut nodes).push(sum)
            (mut parent).push(-1)
        }
        for i in 0..weights.len {
            if weights[i] != 0 {
                var depth = 0
                var node = i
                while parent[node] >= 0 { depth += 1; node = parent[node] }
                if depth == 0 { depth = 1 }
                result[i] = depth
                if depth > deepest { deepest = depth }
            }
        }
        if deepest <= maximum { return result }
        for i in 0..weights.len { weights[i] = (weights[i] + 1) / 2 }
    }
}

fn same_widths(freq: List[int], maximum: int, complete: bool) -> bool {
    let a = lengths(freq, maximum, complete), b = scan_lengths(freq, maximum, complete)
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

// The fixed codes' tables, as inflate built them for every fixed block.
fn fixed_lengths() -> List[int] {
    var result = List[int]()
    for i in 0..288 {
        (mut result).push(if i < 144 then 8 else if i < 256 then 9 else if i < 280 then 7 else 8)
    }
    result
}

fn fixed_distances() -> List[int] {
    var result = List[int]()
    for _ in 0..32 { (mut result).push(5) }
    result
}

// fixed_symbol and fixed_distance decode every fixed code as a table built
// from RFC 1951's lengths does, and refuse a truncated code alike.
fn fixed_rows() -> int ! {invalid} {
    let lt = tree(fixed_lengths(), 1)?
    let dt = tree(fixed_distances(), 2)?
    var checks = 0
    for s in 0..288 {
        var w = Writer { data: List[byte](), pending: 0, used: 0, cap: 16 }
        fixed_code(mut w, s) else |_| { return invalid }
        finish_byte(mut w) else |_| { return invalid }
        var a = Bits { pos: 0, bit: 0 }, b = Bits { pos: 0, bit: 0 }
        let direct = fixed_symbol(w.data, mut a) else |_| -1
        let tabled = symbol(w.data, mut b, lt) else |_| -2
        assert(direct == s && tabled == s && a.pos == b.pos && a.bit == b.bit)
        checks += 1
    }
    for d in 0..32 {
        var w = Writer { data: List[byte](), pending: 0, used: 0, cap: 16 }
        code(mut w, d, 5) else |_| { return invalid }
        finish_byte(mut w) else |_| { return invalid }
        var a = Bits { pos: 0, bit: 0 }, b = Bits { pos: 0, bit: 0 }
        let direct = fixed_distance(w.data, mut a) else |_| -1
        let tabled = symbol(w.data, mut b, dt) else |_| -2
        assert(direct == d && tabled == d)
        checks += 1
    }
    var empty = Bits { pos: 0, bit: 0 }
    let cut = fixed_symbol(List[byte](), mut empty) else |e| {
        if "{e}" == "truncated" then -7 else -8
    }
    assert(cut == -7)
    // bits takes several bits a byte as one bit at a time did.
    let src: List[byte] = [0xb5 as byte, 0x3c as byte, 0xe1 as byte]
    for width in 0..17 {
        for start in 0..8 {
            var r = Bits { pos: 0, bit: start }, q = Bits { pos: 0, bit: start }
            let many = bits(src, mut r, width) else |_| -1
            var one = 0
            for i in 0..width { one = one | (bit(src, mut q) else |_| 0) << i }
            assert(many == one && r.pos == q.pos && r.bit == q.bit)
            checks += 1
        }
    }
    checks
}

fn main() -> int ! {invalid} {
    var freq = zeros(286)
    freq[0] = 1
    freq[1] = 1
    for i in 2..23 { freq[i] = freq[i - 1] + freq[i - 2] }
    let limited = lengths(freq, 15, false)
    let built = tree(limited, 1)?
    assert(built.symbols.len == 23)
    for width in limited { assert(width >= 0 && width <= 15) }
    let one = lengths(zeros(30), 15, false)
    assert(one[0] == 1)
    let complete = tree(lengths(zeros(19), 7, true), 0)?
    assert(complete.symbols.len == 2)
    var heads = List[int]()
    var links = List[int]()
    for _ in 0..32768 { (mut heads).push(-1); (mut links).push(-1) }
    let input = "abcXbcdefYabcdef"
    let chosen = tokens(input.bytes(), 0, input.len, mut heads, mut links)
    assert(chosen.len == 12)
    assert(chosen[10].value == 97 && chosen[10].distance == 0)
    assert(chosen[11].value == 5 && chosen[11].distance == 7)
    // Pseudo-random alphabets: sparse, dense, many equal weights, and skewed
    // enough to pass the limit and be halved. Seven bits only for the
    // 19-symbol header alphabet, as the encoder asks (286 symbols cannot fit).
    var seed = 12345
    var trials = 0
    for shape in 0..6 {
        for _ in 0..10 {
            for size in [19, 30, 286] {
                var f = zeros(size)
                for i in 0..size {
                    seed = (seed * 1103515245 + 12345) % 2147483648
                    let r = seed / 65536 % 1000
                    f[i] = match shape {
                        0 => if r < 900 then 0 else r % 7 + 1,
                        1 => r + 1,
                        2 => if r < 500 then 0 else 3,
                        3 => if r < 300 then 0 else 1 << r % 16,
                        4 => if r < 50 then r * 1000 + 1 else r % 2,
                        _ => if i < 2 then r + 1 else 0,
                    }
                }
                if size == 19 {
                    assert(same_widths(f, 7, true))
                } else {
                    assert(same_widths(f, 15, false))
                }
                trials += 1
            }
        }
    }
    assert(same_widths(freq, 15, false) && same_widths(freq, 7, true))
    assert(same_widths(zeros(30), 15, false) && same_widths(zeros(19), 7, true))
    print("PASS length-limited tree; complete header; empty distance encoder; lazy lookahead")
    print("PASS two-queue join matches the scan on {trials} alphabets")
    let fixed = fixed_rows()?
    print("PASS fixed codes and multi-bit reads match the tables in {fixed} checks")
    0
}
