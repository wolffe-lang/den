//! member: false

// White-box invariants for the original bounded table builder.
fn main() -> int ! {invalid} {
    var freq = zeros(286)
    freq[0] = 1
    freq[1] = 1
    for i in 2..23 { freq[i] = freq[i - 1] + freq[i - 2] }
    let limited = lengths(freq, 15, false)
    let built = tree(limited, 1)?
    assert(built.symbols.len == 23)
    for width in limited { assert(width >= 0 && width <= 15) }
    let one = lengths(zeros(30), 15, false)
    assert(one[0] == 1)
    let complete = tree(lengths(zeros(19), 7, true), 0)?
    assert(complete.symbols.len == 2)
    var heads = List[int]()
    var links = List[int]()
    for _ in 0..32768 { (mut heads).push(-1); (mut links).push(-1) }
    let input = "abcXbcdefYabcdef"
    let chosen = tokens(input.bytes(), 0, input.len, mut heads, mut links)
    assert(chosen.len == 12)
    assert(chosen[10].value == 97 && chosen[10].distance == 0)
    assert(chosen[11].value == 5 && chosen[11].distance == 7)
    print("PASS length-limited tree; complete header; empty distance encoder; lazy lookahead")
    0
}
