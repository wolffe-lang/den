// Original bounded alphabet Huffman construction. No recursion or external code.
// Repeatedly join the two lightest unparented nodes. If a depth exceeds the
// format limit, halve positive weights (round up) and rebuild. This converges
// to equal positive weights and hence a balanced tree, <=9 bits for 286 leaves.
fn lengths(freq: List[int], maximum: int, complete: bool) -> List[int] {
    var weights = copy freq
    var used = 0
    for f in weights { if f != 0 { used += 1 } }
    if used == 0 { weights[0] = 1; used = 1 }
    if used == 1 && complete {
        var i = 0
        while weights[i] != 0 { i += 1 }
        weights[i] = 1
        used += 1
    }
    var result = zeros(freq.len)
    loop {
        var deepest = 0
        region construction {
            var nodes = copy weights
            var parent = List[int]()
            for _ in weights { (mut parent).push(-1) }
            for _ in 1..used {
                var a = -1
                var b = -1
                for i in 0..nodes.len {
                    if parent[i] < 0 && nodes[i] != 0 {
                        if a < 0 || nodes[i] < nodes[a] {
                            b = a
                            a = i
                        } else if b < 0 || nodes[i] < nodes[b] {
                            b = i
                        }
                    }
                }
                let sum = nodes[a] + nodes[b]
                parent[a] = nodes.len
                parent[b] = nodes.len
                (mut nodes).push(sum)
                (mut parent).push(-1)
            }
            for i in 0..weights.len {
                if weights[i] != 0 {
                    var depth = 0
                    var node = i
                    while parent[node] >= 0 { depth += 1; node = parent[node] }
                    if depth == 0 { depth = 1 }
                    result[i] = depth
                    if depth > deepest { deepest = depth }
                }
            }
        }
        if deepest <= maximum { return result }
        for i in 0..weights.len { weights[i] = (weights[i] + 1) / 2 }
    }
}

struct Codes {
    widths: List[int],
    values: List[int],
}

fn codes(take widths: List[int]) -> Codes {
    var values = zeros(widths.len)
    var first = 0
    for width in 1..16 {
        first *= 2
        for i in 0..widths.len {
            if widths[i] == width { values[i] = first; first += 1 }
        }
    }
    Codes { widths: widths, values: values }
}

fn emit_code(mut w: Writer, t: Codes, s: int) -> () ! {limit} {
    code(mut w, t.values[s], t.widths[s])?
}

struct Run {
    symbol: int,
    extra: int,
    width: int,
}

fn runs(lens: List[int]) -> List[Run] {
    var result = List[Run]()
    var i = 0
    while i < lens.len {
        let value = lens[i]
        var n = 1
        while i + n < lens.len && lens[i + n] == value { n += 1 }
        i += n
        if value != 0 {
            (mut result).push(Run { symbol: value, extra: 0, width: 0 })
            n -= 1
            while n >= 3 {
                let count = if n > 6 then 6 else n
                (mut result).push(Run { symbol: 16, extra: count - 3, width: 2 })
                n -= count
            }
        } else {
            while n >= 11 {
                let count = if n > 138 then 138 else n
                (mut result).push(Run { symbol: 18, extra: count - 11, width: 7 })
                n -= count
            }
            if n >= 3 {
                (mut result).push(Run { symbol: 17, extra: n - 3, width: 3 })
                n = 0
            }
        }
        for _ in 0..n { (mut result).push(Run { symbol: value, extra: 0, width: 0 }) }
    }
    result
}

struct Dynamic {
    lit: Codes,
    dist: Codes,
    header: Codes,
    sequence: List[Run],
    nl: int,
    nd: int,
    nc: int,
    cost: int,
}

fn dynamic_plan(ts: List[Token], bases: List[int]) -> Dynamic {
    var lf = zeros(286)
    var df = zeros(30)
    lf[256] = 1
    var extra: int = 0
    for t in ts {
        if t.distance == 0 {
            lf[t.value] += 1
        } else {
            let lc = length_code(t.value, bases)
            let dc = distance_code(t.distance)
            lf[lc + 257] += 1
            df[dc] += 1
            extra += length_extra(lc) + distance_extra(dc)
        }
    }
    let lit = codes(take lengths(lf, 15, false))
    let dist = codes(take lengths(df, 15, false))
    var nl = 286
    while nl > 257 && lit.widths[nl - 1] == 0 { nl -= 1 }
    var nd = 30
    while nd > 1 && dist.widths[nd - 1] == 0 { nd -= 1 }
    var combined = List[int]()
    for i in 0..nl { (mut combined).push(lit.widths[i]) }
    for i in 0..nd { (mut combined).push(dist.widths[i]) }
    let sequence = runs(combined)
    var hf = zeros(19)
    for r in sequence { hf[r.symbol] += 1 }
    let header = codes(take lengths(hf, 7, true))
    let order = code_order()
    var nc = 19
    while nc > 4 && header.widths[order[nc - 1]] == 0 { nc -= 1 }
    var cost: int = 3 + 5 + 5 + 4 + nc * 3 + extra
    for i in 0..lf.len { cost += lf[i] * lit.widths[i] }
    for i in 0..df.len { cost += df[i] * dist.widths[i] }
    for r in sequence { cost += header.widths[r.symbol] + r.width }
    Dynamic {
        lit: lit,
        dist: dist,
        header: header,
        sequence: sequence,
        nl: nl,
        nd: nd,
        nc: nc,
        cost: cost,
    }
}

fn emit_dynamic(
    mut w: Writer,
    ts: List[Token],
    bases: List[int],
    plan: Dynamic,
    final_block: int,
) -> () ! {limit} {
    put(mut w, final_block + 4, 3)?
    put(mut w, plan.nl - 257, 5)?
    put(mut w, plan.nd - 1, 5)?
    put(mut w, plan.nc - 4, 4)?
    let order = code_order()
    for i in 0..plan.nc { put(mut w, plan.header.widths[order[i]], 3)? }
    for r in plan.sequence {
        emit_code(mut w, plan.header, r.symbol)?
        put(mut w, r.extra, r.width)?
    }
    for t in ts {
        if t.distance == 0 {
            emit_code(mut w, plan.lit, t.value)?
        } else {
            let lc = length_code(t.value, bases)
            let dc = distance_code(t.distance)
            emit_code(mut w, plan.lit, lc + 257)?
            put(mut w, t.value - bases[lc], length_extra(lc))?
            emit_code(mut w, plan.dist, dc)?
            put(mut w, t.distance - distance_base(dc), distance_extra(dc))?
        }
    }
    emit_code(mut w, plan.lit, 256)?
}
