// Original three-tree planner; no state publication during collection.
use diff
use difftext
use index
use mergebase
use mergefile
use object
use oid
use repository
use walk
use worktree

/// Owned tree result, unresolved higher stages, and ordered human diagnostics.
pub struct Plan {
    files: List[diff.File],
    stages: List[index.Entry],
    messages: List[str],
    conflicts: List[str],
}

/// Compute all best bases through the owned walker; never consult/write index.
pub fn bases(
    repo: repository.Repo,
    left: oid.Oid,
    right: oid.Oid,
) -> List[oid.Oid] ! worktree.WorkErrors {
    let commits = walk.collect(repo, [copy left, copy right], 100001, 0, 100000, false)?
    var nodes = List[mergebase.Node]()
    for item in commits {
        var parents = List[str]()
        for parent in item.parents { (mut parents).push(oid.hex(parent)?) }
        (mut nodes).push(mergebase.Node { id: oid.hex(item.id)?, parents: parents })
    }
    let names = mergebase.bases(nodes, oid.hex(left)?, oid.hex(right)?, 100000) else |e| match e {
        missing => { return not_found },
        invalid => { return invalid },
        limit => { return Fatal("limit: more than 100000 commits in the merge-base graph") },
    }
    var out = List[oid.Oid]()
    for name in names { (mut out).push(oid.parse("sha1", name)?) }
    out
}

/// Whether a tree entry of `mode` is a blob a merge carries: a regular or
/// executable file, or a symbolic link, whose blob is the link's target
/// (gitformat-index(5) mode 120000). A link's body is that target text, so it
/// is compared, counted in a change summary and written like a file's.
fn blob_mode(mode: int) -> bool {
    mode == 0o100644 || mode == 0o100755 || mode == 0o120000
}

/// Collect bounded blob tree input (files and symbolic links), preserving
/// byte paths and objects.
pub fn files(repo: repository.Repo, id: oid.Oid) -> List[diff.File] ! worktree.WorkErrors {
    var out = List[diff.File](), total = 0
    var reader = object.reader_batch(repo)
    for entry in worktree.flatten_tree(repo, id)? {
        // A gitlink merges by its recorded commit alone (vc25): no blob; its
        // data is the pseudo-blob a diffstat counts, as Git's does.
        if entry.mode == 0o160000 {
            (mut out).push(diff.File {
                path: copy entry.path,
                mode: entry.mode,
                id: copy entry.id,
                data: worktree.subproject_text(entry.id, false)?,
            })
            continue
        }
        if !blob_mode(entry.mode) { return Unsupported("merge nonregular tree entry") }
        let blob = object.read_cached(mut reader, entry.id, 1000000000)?
        if blob.kind != "blob" { return bad_oid }
        total += blob.data.len
        if total > 134217728 {
            return Fatal("limit: more than 134217728 bytes of merge input in one tree")
        }
        (mut out).push(diff.File {
            path: copy entry.path,
            mode: entry.mode,
            id: copy entry.id,
            data: copy blob.data,
        })
    }
    out
}

fn compare(a: List[byte], b: List[byte]) -> int {
    var i = 0
    while i < a.len && i < b.len { if a[i] != b[i] { return a[i] as int - b[i] as int }; i += 1 }
    a.len - b.len
}

fn flat_find(entries: List[worktree.FlatEntry], path: List[byte]) -> int {
    var low = 0, high = entries.len
    while low < high {
        let mid = low + (high - low) / 2
        let order = compare(entries[mid].path, path)
        if order < 0 { low = mid + 1 } else { high = mid }
    }
    if low < entries.len && compare(entries[low].path, path) == 0 then low else -1
}

/// Merge endpoints retain every path/mode/id, but unchanged paths need no
/// body. The planner compares ids before bytes; rename candidates and changed
/// paths have their full bodies. A single reader serves every endpoint.
/// With bodies=false, only metadata is requested (a quiet fast-forward).
pub fn compared(
    repo: repository.Repo,
    ids: List[oid.Oid],
    bodies: bool,
) -> List[List[diff.File]] ! worktree.WorkErrors {
    var trees = List[List[worktree.FlatEntry]]()
    for id in ids { (mut trees).push(worktree.flatten_tree(repo, id)?) }
    var reader = object.reader_batch(repo)
    var result = List[List[diff.File]]()
    // A diagnostic built in a scratch region below is copied out of it (raised:
    // 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
    // is freed.
    var error_payload = "", raised = 0
    for tree in trees {
        var files = List[diff.File](), total = 0
        for entry in tree {
            var changed = false
            for other in trees {
                let at = flat_find(other, entry.path)
                if at < 0 || other[at].mode != entry.mode || !oid.equal(other[at].id, entry.id) {
                    changed = true
                    break
                }
            }
            if !blob_mode(entry.mode) && entry.mode != 0o160000 {
                return Unsupported("merge nonregular tree entry")
            }
            var exceeded = false
            // Reclaim compressed input and reconstruction scratch per body.
            region file {
                var data = List[byte]()
                if entry.mode == 0o160000 {
                    data = worktree.subproject_text(entry.id, false)?
                } else if bodies && changed {
                    let blob = object.read_cached(
                        mut reader,
                        entry.id,
                        1000000000,
                    ) else |e| match e {
                        invalid => { return invalid },
                        invalid_oid => { return invalid_oid },
                        unsupported_format => { return unsupported_format },
                        bad_header => { return bad_header },
                        bad_size => { return bad_size },
                        bad_oid => { return bad_oid },
                        truncated => { return truncated },
                        dictionary => { return dictionary },
                        checksum => { return checksum },
                        limit => { return limit },
                        trailing => { return trailing },
                        unsupported_level => { return unsupported_level },
                        not_found => { return not_found },
                        denied => { return denied },
                        io => { return io },
                        exists => { return exists },
                        unsupported => { return unsupported },
                        Unsupported(message) => {
                            error_payload = copy message
                            raised = 1
                            break
                        },
                        ambiguous => { return ambiguous },
                        cross_device => { return cross_device },
                    }
                    if blob.kind != "blob" { return bad_oid }
                    if blob.data.len > 134217728 - total {
                        exceeded = true
                    } else {
                        total += blob.data.len
                        data = copy blob.data
                    }
                }
                (mut files).push(
                    copy diff.File {
                        path: copy entry.path,
                        mode: entry.mode,
                        id: copy entry.id,
                        data: data,
                    },
                )
            }
            if exceeded {
                return Fatal("limit: more than 134217728 bytes of compared merge input in one tree")
            }
        }
        if raised == 1 { return Unsupported(error_payload) }
        (mut result).push(files)
    }
    result
}

/// Whether either side's changes from base hold a rename (the pairing a
/// diff gives with its defaults).
fn renamed_side(
    base: List[diff.File],
    ours: List[diff.File],
    theirs: List[diff.File],
) -> bool ! worktree.WorkErrors {
    for change in diff.changes(base, ours, diff.defaults())? {
        if change.status == "R" { return true }
    }
    for change in diff.changes(base, theirs, diff.defaults())? {
        if change.status == "R" { return true }
    }
    false
}

/// A text file's three-way merge: base[at] (none when at < 0), ours and
/// theirs, within the alignments den takes (no repeated line in base, one
/// hunk a side) and the line diff's budget.
fn text_merge(
    base: List[diff.File],
    at: int,
    ours: List[byte],
    theirs: List[byte],
    ours_label: str,
    base_label: str,
    theirs_label: str,
    style: str,
    marker_size: int,
) -> mergefile.Result ! worktree.WorkErrors {
    let empty = List[byte]()
    let data = if at < 0 then empty else base[at].data
    // ort defaults to histogram, whereas the file API is measured against
    // merge-file's Myers default. Preserve the existing alignment limits.
    // A line repeated byte for byte; two lines whose hashes collide are not
    // one line repeated (past about 65,000 lines they often collide). The
    // check's table is reclaimed before the scripts are built (den#145).
    var repeated = false, failed = false
    region repeats {
        repeated = difftext.repeated(data) else |_| {
            failed = true
            false
        }
    }
    if failed { repeated = difftext.repeated(data)? }
    if repeated { return Unsupported("merge repeated-line alignment") }
    // Each side's line table and script are built once, here, and the file
    // merge takes them (mergefile.merge_with): it built both again (den#145).
    // A side's line diff keeps the script's budget of 2,000 differing lines,
    // named as a patch names it.
    let bl = difftext.lines(data)?, ol = difftext.lines(ours)?, tl = difftext.lines(theirs)?
    let ours_edits = difftext.edits_with(data, bl, ours, ol) else |e| match e {
        limit => { return Fatal(budget()) },
        invalid => { return invalid },
    }
    let theirs_edits = difftext.edits_with(data, bl, theirs, tl) else |e| match e {
        limit => { return Fatal(budget()) },
        invalid => { return invalid },
    }
    if ours_edits.len > 1 || theirs_edits.len > 1 {
        return Unsupported("merge multi-hunk alignment")
    }
    let safe_markers = marker_size >= 1 && marker_size <= 1024
    mergefile.merge_with(
        data,
        ours,
        theirs,
        bl,
        ol,
        tl,
        ours_edits,
        theirs_edits,
        ours_label,
        base_label,
        theirs_label,
        style,
        if safe_markers then marker_size else 7,
    ) else |e| match e {
        binary => { return Unsupported("merge binary conflict") },
        invalid => { return invalid },
        // Each side was read whole within an object read's bound, so a limit
        // here is the line diff's budget.
        limit => { return Fatal(budget()) },
    }
}

/// The three-way file merge's line diff budget, named (a literal: an error
/// can leave the region the merge ran in).
fn budget() -> str {
    "limit: a file whose line diff passes 2000 differing lines in a three-way file merge"
}

// Whether files' paths ascend strictly, in compare's byte order: a side
// flattened from a tree or an index does.
fn ordered(files: List[diff.File]) -> bool {
    for i in 1..files.len { if compare(files[i - 1].path, files[i].path) >= 0 { return false } }
    true
}

// path's position in files, or -1: by binary search where files is ordered,
// otherwise by a scan. compares counts the comparisons with path.
fn at(files: List[diff.File], sorted: bool, path: List[byte], mut compares: int) -> int {
    if !sorted {
        for i in 0..files.len {
            compares += 1
            if compare(files[i].path, path) == 0 { return i }
        }
        return -1
    }
    var low = 0, high = files.len
    while low < high {
        let mid = low + (high - low) / 2
        compares += 1
        if compare(files[mid].path, path) < 0 { low = mid + 1 } else { high = mid }
    }
    if low < files.len {
        compares += 1
        if compare(files[low].path, path) == 0 { return low }
    }
    -1
}

fn same(a: List[diff.File], ai: int, b: List[diff.File], bi: int) -> bool {
    if ai < 0 || bi < 0 { return ai < 0 && bi < 0 }
    a[ai].mode == b[bi].mode && oid.equal(a[ai].id, b[bi].id)
}

/// Three-way regular-file merge. Renames are detected by the existing shared
/// scorer and refused by name until rename conflict topology has oracle rows.
pub fn plan(
    base: List[diff.File],
    ours: List[diff.File],
    theirs: List[diff.File],
    ours_label: str,
    base_label: str,
    theirs_label: str,
    style: str,
) -> Plan ! worktree.WorkErrors {
    var compares = 0
    plan_counted(base, ours, theirs, ours_label, base_label, theirs_label, style, mut compares)?
}

/// plan, adding to compares each path comparison its lookups of a path in the
/// three sides make. probes/mergetree-client at-compares prints it for a
/// generated merge; a row bounds it per lookup.
pub fn plan_counted(
    base: List[diff.File],
    ours: List[diff.File],
    theirs: List[diff.File],
    ours_label: str,
    base_label: str,
    theirs_label: str,
    style: str,
    mut compares: int,
) -> Plan ! worktree.WorkErrors {
    plan_inner(
        [],
        index.empty(2)?,
        base,
        ours,
        theirs,
        ours_label,
        base_label,
        theirs_label,
        style,
        mut compares,
    )?
}

/// Working-tree attribute lookup is specific to an actual content merge.
/// Equal and one-sided object resolutions never consult merge drivers or CMS.
pub fn plan_with_policy(
    ctx: worktree.Context,
    value: index.Index,
    base: List[diff.File],
    ours: List[diff.File],
    theirs: List[diff.File],
    ours_label: str,
    base_label: str,
    theirs_label: str,
    style: str,
) -> Plan ! worktree.WorkErrors {
    var compares = 0
    plan_inner(
        [ctx],
        value,
        base,
        ours,
        theirs,
        ours_label,
        base_label,
        theirs_label,
        style,
        mut compares,
    )?
}

fn plan_inner(
    contexts: List[worktree.Context],
    value: index.Index,
    base: List[diff.File],
    ours: List[diff.File],
    theirs: List[diff.File],
    ours_label: str,
    base_label: str,
    theirs_label: str,
    style: str,
    mut compares: int,
) -> Plan ! worktree.WorkErrors {
    // The rename check's pairing copies every changed body into its changes
    // and candidates: it runs in a region, and only its answer is kept
    // (den#145). A check that fails runs again outside, where its message
    // can leave.
    var renamed = false, rename_failed = false
    region renames {
        renamed = renamed_side(base, ours, theirs) else |_| {
            rename_failed = true
            false
        }
    }
    if rename_failed { renamed = renamed_side(base, ours, theirs)? }
    if renamed { return Unsupported("merge rename topology") }
    let in_base = ordered(base), in_ours = ordered(ours), in_theirs = ordered(theirs)
    var paths = List[List[byte]]()
    for entry in base { (mut paths).push(copy entry.path) }
    for entry in ours {
        if at(base, in_base, entry.path, mut compares) < 0 { (mut paths).push(copy entry.path) }
    }
    for entry in theirs {
        if at(base, in_base, entry.path, mut compares) < 0 &&
            at(ours, in_ours, entry.path, mut compares) < 0 {
            (mut paths).push(copy entry.path)
        }
    }
    for i in 1..paths.len {
        var j = i
        while j > 0 && compare(paths[j - 1], paths[j]) > 0 {
            let temp = copy paths[j - 1]
            paths[j - 1] = copy paths[j]
            paths[j] = temp
            j -= 1
        }
    }
    var result = Plan { files: [], stages: [], messages: [], conflicts: [] }
    for path in paths {
        let b = at(base, in_base, path, mut compares),
            o = at(ours, in_ours, path, mut compares),
            t = at(theirs, in_theirs, path, mut compares)
        if same(ours, o, theirs, t) || same(base, b, theirs, t) {
            if o >= 0 { (mut result.files).push(copy ours[o]) }
            continue
        }
        if same(base, b, ours, o) {
            if t >= 0 { (mut result.files).push(copy theirs[t]) }
            continue
        }
        // A submodule moved on one side passes through above; moved on both
        // sides, or against a file, it stays a named refusal (vc25).
        if o >= 0 && ours[o].mode == 0o160000 ||
            t >= 0 && theirs[t].mode == 0o160000 ||
            b >= 0 && base[b].mode == 0o160000 {
            return Unsupported("merge of a submodule changed on both sides")
        }
        // A symbolic link changed on one side passes through above. Changed on
        // both sides, or against a file, its target is never merged as text.
        if o >= 0 && ours[o].mode == 0o120000 ||
            t >= 0 && theirs[t].mode == 0o120000 ||
            b >= 0 && base[b].mode == 0o120000 {
            return Unsupported("merge of a symbolic link changed on both sides")
        }
        if o < 0 || t < 0 { return Unsupported("merge modify/delete conflict") }
        if ours[o].mode != theirs[t].mode &&
            (b < 0 || base[b].mode != ours[o].mode && base[b].mode != theirs[t].mode) {
            return Unsupported("merge mode conflict")
        }
        let mode = if b >= 0 && base[b].mode == ours[o].mode then theirs[t].mode else ours[o].mode
        // Mode and blob resolution are independent. A chmod on one side and
        // an edit on the other needs no content driver, even though the full
        // entries above differ. Do not refuse it because of merge metadata.
        if oid.equal(ours[o].id, theirs[t].id) || b >= 0 && oid.equal(base[b].id, theirs[t].id) {
            var chosen = copy ours[o]
            chosen.mode = mode
            (mut result.files).push(chosen)
            continue
        }
        if b >= 0 && oid.equal(base[b].id, ours[o].id) {
            var chosen = copy theirs[t]
            chosen.mode = mode
            (mut result.files).push(chosen)
            continue
        }
        let name = str_from_utf8(path)?
        var driver = "", marker_size = 7
        if contexts.len > 0 {
            let policy = worktree.attribute_policy(contexts[0], path, value)?
            driver = policy.merge
            marker_size = policy.conflict_marker_size
            if driver != "" &&
                driver != "+" &&
                driver != "-" &&
                worktree.configured_attribute_driver(contexts[0], "merge", driver) {
                return Unsupported("merge driver {driver} for {name}")
            }
            // Unconfigured, Git's built-in binary driver keeps ours and text is
            // the default merge. Union is not implemented: it refuses by name.
            if driver == "binary" { driver = "-" }
            if driver == "union" { return Unsupported("merge driver union for {name}") }
        }
        var merged = mergefile.Result { data: List[byte](), conflicts: 1 }
        if driver == "-" {
            merged.data = copy ours[o].data
            (mut result.messages).push(
                "warning: Cannot merge binary files: {name} ({ours_label} vs. {theirs_label})",
            )
        } else {
            // One file's line tables, scripts and result at a time: the region
            // reclaims them, and only the merged body is kept (den#145). A
            // merge that fails runs again outside, where its message can leave.
            let base_at = b
            var failed = false
            region content {
                let found = text_merge(
                    base,
                    base_at,
                    ours[o].data,
                    theirs[t].data,
                    ours_label,
                    base_label,
                    theirs_label,
                    style,
                    marker_size,
                ) else |_| {
                    failed = true
                    mergefile.Result { data: List[byte](), conflicts: 0 }
                }
                if !failed { merged = copy found }
            }
            if failed {
                merged = text_merge(
                    base,
                    base_at,
                    ours[o].data,
                    theirs[t].data,
                    ours_label,
                    base_label,
                    theirs_label,
                    style,
                    marker_size,
                )?
            }
            if merged.conflicts > 0 && !(marker_size >= 1 && marker_size <= 1024) {
                return Unsupported("merge conflict-marker-size={marker_size} for {name}")
            }
        }
        (mut result.messages).push("Auto-merging {name}")
        if merged.conflicts > 0 {
            (mut result.conflicts).push(name)
            (mut result.messages).push(
                "CONFLICT ({if b < 0 then "add/add" else "content"}): Merge conflict in {name}",
            )
            if b >= 0 {
                (mut result.stages).push(index.conflict_entry(path, base[b].mode, base[b].id, 1)?)
            }
            (mut result.stages).push(index.conflict_entry(path, ours[o].mode, ours[o].id, 2)?)
            (mut result.stages).push(index.conflict_entry(path, theirs[t].mode, theirs[t].id, 3)?)
        }
        (mut result.files).push(diff.File {
            path: copy path,
            mode: mode,
            id: object.identify("blob", merged.data)?,
            data: copy merged.data,
        })
    }
    result
}
