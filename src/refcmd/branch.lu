use std.fs
use commit
use commit_format
use history
use oid
use refs
use repository
use revision
use walk
use worktree

fn context() -> worktree.Context ! commit.CommitErrors {
    let repo = repository.discover(".")?
    if (repo.config["core.bare"] else "false") == "true" {
        let root = repo.gitdir
        return worktree.Context { repo: repo, root: root, cwd: root, prefix: "" }
    }
    worktree.discover(".")?
}

fn controls(ctx: worktree.Context, command: str) -> () ! commit.CommitErrors {
    controls_tracking(ctx, command, false)?
}

fn controls_tracking(
    ctx: worktree.Context,
    command: str,
    listing: bool,
) -> () ! commit.CommitErrors {
    if command == "branch" ||
        command == "switch" ||
        command == "checkout" ||
        command == "merge" ||
        command == "revert" {
        if fs.exists("{ctx.repo.gitdir}/rebase-merge") ||
            fs.exists("{ctx.repo.gitdir}/rebase-apply") {
            return Unsupported("{command} in-progress rebase")
        }
    }
    if fs.is_dir("{ctx.repo.gitdir}/worktrees") { return Unsupported("{command} linked worktrees") }
    let hook = ctx.repo.config["core.hookspath"] else "{ctx.repo.gitdir}/hooks"
    let path = if hook.starts_with("/") then hook else "{ctx.root}/{hook}"
    if fs.is_dir(path) && fs.entries(path)?.len > 0 {
        return Unsupported("{command} nonempty hooks directory")
    }
    for (key, value) in ctx.repo.config.pairs() {
        if key.starts_with("branch.") &&
            key != "branch.autosetupmerge" &&
            key != "branch.autosetuprebase" &&
            !(
                (command == "merge" || command == "rebase" || listing) &&
                    (
                        key.ends_with(".remote") ||
                            key.ends_with(".merge") ||
                            key.ends_with(".rebase")
                    )
            ) &&
            // An upstream is read by checkout's and switch's report and
            // ignored by reset, as in Git; creating a tracking branch stays
            // refused in checkout.lu (vc25: every superproject is a clone).
            !(
                (command == "checkout" || command == "switch" || command == "reset") &&
                    (key.ends_with(".remote") || key.ends_with(".merge"))
            ) {
            return Unsupported("{command} branch configuration {key}")
        }
        if key == "branch.autosetupmerge" && value != "true" && value != "false" ||
            key == "branch.autosetuprebase" && value != "never" {
            return Unsupported("{command} {key}={value}")
        }
    }
}

fn identity(ctx: worktree.Context) -> str ! commit.CommitErrors {
    commit_format.identity_text(commit.environment_identity(ctx, "COMMITTER", "")?)?
}

fn resolve_commit(repo: repository.Repo, name: str) -> oid.Oid ! commit.CommitErrors {
    revision.peel(repo, revision.resolve_typed(repo, name, "commit")?, "commit")?
}

fn abbrev(repo: repository.Repo, id: oid.Oid) -> str ! commit.CommitErrors {
    let value = repo.config["core.abbrev"] else "7"
    let n = value.to_int() else |_| { return Unsupported("core.abbrev={value}") }
    history.abbreviate(repo, id, n)?
}

fn write_ref(
    ctx: worktree.Context,
    name: str,
    old: List[oid.Oid],
    next: List[oid.Oid],
    message: str,
    log: bool,
) -> () ! commit.CommitErrors {
    refs.update(ctx.repo, name, old, next, identity(ctx)?, message, log) else |e| match e {
        exists => {
            return Fatal(
                "cannot lock ref '{name}': Unable to create '{ctx.repo.gitdir}/{name}.lock': File exists.\n\nAnother git process seems to be running in this repository, or the lock file may be stale",
            )
        },
        _ => { return Fatal("cannot update ref '{name}': {e}") },
    }
}

fn branch(args: List[str]) -> int ! commit.CommitErrors {
    let ctx = context()?
    let head = worktree.head(ctx)?
    var names = List[str]()
    var list = false, current = false, force = false, deleting = false, quiet = false, log = false
    var moving = false, include_local = true, include_remote = false, verbose = 0
    for arg in args[1..] {
        if arg == "--list" || arg == "-l" {
            list = true
        } else if arg == "--show-current" {
            current = true
        } else if arg == "-f" || arg == "--force" {
            force = true
        } else if arg == "-m" || arg == "--move" {
            moving = true
        } else if arg == "-M" {
            moving = true
            force = true
        } else if arg == "-d" || arg == "--delete" {
            deleting = true
        } else if arg == "-D" {
            deleting = true
            force = true
        } else if arg == "-q" || arg == "--quiet" {
            quiet = true
        } else if arg == "--create-reflog" {
            log = true
        } else if arg == "--no-create-reflog" {
            log = false
        } else if arg == "--verbose" {
            verbose += 1
        } else if arg == "--all" {
            include_local = true
            include_remote = true
        } else if arg == "--remotes" {
            include_local = false
            include_remote = true
        } else if arg.len > 1 &&
            arg.starts_with("-") &&
            !arg.starts_with("--") &&
            listing_flags(arg[1..]) {
            for flag in arg[1..].bytes() {
                if flag == 118 as byte { verbose += 1 }
                if flag == 97 as byte { include_local = true; include_remote = true }
                if flag == 114 as byte { include_local = false; include_remote = true }
            }
        } else if arg == "--no-track" || arg == "--no-color" || arg == "--no-column" {} else if arg.
            starts_with("-") {
            return Unsupported("branch {arg}")
        } else {
            (mut names).push(arg)
        }
    }
    controls_tracking(ctx, "branch", !moving && !deleting && (list || current || names.len == 0))?
    if moving { return move_branch(ctx, head, names, force)? }
    if current { if !head.detached { print(head.branch) }; return 0 }
    if list || names.len == 0 {
        for pattern in names {
            if pattern.contains("*") || pattern.contains("?") || pattern.contains("[") {
                return Unsupported("branch list patterns")
            }
        }
        return branch_listing(ctx, head, names, include_local, include_remote, verbose)?
    }
    if deleting {
        var result = 0
        for name in names {
            if !refs.valid("refs/heads/{name}") {
                eprint("error: branch '{name}' not found")
                result = 1
                continue
            }
            let full = "refs/heads/{name}"
            if full == head.reference {
                eprint("error: cannot delete branch '{name}' used by worktree at '{ctx.root}'")
                result = 1
                continue
            }
            let old = refs.optional(ctx.repo, full)?
            if old.len == 0 {
                eprint("error: branch '{name}' not found")
                result = 1
                continue
            }
            if !force {
                var merged = false
                if head.commits.len > 0 {
                    for item in walk.collect(ctx.repo, head.commits, 100001, 0, 100000, false)? {
                        if oid.equal(item.id, old[0]) { merged = true; break }
                    }
                }
                if !merged {
                    eprint(
                        "error: the branch '{name}' is not fully merged\nhint: If you are sure you want to delete it, run 'git branch -D {name}'\nhint: Disable this message with \"git config set advice.forceDeleteBranch false\"",
                    )
                    result = 1
                    continue
                }
            }
            let short = abbrev(ctx.repo, old[0])?
            write_ref(ctx, full, old, [], "", false)?
            if !quiet { print("Deleted branch {name} (was {short}).") }
        }
        return result
    }
    if names.len > 2 { return Unsupported("branch argument count") }
    let name = names[0]
    if !refs.valid("refs/heads/{name}") || name.starts_with("-") || name == "HEAD" {
        return Fatal("'{name}' is not a valid branch name")
    }
    let full = "refs/heads/{name}"
    let old = refs.optional(ctx.repo, full)?
    if old.len > 0 && !force { return Fatal("a branch named '{name}' already exists") }
    if force && full == head.reference {
        return Fatal("cannot force update the branch '{name}' used by worktree at '{ctx.root}'")
    }
    let start = if names.len == 2 then names[1] else if head.detached then "HEAD" else head.branch
    let id = resolve_commit(ctx.repo, start) else |e| match e {
        Unsupported(feature) => { return Unsupported(feature) },
        _ => { return Fatal("not a valid object name: '{start}'") },
    }
    let message = if old.len == 0 {
        "branch: Created from {start}"
    } else {
        "branch: Reset to {start}"
    }
    write_ref(ctx, full, old, [id], message, log)?
    0
}

fn dispatch(args: List[str]) -> int ! commit.CommitErrors {
    if args[0] == "rebase" { return rebase_command(args)? }
    if args[0] == "cherry-pick" { return pick_command(args)? }
    if args[0] == "merge" { return merge_command(args)? }
    if args[0] == "revert" { return revert_command(args)? }
    if args[0] == "tag" { return tag(args)? }
    if args[0] == "switch" || args[0] == "checkout" { return switch_branch(args)? }
    if args[0] == "reset" { return reset(args)? }
    branch(args)?
}

/// Bounded ref porcelain command edge; unsupported grammar remains named.
pub fn run(args: List[str]) -> int {
    if args.len == 0 { return 2 }
    let result = dispatch(args) else |e| match e {
        Fatal(message) => { eprint("fatal: {message}"); return 128 },
        Failure(message) => { eprint("error: {message}"); return 1 },
        Unsupported(message) => {
            // A named bound is a fatal error, as Git reports its own.
            if message.starts_with("limit: ") { eprint("fatal: {message}"); return 128 }
            eprint("den: not yet implemented: {message}")
            return 2
        },
        _ => { eprint("fatal: {e}"); return 128 },
    }
    result
}
