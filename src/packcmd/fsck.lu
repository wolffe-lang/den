// Bounded full-object validation and default-root connectivity, git-fsck(1).
// Diagnostic-rich corrupt repositories remain named, never reported clean.
use std.fs
use commit_format
use index
use object
use oid
use pack
use refs
use repository
use stashlog
use zlib

struct Link { name: str, kind: str }

struct ValidationLink { source: str, kind: str, target: Link }

fn linked_name(bytes: List[byte]) -> str ! object.StoreErrors {
    let name = str_from_utf8(bytes) else |_| { return Unsupported("fsck object header bytes") }
    let id = oid.parse("sha1", name)?
    oid.hex(id)?
}

fn links(body: object.Object) -> List[Link] ! object.StoreErrors {
    var out = List[Link]()
    if body.kind == "blob" { return out }
    if body.kind == "tree" {
        let entries = object.parse_tree(body.data, "sha1") else |_| {
            return Unsupported("fsck malformed tree diagnostics")
        }
        for entry in entries {
            let path = str_from_utf8(entry.name) else ""
            if path == "." || path == ".." || path.lower() == ".git" {
                return Unsupported("fsck unsafe tree path diagnostics")
            }
            if entry.mode == 0o160000 { continue }
            let kind = if entry.mode == 0o40000 then "tree" else "blob"
            (mut out).push(Link { name: oid.hex(entry.id)?, kind: kind })
        }
        return out
    }
    var parsed = object.Headers { fields: List[object.Header](), message: List[byte]() }
    if body.kind == "commit" {
        parsed = object.parse_commit(body.data, "sha1") else |_| {
            return Unsupported("fsck malformed commit diagnostics")
        }
    } else {
        parsed = object.parse_tag(body.data, "sha1") else |_| {
            return Unsupported("fsck malformed tag diagnostics")
        }
    }
    for field in parsed.fields {
        if body.kind == "commit" && (field.key == "tree" || field.key == "parent") {
            (mut out).push(Link {
                name: linked_name(field.value)?,
                kind: if field.key == "tree" then "tree" else "commit",
            })
        } else if body.kind == "tag" && field.key == "object" {
            let kind = str_from_utf8(parsed.fields[1].value) else |_| {
                return Unsupported("fsck tag type")
            }
            (mut out).push(Link { name: linked_name(field.value)?, kind: kind })
        } else if field.key == "author" || field.key == "committer" || field.key == "tagger" {
            let text = str_from_utf8(field.value) else |_| {
                return Unsupported("fsck identity bytes")
            }
            let _ = commit_format.parse_identity(text) else |_| {
                return Unsupported("fsck identity diagnostics")
            }
        } else if body.kind == "tag" && field.key == "tag" {
            let text = str_from_utf8(field.value) else |_| {
                return Unsupported("fsck tag name bytes")
            }
            if !refs.valid("refs/tags/{text}") { return Unsupported("fsck tag name diagnostics") }
        }
    }
    out
}

fn reflog_roots(path: str, depth: int, mut roots: Map[str, bool]) -> () ! object.StoreErrors {
    if depth > 32 { return Unsupported("fsck reflog depth") }
    let entries = fs.entries(path) else |e| match e {
        not_found => { return },
        _ => { return io },
    }
    for entry in entries {
        let name = str_from_utf8(entry.name) else |_| {
            return Unsupported("fsck reflog path bytes")
        }
        let full = "{path}/{name}"
        if entry.kind == 1 {
            reflog_roots(full, depth + 1, mut roots)?
        } else if entry.kind == 0 {
            let bytes = repository.read_bytes(full, 16777216)?
            let records = stashlog.parse(bytes) else |_| {
                return Unsupported("fsck reflog diagnostics")
            }
            for record in records {
                for id in [record.before, record.after] {
                    if id != "0000000000000000000000000000000000000000" { roots[id] = true }
                }
            }
        } else {
            return Unsupported("fsck reflog file type")
        }
        if roots.len > 10000 { return Unsupported("fsck root count limit") }
    }
}

fn corrupt_diagnostic(
    repo: repository.Repo,
    name: str,
    mut messages: List[str],
) -> () ! object.StoreErrors {
    let source = object.path(repo, oid.parse("sha1", name)?)?
    let path = "{gitdir_display(repo)}/objects/{name[0..2]}/{name[2..]}"
    let bytes = repository.read_bytes(source, 17000000)?
    if bytes.len == 0 {
        (mut messages).push("error: object file {path} is empty")
        (mut messages).push("error: unable to mmap {path}: No such file or directory")
    } else if bytes.len >= 2 && (bytes[0] as int * 256 + bytes[1] as int) % 31 != 0 {
        (mut messages).push("error: inflate: data stream error (incorrect header check)")
        (mut messages).push("error: unable to unpack header of {path}")
    } else {
        let inflated = zlib.inflate(bytes, 16777344) else |_| {
            return Unsupported("fsck compressed corruption diagnostics")
        }
        let actual = oid.digest("sha1", inflated.data)?
        let _ = object.decode(bytes, actual, 16777216) else |_| {
            return Unsupported("fsck malformed object diagnostics")
        }
        if oid.hex(actual)? == name { return Unsupported("fsck object read failure diagnostics") }
        (mut messages).push("error: {oid.hex(actual)?}: hash-path mismatch, found at: {path}")
        return
    }
    (mut messages).push("error: {name}: object corrupt or missing: {path}")
}

fn checked_reflogs(
    repo: repository.Repo,
    relative: str,
    depth: int,
    kinds: Map[str, str],
    mut roots: Map[str, bool],
    mut messages: List[str],
) -> () ! object.StoreErrors {
    if depth > 32 { return Unsupported("fsck reflog depth") }
    let path = "{repo.gitdir}/logs/{relative}"
    let entries = fs.entries(path) else |e| match e {
        not_found => { return },
        _ => { return io },
    }
    var names = List[str](), types = Map[str, int]()
    for entry in entries {
        let name = str_from_utf8(entry.name) else |_| {
            return Unsupported("fsck reflog path bytes")
        }
        (mut names).push(copy name)
        types[name] = entry.kind
    }
    for name in sorted_names(names) {
        let child = if relative == "" then name else "{relative}/{name}"
        if (types[name] else -1) == 1 {
            checked_reflogs(repo, child, depth + 1, kinds, mut roots, mut messages)?
        } else if (types[name] else -1) == 0 {
            let records = stashlog.parse(
                repository.read_bytes("{repo.gitdir}/logs/{child}", 16777216)?,
            ) else |_| { return Unsupported("fsck reflog diagnostics") }
            for record in records {
                for id in [record.before, record.after] {
                    if id == "0000000000000000000000000000000000000000" { continue }
                    if (kinds[id] else "") == "" {
                        (mut messages).push("error: {child}: invalid reflog entry {id}")
                    } else {
                        roots[id] = true
                    }
                }
            }
        } else {
            return Unsupported("fsck reflog file type")
        }
        if roots.len > 10000 || messages.len > 10000 {
            return Unsupported("fsck reflog count limit")
        }
    }
}

fn fsck(args: List[str]) -> int ! object.StoreErrors {
    var dangling = true, logs = true
    for arg in args[1..] {
        if arg == "--full" || arg == "--no-progress" {
            continue
        } else if arg == "--no-dangling" {
            dangling = false
        } else if arg == "--no-reflogs" {
            logs = false
        } else {
            return Unsupported("fsck {arg}")
        }
    }
    let repo = repository.discover(".")?
    for (key, _) in repo.config.pairs() {
        if key.starts_with("fsck.") { return Unsupported("fsck configuration") }
    }
    let items = inventory(repo)?
    let check_graph = (repo.config["core.commitgraph"] else "true") != "false"
    if check_graph && fs.exists("{repo.gitdir}/objects/info/commit-graphs") {
        return Unsupported("fsck split commit-graph validation")
    }
    for path in items.indexes { let _ = pack.inspect(path)? }
    var names = List[str](),
        kinds = Map[str, str](),
        used = Map[str, bool](),
        all_links = List[ValidationLink](),
        seen = Map[str, bool]()
    var messages = List[str](), broken = List[str](), missing = Map[str, str](), status = 0
    for name in items.loose {
        if !(seen[name] else false) { seen[name] = true; (mut names).push(copy name) }
    }
    for name in items.packed {
        if !(seen[name] else false) { seen[name] = true; (mut names).push(copy name) }
    }
    if names.len > 10000 { return Unsupported("fsck object count limit") }
    var total = 0
    for name in names {
        let body = object.read_object(repo, oid.parse("sha1", name)?, 16777216) else |_| {
            corrupt_diagnostic(repo, name, mut messages)?
            status |= 1
            continue
        }
        if body.data.len > 134217728 - total { return Unsupported("fsck payload limit") }
        total += body.data.len
        kinds[name] = copy body.kind
        for link in links(body)? {
            (mut all_links).push(ValidationLink {
                source: copy name,
                kind: copy body.kind,
                target: copy link,
            })
        }
        if all_links.len > 100000 { return Unsupported("fsck link count limit") }
    }
    var invalid_sources = Map[str, bool]()
    for edge in all_links {
        let link = edge.target
        let actual = kinds[link.name] else ""
        if actual == "" {
            if (missing[link.name] else link.kind) != link.kind {
                return Unsupported("fsck conflicting missing types")
            }
            missing[link.name] = copy link.kind
            status |= 2
        } else if actual != link.kind {
            (mut messages).push("error: object {link.name} is a {actual}, not a {link.kind}")
            if edge.kind == "tree" {
                (mut messages).push("error in tree {edge.source}: broken links")
            } else if edge.kind == "commit" && link.kind == "tree" {
                (mut messages).push("error: bad tree pointer {link.name} in commit {edge.source}")
                (mut messages).push("error: {edge.source}: object corrupt or missing")
                invalid_sources[edge.source] = true
            } else {
                return Unsupported("fsck wrong-type parent or tag diagnostics")
            }
            status |= 1
        }
        used[link.name] = true
    }
    var roots = Map[str, bool]()
    let references = refs.list(repo, "refs/")?
    for reference in references {
        let name = oid.hex(reference.id)?
        if (kinds[name] else "") == "" {
            (mut messages).push("error: {reference.name}: invalid sha1 pointer {name}")
            status |= 2
            continue
        }
        if reference.name.starts_with("refs/heads/") && (kinds[name] else "") != "commit" {
            (mut messages).push("error: {reference.name}: not a commit")
            status |= 8
        }
        roots[name] = true
    }
    for id in refs.optional(repo, "HEAD")? {
        let name = oid.hex(id)?
        if (kinds[name] else "") == "" {
            (mut messages).push("error: HEAD: invalid sha1 pointer {name}")
            status |= 2
            continue
        }
        if (kinds[name] else "") != "commit" {
            (mut messages).push("error: HEAD: not a commit")
            status |= 8
        }
        roots[name] = true
    }
    let default_references = roots.len
    if logs {
        let count = messages.len
        checked_reflogs(repo, "", 0, kinds, mut roots, mut messages)?
        if messages.len != count { status |= 2 }
    }
    if fs.exists("{repo.gitdir}/index") {
        let value = index.read(repo, 16777216) else |_| {
            return Unsupported("fsck index diagnostics")
        }
        let cached = index.cached_trees(value) else |_| {
            return Unsupported("fsck cache-tree diagnostics")
        }
        for id in cached {
            let name = oid.hex(id)?
            if (kinds[name] else "") == "" {
                (mut messages).push(
                    "error: {name}: invalid sha1 pointer in cache-tree of {gitdir_display(repo)}/index",
                )
                status |= 8
            } else if (kinds[name] else "") != "tree" {
                return Unsupported("fsck cache-tree type diagnostics")
            } else {
                used[name] = true
            }
        }
        for entry in value.entries {
            if entry.stat[6] == 0o160000 { continue }
            let name = oid.hex(entry.id)?
            if (kinds[name] else "") == "" {
                missing[name] = "blob"
                status |= 2
            } else if (kinds[name] else "") != "blob" {
                return Unsupported("fsck index object diagnostics")
            }
            roots[name] = true
        }
    }
    for (name, _) in roots.pairs() { used[name] = true }
    for edge in all_links {
        if (missing[edge.target.name] else "") != "" && !(roots[edge.target.name] else false) {
            var source_kind = edge.kind, target_kind = edge.target.kind
            while source_kind.len < 7 { source_kind = " {source_kind}" }
            while target_kind.len < 7 { target_kind = " {target_kind}" }
            (mut broken).push(
                "broken link from {source_kind} {edge.source}\n              to {target_kind} {edge.target.name}",
            )
        }
    }
    var tips = List[str]()
    if dangling {
        for name in names {
            if (kinds[name] else "") != "" &&
                !(used[name] else false) &&
                !(invalid_sources[name] else false) {
                (mut tips).push(copy name)
            }
        }
        // Git's hash-table iteration is not sorted OID order. Until measured,
        // refuse multiple-tip display rather than inventing porcelain parity.
        if tips.len > 1 { return Unsupported("fsck multiple dangling object order") }
    }
    if tips.len + missing.len > 1 {
        return Unsupported("fsck multiple dangling or missing object order")
    }
    if broken.len > 1 { return Unsupported("fsck multiple broken-link order") }
    for message in messages { eprint(message) }
    if default_references == 0 { eprint("notice: No default references") }
    for line in broken { print(line) }
    for (name, kind) in missing.pairs() { print("missing {kind} {name}") }
    for name in tips {
        let kind = kinds[name] else ""
        print("dangling {kind} {name}")
    }
    if check_graph && fs.exists("{repo.gitdir}/objects/info/commit-graph") {
        let bytes = repository.read_bytes("{repo.gitdir}/objects/info/commit-graph", 16777216)?
        return status | verify_commit_graph(repo, bytes)?
    }
    status
}
