use sequencer

fn main() -> int ! {invalid, limit, utf8} {
    let rows = sequencer.parse("pick 1234abcd subject\npick abcdef01 other\n".bytes())?
    assert(rows.len == 2)
    assert(rows[0].name == "1234abcd")
    assert(rows[1].subject == "other")
    assert(
        str_from_utf8(sequencer.render(rows)?)? == "pick 1234abcd subject\npick abcdef01 other\n",
    )
    let bad = sequencer.parse("exec arbitrary\n".bytes()) else |e| match e {
        invalid => List[sequencer.Step](),
        _ => { assert(false); List[sequencer.Step]() },
    }
    assert(bad.len == 0)
    assert(sequencer.empty_action(true, false, "stop")? == "stop")
    assert(sequencer.empty_action(true, true, "stop")? == "keep")
    assert(sequencer.empty_action(false, true, "stop")? == "stop")
    assert(sequencer.empty_action(false, false, "drop")? == "drop")
    assert(sequencer.empty_action(true, false, "keep")? == "keep")
    let a = sequencer.line_sum("old\ncontext\n".bytes())?
    let b = sequencer.line_sum("new\ncontext\n".bytes())?
    let c = sequencer.line_sum("different\nold\n".bytes())?
    let d = sequencer.line_sum("different\nnew\n".bytes())?
    assert(b - a == d - c)
    assert(sequencer.line_sum(" n e w \t\n".bytes())? == sequencer.line_sum("new\n".bytes())?)
    assert(a != b)
    0
}
