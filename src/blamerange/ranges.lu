// Git 2.56.0 blame-options and line-range-format documentation; numeric forms.

/// Numeric range diagnostics and named regex/function refusals; no repository IO.
pub error RangeErrors = {invalid, limit, utf8, Fatal(str), Unsupported(str)}

/// Union of 1-based inclusive ranges represented by zero-based selection bits.
/// Ranges/count/input sizes are bounded before arithmetic or indexing.
pub fn selection(count: int, ranges: List[str], path: List[byte]) -> List[bool] ! RangeErrors {
    if count < 0 || count > 200000 || ranges.len > 256 { return invalid }
    var selected = List[bool]()
    for _ in 0..count { (mut selected).push(ranges.len == 0) }
    for range in ranges {
        if range.starts_with(":") || range.starts_with("^:") {
            return Unsupported("blame function ranges")
        }
        if range.contains("/") { return Unsupported("blame regex ranges") }
        if range.len > 4096 { return limit }
        let parts = range.split(",")
        if parts.len > 2 { return invalid }
        var start = if parts[0] == "" then 1 else (parts[0].to_int() else |_| { return invalid })
        if start < 1 { return Fatal("-L invalid line number: {start}") }
        if start > 1000000000 { return invalid }
        var end = count
        if parts.len == 2 && parts[1] != "" {
            let value = parts[1].to_int() else |_| { return invalid }
            if value < -1000000000 || value > 1000000000 { return invalid }
            if parts[1].starts_with("+") || parts[1].starts_with("-") {
                if value == 0 { return Fatal("-L invalid empty range") }
                end = start + value + (if value > 0 then -1 else 1)
            } else {
                end = value
            }
        }
        if end < 1 { return Fatal("-L invalid line number: {end}") }
        if start > end {
            let saved = start
            start = end
            end = saved
        }
        if start > count { return Fatal("file {str_from_utf8(path)?} has only {count} lines") }
        if end > count { end = count }
        for i in start - 1..end { selected[i] = true }
    }
    selected
}
