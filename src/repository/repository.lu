use std.fs

/// Validated administrative directory; worktrees/alternates are not yet supported.
pub struct Repo {
    gitdir: str,
    config: Map[str, str],
}

/// IO errors remain actionable; unsupported repository features carry their name.
pub error RepoErrors = {
    not_found,
    denied,
    io,
    invalid,
    exists,
    unsupported,
    limit,
    Unsupported(str),
}

/// read_bytes's bound, named as fetch, pull, merge and checkout print it.
// A bound's message is a literal: an error can leave the region the read
// that raised it ran in, and a message built at run time would leave with it.
fn file_limit(cap: int) -> str {
    if cap == 4096 { return "limit: a file larger than 4096 bytes" }
    if cap == 32768 { return "limit: a file larger than 32768 bytes" }
    if cap == 65536 { return "limit: a file larger than 65536 bytes" }
    if cap == 1048576 { return "limit: a file larger than 1048576 bytes" }
    if cap == 16777216 { return "limit: a file larger than 16777216 bytes" }
    if cap == 1000000000 { return "limit: a file larger than 1000000000 bytes" }
    "limit: a file larger than its read allows"
}

/// Bounded binary read, including a growth check after stat; never reads a pack.
pub fn read_bytes(path: str, cap: int) -> List[byte] ! RepoErrors {
    if cap < 0 { return invalid }
    var f = fs.open(path)?
    defer fs.close(take f) else |_| {}
    let info = fs_fstat_record(f.fd) else |_| { return io }
    // The bound is named as fetch, pull, merge and checkout print it.
    if info[1] > cap { return Unsupported(file_limit(cap)) }
    var out = List[byte](), exceeded = false
    loop {
        region chunk {
            let bytes = fs.read_chunk(mut f, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if bytes.len > cap - out.len {
                exceeded = true
                break
            }
            for b in bytes { (mut out).push(b) }
        }
    }
    if exceeded { return Unsupported(file_limit(cap)) }
    out
}

/// Refuse unsupported formats before any object write, including at version 0.
pub fn open(gitdir: str) -> Repo ! RepoErrors {
    let absolute = fs.realpath(gitdir)?
    if !fs.is_file("{absolute}/HEAD") || !fs.is_dir("{absolute}/objects") { return not_found }
    if fs.exists("{absolute}/commondir") { return Unsupported("linked worktree commondir") }
    if fs.exists("{absolute}/objects/info/alternates") { return Unsupported("object alternates") }
    let values = config_values(configuration(absolute)?)
    let version = values["core.repositoryformatversion"] else "0"
    if version != "0" && version != "1" {
        return Unsupported("core.repositoryformatversion={version}")
    }
    for (key, value) in values.pairs() {
        if key.starts_with("extensions.") {
            if key != "extensions.objectformat" || value != "sha1" {
                return Unsupported("{key}={value}")
            }
        }
    }
    Repo { gitdir: absolute, config: values }
}

/// Follow a .git gitfile without treating it as an absent repository.
fn gitfile(path: str) -> str ! RepoErrors {
    let bytes = read_bytes(path, 4096)?
    let text = str_from_utf8(bytes) else |_| { return invalid }
    if !text.starts_with("gitdir: ") { return invalid }
    let value = text[8..].trim()
    if value.starts_with("/") { return value }
    "{fs.parent(path) else "."}/{value}"
}

/// Recognize a worktree's own repository without opening its configuration or
/// objects. Untracked repositories are opaque even when their format cannot
/// be operated on here. An empty .git directory is not a repository. Linked
/// worktrees borrow objects/refs from commondir but keep their own HEAD.
/// gitrepository-layout(5), DESCRIPTION, HEAD, commondir and objects.
pub fn embedded(path: str) -> bool ! RepoErrors {
    let marker = "{path}/.git"
    var dir = copy marker
    if fs.is_file(marker) {
        dir = gitfile(marker)?
    } else if !fs.is_dir(marker) {
        return false
    }
    if !fs.is_file("{dir}/HEAD") { return false }
    var common = copy dir
    if fs.is_file("{dir}/commondir") {
        let bytes = read_bytes("{dir}/commondir", 4096)?
        let value = str_from_utf8(bytes) else |_| { return invalid }
        let target = value.trim()
        common = if target.starts_with("/") then copy target else "{dir}/{target}"
    }
    fs.is_dir("{common}/objects") && fs.is_dir("{common}/refs")
}

/// Discover upward from start, or honor explicit GIT_DIR; no shell subprocess.
pub fn discover(start: str) -> Repo ! RepoErrors {
    for name in ["GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"] {
        if (env_get(name) else "") != "" { return Unsupported(name) }
    }
    let explicit = env_get("GIT_DIR") else ""
    if explicit != "" { return open(explicit)? }
    // git(1) GIT_CEILING_DIRECTORIES: absolute directories discovery does
    // not move up into.
    var ceilings = List[str]()
    for entry in (env_get("GIT_CEILING_DIRECTORIES") else "").split(":") {
        if entry.starts_with("/") {
            var trimmed = copy entry
            while trimmed.len > 1 && trimmed.ends_with("/") {
                trimmed = trimmed[0..trimmed.len - 1]
            }
            (mut ceilings).push(fs.realpath(trimmed) else trimmed)
        }
    }
    var dir = fs.realpath(start)?
    loop {
        if fs.is_dir("{dir}/.git") { return open("{dir}/.git")? }
        if fs.is_file("{dir}/.git") { return open(gitfile("{dir}/.git")?)? }
        if fs.is_file("{dir}/HEAD") && fs.is_dir("{dir}/objects") { return open(dir)? }
        let parent = fs.parent(dir) else |_| { return not_found }
        if parent == dir { return not_found }
        for ceiling in ceilings { if parent == ceiling { return not_found } }
        dir = parent
    }
}

/// Return the level this store implements, refusing other settings by name.
pub fn compression(repo: Repo) -> int ! {Unsupported(str)} {
    for key in ["core.compression", "core.loosecompression"] {
        let value = repo.config[key] else "1"
        if value != "1" && value != "-1" { return Unsupported("{key}={value}") }
    }
    1
}

/// Initialize only the measured empty-template surface; preserve existing data.
/// Returns repository and whether this was reinitialization.
pub fn init(path: str, bare: bool, branch: str) -> (Repo, bool) ! RepoErrors {
    init_with(path, bare, branch, "")?
}

/// init, or with WORKTREE non-empty a separate non-bare gitdir at PATH itself
/// whose core.worktree is WORKTREE, as a submodule's .git/modules/<name> is
/// (vc25; gitrepository-layout(5) `modules/`).
pub fn init_with(path: str, bare: bool, branch: str, worktree: str) -> (Repo, bool) ! RepoErrors {
    if branch == "" ||
        branch.contains("..") ||
        branch.contains("@{{") ||
        branch.starts_with("/") ||
        branch.ends_with("/") ||
        branch.ends_with(".") {
        return invalid
    }
    for b in branch.bytes() {
        if b as int <= 32 ||
            b as int == 127 ||
            b == 126 as byte ||
            b == 94 as byte ||
            b == 58 as byte ||
            b == 63 as byte ||
            b == 42 as byte ||
            b == 91 as byte ||
            b == 92 as byte {
            return invalid
        }
    }
    for part in branch.split("/") {
        if part == "" || part.starts_with(".") || part.ends_with(".lock") { return invalid }
    }
    let globals = global_config()?
    let _ = globals
    fs.create_dir_all(path)?
    var dir = if bare || worktree != "" then path else "{path}/.git"
    if fs.is_file(dir) { dir = gitfile(dir)? }
    let reinit = fs.is_file("{dir}/HEAD")
    if reinit { let _ = open(dir)? }
    fs.create_dir_all(dir)?
    for name in ["objects/info", "objects/pack", "refs/heads", "refs/tags", "hooks"] {
        fs.create_dir_all("{dir}/{name}")?
    }
    if !reinit {
        var head = fs.create_new_with_mode("{dir}/HEAD", 0o644)?
        fs.write(mut head, "ref: refs/heads/{branch}\n")?
        fs.sync(mut head)?
        fs.close(take head)?
        var config = fs.create_new_with_mode("{dir}/config", 0o644)?
        var tail = if bare then "\tbare = true\n" else "\tbare = false\n\tlogallrefupdates = true\n"
        if worktree != "" {
            tail = "\tbare = false\n\tlogallrefupdates = true\n\tworktree = {worktree}\n"
        }
        fs.write(mut config, "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n{tail}")?
        fs.sync(mut config)?
        fs.close(take config)?
        fs.sync_dir(dir)?
    }
    (open(dir)?, reinit)
}
