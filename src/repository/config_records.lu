// Ordered config inspection retains source provenance beside parsed entries.

/// A source is deliberately not folded into Repo.config's last-value map.
pub struct ConfigRecord { entry: ConfigEntry, level: str, origin: str }
struct ConfigSource { path: str, level: str }

fn config_sources(gitdir: str) -> List[ConfigSource] ! ConfigReadErrors {
    var sources = List[ConfigSource]()
    if !config_nosystem()? {
        (mut sources).push(ConfigSource {
            path: env_get("GIT_CONFIG_SYSTEM") else "/etc/gitconfig", level: "system",
        })
    }
    let explicit = env_get("GIT_CONFIG_GLOBAL") else "\0"
    if explicit == "\0" {
        let home = env_get("HOME") else "."
        var xdg = env_get("XDG_CONFIG_HOME") else ""
        if xdg == "" { xdg = "{home}/.config" }
        (mut sources).push(ConfigSource { path: "{xdg}/git/config", level: "global" })
        (mut sources).push(ConfigSource { path: "{home}/.gitconfig", level: "global" })
    } else if explicit != "" {
        (mut sources).push(ConfigSource { path: explicit, level: "global" })
    }
    if gitdir != "" {
        (mut sources).push(ConfigSource {
            path: if gitdir == "." then "config" else "{gitdir}/config", level: "local",
        })
    }
    sources
}

/// Enumerate exactly the reader's ordered sources, or one selected level/file.
/// File level is command, as specified for explicitly selected config files.
pub fn configuration_records(
    gitdir: str,
    level: str,
    file: str,
) -> List[ConfigRecord] ! ConfigReadErrors {
    var sources = if level == "file" {
        [ConfigSource { path: file, level: "command" }]
    } else {
        config_sources(gitdir)?
    }
    // Explicit system selection ignores NOSYSTEM, unlike implicit discovery.
    if level == "system" {
        sources = [ConfigSource {
            path: env_get("GIT_CONFIG_SYSTEM") else "/etc/gitconfig", level: "system",
        }]
    }
    var records = List[ConfigRecord]()
    for source in sources {
        if level != "" && level != "file" && source.level != level { continue }
        var entries = List[ConfigEntry]()
        config_file(source.path, source.level != "local" && level != "file", mut entries)?
        for entry in entries {
            (mut records).push(ConfigRecord {
                entry: copy entry, level: source.level, origin: "file:{source.path}",
            })
        }
    }
    if level == "" {
        var runtime = List[ConfigEntry]()
        config_runtime(mut runtime)?
        for entry in runtime {
            (mut records).push(ConfigRecord {
                entry: copy entry, level: "command", origin: "command line:",
            })
        }
    }
    records
}
