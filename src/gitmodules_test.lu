        ["./top", "../x.git", "x.git"],
        ["./top", "./x.git", "top/x.git"],
        ["./top", "../../y/x.git", "FATAL cannot strip one component off url '.'"],
        ["./top", "../../../x.git", "FATAL cannot strip one component off url '.'"],
        ["./top", "./x", "top/x"],
        ["./top", "../x/", "x"],
        ["./top", ".././x", "x"],
        ["./top", "../x/./y", "x/./y"],
        ["./top", "../x/../y", "x/../y"],
        ["top", "../x.git", "x.git"],
        ["top", "./x.git", "top/x.git"],
        ["top", "../../y/x.git", "FATAL cannot strip one component off url '.'"],
