        ["top", "../x/./y", "x/./y"],
        ["top", "../x/../y", "x/../y"],
    ]
    var failed = 0
    var i = 0
    for c in cases {
        i += 1
        let got = gitmodules.resolve(c[0], c[1]) else |e| match e {
            Fatal(message) => "FATAL {message}",
            _ => "ERROR {e}",
        }
        if got != c[2] {
            print("FAIL submodule-url-{i} {c[0]} + {c[1]}: {got}, want {c[2]}")
            failed += 1
        }
    }
    print("submodule-url: {cases.len - failed}/{cases.len}")
    failed
