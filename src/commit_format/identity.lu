// Clean-room: Git v2.56.0 Documentation/git-commit.adoc, --author/--date;
// date-formats.adoc, DATE FORMATS. Identity values are caller-supplied only.

/// An explicit identity, independent of configuration and environment lookup.
pub struct Identity {
    name: str,
    email: str,
    date: Date,
}

// vc26, measured with the pinned Git: a byte Git trims from both ends of a
// name or email (whitespace and , : ; " \ ' < >); `.` is kept.
fn ident_crud(b: byte) -> bool {
    b as int <= 32 ||
        b == 44 as byte ||
        b == 58 as byte ||
        b == 59 as byte ||
        b == 60 as byte ||
        b == 62 as byte ||
        b == 34 as byte ||
        b == 92 as byte ||
        b == 39 as byte
}

/// A name or email as Git writes it: `<`, `>` and LF removed (git-commit(1),
/// COMMIT INFORMATION), then the bytes ident_crud names trimmed from both
/// ends. The result may be empty: Git writes an empty email as `<>`.
pub fn ident_clean(input: str) -> str ! FormatErrors {
    if input.len > 4096 { return limit }
    if input.contains("\0") { return invalid_identity }
    var bytes = List[byte]()
    for b in input.bytes() {
        if b != 60 as byte && b != 62 as byte && b != 10 as byte { (mut bytes).push(b) }
    }
    var start = 0, end = bytes.len
    while start < end && ident_crud(bytes[start]) { start += 1 }
    while end > start && ident_crud(bytes[end - 1]) { end -= 1 }
    str_from_utf8(bytes[start..end]) else |_| { return invalid_identity }
}

fn identity_part(input: str) -> str ! FormatErrors {
    let text = ident_clean(input)?
    if text == "" { return invalid_identity }
    text
}

/// Validate explicit parameters and clean name and email as Git does
/// (ident_clean). No fallback identity is inferred.
pub fn make_identity(name: str, email: str, date: Date) -> Identity ! FormatErrors {
    let clean_name = identity_part(name)?
    // vc26: Git writes an empty email (`<>`); an empty name it refuses, and
    // the commands name that refusal before they get here.
    let clean_email = ident_clean(email)?
    let _ = date_text(date)?
    Identity { name: clean_name, email: clean_email, date: copy date }
}

/// Parse the explicit --author `Name <email>` form. Historical-author search is
/// outside this pure module and is refused by name rather than approximated.
pub fn parse_author(text: str, date: Date) -> Identity ! FormatErrors {
    if text.len > 16384 { return limit }
    let left = text.find("<") else |_| { return Unsupported("commit --author pattern") }
    let right = text.rfind(">") else |_| { return invalid_identity }
    if text.count("<") != 1 || text.count(">") != 1 { return invalid_identity }
    if right <= left || text[right + 1..].trim() != "" { return invalid_identity }
    make_identity(text[0..left], text[left + 1..right], date)?
}

/// Serialize an identity for author/committer headers or reflog ident fields.
pub fn identity_text(identity: Identity) -> str ! FormatErrors {
    let checked = make_identity(identity.name, identity.email, identity.date)?
    "{checked.name} <{checked.email}> {date_text(checked.date)?}"
}

/// Parse a complete existing `Name <email> seconds +HHMM` header identity,
/// preserving its author date for an amend caller that does not reset it.
pub fn parse_identity(text: str) -> Identity ! FormatErrors {
    if text.len > 16384 { return limit }
    let left = text.find("<") else |_| { return invalid_identity }
    let right = text.rfind(">") else |_| { return invalid_identity }
    if text.count("<") != 1 || text.count(">") != 1 { return invalid_identity }
    if right <= left { return invalid_identity }
    let tail = text[right + 1..].trim().words()
    if tail.len != 2 { return invalid_identity }
    let date = Date { seconds: date_number(tail[0])?, offset: canonical_zone(tail[1])? }
    make_identity(text[0..left], text[left + 1..right], date)?
}
