// gitprotocol-pack: negotiated receive-pack side-band-64k, HTTP only.
// Progress rendering is measured against the pinned Git in a nonterminal,
// no-color environment. The HTTP backend owns two fatal diagnostics above it;
// those CLI exit/output bytes are handled separately by configured_push.
use pktline
use wire

/// Fully demultiplexed receive report and diagnostic bytes. A fatal band is
/// never a successful status report, even if preceding band 1 bytes looked valid.
pub struct ReceiveSideband { report: List[byte], progress: List[byte], fatal: bool }

fn diagnostic_append(mut out: List[byte], data: List[byte]) -> () ! Errors {
    if data.len > 2097152 - out.len { return limit }
    wire.append(mut out, data)
}

fn progress_line(mut out: List[byte], pending: List[byte], ending: byte, terminated: bool) -> () ! Errors {
    diagnostic_append(mut out, "remote: ".bytes())?
    diagnostic_append(mut out, pending)?
    if terminated && pending.len > 0 { diagnostic_append(mut out, "        ".bytes())? }
    diagnostic_append(mut out, [ending])?
}

/// Decode complete outer pkt-lines without changing inner report-status bytes.
/// Band 2 partial lines survive packet boundaries; LF and CR retain their exact
/// Git padding, while an unterminated final line receives LF without padding.
/// Unknown bands and truncated frames refuse by name before any ref publication.
pub fn http_receive_sideband(data: List[byte]) -> ReceiveSideband ! Errors {
    if data.len > 2097152 { return limit }
    var report = List[byte](), progress = List[byte](), pending = List[byte](), pos = 0
    while pos < data.len {
        let packet = pktline.decode(data, pos) else |e| match e {
            truncated => { return Unsupported("HTTP truncated sideband") },
            invalid => { return invalid },
            limit => { return limit },
        }
        pos = packet.next
        if packet.kind == 0 {
            if pos != data.len { return invalid }
            if pending.len > 0 { progress_line(mut progress, pending, 10 as byte, false)? }
            return ReceiveSideband { report: report, progress: progress, fatal: false }
        }
        if packet.kind != 4 || packet.data.len == 0 { return invalid }
        let band = packet.data[0] as int
        if band == 1 {
            if packet.data.len - 1 > 2097152 - report.len { return limit }
            wire.append(mut report, packet.data[1..])
        } else if band == 2 {
            for b in packet.data[1..] {
                if b == 10 as byte || b == 13 as byte {
                    progress_line(mut progress, pending, b, true)?
                    pending = List[byte]()
                } else {
                    if pending.len >= 65536 { return limit }
                    (mut pending).push(b)
                }
            }
        } else if band == 3 {
            if pending.len > 0 { progress_line(mut progress, pending, 10 as byte, false)? }
            diagnostic_append(mut progress, "remote: ".bytes())?
            diagnostic_append(mut progress, packet.data[1..])?
            diagnostic_append(mut progress, "\n".bytes())?
            return ReceiveSideband { report: List[byte](), progress: progress, fatal: true }
        } else {
            return Unsupported("HTTP unknown sideband")
        }
    }
    Unsupported("HTTP truncated sideband")
}
