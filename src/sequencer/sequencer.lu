// Original bounded sequencer records; Git 2.56.0 sequencer.adoc and
// git-cherry-pick(1), --allow-empty/--empty. No command execution here.
/// Owned pick record: a lowercase full/prefix SHA-1 and one physical subject line.
pub struct Step { name: str, subject: str }

/// Invalid record/policy, explicit 16-MiB/100,000-row bound, or invalid UTF-8.
pub error SequenceErrors = {invalid, limit, utf8}

/// Parse owned pick records; comments/blank lines are ignored. Reject other
/// operations, NUL/CR, malformed names and bounds without executing anything.
pub fn parse(data: List[byte]) -> List[Step] ! SequenceErrors {
    if data.len > 16777216 { return limit }
    let text = str_from_utf8(data)?
    if text.contains("\0") || text.contains("\r") { return invalid }
    var out = List[Step]()
    for line in text.split("\n") {
        if line == "" || line.starts_with("#") { continue }
        if !line.starts_with("pick ") { return invalid }
        let rest = line[5..]
        let split = rest.find(" ") else rest.len
        let name = rest[0..split]
        if name.len < 4 || name.len > 40 { return invalid }
        for b in name.bytes() {
            if !(b >= 48 as byte && b <= 57 as byte || b >= 97 as byte && b <= 102 as byte) {
                return invalid
            }
        }
        if out.len == 100000 { return limit }
        (mut out).push(Step { name, subject: if split < rest.len then rest[split + 1..] else "" })
    }
    out
}

/// Validate and serialize owned LF-terminated pick lines under the parser bounds.
pub fn render(steps: List[Step]) -> List[byte] ! SequenceErrors {
    if steps.len > 100000 { return limit }
    var out = List[byte]()
    for step in steps {
        if step.subject.contains("\n") || step.subject.contains("\r") { return invalid }
        let line = "pick {step.name} {step.subject}\n"
        if out.len + line.len > 16777216 { return limit }
        for b in line.bytes() { (mut out).push(b) }
    }
    let _ = parse(out)?
    out
}

/// Conservative order-independent checksum of whitespace-normalized lines.
/// A matching net change is only a POSSIBLE patch-equivalence match: callers
/// refuse it, never drop a commit on this checksum. Collisions only refuse more.
/// Inputs above 16 MiB return limit; all intentional arithmetic wraps.
pub fn line_sum(data: List[byte]) -> wrapping[u64] ! {limit} {
    if data.len > 16777216 { return limit }
    var total: wrapping[u64] = 0
    var line: wrapping[u64] = 14695981039346656037
    var start = 0
    for at in 0..data.len {
        let b = data[at]
        if b == 10 as byte {
            total += line
            line = 14695981039346656037
            start = at + 1
        } else if b != 32 as byte && !(b >= 9 as byte && b <= 13 as byte) {
            line = (line ^ (b as wrapping[u64])) * 1099511628211
        }
    }
    if start < data.len { total += line }
    total
}

/// Return keep/drop/stop for an empty result, distinguishing originally empty
/// commits from redundant changes. Unknown policies return invalid, never trap.
pub fn empty_action(originally_empty: bool, allow_empty: bool, policy: str) -> str ! {invalid} {
    if policy != "stop" && policy != "keep" && policy != "drop" { return invalid }
    if policy == "keep" || originally_empty && allow_empty { return "keep" }
    if originally_empty { return "stop" }
    policy
}
