//! member: false

use pack

// The encoder as vc04 wrote it, before den#73 gave it an open-addressing
// table and a rolling fingerprint: pack.encode_delta must give its bytes.
fn ref_number(mut out: List[byte], value: int) {
    var n = value
    while n >= 128 {
        (mut out).push((n & 127 | 128) as byte)
        n = n >> 7
    }
    (mut out).push(n as byte)
}

fn ref_copied(mut out: List[byte], offset: int, length: int) {
    var pos = offset, remaining = length
    while remaining > 0 {
        let n = if remaining > 65536 then 65536 else remaining
        var op = 128
        var fields = List[byte]()
        for i in 0..4 {
            let b = pos >> i * 8 & 255
            if b != 0 { op = op | 1 << i; (mut fields).push(b as byte) }
        }
        if n != 65536 {
            for i in 0..3 {
                let b = n >> i * 8 & 255
                if b != 0 { op = op | 1 << i + 4; (mut fields).push(b as byte) }
            }
        }
        (mut out).push(op as byte)
        for b in fields { (mut out).push(b) }
        pos += n
        remaining -= n
    }
}

fn ref_inserted(mut out: List[byte], data: List[byte], start: int, end: int) {
    var pos = start
    while pos < end {
        let n = if end - pos > 127 then 127 else end - pos
        (mut out).push(n as byte)
        for i in pos..pos + n { (mut out).push(data[i]) }
        pos += n
    }
}

fn ref_fingerprint(data: List[byte], pos: int) -> int {
    var key = 0
    for i in pos..pos + 16 { key = key * 257 + data[i] as int & 0xffffffff }
    key
}

fn ref_delta(before: List[byte], after: List[byte]) -> List[byte] {
    var out = List[byte]()
    ref_number(mut out, before.len)
    ref_number(mut out, after.len)
    var table = Map[int, int]()
    var pos = 0
    while pos + 16 <= before.len {
        let key = ref_fingerprint(before, pos)
        let existing = table[key] else -1
        if existing == -1 { table[key] = pos }
        pos += 16
    }
    pos = 0
    var pending = 0
    while pos + 16 <= after.len {
        let candidate = table[ref_fingerprint(after, pos)] else -1
        var length = 0
        if candidate >= 0 {
            while candidate + length < before.len &&
                pos + length < after.len &&
                before[candidate + length] == after[pos + length] { length += 1 }
        }
        if length >= 16 {
            ref_inserted(mut out, after, pending, pos)
            ref_copied(mut out, candidate, length)
            pos += length
            pending = pos
        } else {
            pos += 1
        }
    }
    ref_inserted(mut out, after, pending, after.len)
    out
}

// Pseudo-random bases (few symbols, so fingerprints repeat and collide) and
// targets made by inserting, deleting and changing runs of them.
fn reference_rows() -> int {
    var seed = 99
    var rows = 0
    for round in 0..60 {
        region one {
            var before = List[byte]()
            let n = match round % 5 {
                0 => 15,
                1 => 16,
                2 => round * 41,
                3 => 1024 + round,
                _ => 3000,
            }
            for _ in 0..n {
                seed = (seed * 1103515245 + 12345) % 2147483648
                (mut before).push((seed / 65536 % (2 + round % 7) * 37) as byte)
            }
            var after = List[byte]()
            var i = 0
            while i < before.len {
                seed = (seed * 1103515245 + 12345) % 2147483648
                let r = seed / 65536 % 100
                if r < 3 {
                    for k in 0..r * 9 + 1 { (mut after).push((k * 11) as byte) }
                } else if r < 5 {
                    i += r * 13
                } else {
                    (mut after).push(before[i])
                    i += 1
                }
            }
            let mine = pack.encode_delta(before, after) else |_| { List[byte]() }
            let theirs = ref_delta(before, after)
            assert(mine.len == theirs.len)
            for k in 0..mine.len { assert(mine[k] == theirs[k]) }
            // Within one byte more, the same bytes; within its own length or
            // less, nothing (it cannot beat that).
            let roomy = pack.encode_delta_within(before, after, theirs.len + 1) else |_| {
                List[byte]()
            }
            assert(roomy.len == theirs.len)
            for k in 0..roomy.len { assert(roomy[k] == theirs[k]) }
            for within in [theirs.len, theirs.len / 2, 1] {
                let tight = pack.encode_delta_within(before, after, within) else |_| { [0 as byte] }
                assert(tight.len == 0)
            }
            let back = pack.apply_delta(before, mine, after.len) else |_| { List[byte]() }
            assert(back.len == after.len)
            for k in 0..after.len { assert(back[k] == after[k]) }
            rows += 1
        }
    }
    rows
}

fn hex_name(prefix: str, value: int) -> str {
    let digits = "0123456789abcdef".bytes()
    var out = prefix.bytes()
    var tail = List[byte]()
    var n = value
    while out.len + tail.len < 40 {
        (mut tail).push(digits[n & 15])
        n = n >> 4
    }
    for i in 0..tail.len { (mut out).push(tail[tail.len - 1 - i]) }
    str_from_utf8(out) else ""
}

// den#73's NameSet: past several growths, with names that share the leading
// 60 bits it hashes (so they probe), each value kept, absent names absent.
fn nameset_rows() -> int {
    var s = pack.nameset()
    var checks = 0
    let kinds = ["commit", "tree", "blob", "tag", "", "other"]
    for i in 0..6000 {
        let name = if i % 3 == 0 {
            hex_name("000000000000000", i)
        } else {
            hex_name("", i * 2654435761 % 4294967296 + i)
        }
        assert(pack.names_add(mut s, name, kinds[i % 6]))
        assert(!pack.names_add(mut s, name, "blob"))
        checks += 2
    }
    assert(pack.names_len(s) == 6000)
    for i in 0..6000 {
        let name = if i % 3 == 0 {
            hex_name("000000000000000", i)
        } else {
            hex_name("", i * 2654435761 % 4294967296 + i)
        }
        assert(pack.names_has(s, name))
        assert(pack.names_value(s, name) == kinds[i % 6])
        assert(!pack.names_has(s, hex_name("fff", i)))
        assert(pack.names_value(s, hex_name("fff", i)) == "")
        checks += 4
    }
    checks + 1
}

fn main() -> int {
    let before = "0123456789abcdef0123456789abcdef".bytes()
    let after = "0123456789abcdef--changed--0123456789abcdef".bytes()
    let encoded = pack.encode_delta(before, after) else |_| { assert(false); return 1 }
    let decoded = pack.apply_delta(before, encoded, after.len) else |_| { assert(false); return 1 }
    assert(decoded.len == after.len)
    for i in 0..after.len { assert(decoded[i] == after[i]) }
    let empty = pack.encode_delta([], []) else |_| { assert(false); return 1 }
    assert(empty.len == 2 && empty[0] == 0 as byte && empty[1] == 0 as byte)
    let literal = pack.encode_delta([], [255 as byte, 0 as byte]) else |_| {
        assert(false)
        return 1
    }
    assert(literal.len == 5 && literal[2] == 2 as byte)
    let restored = pack.apply_delta([], literal, 2) else |_| { assert(false); return 1 }
    assert(restored[0] == 255 as byte && restored[1] == 0 as byte)
    var refused = false
    let _ = pack.apply_delta(before, encoded, after.len - 1) else |_| {
        refused = true
        List[byte]()
    }
    assert(refused)
    let named = nameset_rows()
    print("pack nameset: {named} checks; zero skips")
    let rows = reference_rows()
    assert(rows == 60)
    print(
        "pack writer delta: 5 checks; {rows} reference deltas byte for byte, each within bounds; zero skips",
    )
    0
}
