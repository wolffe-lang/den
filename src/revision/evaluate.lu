// Original evaluator over owned revsyntax; no mutation or index tree writes.
use std.fs
use std.time
use object
use oid
use refs
use repository
use revsyntax

/// Object/ref/IO failures plus exact command diagnostics and named limits.
pub error RevisionErrors = {
    invalid,
    invalid_oid,
    unsupported_format,
    bad_header,
    bad_size,
    bad_oid,
    truncated,
    dictionary,
    checksum,
    limit,
    trailing,
    unsupported_level,
    not_found,
    denied,
    io,
    exists,
    unsupported,
    Unsupported(str),
    ambiguous,
    cross_device,
    invalid_header,
    invalid_tree,
    duplicate_name,
    utf8,
    Fatal(str),
}

/// Owned identity plus chosen reference and current detached provenance.
pub struct Resolved { id: oid.Oid, reference: str, detached: bool }

/// Read-only HEAD origin; unborn is distinct from detached.
pub struct Provenance { reference: str, detached: bool, unborn: bool }

/// Read HEAD without inventing an OID for an unborn symbolic target.
pub fn provenance(repo: repository.Repo) -> Provenance ! RevisionErrors {
    let text = str_from_utf8(repository.read_bytes("{repo.gitdir}/HEAD", 4096)?)?.trim()
    if text.starts_with("ref: ") {
        let target = text[5..]
        if !refs.valid(target) { return invalid_oid }
        return Provenance {
            reference: target,
            detached: false,
            unborn: refs.optional(repo, target)?.len == 0,
        }
    }
    let _ = oid.parse("sha1", text)?
    Provenance { reference: "HEAD", detached: true, unborn: false }
}

fn read_ref(repo: repository.Repo, name: str) -> oid.Oid ! RevisionErrors {
    var parent = repo.gitdir
    let parts = name.split("/")
    for i in 0..parts.len - 1 {
        parent += "/" + parts[i]
        if fs.exists(parent) && !fs.is_dir(parent) { return not_found }
    }
    if fs.is_dir("{repo.gitdir}/{name}") { return not_found }
    if name == "HEAD" || name.starts_with("refs/") { return refs.read(repo, name)? }
    // Full root-level names, including the documented pseudorefs. A multi-line
    // MERGE_HEAD resolves its first record, as the pinned oracle does.
    let text = str_from_utf8(repository.read_bytes("{repo.gitdir}/{name}", 4096)?)?
    let line = text.split("\n")[0].trim()
    if line.starts_with("ref: ") { return refs.read(repo, line[5..])? }
    oid.parse("sha1", line)?
}

fn atom_ref(
    repo: repository.Repo,
    name: str,
    mut warnings: List[str],
) -> Resolved ! RevisionErrors {
    if !refs.valid("refs/{name}") { return not_found }
    var selected = List[oid.Oid](), reference = "", matches = 0
    for candidate in [
        name,
        "refs/{name}",
        "refs/tags/{name}",
        "refs/heads/{name}",
        "refs/remotes/{name}",
        "refs/remotes/{name}/HEAD",
    ] {
        let id = read_ref(repo, candidate) else |e| match e {
            not_found => { continue },
            invalid_oid => { continue },
            _ => { return Unsupported("revision object {e}") },
        }
        matches += 1
        if selected.len == 0 { (mut selected).push(id); reference = candidate }
    }
    if selected.len == 0 { return not_found }
    if matches > 1 && (repo.config["core.warnambiguousrefs"] else "true") != "false" {
        (mut warnings).push("warning: refname '{name}' is ambiguous.")
    }
    let state = provenance(repo)?
    Resolved { id: copy selected[0], reference: reference, detached: state.detached }
}

/// Full candidate enumeration is diagnostic-only. It shares the loose/pack
/// namespace, splitting only ambiguous prefixes, rather than reading objects
/// through another store. Explicit bounds prevent a hostile namespace explosion.
fn candidates(repo: repository.Repo, prefix: str) -> List[oid.Oid] ! RevisionErrors {
    var pending = [prefix], out = List[oid.Oid](), nodes = 0
    while pending.len > 0 {
        let name = (mut pending).pop() else { return invalid }
        nodes += 1
        if nodes > 65536 || out.len > 256 {
            return Unsupported("revision ambiguity candidate limit")
        }
        let id = object.lookup(repo, name) else |e| match e {
            not_found => { continue },
            ambiguous => {
                for digit in "fedcba9876543210".chars() { (mut pending).push(name + digit) }
                continue
            },
            _ => { return Unsupported("revision object {e}") },
        }
        if out.len >= 256 { return Unsupported("revision ambiguity candidate limit") }
        (mut out).push(id)
    }
    out
}

struct Hint { rank: int, full: str, text: str }

fn hint_date(value: List[byte]) -> str ! RevisionErrors {
    let text = str_from_utf8(value)?
    let close = text.rfind(">") else { return invalid_header }
    let parts = text[close + 1..].words()
    if parts.len != 2 { return invalid_header }
    let seconds = parts[0].to_int() else { return invalid_header }
    let zone = parts[1]
    if zone.len != 5 || !zone.starts_with("+") && !zone.starts_with("-") { return invalid_header }
    let hours = zone[1..3].to_int() else { return invalid_header }
    let minutes = zone[3..].to_int() else { return invalid_header }
    if hours < 0 ||
        hours > 23 ||
        minutes < 0 ||
        minutes > 59 ||
        seconds < 0 ||
        seconds > 253401938459 {
        return Unsupported("revision hint date range")
    }
    let local = seconds + (hours * 60 + minutes) * (if zone.starts_with("-") then -60 else 60)
    if local < 0 { return Unsupported("revision hint date range") }
    time.format(time.local_in("UTC", local) else { return invalid_header }, "%Y-%m-%d") else {
        return invalid_header
    }
}

fn ambiguity(repo: repository.Repo, prefix: str, mut warnings: List[str]) -> () ! RevisionErrors {
    (mut warnings).push("error: short object ID {prefix} is ambiguous")
    (mut warnings).push("hint: The candidates are:")
    var hints = List[Hint](), used = 0
    for id in candidates(repo, prefix)? {
        let full = oid.hex(id)?
        var short = full[0..7]
        for n in 7..40 {
            let _ = object.lookup(repo, full[0..n]) else |e| match e {
                ambiguous => { continue },
                _ => { return Unsupported("revision object {e}") },
            }
            short = full[0..n]
            break
        }
        let stored = charged(repo, id, mut used)?
        var suffix = "", rank = 3
        if stored.kind == "commit" || stored.kind == "tag" {
            let parsed = if stored.kind == "commit" {
                object.parse_commit(stored.data, "sha1")?
            } else {
                object.parse_tag(stored.data, "sha1")?
            }
            var date = "", title = ""
            for field in parsed.fields {
                if stored.kind == "commit" && field.key == "author" ||
                    stored.kind == "tag" && field.key == "tagger" {
                    date = hint_date(field.value)?
                }
                if field.key == "tag" { title = str_from_utf8(field.value)? }
            }
            if stored.kind == "commit" { title = str_from_utf8(object.subject(parsed.message)?)? }
            suffix = " {date} - {title}"
            rank = if stored.kind == "commit" then 0 else 1
        } else if stored.kind == "tree" {
            rank = 2
        }
        let hint = Hint { rank: rank, full: full, text: "hint:   {short} {stored.kind}{suffix}" }
        (mut hints).push(copy hint)
        var at = hints.len - 1
        while at > 0 &&
            (hints[at - 1].rank > rank || hints[at - 1].rank == rank && hints[at - 1].full > full) {
            hints[at] = copy hints[at - 1]
            at -= 1
        }
        hints[at] = hint
    }
    for hint in hints { (mut warnings).push(hint.text) }
}

fn base(
    repo: repository.Repo,
    name: str,
    preference: str,
    mut warnings: List[str],
) -> Resolved ! RevisionErrors {
    let prefix = oid.prefix("sha1", name) else ""
    if prefix.len == 40 {
        return Resolved {
            id: oid.parse("sha1", prefix)?,
            reference: "",
            detached: provenance(repo)?.detached,
        }
    }
    let reference = atom_ref(repo, name, mut warnings) else |e| match e {
        not_found => {
            if prefix == "" { return not_found }
            let id = object.lookup(repo, prefix) else |failure| match failure {
                ambiguous => {
                    if preference != "" && preference != "object" && preference != "peel" {
                        var matching = List[oid.Oid](), used = 0
                        for candidate in candidates(repo, prefix)? {
                            let _ = peel_budget(
                                repo,
                                candidate,
                                preference,
                                mut used,
                            ) else |e| match e {
                                not_found => { continue },
                                _ => { return Unsupported("revision candidate type {e}") },
                            }
                            (mut matching).push(copy candidate)
                        }
                        if matching.len == 1 {
                            return Resolved {
                                id: copy matching[0],
                                reference: "",
                                detached: provenance(repo)?.detached,
                            }
                        }
                    }
                    ambiguity(repo, prefix, mut warnings)?
                    return ambiguous
                },
                not_found => { return not_found },
                _ => { return Unsupported("revision object {failure}") },
            }
            return Resolved { id: id, reference: "", detached: provenance(repo)?.detached }
        },
        _ => { return Unsupported("revision object {e}") },
    }
    reference
}

fn previous(repo: repository.Repo, selector: str) -> str ! RevisionErrors {
    let wanted = selector[1..].to_int() else { return invalid }
    if wanted <= 0 || wanted > 10000 { return invalid }
    let data = str_from_utf8(repository.read_bytes("{repo.gitdir}/logs/HEAD", 16777216)?)?
    let lines = data.split("\n")
    if lines.len > 100001 { return limit }
    var count = 0
    for i in 0..lines.len {
        let line = lines[lines.len - i - 1]
        let tab = line.find("\tcheckout: moving from ") else { continue }
        let message = line[tab + 23..]
        let end = message.find(" to ") else { return invalid }
        count += 1
        if count == wanted { return message[0..end] }
    }
    not_found
}

/// Preserve the previous checkout's branch spelling for branch-taking edges;
/// other expressions are returned unchanged and remain single-object inputs.
pub fn checkout_name(repo: repository.Repo, name: str) -> str ! RevisionErrors {
    let expression = revsyntax.parse(name) else { return name }
    if expression.kind == "single" &&
        expression.left.base == "" &&
        expression.left.selector.starts_with("-") &&
        expression.left.steps.len == 0 &&
        !expression.left.has_path {
        return previous(repo, expression.left.selector)?
    }
    name
}

fn reflog(
    repo: repository.Repo,
    value: revsyntax.Atom,
    mut warnings: List[str],
) -> Resolved ! RevisionErrors {
    let selector = value.selector
    if selector == "upstream" || selector == "u" {
        return Unsupported("revision upstream tracking")
    }
    if selector == "push" { return Unsupported("revision push tracking") }
    if selector.starts_with("-") {
        return base(repo, previous(repo, selector)?, "", mut warnings)?
    }
    let name = if value.base == "" then provenance(repo)?.reference else value.base
    let reference = atom_ref(repo, name, mut warnings)?
    let logname = if value.base == "HEAD" then "HEAD" else reference.reference
    let data = str_from_utf8(repository.read_bytes("{repo.gitdir}/logs/{logname}", 16777216)?)?
    let lines = data.split("\n")
    if lines.len > 100001 { return limit }
    var records = List[str]()
    for line in lines { if line != "" { (mut records).push(line) } }
    let count = selector.to_int() else { return invalid }
    if count < 0 || count > 10000 { return invalid }
    if count >= records.len { return Fatal("log for '{name}' only has {records.len} entries") }
    let line = records[records.len - count - 1]
    if line.len < 82 || line.bytes()[40] != 32 as byte || line.bytes()[81] != 32 as byte {
        return invalid
    }
    Resolved {
        id: oid.parse("sha1", line[41..81])?,
        reference: reference.reference,
        detached: reference.detached,
    }
}

fn charged(repo: repository.Repo, id: oid.Oid, mut used: int) -> object.Object ! RevisionErrors {
    let stored = object.read_object(repo, id, 16777216)?
    used += stored.data.len
    if used > 134217728 { return Unsupported("revision object payload limit") }
    stored
}

fn commit_ids(
    repo: repository.Repo,
    id: oid.Oid,
    key: str,
    mut used: int,
) -> List[oid.Oid] ! RevisionErrors {
    let stored = charged(repo, id, mut used)?
    if stored.kind != "commit" { return invalid_header }
    var out = List[oid.Oid]()
    for field in object.parse_commit(stored.data, "sha1")?.fields {
        if field.key == key { (mut out).push(oid.parse("sha1", str_from_utf8(field.value)?)?) }
    }
    out
}

/// Peel only the documented types, checking raw tag and commit headers.
pub fn peel(repo: repository.Repo, id: oid.Oid, kind: str) -> oid.Oid ! RevisionErrors {
    var used = 0
    peel_budget(repo, id, kind, mut used)?
}

fn peel_budget(
    repo: repository.Repo,
    id: oid.Oid,
    kind: str,
    mut used: int,
) -> oid.Oid ! RevisionErrors {
    var current = copy id
    for _ in 0..64 {
        let value = charged(repo, current, mut used)?
        if kind == "object" || value.kind == kind || kind == "peel" && value.kind != "tag" {
            return current
        }
        if value.kind == "tag" {
            let parsed = object.parse_tag(value.data, "sha1")?
            for field in parsed.fields {
                if field.key == "object" {
                    current = oid.parse("sha1", str_from_utf8(field.value)?)?
                    break
                }
            }
        } else if value.kind == "commit" && kind == "tree" {
            let trees = commit_ids(repo, current, "tree", mut used)?
            if trees.len != 1 { return invalid_header }
            return copy trees[0]
        } else {
            return not_found
        }
    }
    Unsupported("revision tag depth limit")
}

/// Resolve an owned atom; diagnostics are returned to the caller, never printed.
pub fn evaluate(
    repo: repository.Repo,
    value: revsyntax.Atom,
    mut warnings: List[str],
) -> Resolved ! RevisionErrors {
    evaluate_typed(repo, value, "", mut warnings)?
}

/// Apply a consumer's object-kind preference only when a prefix is ambiguous;
/// retain the original tag identity after disambiguating a commit-ish candidate.
pub fn evaluate_typed(
    repo: repository.Repo,
    value: revsyntax.Atom,
    preference: str,
    mut warnings: List[str],
) -> Resolved ! RevisionErrors {
    if preference != "" &&
        preference != "commit" &&
        preference != "tree" &&
        preference != "tag" &&
        preference != "blob" &&
        preference != "object" &&
        preference != "peel" {
        return invalid
    }
    if value.source.len > 4096 ||
        value.base.len > 4096 ||
        value.selector.len > 4096 ||
        value.path.len > 4096 ||
        value.steps.len > 256 {
        return limit
    }
    for step in value.steps {
        if step.count < 0 ||
            step.count > 10000 ||
            step.kind != "^" && step.kind != "~" && step.count != 0 {
            return invalid
        }
        if step.kind != "^" &&
            step.kind != "~" &&
            step.kind != "commit" &&
            step.kind != "tree" &&
            step.kind != "tag" &&
            step.kind != "object" &&
            step.kind != "peel" {
            return invalid
        }
    }
    if !value.has_path && value.path.len != 0 { return invalid }
    var wanted = preference
    if value.steps.len > 0 {
        wanted = value.steps[0].kind
        if wanted == "^" || wanted == "~" { wanted = "commit" }
    } else if value.has_path {
        wanted = "tree"
    }
    var result = if value.selector != "" {
        reflog(repo, value, mut warnings)?
    } else {
        base(repo, value.base, wanted, mut warnings)?
    }
    var steps = 0, used = 0
    for step in value.steps {
        if step.kind == "^" || step.kind == "~" {
            result.id = peel_budget(repo, result.id, "commit", mut used)?
            let count = if step.kind == "^" && step.count != 0 then 1 else step.count
            steps += count
            if steps > 10000 { return Unsupported("revision ancestry step limit") }
            for _ in 0..count {
                let parents = commit_ids(repo, result.id, "parent", mut used)?
                let parent = if step.kind == "~" then 1 else step.count
                if parent > parents.len { return not_found }
                result.id = copy parents[parent - 1]
            }
        } else {
            result.id = peel_budget(repo, result.id, step.kind, mut used) else |e| match e {
                not_found => {
                    let terminal = peel_budget(repo, result.id, "peel", mut used)?
                    let stored = charged(repo, terminal, mut used)?
                    let actual = if stored.kind == "commit" then "tree" else stored.kind
                    (mut warnings).push(
                        "error: {value.source}: expected {step.kind} type, but the object dereferences to {actual} type",
                    )
                    return not_found
                },
                _ => { return Unsupported("revision peel {e}") },
            }
        }
    }
    if value.has_path {
        result.id = peel_budget(repo, result.id, "tree", mut used)?
        var start = 0, components = 0
        for at in 0..=value.path.len {
            if at != value.path.len && value.path[at] != 47 as byte { continue }
            if value.path.len == 0 { break }
            components += 1
            if components > 256 { return limit }
            var part = List[byte]()
            for i in start..at { (mut part).push(value.path[i]) }
            if part.len == 0 ||
                part.len == 1 && part[0] == 46 as byte ||
                part.len == 2 && part[0] == 46 as byte && part[1] == 46 as byte {
                return Unsupported("revision relative object path")
            }
            let tree = charged(repo, result.id, mut used)?
            var found = false
            if tree.kind == "tree" {
                for entry in object.parse_tree(tree.data, "sha1")? {
                    if entry.name.len != part.len { continue }
                    var equal = true
                    for i in 0..part.len { if entry.name[i] != part[i] { equal = false } }
                    if equal {
                        result.id = copy entry.id
                        found = true
                        break
                    }
                }
            }
            if !found {
                let path = str_from_utf8(value.path) else {
                    return Unsupported("revision missing non-UTF-8 path diagnostic")
                }
                return Fatal("path '{path}' does not exist in '{value.source}'")
            }
            start = at + 1
        }
    }
    result
}

/// Shared command-edge unknown/ambiguous argument diagnostic, without fatal prefix.
pub fn unknown(name: str) -> str {
    "ambiguous argument '{name}': unknown revision or path not in the working tree.\nUse '--' to separate paths from revisions, like this:\n'git <command> [<revision>...] -- [<file>...]'"
}

/// Command adapter; the non-printing evaluator above is the importing API.
pub fn resolve(repo: repository.Repo, name: str) -> oid.Oid ! RevisionErrors {
    resolve_typed(repo, name, "")?
}

/// Resolve a single object with a command's prefix-kind preference.
pub fn resolve_typed(
    repo: repository.Repo,
    name: str,
    preference: str,
) -> oid.Oid ! RevisionErrors {
    let expression = revsyntax.parse(name) else |e| match e {
        Unsupported(feature) => { return Unsupported(feature) },
        limit => { return Unsupported("revision parser limit") },
        _ => { return Fatal(unknown(name)) },
    }
    if expression.kind != "single" { return Unsupported("revision set in single-object consumer") }
    resolve_atom_typed(repo, expression.left, name, preference)?
}

/// Command adapter for an already parsed atom; preserves pending warnings on error.
pub fn resolve_atom(
    repo: repository.Repo,
    value: revsyntax.Atom,
    name: str,
) -> oid.Oid ! RevisionErrors {
    resolve_atom_typed(repo, value, name, "")?
}

/// Command adapter retaining a consumer's prefix-kind preference.
pub fn resolve_atom_typed(
    repo: repository.Repo,
    value: revsyntax.Atom,
    name: str,
    preference: str,
) -> oid.Oid ! RevisionErrors {
    var warnings = List[str]()
    let result = evaluate_typed(repo, value, preference, mut warnings) else |e| {
        for line in warnings {
            eprint(line)
            // Porcelain's revision/path probes report this type error twice.
            if line.starts_with("error: ") && line.contains(": expected ") { eprint(line) }
        }
        match e {
            not_found => { return Fatal(unknown(name)) },
            ambiguous => { return Fatal(unknown(name)) },
            invalid_oid => { return Fatal(unknown(name)) },
            Fatal(message) => { return Fatal(message) },
            Unsupported(feature) => { return Unsupported(feature) },
            _ => { return Unsupported("revision object {e}") },
        }
    }
    for line in warnings { eprint(line) }
    result.id
}
