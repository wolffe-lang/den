//! member: false

// RFC 3986 authority and RFC 9112 message framing; independently written cases.
use http

fn url_refused(url: str, expected: str) {
    let _ = http.endpoint(url) else |e| {
        assert("{e}" == expected, "http-url-refusal")
        return
    }
    assert(false, "http-url-accepted-invalid")
}

fn head_refused(text: str, expected: str) {
    let _ = http.head(text.bytes(), 1024) else |e| {
        assert("{e}" == expected, "http-head-refusal")
        return
    }
    assert(false, "http-head-accepted-invalid")
}

fn checks() -> () ! http.Errors {
    let a = http.endpoint("https://Example.COM:443/project.git///")?
    assert(a.scheme == "https" && a.host == "example.com" && a.port == 443)
    assert(a.authority == "example.com:443" && a.path == "/project.git")
    let b = http.endpoint("http://127.0.0.1:19348/a%20b.git")?
    assert(b.port == 19348 && b.path == "/a%20b.git")
    assert(http.endpoint("https://example.com")?.path == "")
    url_refused("http://example.com/a", "Unsupported(HTTP requires literal loopback)")
    url_refused("http://localhost/a", "Unsupported(HTTP requires literal loopback)")
    url_refused("https://user:secret@example.com/a", "Unsupported(HTTP URL userinfo)")
    url_refused("https://example.com/a?secret=x", "Unsupported(HTTP repository query)")
    url_refused("https://example.com/a#frag", "Unsupported(HTTP URL fragment)")
    url_refused("https://example.com:0/a", "invalid")
    url_refused("https://example.com:65536/a", "invalid")
    url_refused("https://example.com:+80/a", "invalid")
    url_refused("https://example.com/a%0d%0a", "invalid")
    url_refused("https://example.com/a%zz", "invalid")
    url_refused("https://example.com/a b", "invalid")
    url_refused("https://example.com/a\r\nX: y", "invalid")
    print("PASS http-url")

    let h = http.head(
        "HTTP/1.1 200 OK\r\ncOnTeNt-LeNgTh: 3\r\nContent-Type: application/x-git-upload-pack-result\r\n\r\n".
            bytes(),
        1024,
    )?
    assert(h.status == 200 && h.length == 3 && !h.chunked && !h.close)
    assert(h.content_type == "application/x-git-upload-pack-result")
    let c = http.head(
        "HTTP/1.1 200 \r\nTransfer-Encoding: chunked\r\nConnection: keep-alive, close\r\n\r\n".
            bytes(),
        1024,
    )?
    assert(c.chunked && c.close && c.length == -1)
    assert(http.head("HTTP/1.0 200 OK\r\nContent-Length: 0\r\n\r\n".bytes(), 1024)?.close)
    assert(
        !http.head(
            "HTTP/1.0 200 OK\r\nContent-Length: 0\r\nConnection: keep-alive\r\n\r\n".bytes(),
            1024,
        )?.close,
    )
    assert(http.head("HTTP/1.1 204 No Content\r\n\r\n".bytes(), 1024)?.length == 0)
    assert(
        http.head(
            "HTTP/1.1 200 OK\r\nContent-Length: 3, 3\r\nContent-Length: 3\r\n\r\n".bytes(),
            1024,
        )?.length ==
            3,
    )
    assert(http.head("HTTP/1.1 200 OK\r\n\r\n".bytes(), 1024)?.close)
    head_refused("HTTP/1.1 200 OK\r\n", "truncated")
    head_refused(
        "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n",
        "Unsupported(HTTP conflicting Content-Length)",
    )
    head_refused("HTTP/1.1 200 OK\r\nContent-Length: +1\r\n\r\n", "invalid")
    head_refused("HTTP/1.1 200 OK\r\nContent-Length: 1025\r\n\r\n", "limit")
    head_refused("HTTP/1.1 200 OK\r\nContent-Length: 99999999999999999999\r\n\r\n", "limit")
    head_refused(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 1\r\n\r\n",
        "Unsupported(HTTP ambiguous framing)",
    )
    head_refused(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
        "Unsupported(HTTP transfer coding)",
    )
    head_refused(
        "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\n\r\n",
        "Unsupported(HTTP content encoding)",
    )
    head_refused("HTTP/1.1 200 OK\r\nContent-Length : 3\r\n\r\n", "invalid")
    head_refused("HTTP/1.1 101 Switching Protocols\r\n\r\n", "Unsupported(HTTP protocol upgrade)")
    print("PASS http-head")

    assert(http.chunk_size("a", 20)? == 10)
    assert(http.chunk_size("A; ignored=\"a;b\"", 20)? == 10)
    assert(http.chunk_size("0000", 20)? == 0)
    for bad in ["", "-1", "+1", "0x1", "1g", "1;", "1; a=\"unterminated"] {
        var refused = false
        let _ = http.chunk_size(bad, 1024) else |_| { refused = true; 0 }
        assert(refused, "http-chunk-invalid")
    }
    var limited = false
    let _ = http.chunk_size("FFFFFFFFFFFFFFFFFFFFFFFF", 1024) else |e| {
        assert("{e}" == "limit")
        limited = true
        0
    }
    assert(limited)
    print("PASS http-chunk-size")
}

fn main() -> int {
    checks() else |e| { eprint("FAIL http-pure: {e}"); return 1 }
    0
}
