use delta
use diffbinary
use difftext
use object
use oid
use worktree

fn data(files: List[File]) -> List[byte] { if files.len == 0 { return [] }; copy files[0].data }

fn size(files: List[File]) -> int { if files.len == 0 { return 0 }; files[0].data.len }

fn unchanged(change: Change) -> bool {
    change.before.len == 1 &&
        change.after.len == 1 &&
        oid.equal(change.before[0].id, change.after[0].id)
}

fn quoted(value: List[byte], options: Options) -> List[byte] {
    worktree.quote(value, options.quote_path, false)
}

fn prefixed(prefix: str, value: List[byte]) -> List[byte] {
    var out = owned(prefix.bytes())
    add(mut out, value)
    out
}

fn abbreviation(
    ctx: worktree.Context,
    files: List[File],
    options: Options,
) -> str ! worktree.WorkErrors {
    abbreviated(
        ctx,
        files,
        if options.full_index || options.binary_patch then 40 else options.abbreviate,
    )?
}

fn abbreviated(ctx: worktree.Context, files: List[File], width: int) -> str ! worktree.WorkErrors {
    if files.len == 0 { return "0000000000000000000000000000000000000000"[0..width] }
    let full = oid.hex(files[0].id)?
    var n = width
    while n < 40 {
        object.lookup(ctx.repo, full[0..n]) else |e| match e {
            ambiguous => { n += 1; continue },
            _ => { break },
        }
        break
    }
    full[0..n]
}

fn header_name(mut out: List[byte], marker: str, prefix: str, files: List[File], options: Options) {
    add(mut out, marker.bytes())
    if files.len == 0 { add(mut out, "/dev/null\n".bytes()); return }
    let path = prefixed(prefix, files[0].path)
    let display = quoted(path, options)
    add(mut out, display)
    var space = false
    for b in path { if b == 32 as byte { space = true } }
    if space && display.len > 0 && display[0] != 34 as byte { (mut out).push(9 as byte) }
    (mut out).push(10 as byte)
}

// The explicit text option wins over attributes. Named drivers not handled
// by the patch consumer have already refused; unconfigured names use auto.
fn binary_policy(driver: str, options: Options, detected: bool) -> bool {
    if options.text { return false }
    if driver == "-" { return true }
    if driver == "+" { return false }
    detected
}

fn diff_binary(change: Change, driver: str, options: Options) -> bool {
    binary_policy(
        if regular_change(change) then driver else "",
        options,
        change.before.len > 0 && delta.binary(change.before[0].data) ||
            change.after.len > 0 && delta.binary(change.after[0].data),
    )
}

fn patch_one(
    mut out: List[byte],
    ctx: worktree.Context,
    change: Change,
    options: Options,
    driver: str,
) -> () ! worktree.WorkErrors {
    let old_path = if change.before.len > 0 {
        copy change.before[0].path
    } else {
        copy change.after[0].path
    }
    let new_path = if change.after.len > 0 {
        copy change.after[0].path
    } else {
        copy change.before[0].path
    }
    add(mut out, "diff --git ".bytes())
    add(mut out, quoted(prefixed(if options.reverse then "b/" else "a/", old_path), options))
    (mut out).push(32 as byte)
    add(mut out, quoted(prefixed(if options.reverse then "a/" else "b/", new_path), options))
    (mut out).push(10 as byte)
    if change.before.len == 0 {
        add(mut out, "new file mode {object.mode_text(change.after[0].mode)?}\n".bytes())
    } else if change.after.len == 0 {
        add(mut out, "deleted file mode {object.mode_text(change.before[0].mode)?}\n".bytes())
    } else if change.before[0].mode != change.after[0].mode {
        add(
            mut out,
            "old mode {object.mode_text(change.before[0].mode)?}\nnew mode {object.mode_text(change.after[0].mode)?}\n".
                bytes(),
        )
    }
    if change.status == "R" || change.status == "C" {
        let verb = if change.status == "R" then "rename" else "copy"
        add(mut out, "similarity index {change.percent}%\n{verb} from ".bytes())
        add(mut out, quoted(old_path, options))
        add(mut out, "\n{verb} to ".bytes())
        add(mut out, quoted(new_path, options))
        (mut out).push(10 as byte)
    }
    // A gitlink whose commit is unchanged but whose worktree is dirty prints
    // its `-dirty` hunk with no index line (vc25 probe 1, diff-modified).
    let dirty_only = unchanged(change) && compare(data(change.before), data(change.after)) != 0
    if unchanged(change) && !dirty_only { return }
    let binary = diff_binary(change, driver, options)
    // --binary implies the full index only for a file it renders as a binary
    // patch; a text hunk keeps the abbreviated ids, as the pinned Git prints.
    let width = if options.full_index || options.binary_patch && binary {
        40
    } else {
        options.abbreviate
    }
    if !dirty_only {
        add(
            mut out,
            "index {abbreviated(ctx,change.before,width)?}..{abbreviated(ctx,change.after,width)?}".
                bytes(),
        )
        if change.before.len > 0 &&
            change.after.len > 0 &&
            change.before[0].mode == change.after[0].mode {
            add(mut out, " {object.mode_text(change.before[0].mode)?}".bytes())
        }
        (mut out).push(10 as byte)
    }
    if binary {
        if options.binary_patch {
            add(mut out, diffbinary.patch(data(change.before), data(change.after))?)
            return
        }
        add(mut out, "Binary files ".bytes())
        add(
            mut out,
            if change.before.len == 0 {
                owned("/dev/null".bytes())
            } else {
                quoted(prefixed(if options.reverse then "b/" else "a/", old_path), options)
            },
        )
        add(mut out, " and ".bytes())
        add(
            mut out,
            if change.after.len == 0 {
                owned("/dev/null".bytes())
            } else {
                quoted(prefixed(if options.reverse then "a/" else "b/", new_path), options)
            },
        )
        add(mut out, " differ\n".bytes())
        return
    }
    // The script's own budget is named as the stat's bound is: a patch's
    // line diff stops past 2,000 differing lines, where Git's continues.
    let body = change_hunks(change, options) else |e| match e {
        limit => {
            return Fatal("limit: a file whose line diff passes 2000 differing lines in a patch")
        },
        invalid => { return invalid },
    }
    if body.len > 0 {
        header_name(mut out, "--- ", if options.reverse then "b/" else "a/", change.before, options)
        header_name(mut out, "+++ ", if options.reverse then "a/" else "b/", change.after, options)
        add(mut out, body)
    }
}

/// A change's hunks, each side's body read where the change holds it: a copy
/// of each kept the pair twice while the change rendered (den#145).
fn change_hunks(change: Change, options: Options) -> List[byte] ! difftext.DeltaErrors {
    let has_old = change.before.len > 0, has_new = change.after.len > 0
    if has_old && has_new {
        return difftext.hunks(
            change.before[0].data,
            change.after[0].data,
            options.context,
            options.indent,
        )?
    }
    if has_old {
        return difftext.hunks(change.before[0].data, List[byte](), options.context, options.indent)?
    }
    if has_new {
        return difftext.hunks(List[byte](), change.after[0].data, options.context, options.indent)?
    }
    difftext.hunks(List[byte](), List[byte](), options.context, options.indent)?
}

fn name_record(mut out: List[byte], change: Change, options: Options) {
    let sep = if options.nul then 0 as byte else 9 as byte
    if options.name_status {
        add(mut out, change.status.bytes())
        if change.status == "R" || change.status == "C" {
            if change.percent < 100 { (mut out).push(48 as byte) }
            if change.percent < 10 { (mut out).push(48 as byte) }
            add(mut out, "{change.percent}".bytes())
        }
        (mut out).push(sep)
        if change.status == "R" || change.status == "C" {
            add(
                mut out,
                if options.nul {
                    copy change.before[0].path
                } else {
                    quoted(change.before[0].path, options)
                },
            )
            (mut out).push(sep)
        }
    }
    let value = if options.name_status &&
        change.status == "M" &&
        change.before.len == 1 &&
        change.after.len == 1 {
        copy change.before[0].path
    } else {
        path(change)
    }
    add(mut out, if options.nul then owned(value) else quoted(value, options))
    (mut out).push(if options.nul then 0 as byte else 10 as byte)
}

fn validate_side(files: List[File]) -> () ! worktree.WorkErrors {
    for file in files {
        if file.path.len == 0 { return invalid }
        for b in file.path { if b == 0 as byte { return invalid } }
        if file.data.len > 1000000000 {
            return Fatal("limit: a file larger than 1000000000 bytes in a diff")
        }
        if file.mode != 0o100644 &&
            file.mode != 0o100755 &&
            file.mode != 0o120000 &&
            file.mode != 0o160000 {
            return invalid
        }
        oid.validate(file.id)?
    }
}

fn validate_change(change: Change) -> () ! worktree.WorkErrors {
    if change.before.len > 1 || change.after.len > 1 || change.before.len + change.after.len == 0 {
        return invalid
    }
    match change.status {
        "A" => { if change.before.len != 0 || change.after.len != 1 { return invalid } },
        "D" => { if change.before.len != 1 || change.after.len != 0 { return invalid } },
        "M" | "T" | "R" | "C" => {
            if change.before.len != 1 || change.after.len != 1 { return invalid }
        },
        _ => { return invalid },
    }
    if change.percent < 0 || change.percent > 100 { return invalid }
    validate_side(change.before)?
    validate_side(change.after)?
}

/// Render all requested display modes in Git order; never publishes objects.
pub fn render(
    ctx: worktree.Context,
    changes: List[Change],
    options: Options,
) -> List[byte] ! worktree.WorkErrors {
    render_known(ctx, changes, options, List[List[str]]())?
}

/// render with the changes' diff drivers the caller's collect already
/// resolved (known holds at most one list); with none, it resolves them
/// itself, reading the index.
pub fn render_known(
    ctx: worktree.Context,
    changes: List[Change],
    options: Options,
    known: List[List[str]],
) -> List[byte] ! worktree.WorkErrors {
    if options.context < 0 ||
        options.context > 200000 ||
        options.abbreviate < 4 ||
        options.abbreviate > 40 {
        return invalid
    }
    for change in changes { validate_change(change)? }
    var out = List[byte]()
    if options.quiet { return out }
    if options.names || options.name_status {
        for change in changes { name_record(mut out, change, options) }
        return out
    }
    let policies = if options.patch || options.stat || options.numstat || options.shortstat {
        if known.len > 0 {
            copy known[0]
        } else if changes.len == 0 {
            List[str]()
        } else {
            diff_policies(ctx, changes, options.patch, worktree.read_index(ctx)?)?
        }
    } else {
        List[str]()
    }
    if options.stat || options.numstat || options.shortstat {
        render_stats(mut out, changes, options, policies)?
    }
    if options.patch {
        if changes.len > 0 && (options.stat || options.numstat || options.shortstat) {
            (mut out).push(10 as byte)
        }
        var at = 0
        // A diagnostic built in a scratch region below is copied out of it (raised:
        // 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
        // is freed.
        var error_payload = "", raised = 0
        for change in changes {
            let driver = policies[at]
            at += 1
            region patch_scratch {
                if options.submodule != "short" && gitlink_change(change) {
                    submodule_patch(mut out, ctx, change, options, driver) else |e| match e {
                        invalid_index => { return invalid_index },
                        unmerged => { return unmerged },
                        invalid_tree => { return invalid_tree },
                        duplicate_name => { return duplicate_name },
                        invalid => { return invalid },
                        invalid_oid => { return invalid_oid },
                        unsupported_format => { return unsupported_format },
                        bad_header => { return bad_header },
                        bad_size => { return bad_size },
                        bad_oid => { return bad_oid },
                        truncated => { return truncated },
                        dictionary => { return dictionary },
                        checksum => { return checksum },
                        limit => { return limit },
                        trailing => { return trailing },
                        unsupported_level => { return unsupported_level },
                        not_found => { return not_found },
                        denied => { return denied },
                        io => { return io },
                        exists => { return exists },
                        unsupported => { return unsupported },
                        Unsupported(message) => {
                            error_payload = copy message
                            raised = 1
                            break
                        },
                        ambiguous => { return ambiguous },
                        cross_device => { return cross_device },
                        invalid_header => { return invalid_header },
                        utf8 => { return utf8 },
                        Pathspec(message) => {
                            error_payload = copy message
                            raised = 2
                            break
                        },
                        Fatal(message) => {
                            error_payload = copy message
                            raised = 3
                            break
                        },
                        Failure(message) => {
                            error_payload = copy message
                            raised = 4
                            break
                        },
                    }
                } else if change.status == "T" {
                    patch_one(
                        mut out,
                        ctx,
                        Change { before: copy change.before, after: [], status: "D", percent: 0 },
                        options,
                        driver,
                    )?
                    patch_one(
                        mut out,
                        ctx,
                        Change { before: [], after: copy change.after, status: "A", percent: 0 },
                        options,
                        driver,
                    )?
                } else {
                    patch_one(mut out, ctx, change, options, driver)?
                }
            }
        }
        if raised == 1 { return Unsupported(error_payload) }
        if raised == 2 { return Pathspec(error_payload) }
        if raised == 3 { return Fatal(error_payload) }
        if raised == 4 { return Failure(error_payload) }
    }
    out
}

fn gitlink_change(change: Change) -> bool {
    change.before.len > 0 && change.before[0].mode == 0o160000 ||
        change.after.len > 0 && change.after[0].mode == 0o160000
}

fn side_ids(files: List[File]) -> List[oid.Oid] {
    if files.len == 0 || files[0].mode != 0o160000 { return [] }
    [copy files[0].id]
}

// --submodule=log|diff for one change touching a gitlink (vc25). A
// typechange prints the gitlink side's summary and the file side's patch.
fn submodule_patch(
    mut out: List[byte],
    ctx: worktree.Context,
    change: Change,
    options: Options,
    driver: str,
) -> () ! worktree.WorkErrors {
    let path = if change.after.len > 0 {
        copy change.after[0].path
    } else {
        copy change.before[0].path
    }
    if change.status == "T" {
        if change.before[0].mode == 0o160000 {
            add(mut out, summary(ctx, path, side_ids(change.before), [], false)?)
            patch_one(
                mut out,
                ctx,
                Change { before: [], after: copy change.after, status: "A", percent: 0 },
                options,
                driver,
            )?
        } else {
            patch_one(
                mut out,
                ctx,
                Change { before: copy change.before, after: [], status: "D", percent: 0 },
                options,
                driver,
            )?
            add(mut out, summary(ctx, path, [], side_ids(change.after), false)?)
        }
        return
    }
    let dirty = dirty_side(change.after)
    let lines = summary(ctx, path, side_ids(change.before), side_ids(change.after), dirty)?
    if options.submodule == "log" {
        add(mut out, lines)
        return
    }
    // diff: the summary's header (its commit lines dropped), then the
    // submodule's own patch with paths under the gitlink.
    let text = str_from_utf8(lines) else ""
    for line in text.split("\n") {
        if line == "" || line.starts_with("  ") { continue }
        add(mut out, "{line}\n".bytes())
    }
    add(mut out, inner(ctx, path, side_ids(change.before), side_ids(change.after), dirty, options)?)
}
