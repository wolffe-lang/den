// git-config(1), diff.autoRefreshIndex: porcelain silently refreshes matching
// stat-only entries. This is not a content/index staging operation.
use index
use oid
use worktree

fn fresh_stat(file: worktree.FileState, prior: index.Entry) -> index.Entry ! worktree.WorkErrors {
    var fresh = if file.kind == 3 {
        index.entry_from_lstat(file.stat, prior.path, prior.id, prior.flags, prior.extended)?
    } else {
        index.entry_from_stat(
            file.stat,
            prior.path,
            prior.id,
            if file.mode == 0o120000 then 0o100644 else file.mode,
            prior.flags,
            prior.extended,
        )?
    }
    fresh.stat[6] = prior.stat[6]
    fresh
}

fn stat_differs(a: index.Entry, b: index.Entry) -> bool {
    for i in 0..10 { if a.stat[i] != b.stat[i] { return true } }
    false
}

/// Whether the locked index's entry is the one collect compared (path, id,
/// flags and all ten stat words), so collect's hash of it still answers.
fn same_entry(a: index.Entry, b: index.Entry) -> bool {
    compare(a.path, b.path) == 0 &&
        oid.equal(a.id, b.id) &&
        a.flags == b.flags &&
        a.extended == b.extended &&
        a.stat.len == 10 &&
        b.stat.len == 10 &&
        !stat_differs(a, b) &&
        a.stat[6] == b.stat[6]
}

/// An entry's worktree state as refresh reads it, for an entry collect did not
/// hash; an error for one refresh leaves alone: absent, a directory, or
/// stat-clean (its stat words are the entry's, so nothing would change).
fn current(
    ctx: worktree.Context,
    prior: index.Entry,
    written: List[int],
    filemode: bool,
    symlinks: bool,
    text_check: bool,
    mut verified: List[List[byte]],
) -> worktree.FileState ! worktree.WorkErrors {
    let seen = worktree.tracked(ctx, prior, written, filemode, symlinks, text_check, mut verified)?
    if seen.clean || !seen.present { return not_found }
    seen.state
}

/// prior's worktree state: collect's hash when hashed[k] is the entry collect
/// compared, else current's answer.
fn state_of(
    ctx: worktree.Context,
    prior: index.Entry,
    hashed: List[Hashed],
    k: int,
    written: List[int],
    filemode: bool,
    symlinks: bool,
    text_check: bool,
    mut verified: List[List[byte]],
) -> worktree.FileState ! worktree.WorkErrors {
    if k < hashed.len && same_entry(hashed[k].entry, prior) { return copy hashed[k].state }
    current(ctx, prior, written, filemode, symlinks, text_check, mut verified)?
}

/// refresh's answer without reading a file twice (den#101). An entry collect
/// hashed answers from that hash; an entry collect did not hash (it was
/// stat-clean, or outside the pathspec) answers as refresh does, by reading
/// it, unless its lstat is stat-clean, when refresh would find its stat
/// unchanged and leave it.
fn refresh_known(
    ctx: worktree.Context,
    options: Options,
    hashed: List[Hashed],
) -> () ! worktree.WorkErrors {
    if options.cached ||
        options.revisions.len == 2 ||
        !worktree.config_bool(ctx, "diff.autorefreshindex", true)? {
        return
    }
    let specs = pathspecs(ctx, options.paths)?
    // A foreign lock silently suppresses refresh and is never removed.
    var tx = index.begin(ctx.repo, 1000000000, 0)?
    defer index.abort(mut tx)
    let written = worktree.index_written(ctx)
    let filemode = worktree.config_bool(ctx, "core.filemode", true)?
    let symlinks = worktree.config_bool(ctx, "core.symlinks", true)?
    var verified = List[List[byte]]()
    var directories = worktree.directory_modes()
    var triggered = false
    var k = 0
    for at in 0..tx.value.entries.len {
        let prior = copy tx.value.entries[at]
        if index.stage(prior) != 0 || prior.flags & 0x8000 != 0 || prior.extended & 0x6000 != 0 {
            continue
        }
        while k < hashed.len && compare(hashed[k].entry.path, prior.path) < 0 { k += 1 }
        // An entry collect did not hash is read with its CR-LF guard where a
        // text rule may apply: a body Git would clean is left unrefreshed.
        var text_check = false
        if (k >= hashed.len || !same_entry(hashed[k].entry, prior)) &&
            (prior.stat[6] == 0o100644 || prior.stat[6] == 0o100755) {
            let modes = worktree.path_modes(ctx, prior.path, tx.value, mut directories)?
            text_check = modes[0] || modes[1]
        }
        let file = state_of(
            ctx,
            prior,
            hashed,
            k,
            written,
            filemode,
            symlinks,
            text_check,
            mut verified,
        ) else |_| {
            continue
        }
        if file.mode != prior.stat[6] || !oid.equal(file.id, prior.id) { continue }
        let fresh = fresh_stat(file, prior)?
        if stat_differs(fresh, prior) {
            // A selected stat-only path triggers update-index --refresh for
            // all unchanged entries, not only the selected pathspec subset.
            if selected(prior.path, specs)? { triggered = true }
            tx.value.entries[at] = fresh
        }
    }
    if triggered { index.commit(mut tx)? }
}

fn stat_only_names(
    ctx: worktree.Context,
    options: Options,
    mut result: List[Change],
) -> () ! worktree.WorkErrors {
    if options.cached ||
        options.revisions.len == 2 ||
        !(options.names || options.name_status) ||
        worktree.config_bool(ctx, "diff.autorefreshindex", true)? {
        return
    }
    let value = worktree.read_index(ctx)?
    let specs = pathspecs(ctx, options.paths)?
    for prior in value.entries {
        if index.stage(prior) != 0 ||
            prior.flags & 0x8000 != 0 ||
            prior.extended & 0x6000 != 0 ||
            !selected(prior.path, specs)? {
            continue
        }
        var present = false
        for change in result { if compare(path(change), prior.path) == 0 { present = true; break } }
        if present { continue }
        let file = worktree.read_file(ctx, prior.path, [copy prior]) else |_| { continue }
        if stat_differs(fresh_stat(file, prior)?, prior) {
            let old = blob(ctx, worktree.
                FlatEntry { path: owned(prior.path), mode: prior.stat[6], id: copy prior.id })?
            let new = File {
                path: owned(file.path),
                mode: file.mode,
                id: copy file.id,
                data: owned(file.data),
            }
            (mut result).push(Change { before: [old], after: [new], status: "M", percent: 0 })
        }
    }
    for i in 1..result.len {
        let item = copy result[i]
        var j = i
        while j > 0 && compare(path(result[j - 1]), path(item)) > 0 {
            result[j] = copy result[j - 1]
            j -= 1
        }
        result[j] = item
    }
}
