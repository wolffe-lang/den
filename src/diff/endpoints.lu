use std.fs
use gitmodules
use index
use object
use oid
use rename
use worktree

fn blob(ctx: worktree.Context, entry: worktree.FlatEntry) -> File ! worktree.WorkErrors {
    // A gitlink diffs as Git's text for it (vc25), never as an object read.
    if entry.mode == 0o160000 {
        return File {
            path: owned(entry.path),
            mode: entry.mode,
            id: copy entry.id,
            data: worktree.subproject_text(entry.id, false)?,
        }
    }
    let stored = object.read_object(ctx.repo, entry.id, 16777216)?
    if stored.kind != "blob" { return invalid_tree }
    File { path: owned(entry.path), mode: entry.mode, id: copy entry.id, data: owned(stored.data) }
}

fn from_tree(ctx: worktree.Context, name: str) -> List[File] ! worktree.WorkErrors {
    let id = resolve(ctx, name)?
    var out = List[File]()
    var total: int = 0
    for entry in worktree.flatten_tree(ctx.repo, id)? {
        let file = blob(ctx, entry)?
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(file)
    }
    out
}

fn from_worktree(ctx: worktree.Context, value: index.Index) -> List[File] ! worktree.WorkErrors {
    from_worktree_ignoring(ctx, value, "")?
}

/// The worktree side; a gitlink is its submodule's HEAD, `-dirty` when its
/// tracked content is modified (untracked content alone never shows in a
/// diff unless the ignore setting is none; vc25 rows).
fn from_worktree_ignoring(
    ctx: worktree.Context,
    value: index.Index,
    ignore_option: str,
) -> List[File] ! worktree.WorkErrors {
    let autocrlf = (ctx.repo.config["core.autocrlf"] else "false").lower()
    if autocrlf != "false" && autocrlf != "0" { return Unsupported("core.autocrlf={autocrlf}") }
    var out = List[File]()
    var total: int = 0
    var parsed = List[gitmodules.Parsed]()
    for entry in value.entries {
        if index.stage(entry) != 0 { return Unsupported("diff unmerged index") }
        if entry.stat[6] == 0o160000 {
            if !fs.is_dir("{ctx.root}/{text(entry.path)?}") { continue }
            if parsed.len == 0 { (mut parsed).push(worktree.modules(ctx)?) }
            let setting = worktree.ignore_for(ctx, parsed[0], text(entry.path)?, ignore_option)
            if setting == "all" {
                (mut out).push(blob(ctx, worktree.FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?)
                continue
            }
            let state = worktree.submodule_state(
                ctx,
                text(entry.path)?,
                entry.id,
                if setting == "" then "untracked" else setting,
            )?
            let dirty = state.modified || setting == "none" && state.untracked
            (mut out).push(File {
                path: owned(entry.path),
                mode: 0o160000,
                id: copy state.head,
                data: worktree.subproject_text(state.head, dirty)?,
            })
            continue
        }
        if entry.flags & 0x8000 != 0 || entry.extended & 0x4000 != 0 {
            let file = blob(ctx, worktree.
                FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?
            total += file.data.len
            if total > 134217728 { return limit }
            (mut out).push(file)
            continue
        }
        let full = "{ctx.root}/{text(entry.path)?}"
        let stat = fs_lstat(full) else |e| match e {
            not_found => { continue },
            _ => { return io },
        }
        if stat[0] == 1 { continue }
        let file = worktree.read_file(ctx, entry.path, [copy entry])?
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(File {
            path: owned(file.path),
            mode: file.mode,
            id: copy file.id,
            data: owned(file.data),
        })
    }
    out
}

fn candidates(files: List[File], retained: bool) -> List[rename.Candidate] {
    var out = List[rename.Candidate]()
    for file in files {
        (mut out).push(rename.Candidate {
            path: owned(file.path),
            mode: file.mode,
            id: copy file.id,
            data: owned(file.data),
            retained: retained,
        })
    }
    out
}

/// Compare sorted endpoint lists and use the shared pairer for A/D candidates.
pub fn changes(
    before: List[File],
    after: List[File],
    options: Options,
) -> List[Change] ! worktree.WorkErrors {
    var out = List[Change](), deleted = List[File](), added = List[File](), modified = List[File]()
    var a = 0, b = 0
    while a < before.len || b < after.len {
        let cmp = if a == before.len {
            1
        } else if b == after.len {
            -1
        } else {
            compare(before[a].path, after[b].path)
        }
        if cmp == 0 {
            // A gitlink keeps its commit but differs in its `-dirty` text when
            // its worktree is modified (vc25): still a change.
            let dirty = before[a].mode == 0o160000 &&
                after[b].mode == 0o160000 &&
                compare(before[a].data, after[b].data) != 0
            if before[a].mode != after[b].mode || !oid.equal(before[a].id, after[b].id) || dirty {
                let status = if before[a].mode & 0o170000 != after[b].mode & 0o170000 {
                    "T"
                } else {
                    "M"
                }
                (mut out).push(Change {
                    before: [copy before[a]],
                    after: [copy after[b]],
                    status: status,
                    percent: 0,
                })
                (mut modified).push(copy before[a])
            }
            a += 1
            b += 1
        } else if cmp < 0 {
            (mut deleted).push(copy before[a])
            a += 1
        } else {
            (mut added).push(copy after[b])
            b += 1
        }
    }
    var sources = candidates(deleted, false)
    if options.copies {
        for candidate in candidates(modified, true) { (mut sources).push(copy candidate) }
    }
    let targets = candidates(added, false)
    let pairs = rename.pair(sources, targets, rename.
        Options { enabled: options.renames, copies: options.copies, threshold: options.threshold })?
    var taken_old = List[int](), taken_new = List[int]()
    for pair in pairs {
        let source = copy sources[pair.source]
        let old = File {
            path: owned(source.path),
            mode: source.mode,
            id: copy source.id,
            data: owned(source.data),
        }
        (mut out).push(Change {
            before: [old],
            after: [copy added[pair.destination]],
            status: if pair.is_copy then "C" else "R",
            percent: pair.percent,
        })
        if pair.source < deleted.len { (mut taken_old).push(pair.source) }
        (mut taken_new).push(pair.destination)
    }
    for i in 0..deleted.len {
        var used = false
        for taken in taken_old { if taken == i { used = true } }
        if !used { (mut out).push(Change { before: [copy deleted[i]], after: [], status: "D", percent: 0 }) }
    }
    for i in 0..added.len {
        var used = false
        for taken in taken_new { if taken == i { used = true } }
        if !used { (mut out).push(Change { before: [], after: [copy added[i]], status: "A", percent: 0 }) }
    }
    for i in 1..out.len {
        let item = copy out[i]
        var j = i
        while j > 0 && compare(path(out[j - 1]), path(item)) > 0 {
            out[j] = copy out[j - 1]
            j -= 1
        }
        out[j] = item
    }
    out
}

/// An endpoint whose body is read only when it is needed (den#101): source 0
/// carries its body (a gitlink's text), 1 reads it by id from the object
/// store, 2 from the worktree (read_file, prior the index entry at `at`).
struct Pending { file: File, source: int, at: int }

/// A worktree path collect hashed because its stat differed from its entry:
/// the entry it was compared with and what the hash saw, for the
/// autoRefreshIndex step (refresh_known), which then reads nothing again.
struct Hashed { entry: index.Entry, state: worktree.FileState }

/// collect's answer with the hashes the worktree side made.
struct Collected { changes: List[Change], hashed: List[Hashed] }

fn pending_entry(
    ctx: worktree.Context,
    entry: worktree.FlatEntry,
) -> Pending ! worktree.WorkErrors {
    if entry.mode == 0o160000 { return Pending { file: blob(ctx, entry)?, source: 0, at: -1 } }
    Pending {
        file: File {
            path: owned(entry.path),
            mode: entry.mode,
            id: copy entry.id,
            data: List[byte](),
        },
        source: 1,
        at: -1,
    }
}

fn pending_flat(
    ctx: worktree.Context,
    entries: List[worktree.FlatEntry],
) -> List[Pending] ! worktree.WorkErrors {
    var out = List[Pending]()
    for entry in entries { (mut out).push(pending_entry(ctx, entry)?) }
    out
}

fn pending_tree(ctx: worktree.Context, name: str) -> List[Pending] ! worktree.WorkErrors {
    let id = resolve(ctx, name)?
    pending_flat(ctx, worktree.flatten_tree(ctx.repo, id)?)?
}

fn pending_index(ctx: worktree.Context, value: index.Index) -> List[Pending] ! worktree.WorkErrors {
    var out = List[Pending]()
    for entry in value.entries {
        if index.stage(entry) != 0 { return Unsupported("diff unmerged index") }
        if entry.extended & 0x2000 != 0 { continue }
        (mut out).push(pending_entry(ctx, worktree.FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?)
    }
    out
}

/// from_worktree_ignoring's answer with ids only: a stat-clean file takes its
/// entry's id unread, any other is hashed as it streams (worktree.tracked),
/// and each hash is kept in hashed for the refresh step.
fn pending_worktree(
    ctx: worktree.Context,
    value: index.Index,
    ignore_option: str,
    mut hashed: List[Hashed],
) -> List[Pending] ! worktree.WorkErrors {
    let autocrlf = (ctx.repo.config["core.autocrlf"] else "false").lower()
    if autocrlf != "false" && autocrlf != "0" { return Unsupported("core.autocrlf={autocrlf}") }
    let written = worktree.index_written(ctx)
    let filemode = worktree.config_bool(ctx, "core.filemode", true)?
    let symlinks = worktree.config_bool(ctx, "core.symlinks", true)?
    var verified = List[List[byte]]()
    var out = List[Pending]()
    var parsed = List[gitmodules.Parsed]()
    var directory = List[byte](), known = false, possible = false
    for at in 0..value.entries.len {
        let entry = copy value.entries[at]
        if index.stage(entry) != 0 { return Unsupported("diff unmerged index") }
        if entry.stat[6] == 0o160000 {
            if !fs.is_dir("{ctx.root}/{text(entry.path)?}") { continue }
            if parsed.len == 0 { (mut parsed).push(worktree.modules(ctx)?) }
            let setting = worktree.ignore_for(ctx, parsed[0], text(entry.path)?, ignore_option)
            if setting == "all" {
                (mut out).push(Pending {
                    file: blob(ctx, worktree.FlatEntry {
                        path: owned(entry.path),
                        mode: entry.stat[6],
                        id: copy entry.id,
                    })?,
                    source: 0,
                    at: at,
                })
                continue
            }
            let state = worktree.submodule_state(
                ctx,
                text(entry.path)?,
                entry.id,
                if setting == "" then "untracked" else setting,
            )?
            let dirty = state.modified || setting == "none" && state.untracked
            (mut out).push(Pending {
                file: File {
                    path: owned(entry.path),
                    mode: 0o160000,
                    id: copy state.head,
                    data: worktree.subproject_text(state.head, dirty)?,
                },
                source: 0,
                at: at,
            })
            continue
        }
        if entry.flags & 0x8000 != 0 || entry.extended & 0x4000 != 0 {
            (mut out).push(pending_entry(ctx, worktree.FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?)
            continue
        }
        // A text rule can make a stat-clean body differ once cleaned, so
        // such a path is hashed and its CR-LF checked, as status does.
        var text_check = false
        if entry.stat[6] == 0o100644 || entry.stat[6] == 0o100755 {
            var end = 0
            for i in 0..entry.path.len { if entry.path[i] == 47 as byte { end = i } }
            var same = known && directory.len == end
            if same {
                for i in 0..end { if directory[i] != entry.path[i] { same = false; break } }
            }
            if !same {
                directory = owned(entry.path[0..end])
                possible = worktree.attributes_directory(ctx, directory, value)?
                known = true
            }
            text_check = possible
        }
        let seen = worktree.tracked(
            ctx,
            entry,
            written,
            filemode,
            symlinks,
            text_check,
            mut verified,
        )?
        if !seen.present { continue }
        if !seen.clean { (mut hashed).push(Hashed { entry: copy entry, state: copy seen.state }) }
        (mut out).push(Pending {
            file: File {
                path: owned(entry.path),
                mode: seen.state.mode,
                id: copy seen.state.id,
                data: List[byte](),
            },
            source: 2,
            at: at,
        })
    }
    out
}

/// Whether two endpoints at one path are the same: mode and id, and for a
/// gitlink its text (`-dirty`), as changes compares them.
fn same_endpoint(a: File, b: File) -> bool {
    if a.mode != b.mode || !oid.equal(a.id, b.id) { return false }
    if a.mode == 0o160000 && compare(a.data, b.data) != 0 { return false }
    true
}

/// HEAD's tree for a cached diff. While no entry is unmerged or intent-to-add,
/// status's reading serves: the index's own entries when its cache tree's
/// root names HEAD's tree (no tree object is read), else the full walk.
fn pending_head(
    ctx: worktree.Context,
    value: index.Index,
    commit: oid.Oid,
) -> List[Pending] ! worktree.WorkErrors {
    for entry in value.entries {
        if index.stage(entry) != 0 || entry.extended & 0x2000 != 0 {
            return pending_tree(ctx, oid.hex(commit)?)?
        }
    }
    pending_flat(ctx, worktree.head_tree(ctx, value, commit)?)?
}

/// The endpoints changes can report: every path with no equal counterpart.
/// A pair changes would pass over silently is dropped before any body is
/// read; the answer changes gives for what remains is the one it gave for
/// the whole lists, since unchanged pairs are neither reported nor rename or
/// copy candidates.
fn differing(before: List[Pending], after: List[Pending]) -> (List[Pending], List[Pending]) {
    var old = List[Pending](), new = List[Pending]()
    var a = 0, b = 0
    while a < before.len || b < after.len {
        let cmp = if a == before.len {
            1
        } else if b == after.len {
            -1
        } else {
            compare(before[a].file.path, after[b].file.path)
        }
        if cmp == 0 {
            if !same_endpoint(before[a].file, after[b].file) {
                (mut old).push(copy before[a])
                (mut new).push(copy after[b])
            }
            a += 1
            b += 1
        } else if cmp < 0 {
            (mut old).push(copy before[a])
            a += 1
        } else {
            (mut new).push(copy after[b])
            b += 1
        }
    }
    (old, new)
}

/// Bodies for the endpoints that differ, within the 128 MiB bound on what a
/// diff holds. A worktree body is read as before (read_file), and its id and
/// mode are the read's own.
fn bodies(
    ctx: worktree.Context,
    value: index.Index,
    list: List[Pending],
    mut total: int,
) -> List[File] ! worktree.WorkErrors {
    var out = List[File]()
    for item in list {
        let file = if item.source == 0 {
            copy item.file
        } else if item.source == 1 {
            blob(ctx, worktree.FlatEntry {
                path: owned(item.file.path),
                mode: item.file.mode,
                id: copy item.file.id,
            })?
        } else {
            let read = worktree.read_file(ctx, item.file.path, [copy value.entries[item.at]])?
            File {
                path: owned(read.path),
                mode: read.mode,
                id: copy read.id,
                data: owned(read.data),
            }
        }
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(file)
    }
    out
}

fn without_gitlinks(list: List[Pending]) -> List[Pending] {
    var out = List[Pending]()
    for item in list { if item.file.mode != 0o160000 { (mut out).push(copy item) } }
    out
}

fn chosen(list: List[Pending], specs: List[Spec]) -> List[Pending] ! worktree.WorkErrors {
    var out = List[Pending]()
    for item in list { if selected(item.file.path, specs)? { (mut out).push(copy item) } }
    out
}

fn endpoint_attributes(
    ctx: worktree.Context,
    files: List[File],
    value: index.Index,
) -> () ! worktree.WorkErrors {
    // Endpoints are path ordered. Cache the current directory without making
    // a fresh UTF-8 map key for every file on both sides of a large diff.
    var directory = List[byte](), known = false, possible = false
    for file in files {
        if file.mode != 0o100644 && file.mode != 0o100755 { continue }
        var end = 0
        for i in 0..file.path.len { if file.path[i] == 47 as byte { end = i } }
        var same = known && directory.len == end
        if same {
            for i in 0..end { if directory[i] != file.path[i] { same = false; break } }
        }
        if !same {
            directory = owned(file.path[0..end])
            possible = worktree.attributes_directory(ctx, directory, value)?
            known = true
        }
        if possible { worktree.check_text_content(ctx, file.path, file.data)? }
    }
}

fn regular_change(change: Change) -> bool {
    for file in change.before {
        if file.mode == 0o100644 || file.mode == 0o100755 { return true }
    }
    for file in change.after {
        if file.mode == 0o100644 || file.mode == 0o100755 { return true }
    }
    false
}

// Resolve at the destination (or the source for a deletion), using the same
// worktree/index attribute sources as staging. Symlinks and gitlinks do not
// acquire a regular file's diff policy.
fn attribute_diff(
    ctx: worktree.Context,
    change: Change,
    value: index.Index,
    mut cache: worktree.AttributeCache,
) -> str ! worktree.WorkErrors {
    if !regular_change(change) { return "" }
    let policy = worktree.attribute_policy_cached(ctx, path(change), value, mut cache)?
    policy.diff
}

fn check_diff_driver(
    ctx: worktree.Context,
    path: List[byte],
    driver: str,
) -> () ! worktree.WorkErrors {
    if driver == "" || driver == "-" || driver == "+" { return }
    if driver == "cpp" ||
        driver == "dts" ||
        driver == "perl" ||
        driver == "python" ||
        driver == "rust" ||
        worktree.configured_attribute_driver(ctx, "diff", driver) {
        return Unsupported("diff driver {driver} at {text(path)?}")
    }
    // An unconfigured custom driver is Git's default content-based diff.
}

fn diff_policies(
    ctx: worktree.Context,
    changes: List[Change],
    patch: bool,
) -> List[str] ! worktree.WorkErrors {
    var out = List[str]()
    if changes.len == 0 { return out }
    let value = worktree.read_index(ctx)?
    var cache = worktree.attribute_cache(ctx)?
    for change in changes {
        let driver = attribute_diff(ctx, change, value, mut cache)?
        if patch { check_diff_driver(ctx, path(change), driver)? }
        (mut out).push(driver)
    }
    out
}

/// collect's answer and the worktree hashes it made (den#101). Endpoints carry
/// ids first; bodies are read only for paths that differ; the worktree side
/// reads a file only when its stat is not clean against its entry.
fn collect_known(ctx: worktree.Context, options: Options) -> Collected ! worktree.WorkErrors {
    worktree.check_attributes(ctx)?
    var hashed = List[Hashed]()
    var before = List[Pending](), after = List[Pending]()
    var value = index.empty(2)?
    if options.revisions.len == 2 {
        let a = resolve(ctx, options.revisions[0])?
        let b = resolve(ctx, options.revisions[1])?
        let left = object.read_object(ctx.repo, a, 16777216)?
        let right = object.read_object(ctx.repo, b, 16777216)?
        if left.kind == "blob" && right.kind == "blob" {
            let old = [
                File {
                    path: owned(options.revisions[0].bytes()),
                    mode: 0o100644,
                    id: a,
                    data: owned(left.data),
                },
            ]
            let new = [
                File {
                    path: owned(options.revisions[1].bytes()),
                    mode: 0o100644,
                    id: b,
                    data: owned(right.data),
                },
            ]
            if oid.equal(old[0].id, new[0].id) {
                return Collected { changes: List[Change](), hashed: hashed }
            }
            if options.reverse {
                return Collected {
                    changes: [Change { before: new, after: old, status: "M", percent: 0 }],
                    hashed: hashed,
                }
            }
            return Collected {
                changes: [Change { before: old, after: new, status: "M", percent: 0 }],
                hashed: hashed,
            }
        }
        before = pending_tree(ctx, options.revisions[0])?
        after = pending_tree(ctx, options.revisions[1])?
        // Attribute sources fall back to the index, as for every other diff.
        value = worktree.read_index(ctx)?
    } else {
        value = worktree.read_index(ctx)?
        if options.cached {
            if options.revisions.len == 1 {
                before = pending_tree(ctx, options.revisions[0])?
            } else {
                let head = worktree.head(ctx)?
                if head.commits.len > 0 { before = pending_head(ctx, value, head.commits[0])? }
            }
            after = pending_index(ctx, value)?
        } else {
            before = if options.revisions.len == 1 {
                pending_tree(ctx, options.revisions[0])?
            } else {
                pending_index(ctx, value)?
            }
            after = pending_worktree(ctx, value, options.ignore_submodules, mut hashed)?
        }
    }
    if options.ignore_submodules == "all" {
        before = without_gitlinks(before)
        after = without_gitlinks(after)
    }
    let specs = pathspecs(ctx, options.paths)?
    let (old, new) = differing(chosen(before, specs)?, chosen(after, specs)?)
    var total: int = 0
    let selected_old = bodies(ctx, value, old, mut total)?
    let selected_new = bodies(ctx, value, new, mut total)?
    // Every body a diff shows passes the worktree attribute policy. The
    // worktree side was also checked as it was hashed (pending_worktree).
    endpoint_attributes(ctx, selected_old, value)?
    endpoint_attributes(ctx, selected_new, value)?
    var result = if options.reverse {
        changes(selected_new, selected_old, options)?
    } else {
        changes(selected_old, selected_new, options)?
    }
    stat_only_names(ctx, options, mut result)?
    Collected { changes: result, hashed: hashed }
}

/// Resolve supported loose endpoints without refreshing or publishing the index.
pub fn collect(ctx: worktree.Context, options: Options) -> List[Change] ! worktree.WorkErrors {
    let collected = collect_known(ctx, options)?
    collected.changes
}
