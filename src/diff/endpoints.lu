use index
use object
use oid
use rename
use worktree

fn blob(ctx: worktree.Context, entry: worktree.FlatEntry) -> File ! worktree.WorkErrors {
    if entry.mode == 0o160000 { return Unsupported("diff submodule") }
    let stored = object.read_object(ctx.repo, entry.id, 16777216)?
    if stored.kind != "blob" { return invalid_tree }
    File { path: owned(entry.path), mode: entry.mode, id: copy entry.id, data: owned(stored.data) }
}

fn from_tree(ctx: worktree.Context, name: str) -> List[File] ! worktree.WorkErrors {
    let id = resolve(ctx, name)?
    var out = List[File]()
    var total: int = 0
    for entry in worktree.flatten_tree(ctx.repo, id)? {
        let file = blob(ctx, entry)?
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(file)
    }
    out
}

fn from_index(
    ctx: worktree.Context,
    value: index.Index,
    cached: bool,
) -> List[File] ! worktree.WorkErrors {
    var out = List[File]()
    var total: int = 0
    for entry in value.entries {
        if index.stage(entry) != 0 { return Unsupported("diff unmerged index") }
        if entry.extended & 0x2000 != 0 { continue }
        let file = blob(ctx, worktree.
            FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(file)
    }
    let _ = cached
    out
}

fn from_worktree(ctx: worktree.Context, value: index.Index) -> List[File] ! worktree.WorkErrors {
    let autocrlf = (ctx.repo.config["core.autocrlf"] else "false").lower()
    if autocrlf != "false" { return Unsupported("core.autocrlf={autocrlf}") }
    var out = List[File]()
    var total: int = 0
    for entry in value.entries {
        if index.stage(entry) != 0 { return Unsupported("diff unmerged index") }
        if entry.flags & 0x8000 != 0 || entry.extended & 0x4000 != 0 {
            (mut out).push(blob(ctx, worktree.FlatEntry { path: owned(entry.path), mode: entry.stat[6], id: copy entry.id })?)
            continue
        }
        let full = "{ctx.root}/{text(entry.path)?}"
        let stat = fs_lstat(full) else |e| match e {
            not_found => { continue },
            _ => { return io },
        }
        if stat[0] == 1 { continue }
        let file = worktree.read_file(ctx, entry.path, [copy entry])?
        total += file.data.len
        if total > 134217728 { return limit }
        (mut out).push(File {
            path: owned(file.path),
            mode: file.mode,
            id: copy file.id,
            data: owned(file.data),
        })
    }
    out
}

fn candidates(files: List[File], retained: bool) -> List[rename.Candidate] {
    var out = List[rename.Candidate]()
    for file in files {
        (mut out).push(rename.Candidate {
            path: owned(file.path),
            mode: file.mode,
            id: copy file.id,
            data: owned(file.data),
            retained: retained,
        })
    }
    out
}

/// Compare sorted endpoint lists and use the shared pairer for A/D candidates.
pub fn changes(
    before: List[File],
    after: List[File],
    options: Options,
) -> List[Change] ! worktree.WorkErrors {
    var out = List[Change](), deleted = List[File](), added = List[File](), modified = List[File]()
    var a = 0, b = 0
    while a < before.len || b < after.len {
        let cmp = if a == before.len {
            1
        } else if b == after.len {
            -1
        } else {
            compare(before[a].path, after[b].path)
        }
        if cmp == 0 {
            if before[a].mode != after[b].mode || !oid.equal(before[a].id, after[b].id) {
                let status = if before[a].mode & 0o170000 != after[b].mode & 0o170000 {
                    "T"
                } else {
                    "M"
                }
                (mut out).push(Change {
                    before: [copy before[a]],
                    after: [copy after[b]],
                    status: status,
                    percent: 0,
                })
                (mut modified).push(copy before[a])
            }
            a += 1
            b += 1
        } else if cmp < 0 {
            (mut deleted).push(copy before[a])
            a += 1
        } else {
            (mut added).push(copy after[b])
            b += 1
        }
    }
    var sources = candidates(deleted, false)
    if options.copies {
        for candidate in candidates(modified, true) { (mut sources).push(copy candidate) }
    }
    let targets = candidates(added, false)
    let pairs = rename.pair(sources, targets, rename.
        Options { enabled: options.renames, copies: options.copies, threshold: options.threshold })?
    var taken_old = List[int](), taken_new = List[int]()
    for pair in pairs {
        let source = copy sources[pair.source]
        let old = File {
            path: owned(source.path),
            mode: source.mode,
            id: copy source.id,
            data: owned(source.data),
        }
        (mut out).push(Change {
            before: [old],
            after: [copy added[pair.destination]],
            status: if pair.is_copy then "C" else "R",
            percent: pair.percent,
        })
        if pair.source < deleted.len { (mut taken_old).push(pair.source) }
        (mut taken_new).push(pair.destination)
    }
    for i in 0..deleted.len {
        var used = false
        for taken in taken_old { if taken == i { used = true } }
        if !used { (mut out).push(Change { before: [copy deleted[i]], after: [], status: "D", percent: 0 }) }
    }
    for i in 0..added.len {
        var used = false
        for taken in taken_new { if taken == i { used = true } }
        if !used { (mut out).push(Change { before: [], after: [copy added[i]], status: "A", percent: 0 }) }
    }
    for i in 1..out.len {
        let item = copy out[i]
        var j = i
        while j > 0 && compare(path(out[j - 1]), path(item)) > 0 {
            out[j] = copy out[j - 1]
            j -= 1
        }
        out[j] = item
    }
    out
}

/// Resolve supported loose endpoints without refreshing or publishing the index.
pub fn collect(ctx: worktree.Context, options: Options) -> List[Change] ! worktree.WorkErrors {
    var before = List[File](), after = List[File]()
    if options.revisions.len == 2 {
        let a = resolve(ctx, options.revisions[0])?
        let b = resolve(ctx, options.revisions[1])?
        let left = object.read_object(ctx.repo, a, 16777216)?
        let right = object.read_object(ctx.repo, b, 16777216)?
        if left.kind == "blob" && right.kind == "blob" {
            before = [
                File {
                    path: owned(options.revisions[0].bytes()),
                    mode: 0o100644,
                    id: a,
                    data: owned(left.data),
                },
            ]
            after = [
                File {
                    path: owned(options.revisions[1].bytes()),
                    mode: 0o100644,
                    id: b,
                    data: owned(right.data),
                },
            ]
            if oid.equal(before[0].id, after[0].id) { return List[Change]() }
            if options.reverse {
                return [Change { before: after, after: before, status: "M", percent: 0 }]
            }
            return [Change { before: before, after: after, status: "M", percent: 0 }]
        }
        before = from_tree(ctx, options.revisions[0])?
        after = from_tree(ctx, options.revisions[1])?
    } else {
        let value = worktree.read_index(ctx)?
        if options.cached {
            if options.revisions.len == 1 {
                before = from_tree(ctx, options.revisions[0])?
            } else {
                let head = worktree.head(ctx)?
                if head.commits.len > 0 { before = from_tree(ctx, oid.hex(head.commits[0])?)? }
            }
            after = from_index(ctx, value, true)?
        } else {
            before = if options.revisions.len == 1 {
                from_tree(ctx, options.revisions[0])?
            } else {
                from_index(ctx, value, false)?
            }
            after = from_worktree(ctx, value)?
        }
    }
    var selected_old = List[File](), selected_new = List[File]()
    let specs = pathspecs(ctx, options.paths)?
    for file in before { if selected(file.path, specs)? { (mut selected_old).push(copy file) } }
    for file in after { if selected(file.path, specs)? { (mut selected_new).push(copy file) } }
    if options.reverse {
        changes(selected_new, selected_old, options)?
    } else {
        changes(selected_old, selected_new, options)?
    }
}
