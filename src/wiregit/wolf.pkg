pkg {
    name: "wiregit",
    edition: "1",
    capabilities: [fs, env, exec, net],
    deps: {
        object: {path: "../object"},
        oid: {path: "../oid"},
        pack: {path: "../pack"},
        packcmd: {path: "../packcmd"},
        pktline: {path: "../pktline"},
        refs: {path: "../refs"},
        refcmd: {path: "../refcmd"},
        remote: {path: "../remote"},
        history: {path: "../history"},
        revision: {path: "../revision"},
        repository: {path: "../repository"},
        transport: {path: "../transport"},
        wire: {path: "../wire"},
        index: {path: "../index"},
        worktree: {path: "../worktree"},
        gitmodules: {path: "../gitmodules"},
        revset: {path: "../revset"},
    },
}
