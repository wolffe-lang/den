// git-push refspec/default/upstream/lease porcelain over the shared protocol.
use object
use oid
use refs
use remote
use repository
use revision
use transport

fn tracking_expectation(
    repo: repository.Repo,
    name: str,
    destination: str,
) -> str ! object.StoreErrors {
    if name == "" || !destination.starts_with("refs/heads/") { return zero() }
    let spec = repo.config["remote.{name}.fetch"] else ""
    if spec == "" { return zero() }
    if spec != "+refs/heads/*:refs/remotes/{name}/*" &&
        spec != "refs/heads/*:refs/remotes/{name}/*" {
        return Unsupported("plain lease with nondefault fetch mapping")
    }
    let before = refs.optional(repo, "refs/remotes/{name}/{destination[11..]}")?
    if before.len == 0 { zero() } else { oid.hex(before[0])? }
}

// git-push(1) <refspec>'s <src>: HEAD; else a ref by gitrevisions(7)'s
// <refname> order (the full name itself, refs/X, refs/tags/X, refs/heads/X,
// refs/remotes/X, refs/remotes/X/HEAD), refused when two exist; else any
// revision. Git's refusal text is returned for a source that names nothing.
fn push_source(
    repo: repository.Repo,
    raw: str,
    branch: str,
    mut plans: List[PushPlan],
) -> str ! object.StoreErrors {
    let plus = raw.starts_with("+")
    let text = if plus then raw[1..] else copy raw
    let parts = text.split(":")
    if parts.len > 2 { return invalid }
    let typed = copy parts[0]
    var source = "", namespace = "", id = ""
    if typed == "HEAD" {
        let head = refs.optional(repo, "HEAD")?
        if head.len == 0 { return "error: src refspec HEAD does not match any" }
        source = "HEAD"
        namespace = if branch != "" then "refs/heads/{branch}" else ""
        id = oid.hex(head[0])?
    } else if typed != "" {
        var found = List[str]()
        var spellings = List[str]()
        if typed.starts_with("refs/") { (mut spellings).push(copy typed) }
        for prefix in ["refs/", "refs/tags/", "refs/heads/", "refs/remotes/"] {
            (mut spellings).push("{prefix}{typed}")
        }
        (mut spellings).push("refs/remotes/{typed}/HEAD")
        for spelling in spellings {
            if !refs.valid(spelling) { continue }
            let value = refs.optional(repo, spelling)?
            if value.len > 0 {
                var again = false
                for prior in found { if prior == spelling { again = true } }
                if !again { (mut found).push(copy spelling) }
            }
        }
        if found.len > 1 { return "error: src refspec {typed} matches more than one" }
        if found.len == 1 {
            source = copy found[0]
            namespace = copy found[0]
            id = oid.hex(refs.read(repo, source)?)?
        } else {
            let resolved = revision.resolve(repo, typed) else |_| {
                return "error: src refspec {typed} does not match any"
            }
            id = oid.hex(resolved)?
        }
    }
    var kind = ""
    if id != "" { kind = copy object.read_object(repo, oid.parse("sha1", id)?, 16777216)?.kind }
    // With no colon the destination is the source's own ref (HEAD on a
    // branch is that branch), or the source as typed for another revision.
    var destination = if parts.len == 2 then copy parts[1] else ""
    if parts.len == 1 {
        destination = if source == "HEAD" {
            if branch != "" then "refs/heads/{branch}" else "HEAD"
        } else if source != "" {
            copy source
        } else {
            copy typed
        }
    }
    if destination == "" { return Unsupported("push refspec with an empty destination") }
    (mut plans).push(PushPlan {
        force: plus,
        typed: typed,
        source: source,
        namespace: namespace,
        id: id,
        kind: kind,
        destination: destination,
    })
    ""
}

fn push_leases(
    repo: repository.Repo,
    name: str,
    specs: List[str],
    requests: List[str],
) -> List[PushLease] ! object.StoreErrors {
    var values = Map[str, str]()
    for request in requests {
        if request == "" {
            for spec in specs {
                let parts = spec.split(":")
                values[parts[1]] = tracking_expectation(repo, name, parts[1])?
            }
        } else {
            let parts = request.split(":")
            if parts.len > 2 { return invalid }
            let reference = if parts[0].starts_with("refs/") {
                copy parts[0]
            } else {
                "refs/heads/{parts[0]}"
            }
            if !refs.valid(reference) { return invalid }
            var expected = copy zero()
            if parts.len == 1 {
                expected = tracking_expectation(repo, name, reference)?
            } else if parts[1] != "" {
                expected = if parts[1].len == 40 {
                    oid.hex(oid.parse("sha1", parts[1])?)?
                } else {
                    let id = revision.resolve(repo, parts[1]) else |e| {
                        return Unsupported("lease expected revision: {e}")
                    }
                    oid.hex(id)?
                }
            }
            values[reference] = expected
        }
    }
    var out = List[PushLease]()
    for (reference, expected) in values.pairs() {
        (mut out).push(PushLease { name: copy reference, expected: copy expected })
    }
    out
}

fn publish_push_tracking(
    repo: repository.Repo,
    name: str,
    outcomes: List[PushOutcome],
    upstream: bool,
    quiet: bool,
) -> () ! object.StoreErrors {
    if name == "" { return }
    let identity = remote.reflog_identity(repo)?
    let mapping = repo.config["remote.{name}.fetch"] else ""
    let mapped = mapping == "+refs/heads/*:refs/remotes/{name}/*" ||
        mapping == "refs/heads/*:refs/remotes/{name}/*"
    for outcome in outcomes {
        if outcome.status != "ok" && outcome.status != "up-to-date" { continue }
        if !outcome.name.starts_with("refs/heads/") { continue }
        if mapped {
            let destination = "refs/remotes/{name}/{outcome.name[11..]}"
            let before = refs.optional(repo, destination)?
            let after = if outcome.after == zero() {
                List[oid.Oid]()
            } else {
                [oid.parse("sha1", outcome.after)?]
            }
            refs.update(repo, destination, before, after, identity, "update by push", false)?
        }
        if upstream && outcome.after != zero() {
            var branch = ""
            if outcome.source.starts_with("refs/heads/") { branch = outcome.source[11..] }
            if outcome.source == "HEAD" { branch = remote.current_branch(repo)? }
            if branch != "" {
                remote.configure_branch(repo, branch, name, outcome.name)?
                if !quiet {
                    print("branch '{branch}' set up to track '{name}/{outcome.name[11..]}'.")
                }
            }
        }
    }
}

fn perform_push(args: List[str]) -> int ! object.StoreErrors {
    var quiet = false,
        force = false,
        atomic = false,
        upstream = false,
        literal = false,
        receive = ""
    var operands = List[str](), requests = List[str]()
    for arg in args[1..] {
        if literal { (mut operands).push(copy arg); continue }
        if arg == "--" {
            literal = true
        } else if arg == "-q" || arg == "--quiet" {
            quiet = true
        } else if arg == "--force" || arg == "-f" {
            force = true
        } else if arg.starts_with("--receive-pack=") {
            receive = arg[15..]
            if receive == "" { return Unsupported("empty receive-pack service path") }
        } else if arg == "--atomic" {
            atomic = true
        } else if arg == "-u" || arg == "--set-upstream" {
            upstream = true
        } else if arg == "--force-with-lease" {
            (mut requests).push("")
        } else if arg.starts_with("--force-with-lease=") {
            (mut requests).push(arg[19..])
        } else if arg == "--no-force-with-lease" {
            requests = List[str]()
        } else if arg.starts_with("-") {
            return Unsupported("push option {arg}")
        } else {
            (mut operands).push(copy arg)
        }
    }
    let repo = repository.discover(".")?
    let branch = remote.current_branch(repo)?
    var name = "", url = "", input = List[str]()
    if operands.len > 0 {
        if operands[0].contains("://") || transport.ssh_form(operands[0]) {
            url = copy operands[0]
        } else {
            name = copy operands[0]
            url = remote.url(repo, name, true)?
        }
        input = operands[1..]
    } else {
        name = remote.default_name(repo, true)?
        url = remote.url(repo, name, true)?
    }
    if input.len == 0 {
        if branch == "" { return Unsupported("push default while detached") }
        let policy = repo.config["push.default"] else "simple"
        var destination = "refs/heads/{branch}"
        if !upstream && policy != "current" {
            if policy != "simple" && policy != "upstream" {
                return Unsupported("push.default={policy}")
            }
            let merge = repo.config["branch.{branch}.merge"] else ""
            if merge == "" { return Unsupported("push branch has no upstream") }
            if policy == "simple" && merge != destination {
                return Unsupported("push simple upstream name differs")
            }
            destination = merge
        }
        (mut input).push("refs/heads/{branch}:{destination}")
    }
    let program = if receive != "" {
        copy receive
    } else if name != "" {
        repo.config["remote.{name}.receivepack"] else ""
    } else {
        ""
    }
    let service_state = override_service("DEN_RECEIVE_PACK", program)?
    defer restore_service(take service_state)
    var plans = List[PushPlan](), refused = List[str]()
    for raw in input {
        let refusal = push_source(repo, raw, branch, mut plans)?
        if refusal != "" { (mut refused).push(refusal) }
    }
    if refused.len == 0 {
        return push_planned(repo, url, name, plans, requests, force, atomic, quiet, upstream)
    }
    for refusal in refused { eprint(refusal) }
    eprint("error: failed to push some refs to '{transport.redact(url)}'")
    1
}

// The connected half of perform_push: place, lease, send and report.
fn push_planned(
    repo: repository.Repo,
    url: str,
    name: str,
    plans: List[PushPlan],
    requests: List[str],
    force: bool,
    atomic: bool,
    quiet: bool,
    upstream: bool,
) -> int ! object.StoreErrors {
    var outcomes = List[PushOutcome](),
        refused = List[str](),
        error_text = "",
        remote_failure = "",
        http_fatal = false
    push_plans(
        repo,
        url,
        plans,
        force,
        atomic,
        [],
        name,
        requests,
        mut outcomes,
        mut refused,
    ) else |e| match e {
        Unsupported(message) => {
            if message == "HTTP receive-pack fatal" { http_fatal = true }
            if message == "remote service unavailable" || message.starts_with("remote error: ") {
                remote_failure = copy message
            }
            error_text = "{e}"
        },
        _ => { error_text = "{e}" },
    }
    if http_fatal {
        eprint(
            "fatal: the remote end hung up unexpectedly\nfatal: the remote end hung up unexpectedly",
        )
        let safe_url = transport.redact(url)
        eprint("error: failed to push some refs to '{safe_url}'")
        return 1
    }
    if remote_failure != "" && startup_diagnostic(remote_failure) { return 128 }
    if refused.len > 0 {
        for refusal in refused { eprint(refusal) }
        eprint("error: failed to push some refs to '{transport.redact(url)}'")
        return 1
    }
    var rejected = false
    for outcome in outcomes {
        if outcome.status == "rejected" || outcome.status == "remote rejected" { rejected = true }
    }
    if error_text != "" && !rejected { return Unsupported("push: {error_text}") }
    publish_push_tracking(repo, name, outcomes, upstream, quiet)?
    let failed = push_report(repo, url, outcomes, quiet)?
    if error_text != "" && !failed { return Unsupported("push: {error_text}") }
    if failed then 1 else 0
}

/// Push porcelain keeps deterministic local rejection status separate from
/// unmeasured transport/IO diagnostics, which remain named refusals.
pub fn push_command(args: List[str]) -> int {
    // R-vc25-3: Git's push recurses into submodules on demand under
    // submodule.recurse=true or push.recurseSubmodules (git-config(1)); den
    // refuses those forms by name rather than push without the check.
    var recurse = ""
    for arg in args[1..] {
        if arg == "--no-recurse-submodules" {
            recurse = "no"
        } else if arg.starts_with("--recurse-submodules=") {
            recurse = arg[21..]
        } else if arg == "--recurse-submodules" {
            recurse = "on-demand"
        }
    }
    if recurse == "" {
        let repo = repository.discover(".") else |_| { return push_rest(args) }
        recurse = (repo.config["push.recursesubmodules"] else "").lower()
        if recurse == "" {
            let general = (repo.config["submodule.recurse"] else "false").lower()
            if general == "true" || general == "yes" || general == "on" || general == "1" {
                recurse = "on-demand"
            }
        }
    }
    if recurse != "" && recurse != "no" && recurse != "false" {
        eprint("den: not yet implemented: push --recurse-submodules={recurse} (vc25b)")
        return 2
    }
    push_rest(args)
}

fn push_rest(args: List[str]) -> int {
    var plain = List[str]()
    for arg in args {
        if arg == "--no-recurse-submodules" || arg == "--recurse-submodules=no" { continue }
        (mut plain).push(copy arg)
    }
    perform_push(plain) else |e| { eprint("den: wire: {transport.redact("{e}")}"); 2 }
}
