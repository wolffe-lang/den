use object
use oid
use refs
use remote
use repository

fn local_fetch_command(operands: List[str], quiet: bool, force: bool) -> () ! object.StoreErrors {
    if operands.len == 0 || operands.len > 2 { return Unsupported("local fetch refspec count") }
    let repo = repository.discover(".")?
    let url = operands[0]
    var source = "HEAD", destination = "", forced = force
    if operands.len == 2 {
        let raw = operands[1]
        forced = force || raw.starts_with("+")
        let spec = if raw.starts_with("+") then raw[1..] else raw
        let pair = spec.split(":")
        if pair.len > 2 || pair[0] == "" { return Unsupported("local fetch refspec") }
        source = if pair[0] == "HEAD" || pair[0].starts_with("refs/") {
            copy pair[0]
        } else {
            "refs/heads/{pair[0]}"
        }
        if pair.len == 2 { destination = copy pair[1] }
    }
    var action = "fetch"
    if quiet { action = "{action} -q" }
    for operand in operands { action = "{action} {operand}" }
    let identity = remote.reflog_identity(repo)?
    write_fetch_head(repo, "")?
    let before = if destination == "" then List[oid.Oid]() else refs.optional(repo, destination)?
    var id = ""
    if destination != "" {
        fetch_into_context(repo, url, source, destination, forced, identity, action)?
        id = oid.hex(refs.read(repo, destination)?)?
    } else {
        for record in fetch_view(repo, url, source, true)? {
            if record.name == source && record.id != "unborn" { id = copy record.id }
        }
        if id == "" { return Unsupported("couldn't find remote ref {source}") }
    }
    let description = if source == "HEAD" {
        fetch_url(url)
    } else if source.starts_with("refs/heads/") {
        "branch '{source[11..]}' of {fetch_url(url)}"
    } else if source.starts_with("refs/tags/") {
        "tag '{source[10..]}' of {fetch_url(url)}"
    } else {
        "'{source}' of {fetch_url(url)}"
    }
    var fetch_head = "{id}\t\t{description}\n"
    var rows = List[TransportRow]()
    if destination == "" {
        (mut rows).push(TransportRow {
            flag: "*",
            summary: "branch",
            source: short_ref(source),
            destination: "FETCH_HEAD",
            reason: "",
        })
    } else if before.len == 0 {
        (mut rows).push(TransportRow {
            flag: "*",
            summary: "[new branch]",
            source: short_ref(source),
            destination: short_ref(destination),
            reason: "",
        })
    } else if oid.hex(before[0])? != id {
        let old = oid.hex(before[0])?
        let forward = ancestor(repo, old, id)?
        (mut rows).push(TransportRow {
            flag: if forward then " " else "+",
            summary: if forward {
                "{report_id(repo, old)?}..{report_id(repo, id)?}"
            } else {
                "{report_id(repo, old)?}...{report_id(repo, id)?}"
            },
            source: short_ref(source),
            destination: short_ref(destination),
            reason: if forward then "" else "forced update",
        })
    }
    if source != "HEAD" {
        let followed = fetch_tags(repo, url, [id], identity, action, mut rows)?
        fetch_head = "{fetch_head}{followed}"
    }
    write_fetch_head(repo, fetch_head)?
    if !quiet { fetch_report(repo, url, rows)? }
}
