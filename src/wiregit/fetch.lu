use std.fs
use index
use object
use oid
use pack
use refs
use repository
use transport
use wire
use worktree

/// Negotiate v2 for the ordinary clone view (HEAD, branches and tags), importing
/// canonical objects and validating every selected closure before returning refs.
pub fn fetch_objects(repo: repository.Repo, url: str) -> List[wire.Ref] ! object.StoreErrors {
    fetch_selected(repo, url, "", [], true, true)?
}

fn fetch_view(
    repo: repository.Repo,
    url: str,
    source: str,
    download: bool,
) -> List[wire.Ref] ! object.StoreErrors {
    fetch_selected(repo, url, source, [], download, false)?
}

/// Fetch exactly the named remote refs' objects (an explicit refspec's
/// sources, already listed), validating their closures; returns those refs.
pub fn fetch_names(
    repo: repository.Repo,
    url: str,
    names: List[str],
) -> List[wire.Ref] ! object.StoreErrors {
    fetch_selected(repo, url, "", names, true, false)?
}

// keep: a clone keeps the received pack whatever its size; a fetch keeps it
// at 100 objects or more (publish_received). names, when given, selects
// exactly those refs instead of source's prefix.
fn fetch_selected(
    repo: repository.Repo,
    url: str,
    source: str,
    names: List[str],
    download: bool,
    keep: bool,
) -> List[wire.Ref] ! object.StoreErrors {
    let opened = wire_url(repo.gitdir, repo.config, url, false)?
    transport.check_http_configuration(opened, repo.config)?
    object_checks(repo.config, "fetch")?
    var p = transport.peer(opened, "upload-pack")?
    var active = true
    defer { if active { let _ = transport.close_peer(mut p) else 1 } }
    let advertisement = transport.advertisement(mut p, 65536)?
    if advertisement.len == 0 { return Unsupported("remote service unavailable") }
    let remote_message = remote_error(advertisement)?
    if remote_message != "" { return Unsupported(remote_message) }
    let caps = wire.capabilities(advertisement) else |_| {
        return Unsupported("remote does not advertise protocol v2")
    }
    if !wire.supports(caps, "ls-refs") || !wire.supports(caps, "fetch") {
        return Unsupported("v2 ls-refs/fetch unavailable")
    }
    for cap in caps {
        if cap.starts_with("object-format=") && cap != "object-format=sha1" {
            return Unsupported("remote object format")
        }
    }
    var args = ["symrefs", "peel"]
    for cap in caps {
        if cap.starts_with("ls-refs=") {
            for feature in cap[8..].split(" ") {
                if feature == "unborn" { (mut args).push("unborn") }
            }
        }
    }
    if names.len > 0 {
        for name in names { (mut args).push("ref-prefix {name}") }
    } else if source == "" {
        for prefix in ["HEAD", "refs/heads/", "refs/tags/"] {
            (mut args).push("ref-prefix {prefix}")
        }
    } else {
        (mut args).push("ref-prefix {source}")
    }
    let request = wire.request("ls-refs", args)?
    let response = transport.exchange(mut p, request, 2097152)?
    let received = wire.parse_refs(response)?
    var advertised = List[wire.Ref]()
    for reference in received {
        var named = false
        for name in names { if reference.name == name { named = true } }
        let selected = if names.len > 0 {
            named
        } else if source != "" {
            reference.name == source || source.ends_with("/") && reference.name.starts_with(source)
        } else {
            reference.name == "HEAD" ||
                reference.name.starts_with("refs/heads/") ||
                reference.name.starts_with("refs/tags/")
        }
        if selected { (mut advertised).push(copy reference) }
    }
    if !download {
        transport.end_peer(p)?
        let status = transport.close_peer(mut p)?
        active = false
        if status != 0 { return io }
        return advertised
    }
    var wants = List[str](), haves = List[str](), wanted = Map[str, bool](), had = Map[str, bool]()
    for reference in refs.list(repo, "refs/")? {
        let name = oid.hex(reference.id)?
        let body = object.read_object(repo, reference.id, 16777216)?
        if body.kind == "commit" && !(had[name] else false) {
            (mut haves).push(copy name)
            had[name] = true
        }
    }
    for reference in advertised {
        if reference.id == "unborn" || (wanted[reference.id] else false) { continue }
        wanted[reference.id] = true
        let _ = object.read_object(
            repo,
            oid.parse("sha1", reference.id)?,
            16777216,
        ) else |e| match e {
            not_found => { (mut wants).push(copy reference.id); continue },
            invalid => { return invalid },
            invalid_oid => { return invalid_oid },
            unsupported_format => { return unsupported_format },
            bad_header => { return bad_header },
            bad_size => { return bad_size },
            bad_oid => { return bad_oid },
            truncated => { return truncated },
            dictionary => { return dictionary },
            checksum => { return checksum },
            limit => { return limit },
            trailing => { return trailing },
            unsupported_level => { return unsupported_level },
            denied => { return denied },
            io => { return io },
            exists => { return exists },
            unsupported => { return unsupported },
            ambiguous => { return ambiguous },
            cross_device => { return cross_device },
            Unsupported(text) => { return Unsupported(text) },
        }
    }
    var roots = List[str]()
    for reference in advertised {
        if reference.id != "unborn" { (mut roots).push(copy reference.id) }
    }
    // A full object id as the source is wanted directly, as a submodule
    // update asks for a recorded commit no advertised ref reaches (vc25).
    if object_id(source) {
        (mut wants).push(copy source)
        (mut roots).push(copy source)
    }
    if wants.len > 0 {
        // vc23 (den#61): the response streams to disk and is indexed there,
        // never held. No thin-pack: the received pack is self-contained, so
        // it is installed as it arrived (git-index-pack(1) appends bases).
        let request = wire.fetch_request(wants, haves, false)?
        var stream = transport.begin_stream(mut p, request)?
        let received = receive_pack(repo, mut stream)?
        defer pack.received_discard(received)
        transport.end_stream(mut p, take stream)?
        publish_received(repo, received, keep)?
        closure_received(repo, roots, received)?
    } else {
        let _ = closure(repo, roots, [])?
    }
    transport.end_peer(p)?
    let code = transport.close_peer(mut p)?
    active = false
    if code != 0 { return io }
    advertised
}

fn update(repo: repository.Repo, name: str, id: str) -> () ! object.StoreErrors {
    let before = refs.optional(repo, name)?
    refs.update(
        repo,
        name,
        before,
        [oid.parse("sha1", id)?],
        "Den Transport <den@example.invalid> 0 +0000",
        "fetch",
        false,
    )?
}

/// Bare clone through the same selection and publication path as normal clone.
pub fn clone_bare(url: str, destination: str) -> () ! object.StoreErrors {
    clone_repository(url, destination, true)?
}

fn checkout_clone(repo: repository.Repo, root: str, id: oid.Oid) -> () ! worktree.WorkErrors {
    let absolute = fs.realpath(root)?
    let ctx = worktree.Context { repo: copy repo, root: copy absolute, cwd: absolute, prefix: "" }
    let tree = worktree.flatten_tree(repo, id)?
    var tx = index.begin(repo, 16777216, worktree.index_version(ctx)?)?
    defer index.abort(mut tx)
    worktree.transition(ctx, mut tx.value, tree, "hard")?
    index.commit(mut tx)?
}

/// Clone into an exclusively created destination. Normal clones project the
/// selected HEAD through the shared worktree/index transaction, never a second
/// checkout implementation. Existing destination directories are refused.
/// A failed clone removes the directory this call created, as the pinned Git
/// does (R-vc22-6, measured black-box); nothing it did not create is touched.
pub fn clone_repository(url: str, destination: str, bare: bool) -> () ! object.StoreErrors {
    let _ = clone_mode(url, destination, bare, true)?
}

// True when the cloned repository had no refs (Git's empty-repository
// warning). An existing empty directory is filled, and on failure emptied
// again but kept, as Git keeps it; one this call creates is removed.
fn clone_mode(url: str, destination: str, bare: bool, local: bool) -> bool ! object.StoreErrors {
    if url.contains("\n") || url.contains("\r") { return invalid }
    let existed = fs.exists(destination)
    if existed && (!fs.is_dir(destination) || fs.entries(destination)?.len > 0) { return exists }
    if !existed { fs.create_dir(destination)? }
    var complete = false
    defer {
        if !complete {
            if existed {
                for entry in fs.entries(destination) else List[fs.Entry]() {
                    let name = str_from_utf8(entry.name) else ""
                    let path = "{destination}/{name}"
                    if name == "" { continue }
                    if fs.is_dir(path) {
                        fs.remove_dir_all(path) else |_| {}
                    } else {
                        fs.remove(path) else |_| {}
                    }
                }
            } else {
                fs.remove_dir_all(destination) else |_| {}
            }
        }
    }
    let empty = clone_created(url, destination, bare, local)?
    complete = true
    empty
}

fn clone_created(url: str, destination: str, bare: bool, local: bool) -> bool ! object.StoreErrors {
    let (repo, _) = repository.init(destination, bare, "main")?
    clone_into(repo, url, destination, bare, local, true)?
}

/// The directory `clone` makes from its operands (a repository and at most
/// one directory), as the clone command derives it; "" when there is none.
pub fn clone_destination(operands: List[str], bare: bool) -> str {
    if operands.len == 2 { return copy operands[1] }
    if operands.len == 1 { return clone_name(operands[0], bare) }
    ""
}

/// Clone URL into a submodule's own gitdir GITDIR, whose core.worktree is
/// WORKTREE (relative to GITDIR), without a checkout: the submodule layer
/// detaches HEAD at the recorded commit (vc25). A failure removes GITDIR.
pub fn clone_submodule(url: str, gitdir: str, worktree: str) -> () ! object.StoreErrors {
    if url.contains("\n") || url.contains("\r") { return invalid }
    if fs.exists(gitdir) { return exists }
    var complete = false
    defer { if !complete { fs.remove_dir_all(gitdir) else |_| {} } }
    let (repo, _) = repository.init_with(gitdir, false, "main", worktree)?
    let _ = clone_into(repo, url, gitdir, false, true, false)?
    complete = true
}

fn clone_into(
    repo: repository.Repo,
    url: str,
    destination: str,
    bare: bool,
    local: bool,
    checkout: bool,
) -> bool ! object.StoreErrors {
    let plain = transport.local_path(url)
    if plain { protocol_check(repo.config, url)? }
    let advertised = if plain && local {
        clone_local_objects(repo, url)?
    } else {
        fetch_objects(repo, url)?
    }
    var selected = wire.Ref { name: "HEAD", id: "unborn", target: "", peeled: "" }
    for reference in advertised { if reference.name == "HEAD" { selected = copy reference } }
    var packed = List[refs.Packed]()
    for reference in advertised {
        if reference.name == "HEAD" || reference.id == "unborn" { continue }
        var name = copy reference.name
        if name.starts_with("refs/heads/") {
            let body = object.read_object(repo, oid.parse("sha1", reference.id)?, 16777216)?
            if body.kind != "commit" { return invalid }
        }
        if !bare && name.starts_with("refs/heads/") { name = "refs/remotes/origin/{name[11..]}" }
        // Every transport's clone packs its refs, as the pinned Git's does
        // (vc25: loose refs differed byte for byte from Git's file:// clone).
        (mut packed).push(refs.Packed {
            name: name,
            id: oid.parse("sha1", reference.id)?,
            peeled: if reference.peeled == "" {
                List[oid.Oid]()
            } else {
                [oid.parse("sha1", reference.peeled)?]
            },
        })
    }
    if packed.len > 0 {
        var file = fs.create_new_with_mode("{repo.gitdir}/packed-refs", 0o666)?
        defer fs.close(take file) else |_| {}
        let bytes = refs.packed_bytes(packed, "peeled fully-peeled")?
        fs.write_chunk(mut file, bytes)?
        fs.sync(mut file)?
    }
    if fs.is_dir("{repo.gitdir}/hooks") && fs.entries("{repo.gitdir}/hooks")?.len == 0 {
        fs.remove_dir("{repo.gitdir}/hooks")?
    }
    if !bare && selected.id != "unborn" && selected.target != "" {
        if !selected.target.starts_with("refs/heads/") {
            return Unsupported("clone HEAD outside refs/heads")
        }
        update(repo, selected.target, selected.id)?
        let remote_head = refs.administrative(repo, "refs/remotes/origin/HEAD", true)?
        var symbolic = fs.create_new_with_mode(remote_head, 0o666)?
        defer fs.close(take symbolic) else |_| {}
        fs.write(mut symbolic, "ref: refs/remotes/origin/{selected.target[11..]}\n")?
        fs.sync(mut symbolic)?
    }
    let raw = repository.read_bytes("{repo.gitdir}/HEAD", 4096)?
    let old = str_from_utf8(raw) else |_| { return invalid }
    let next = if selected.target != "" {
        "ref: {selected.target}\n"
    } else if selected.id != "unborn" {
        "{selected.id}\n"
    } else {
        copy old
    }
    let after = if selected.id == "unborn" {
        List[oid.Oid]()
    } else {
        [oid.parse("sha1", selected.id)?]
    }
    refs.set_head(
        repo,
        old,
        next,
        [],
        after,
        "Den Transport <den@example.invalid> 0 +0000",
        "clone",
    )?
    var config = fs.open_append("{repo.gitdir}/config")?
    defer fs.close(take config) else |_| {}
    let configured_url = if plain && !url.starts_with("/") {
        "{fs.realpath(".")?}/{url}"
    } else {
        copy url
    }
    // Quoted only where config syntax needs it, as Git writes it (vc25).
    let quoted = repository.config_quote(configured_url)?
    fs.write(mut config, "[remote \"origin\"]\n\turl = {quoted}\n")?
    if !bare {
        fs.write(mut config, "\tfetch = +refs/heads/*:refs/remotes/origin/*\n")?
        if selected.target.starts_with("refs/heads/") {
            let branch = selected.target[11..].replace("\"", "\\\"")
            fs.write(
                mut config,
                "[branch \"{branch}\"]\n\tremote = origin\n\tmerge = {selected.target}\n",
            )?
        }
    }
    fs.sync(mut config)?
    if checkout && !bare && after.len == 1 {
        checkout_clone(repo, destination, after[0]) else |e| {
            return Unsupported("clone checkout: {e}")
        }
    }
    for reference in advertised { if reference.id != "unborn" { return false } }
    true
}

/// Fetch a single fully-qualified source ref into a single fully-qualified destination; preserve errors.
pub fn fetch_into(
    repo: repository.Repo,
    url: str,
    source: str,
    destination: str,
    force: bool,
) -> () ! object.StoreErrors {
    fetch_into_context(
        repo,
        url,
        source,
        destination,
        force,
        "Den Transport <den@example.invalid> 0 +0000",
        "",
    )?
}

fn fetch_into_context(
    repo: repository.Repo,
    url: str,
    source: str,
    destination: str,
    force: bool,
    identity: str,
    action: str,
) -> () ! object.StoreErrors {
    if !refs.valid(source) || !refs.valid(destination) { return invalid }
    if (repo.config["core.bare"] else "false") != "true" {
        let head = str_from_utf8(repository.read_bytes("{repo.gitdir}/HEAD", 4096)?) else |_| {
            return invalid
        }
        if head.trim() == "ref: {destination}" {
            return Unsupported("fetch into checked-out branch")
        }
    }
    let advertised = fetch_view(repo, url, source, true)?
    for reference in advertised {
        if reference.name == source && reference.id != "unborn" {
            let before = refs.optional(repo, destination)?
            if destination.starts_with("refs/heads/") {
                let body = object.read_object(repo, oid.parse("sha1", reference.id)?, 16777216)?
                if body.kind != "commit" { return invalid }
            }
            if before.len > 0 && !force {
                let old = oid.hex(before[0])?
                if old != reference.id && destination.starts_with("refs/tags/") {
                    return Unsupported("fetch would replace tag (use force)")
                }
                if destination.starts_with("refs/heads/") && !ancestor(repo, old, reference.id)? {
                    return Unsupported("non-fast-forward fetch (use force)")
                }
            }
            var message = "fetch"
            if action != "" {
                var reason = if source.starts_with("refs/tags/") {
                    "storing tag"
                } else {
                    "storing head"
                }
                if before.len > 0 {
                    reason = if destination.starts_with("refs/tags/") {
                        "updating tag"
                    } else if ancestor(repo, oid.hex(before[0])?, reference.id)? {
                        "fast-forward"
                    } else {
                        "forced-update"
                    }
                }
                message = "{action}: {reason}"
            }
            refs.update(
                repo,
                destination,
                before,
                [oid.parse("sha1", reference.id)?],
                identity,
                message,
                false,
            )?
            return
        }
    }
    not_found
}

fn object_id(text: str) -> bool {
    if text.len != 40 { return false }
    for b in text.bytes() {
        let n = b as int
        if !(n >= 48 && n <= 57 || n >= 97 && n <= 102) { return false }
    }
    true
}

/// Fetch the commit SHA by id from URL into REPO (git-submodule(1) update's
/// direct fetch), refusing by the server's own words when it will not
/// serve it (vc25).
pub fn fetch_commit(repo: repository.Repo, url: str, sha: str) -> () ! object.StoreErrors {
    if !object_id(sha) { return invalid }
    let _ = fetch_selected(repo, url, sha, [], true, false)?
}
