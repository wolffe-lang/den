use std.fs
use object
use oid
use pack
use pktline
use refs
use repository
use revision
use transport
use wire

fn zero() -> str { "0000000000000000000000000000000000000000" }

struct PushUpdate { name: str, before: str, after: str }

/// Expected advertised value for one fully qualified destination; zero means absent.
pub struct PushLease { name: str, expected: str }

/// One planned/reported ref outcome. Only `ok` and `up-to-date` are successes;
/// `pending` never establishes that the server accepted an update.
pub struct PushOutcome { source: str, name: str, before: str, after: str, status: str, reason: str }

fn reject_push(mut outcomes: List[PushOutcome], reason: str) {
    let at = outcomes.len - 1
    outcomes[at].status = "rejected"
    outcomes[at].reason = copy reason
}

fn ids(text: str) -> List[oid.Oid] ! object.StoreErrors {
    if text == zero() { return List[oid.Oid]() }
    [oid.parse("sha1", text)?]
}

fn receive_advertisement(data: List[byte]) -> (List[wire.Ref], List[str]) ! object.StoreErrors {
    var pos = 0, out = List[wire.Ref](), caps = List[str](), first = true, seen = Map[str, bool]()
    while pos < data.len {
        let p = pktline.decode(data, pos)?
        pos = p.next
        if p.kind == 0 { if pos != data.len { return invalid }; return (out, caps) }
        if p.kind != 4 || out.len > 10000 { return invalid }
        let text = str_from_utf8(p.data) else |_| {
            return Unsupported("non-UTF-8 push advertisement")
        }
        let nul = text.split("\0")
        if first {
            if nul.len != 2 { return invalid }
            caps = nul[1].trim().split(" ")
        } else if nul.len != 1 {
            return invalid
        }
        first = false
        let fields = pktline.text(nul[0].bytes())?.split(" ")
        if fields.len != 2 { return invalid }
        let id = oid.hex(oid.parse("sha1", fields[0])?)?
        if fields[1] == "capabilities^{{}}" && id == zero() { continue }
        if !refs.valid(fields[1]) || (seen[fields[1]] else false) { return invalid }
        seen[fields[1]] = true
        (mut out).push(wire.Ref { name: copy fields[1], id: id, target: "", peeled: "" })
    }
    truncated
}

/// Push fully-qualified refspecs, with local fast-forward/tag guards unless
/// forced; honor server atomic/report-status capabilities and final status.
/// Other namespaces compare fully peeled commits; non-commit updates need force.
pub fn push(
    repo: repository.Repo,
    url: str,
    specs: List[str],
    force: bool,
    atomic: bool,
) -> () ! object.StoreErrors {
    var outcomes = List[PushOutcome]()
    push_reported(repo, url, specs, force, atomic, [], mut outcomes)?
}

/// One push refspec resolved locally (git-push(1) <refspec>): the source as
/// typed; the full ref it names, or HEAD, or empty for another revision or a
/// deletion; the ref a short destination's namespace is inferred from (a
/// branch for an attached HEAD); the object id and type (empty for a
/// deletion); the destination as typed or full.
pub struct PushPlan {
    force: bool,
    typed: str,
    source: str,
    namespace: str,
    id: str,
    kind: str,
    destination: str,
}

/// Push fully qualified "SRC:DST" refspecs with checked leases and retained
/// per-ref outcomes; the output list must start empty.
pub fn push_reported(
    repo: repository.Repo,
    url: str,
    specs: List[str],
    force: bool,
    atomic: bool,
    leases: List[PushLease],
    mut outcomes: List[PushOutcome],
) -> () ! object.StoreErrors {
    if specs.len == 0 || specs.len > 10000 { return invalid }
    var plans = List[PushPlan]()
    for raw in specs {
        let override = raw.starts_with("+")
        let spec = if override then raw[1..] else copy raw
        let parts = spec.split(":")
        if parts.len != 2 || !refs.valid(parts[1]) { return invalid }
        var id = "", kind = ""
        if parts[0] != "" {
            let resolved = object.resolve(repo, parts[0])?
            id = oid.hex(resolved)?
            kind = copy object.read_object(repo, resolved, 16777216)?.kind
        }
        (mut plans).push(PushPlan {
            force: override,
            typed: copy parts[0],
            source: copy parts[0],
            namespace: copy parts[0],
            id: id,
            kind: kind,
            destination: copy parts[1],
        })
    }
    var refused = List[str]()
    push_plans(repo, url, plans, force, atomic, leases, "", [], mut outcomes, mut refused)?
    if refused.len > 0 { return Unsupported(refused[0]) }
}

// gitrevisions(7)'s <refname> order after the name itself: the remote's refs
// a short push destination names, at most one of each spelling.
fn remote_matches(remote: List[wire.Ref], name: str) -> List[str] {
    var out = List[str]()
    for spelling in [
        "refs/{name}",
        "refs/tags/{name}",
        "refs/heads/{name}",
        "refs/remotes/{name}",
        "refs/remotes/{name}/HEAD",
    ] {
        for reference in remote {
            if reference.name == spelling { (mut out).push(copy spelling); break }
        }
    }
    out
}

// git-push(1) <refspec>: a destination outside refs/ is the one remote ref
// it names, else the source's namespace (refs/heads/ or refs/tags/), else
// Git's refusal (returned as its lines; the caller adds the failed-push line).
fn place_destination(repo: repository.Repo, remote: List[wire.Ref], plan: PushPlan) -> (str, str) {
    let wanted = plan.destination
    if wanted.starts_with("refs/") { return (copy wanted, "") }
    let found = remote_matches(remote, wanted)
    if found.len > 1 { return ("", "error: dst refspec {wanted} matches more than one") }
    if found.len == 1 { return (copy found[0], "") }
    if plan.namespace.starts_with("refs/heads/") { return ("refs/heads/{wanted}", "") }
    if plan.namespace.starts_with("refs/tags/") { return ("refs/tags/{wanted}", "") }
    if plan.id == "" {
        return ("", "error: unable to delete '{wanted}': remote ref does not exist")
    }
    var text = "error: The destination you provided is not a full refname (i.e.,\nstarting with \"refs/\"). We tried to guess what you meant by:\n\n- Looking for a ref that matches '{wanted}' on the remote side.\n- Checking if the <src> being pushed ('{plan.typed}')\n  is a ref in \"refs/{{heads,tags}}/\". If so we add a corresponding\n  refs/{{heads,tags}}/ prefix on the remote side.\n\nNeither worked, so we gave up. You must fully qualify the ref."
    if (repo.config["advice.pushunqualifiedrefname"] else "true") != "false" {
        let (verb, space) = match plan.kind {
            "commit" => ("create a new branch", "heads"),
            "tag" => ("create a new tag", "tags"),
            "tree" => ("tag a new tree", "tags"),
            _ => ("tag a new blob", "tags"),
        }
        text = "{text}\nhint: The <src> part of the refspec is a {plan.kind} object.\nhint: Did you mean to {verb} by pushing to\nhint: '{plan.typed}:refs/{space}/{wanted}'?"
    }
    ("", text)
}

/// Push resolved plans with checked leases and retained per-ref outcomes. The
/// output list must start empty. Short destinations are placed against the
/// advertisement (place_destination); Git's refusals are collected in
/// refused and nothing is sent. Leases named by requests (push_leases) are
/// taken once every destination is placed. Local rejections precede
/// transmission; the wire CAS still uses the advertisement's old value,
/// never the tracking ref's unchecked value.
pub fn push_plans(
    repo: repository.Repo,
    url: str,
    plans: List[PushPlan],
    force: bool,
    atomic: bool,
    given: List[PushLease],
    name: str,
    requests: List[str],
    mut outcomes: List[PushOutcome],
    mut refused: List[str],
) -> () ! object.StoreErrors {
    if plans.len == 0 || plans.len > 10000 || given.len > 10000 || outcomes.len != 0 {
        return invalid
    }
    let opened = wire_url(repo.gitdir, repo.config, url, true)?
    transport.check_http_configuration(opened, repo.config)?
    var p = transport.peer(opened, "receive-pack")?
    var active = true, started = false, advertised = false
    defer {
        if active {
            if advertised && !started { transport.end_peer(p) else |_| {} }
            let _ = transport.close_peer(mut p) else 1
        }
    }
    let advertisement = transport.advertisement(mut p, 2097152)?
    if advertisement.len == 0 { return Unsupported("remote service unavailable") }
    let remote_message = remote_error(advertisement)?
    if remote_message != "" { return Unsupported(remote_message) }
    let (remote, caps) = receive_advertisement(advertisement)?
    advertised = true
    if !wire.supports(caps, "report-status") {
        return Unsupported("push server lacks report-status")
    }
    if atomic && !wire.supports(caps, "atomic") {
        return Unsupported("server does not support --atomic push")
    }
    for cap in caps {
        if cap.starts_with("object-format=") && cap != "object-format=sha1" {
            return unsupported_format
        }
    }
    var before = Map[str, str](),
        updates = List[PushUpdate](),
        seen = Map[str, bool](),
        positions = Map[str, int](),
        roots = List[str]()
    for reference in remote { before[reference.name] = copy reference.id }
    var placed = List[str](), specs = List[str]()
    for plan in plans {
        let (destination, refusal) = place_destination(repo, remote, plan)
        if refusal != "" {
            (mut refused).push(refusal)
            (mut placed).push("")
            continue
        }
        if !refs.valid(destination) { return invalid }
        (mut placed).push(copy destination)
        (mut specs).push("{plan.source}:{destination}")
    }
    if refused.len > 0 { return }
    var leases = copy given
    if requests.len > 0 {
        leases = push_leases(repo, name, specs, requests)?
    }
    var leased_names = Map[str, bool]()
    for lease in leases {
        if !refs.valid(lease.name) || (leased_names[lease.name] else false) { return invalid }
        let _ = oid.parse("sha1", lease.expected)?
        leased_names[lease.name] = true
    }
    for at in 0..plans.len {
        let plan = copy plans[at]
        let override = plan.force
        let destination = placed[at]
        if seen[destination] else false { return invalid }
        seen[destination] = true
        let old = before[destination] else zero()
        var next = copy zero()
        if plan.id != "" {
            next = copy plan.id
            if destination.starts_with("refs/heads/") && plan.kind != "commit" {
                return Unsupported("push branch target must be a commit")
            }
        } else if !wire.supports(caps, "delete-refs") {
            return Unsupported("server does not support delete-refs")
        }
        if next == zero() && old == zero() { return Unsupported("remote ref does not exist") }
        positions[destination] = outcomes.len
        (mut outcomes).push(PushOutcome {
            source: if plan.source == "" then copy plan.typed else copy plan.source,
            name: copy destination,
            before: copy old,
            after: copy next,
            status: if next == old then "up-to-date" else "pending",
            reason: "",
        })
        if next == old { continue }
        var leased = false
        if !force && !override {
            for lease in leases {
                if lease.name != destination { continue }
                if lease.expected != old {
                    reject_push(mut outcomes, "stale info")
                    return Unsupported("stale info")
                }
                leased = true
            }
        }
        if old != zero() && next != zero() && !force && !override && !leased {
            if destination.starts_with("refs/tags/") {
                reject_push(mut outcomes, "already exists")
                return Unsupported("push would replace tag (use --force)")
            }
            let old_id = oid.parse("sha1", old)?, next_id = oid.parse("sha1", next)?
            let _ = object.read_object(repo, old_id, 16777216) else |_| {
                reject_push(mut outcomes, "fetch first")
                return Unsupported("push needs fetch first")
            }
            let old_tip = revision.peel(repo, old_id, "peel") else |e| {
                return Unsupported("push old tag peel: {e}")
            }
            let next_tip = revision.peel(repo, next_id, "peel") else |e| {
                return Unsupported("push new tag peel: {e}")
            }
            if object.read_object(repo, old_tip, 16777216)?.kind != "commit" ||
                object.read_object(repo, next_tip, 16777216)?.kind != "commit" {
                reject_push(mut outcomes, "needs force")
                return Unsupported("push non-commit update requires force")
            }
            if !ancestor(repo, oid.hex(old_tip)?, oid.hex(next_tip)?)? {
                reject_push(mut outcomes, "non-fast-forward")
                return Unsupported("non-fast-forward push (use --force)")
            }
        }
        if next != zero() { (mut roots).push(copy next) }
        (mut updates).push(PushUpdate { name: copy destination, before: copy old, after: next })
    }
    if updates.len == 0 {
        started = true
        transport.end_peer(p)?
        active = false
        let status = transport.close_peer(mut p)?
        if status != 0 { return io }
        return
    }
    let sideband = transport.http_form(url) && wire.supports(caps, "side-band-64k")
    var selected = "report-status"
    if sideband { selected = "{selected} side-band-64k" }
    if wire.supports(caps, "ofs-delta") { selected = "{selected} ofs-delta" }
    if wire.supports(caps, "quiet") { selected = "{selected} quiet" }
    if wire.supports(caps, "object-format") { selected = "{selected} object-format=sha1" }
    if atomic { selected = "{selected} atomic" }
    var request = List[byte]()
    for i in 0..updates.len {
        let u = copy updates[i]
        let extra = if i == 0 then "\0{selected}" else ""
        wire.append(mut request, pktline.encode("{u.before} {u.after} {u.name}{extra}\n".bytes())?)
    }
    wire.append(mut request, "0000".bytes())
    started = true
    if roots.len > 0 { wire.append(mut request, pack_for(repo, roots, [], "ofs")?) }
    var response = transport.exchange(mut p, request, 2097152)?
    if sideband {
        let decoded = transport.http_receive_sideband(response)?
        if decoded.progress.len > 0 {
            let text = str_from_utf8(decoded.progress) else |_| {
                return Unsupported("HTTP non-UTF-8 sideband diagnostic")
            }
            let safe = transport.redact(text)
            fs_write_chunk(2, safe.bytes())?
        }
        if decoded.fatal { return Unsupported("HTTP receive-pack fatal") }
        response = decoded.report
    }
    var pos = 0, unpacked = false, reported = Map[str, bool](), failed = false
    while pos < response.len {
        let p = pktline.decode(response, pos)?
        pos = p.next
        if p.kind == 0 { break }
        if p.kind != 4 { return invalid }
        let text = pktline.text(p.data)?
        if !unpacked {
            if !text.starts_with("unpack ") { return invalid }
            unpacked = true
            if text != "unpack ok" { failed = true }
        } else if text.starts_with("ok ") || text.starts_with("ng ") {
            let fields = text.split(" ")
            if fields.len < 2 || !(seen[fields[1]] else false) || (reported[fields[1]] else false) {
                return invalid
            }
            reported[fields[1]] = true
            let at = positions[fields[1]] else { return invalid }
            if outcomes[at].status != "pending" { return invalid }
            if text.starts_with("ng ") {
                if fields.len < 3 { return invalid }
                failed = true
                outcomes[at].status = "remote rejected"
                outcomes[at].reason = text[fields[1].len + 4..]
            } else {
                if fields.len != 2 { return invalid }
                outcomes[at].status = "ok"
            }
        } else {
            return invalid
        }
    }
    for u in updates { if !(reported[u.name] else false) { return truncated } }
    active = false
    let status = transport.close_peer(mut p)?
    if failed { return Unsupported("remote rejected push") }
    if !unpacked || status != 0 { return io }
}

fn receive_configuration(repo: repository.Repo) -> () ! object.StoreErrors {
    if (repo.config["core.bare"] else "false") != "true" {
        return Unsupported("receive-pack requires bare repository")
    }
    for (key, _) in repo.config.pairs() {
        if key.starts_with("receive.") &&
            key != "receive.denynonfastforwards" &&
            key != "receive.denydeletes" {
            return Unsupported("receive-pack configuration {key}")
        }
        if key == "transfer.hiderefs" || key == "transfer.fsckobjects" {
            return Unsupported("receive-pack configuration {key}")
        }
    }
    let hooks = repo.config["core.hookspath"] else "{repo.gitdir}/hooks"
    if fs.is_dir(hooks) && fs.entries(hooks)?.len != 0 { return Unsupported("receive-pack hooks") }
}

fn receive_pack_bytes(c: transport.Channel) -> List[byte] ! object.StoreErrors {
    var bytes = List[byte]()
    loop {
        let chunk = transport.read(c, 65536)?
        if chunk.len == 0 { return truncated }
        if chunk.len > 134217728 - bytes.len { return limit }
        wire.append(mut bytes, chunk)
        let end = pack.stream_length(bytes) else |e| match e {
            truncated => { continue },
            invalid => { return invalid },
            limit => { return limit },
            Unsupported(text) => { return Unsupported(text) },
        }
        if end != bytes.len { return invalid }
        return bytes
    }
}

fn true_value(value: str) -> bool {
    value == "true" || value == "1" || value == "yes" || value == "on"
}

/// Receive v0 push framing (Git does not define v2 push commands), import the
/// pack before ref mutation, apply policy, and report every update. Atomic
/// requests commit all refs through the shared single-file transaction.
pub fn receive(repo: repository.Repo, c: transport.Channel) -> () ! object.StoreErrors {
    receive_configuration(repo)?
    let log_policy = repo.config["core.logallrefupdates"] else "false"
    let can_atomic = log_policy == "false" || log_policy == "0"
    let base_cap = "report-status delete-refs ofs-delta quiet object-format=sha1 agent=den/0.0.0"
    let cap = if can_atomic then "{base_cap} atomic" else copy base_cap
    let references = refs.list(repo, "refs/")?
    var advertisement = List[byte]()
    if references.len == 0 {
        wire.append(
            mut advertisement,
            pktline.encode("{zero()} capabilities^{{}}\0{cap}\n".bytes())?,
        )
    }
    for i in 0..references.len {
        let reference = copy references[i]
        let extra = if i == 0 then "\0{cap}" else ""
        wire.append(
            mut advertisement,
            pktline.encode("{oid.hex(reference.id)?} {reference.name}{extra}\n".bytes())?,
        )
    }
    wire.append(mut advertisement, "0000".bytes())
    transport.write(c, advertisement)?
    let request = transport.message(c, 2097152)?
    if request.len == 0 || request.len == 4 { return }
    var pos = 0,
        updates = List[PushUpdate](),
        atomic = false,
        report = false,
        seen = Map[str, bool](),
        needs_pack = false
    while pos < request.len {
        let p = pktline.decode(request, pos)?
        pos = p.next
        if p.kind == 0 { break }
        if p.kind != 4 { return invalid }
        let raw = str_from_utf8(p.data) else |_| { return invalid }
        let parts = raw.split("\0")
        if updates.len == 0 {
            if parts.len != 2 { return invalid }
            for choice in parts[1].trim().split(" ") {
                if choice == "atomic" {
                    if !can_atomic { return Unsupported("atomic reflog policy") }
                    atomic = true
                } else if choice == "report-status" {
                    report = true
                } else if choice != "ofs-delta" &&
                    choice != "quiet" &&
                    choice != "object-format=sha1" &&
                    !choice.starts_with("agent=") {
                    return Unsupported("push capability {choice}")
                }
            }
        } else if parts.len != 1 {
            return invalid
        }
        let fields = pktline.text(parts[0].bytes())?.split(" ")
        if fields.len != 3 || !refs.valid(fields[2]) || (seen[fields[2]] else false) {
            return invalid
        }
        let before = oid.hex(oid.parse("sha1", fields[0])?)?,
            after = oid.hex(oid.parse("sha1", fields[1])?)?
        if before == zero() && after == zero() { return invalid }
        if after != zero() { needs_pack = true }
        seen[fields[2]] = true
        (mut updates).push(PushUpdate { name: copy fields[2], before: before, after: after })
        if updates.len > 10000 { return limit }
    }
    var unpack_error = ""
    if needs_pack {
        let bytes = receive_pack_bytes(c)?
        import_pack(repo, bytes) else |e| { unpack_error = "{e}" }
    }
    var reasons = List[str](), changes = List[refs.AtomicUpdate](), any_failed = unpack_error != ""
    for u in updates {
        var reason = ""
        if unpack_error != "" {
            reason = "unpacker error"
        } else if u.name == "refs/stash" {
            // The pinned receive-pack refuses this single-level ref even
            // when the client supplies force; local refs/stash is still valid.
            reason = "funny refname"
        } else {
            let current = refs.optional(repo, u.name)?
            let actual = if current.len == 0 then zero() else oid.hex(current[0])?
            if actual != u.before {
                reason = "stale info"
            } else if u.after == zero() {
                if true_value(repo.config["receive.denydeletes"] else "false") {
                    reason = "deletion prohibited"
                }
            } else {
                let body = object.read_object(repo, oid.parse("sha1", u.after)?, 16777216)?
                if u.name.starts_with("refs/heads/") && body.kind != "commit" {
                    reason = "non-commit object"
                }
                if reason == "" &&
                    u.before != zero() &&
                    u.name.starts_with("refs/heads/") &&
                    true_value(repo.config["receive.denynonfastforwards"] else "false") &&
                    !ancestor(repo, u.before, u.after)? {
                    reason = "non-fast-forward"
                }
                if reason == "" { let _ = closure(repo, [u.after], [])? }
            }
        }
        if reason != "" { any_failed = true }
        (mut reasons).push(reason)
        (mut changes).push(refs.
            AtomicUpdate { name: copy u.name, expected: ids(u.before)?, after: ids(u.after)? })
    }
    if atomic {
        if any_failed {
            for i in 0..reasons.len { if reasons[i] == "" { reasons[i] = "atomic push failure" } }
        } else {
            let durable = refs.transaction(repo, changes) else |e| {
                for i in 0..reasons.len { reasons[i] = "atomic transaction failed" }
                eprint("den: atomic refs: {e}")
                true
            }
            if !durable { eprint("den: atomic refs committed; directory sync failed") }
        }
    } else {
        for i in 0..changes.len {
            if reasons[i] != "" { continue }
            let change = copy changes[i]
            refs.update(
                repo,
                change.name,
                change.expected,
                change.after,
                "Den Transport <den@example.invalid> 0 +0000",
                "push",
                false,
            ) else |e| {
                reasons[i] = "ref update failed"
                eprint("den: receive refs: {e}")
            }
        }
    }
    if report {
        var response = List[byte]()
        wire.line(
            mut response,
            if unpack_error == "" then "unpack ok" else "unpack {unpack_error}",
        )?
        for i in 0..updates.len {
            wire.line(
                mut response,
                if reasons[i] == "" {
                    "ok {updates[i].name}"
                } else {
                    "ng {updates[i].name} {reasons[i]}"
                },
            )?
        }
        wire.append(mut response, "0000".bytes())
        transport.write(c, response)?
    }
}
