// Local clone copies object files (never hardlinks), including unreachable ones.
use std.fs
use object
use oid
use refs
use repository
use revision
use wire

struct LocalDirectory { source: str, destination: str }

fn local_objects(source: str, destination: str) -> () ! object.StoreErrors {
    let source_info = fs_lstat(source)?, destination_info = fs_lstat(destination)?
    if source_info[0] != 1 { return Unsupported("local clone object directory symlink") }
    if source_info[6] != destination_info[6] {
        return Unsupported("local clone repository owned by another user; use --no-local")
    }
    var pending = [LocalDirectory { source: source, destination: destination }]
    var count = 0, total = 0
    while pending.len > 0 {
        let directory = (mut pending).pop() else |_| { return invalid }
        for entry in fs.entries(directory.source)? {
            let name = str_from_utf8(entry.name) else |_| { return invalid }
            let from = "{directory.source}/{name}", to = "{directory.destination}/{name}"
            let info = fs_lstat(from)?
            if info[0] == 1 {
                fs.create_dir_all(to)?
                (mut pending).push(LocalDirectory { source: from, destination: to })
            } else if info[0] == 0 {
                if name == "alternates" || name == "http-alternates" {
                    return Unsupported("local clone alternate object store")
                }
                if count >= 100000 { return limit }
                count += 1
                var input = fs.File { fd: fs_open_mode(from, 21)? }
                defer fs.close(take input) else |_| {}
                var output = fs.create_new_with_mode(to, info[4])?
                defer fs.close(take output) else |_| {}
                loop {
                    region chunk {
                        let data = fs.read_chunk(mut input, 65536) else |error| match error {
                            eof => { break },
                            io => { return io },
                        }
                        if data.len > 134217728 - total { return limit }
                        total += data.len
                        fs.write_chunk(mut output, data)?
                    }
                }
                fs.sync(mut output)?
            } else {
                return Unsupported("local clone object symlink or special file")
            }
        }
    }
}

fn clone_local_objects(repo: repository.Repo, path: str) -> List[wire.Ref] ! object.StoreErrors {
    let admin = if fs.is_dir("{path}/.git") then "{path}/.git" else path
    let source = repository.open(admin)?
    local_objects("{source.gitdir}/objects", "{repo.gitdir}/objects")?
    let tip = refs.optional(source, "HEAD")?
    let head_text = (
        str_from_utf8(repository.read_bytes("{source.gitdir}/HEAD", 4096)?) else |_| {
            return invalid
        }
    ).trim()
    let target = if head_text.starts_with("ref: ") then head_text[5..] else ""
    var advertised = [
        wire.Ref {
            name: "HEAD",
            id: if tip.len == 0 then "unborn" else oid.hex(tip[0])?,
            target: target,
            peeled: "",
        },
    ]
    for record in refs.list(source, "refs/")? {
        if !record.name.starts_with("refs/heads/") && !record.name.starts_with("refs/tags/") {
            continue
        }
        let body = object.read_object(source, record.id, 16777216)?
        let peeled = if body.kind == "tag" {
            let target_id = revision.peel(source, record.id, "peel") else |error| {
                return Unsupported("local clone tag: {error}")
            }
            oid.hex(target_id)?
        } else {
            ""
        }
        (mut advertised).push(wire.Ref {
            name: copy record.name,
            id: oid.hex(record.id)?,
            target: "",
            peeled: peeled,
        })
    }
    advertised
}
