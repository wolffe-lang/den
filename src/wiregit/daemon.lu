use std.fs
use std.net
use object
use repository
use transport

/// Serve one unauthenticated connection on loopback. Canonical administrative
/// paths remain within base and require git-daemon-export-ok. The v0 receive
/// service is available only with the caller's explicit write opt-in.
pub fn serve(base: str, port: int, allow_receive: bool) -> () ! object.StoreErrors {
    if port < 0 || port > 65535 { return invalid }
    let root = fs.realpath(base)?
    var listener = net.listen("127.0.0.1:{port}") else |_| { return io }
    defer net.close_listener(take listener) else |_| {}
    net.set_listener_deadline(mut listener, 30000) else |_| { return io }
    let chosen = net.port(listener) else |_| { return io }
    print("port {chosen}")
    var socket = net.accept(mut listener) else |_| { return io }
    net.set_deadline(mut socket, 30000) else |_| {
        net.close(take socket) else |_| {}
        return io
    }
    let c = transport.Channel { input: socket.fd, output: socket.fd, socket: true, child: -1 }
    defer { let _ = transport.close(take copy c) else 1 }
    let first = transport.packet(c)?
    if first.kind != 4 { return invalid }
    let text = str_from_utf8(first.data) else |_| { return invalid }
    let parts = text.split("\0")
    if parts.len < 2 { return invalid }
    let writing = parts[0].starts_with("git-receive-pack ")
    if !parts[0].starts_with("git-upload-pack ") && !writing { return Unsupported("git service") }
    if writing && !allow_receive { return Unsupported("receive service disabled") }
    let prefix = if writing then 17 else 16
    let path = parts[0][prefix..]
    if !path.starts_with("/") { return invalid }
    var version2 = false
    for item in parts { if item == "version=2" { version2 = true } }
    if !writing && !version2 { return Unsupported("git transport requires version 2") }
    let absolute = fs.realpath("{root}{path}")?
    if absolute != root && !absolute.starts_with("{root}/") { return denied }
    let candidate = if fs.is_dir("{absolute}/.git") then "{absolute}/.git" else copy absolute
    let admin = fs.realpath(candidate)?
    if admin != root && !admin.starts_with("{root}/") { return denied }
    if !fs.is_file("{admin}/git-daemon-export-ok") { return denied }
    let repo = repository.open(admin)?
    if writing { receive(repo, c)? } else { upload(repo, c)? }
}
