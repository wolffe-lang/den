use std.fs
use object
use oid
use refs
use remote
use repository
use transport

fn execute(args: List[str]) -> () ! object.StoreErrors {
    if args.len == 0 { return invalid }
    if args[0] == "fetch" && configured_form(args) {
        configured_fetch_command(args)?
        return
    }
    if args[0] == "daemon" {
        let writing = args.len > 1 && args[1] == "--enable-receive-pack"
        let start = if writing then 2 else 1
        if args.len != start + 2 {
            return Unsupported("daemon requires [--enable-receive-pack] BASE PORT")
        }
        let port = args[start + 1].to_int() else |_| { return invalid }
        serve(args[start], port, writing)?
        return
    }
    if args[0] == "upload-pack" || args[0] == "receive-pack" {
        var version2 = false
        for item in (env_get("GIT_PROTOCOL") else "").split(":") {
            if item == "version=2" { version2 = true }
        }
        if args[0] == "upload-pack" && !version2 {
            return Unsupported("upload-pack requires protocol v2")
        }
        var path = ""
        for i in 1..args.len {
            if args[i] == "--strict" { continue }
            if args[i].starts_with("-") || path != "" { return Unsupported("upload-pack option") }
            path = copy args[i]
        }
        if path == "" { return invalid }
        let admin = if fs.is_dir("{path}/.git") then "{path}/.git" else copy path
        let repo = repository.open(admin)?
        let peer = transport.stdio()
        if args[0] == "upload-pack" {
            upload(repo, peer)?
        } else {
            receive(repo, peer)?
        }
        return
    }
    var quiet = false,
        bare = false,
        local = true,
        force = false,
        atomic = false,
        upload = "",
        operands = List[str]()
    for i in 1..args.len {
        let arg = args[i]
        if arg == "-q" || arg == "--quiet" {
            quiet = true
        } else if arg.starts_with("--upload-pack=") && (args[0] == "clone" || args[0] == "fetch") {
            upload = arg[14..]
            if upload == "" { return Unsupported("empty upload-pack service path") }
        } else if arg == "--no-local" && args[0] == "clone" {
            local = false
        } else if arg == "--local" && args[0] == "clone" {
            local = true
        } else if arg == "--bare" {
            bare = true
        } else if (arg == "--force" || arg == "-f") && (args[0] == "push" || args[0] == "fetch") {
            force = true
        } else if arg == "--atomic" && args[0] == "push" {
            atomic = true
        } else if arg.starts_with("-") {
            return Unsupported("{args[0]} option {arg}")
        } else {
            (mut operands).push(copy arg)
        }
    }
    let service_state = override_service("DEN_UPLOAD_PACK", upload)?
    defer restore_service(take service_state)
    if args[0] == "clone" {
        if operands.len == 0 { return Unsupported("clone requires a repository") }
        if operands.len > 2 {
            return Unsupported("clone takes a repository and at most one directory")
        }
        // A local source is checked before a name is guessed, as Git does.
        if transport.local_path(operands[0]) &&
            !fs.exists(operands[0]) &&
            !fs.exists("{operands[0]}.git") {
            return Unsupported("fatal: repository '{operands[0]}' does not exist")
        }
        // git-clone(1) <directory>: the URL's humanish part when none is given.
        let destination = if operands.len == 2 {
            copy operands[1]
        } else {
            clone_name(operands[0], bare)
        }
        if destination == "" {
            return Unsupported(
                "fatal: No directory name could be guessed.\nPlease specify a directory on the command line",
            )
        }
        if fs.exists(destination) && (!fs.is_dir(destination) || fs.entries(destination)?.len > 0) {
            return Unsupported(
                "fatal: destination path '{destination}' already exists and is not an empty directory.",
            )
        }
        if !quiet {
            if bare {
                eprint("Cloning into bare repository '{destination}'...")
            } else {
                eprint("Cloning into '{destination}'...")
            }
        }
        let empty = clone_mode(operands[0], destination, bare, local)?
        if empty { eprint("warning: You appear to have cloned an empty repository.") }
        // The local copy reports its completion; the transport path does not.
        if !quiet && local && transport.local_path(operands[0]) { eprint("done.") }
        return
    }
    if args[0] == "fetch" {
        if operands.len > 0 && transport.local_path(operands[0]) {
            local_fetch_command(operands, quiet, force)?
            return
        }
        if !quiet || bare || operands.len != 2 {
            return Unsupported("fetch requires -q URL SRC:DST")
        }
        let forced_spec = operands[1].starts_with("+")
        let spec = if forced_spec then operands[1][1..] else copy operands[1]
        let pair = spec.split(":")
        if pair.len != 2 { return invalid }
        let repo = repository.discover(".")?
        write_fetch_head(repo, "")?
        var action = "fetch"
        for arg in args[1..] { action = "{action} {arg}" }
        fetch_into_context(
            repo,
            operands[0],
            pair[0],
            pair[1],
            force || forced_spec,
            remote.reflog_identity(repo)?,
            action,
        ) else |e| match e {
            not_found => { return Unsupported("couldn't find remote ref {pair[0]}") },
            Unsupported(message) => { return Unsupported(message) },
            _ => { return Unsupported("fetch: {e}") },
        }
        let id = oid.hex(refs.read(repo, pair[1])?)?
        let description = if pair[0].starts_with("refs/heads/") {
            "branch '{pair[0][11..]}'"
        } else if pair[0].starts_with("refs/tags/") {
            "tag '{pair[0][10..]}'"
        } else {
            "'{pair[0]}'"
        }
        write_fetch_head(repo, "{id}\t\t{description} of {fetch_url(operands[0])}\n")?
        return
    }
    if args[0] == "push" {
        if !quiet || bare || operands.len < 2 {
            return Unsupported("push requires -q URL SRC:DST...")
        }
        push(repository.discover(".")?, operands[0], operands[1..], force, atomic)?
        return
    }
    Unsupported("wire command {args[0]}")
}

/// Dispatch the measured bounded wire CLI; print named refusals and return 2 on any failed operation.
fn run_inner(args: List[str]) -> int {
    let missing = absent_remote_command(args) else |e| {
        eprint("den: wire: {transport.redact("{e}")}")
        return 2
    }
    if missing >= 0 { return missing }
    if args.len > 0 && args[0] == "push" { return push_command(args) }
    if args.len > 0 && args[0] == "ls-remote" { return ls_remote_command(args) }
    if args.len > 0 &&
        args[0] == "fetch" &&
        configured_form(args) &&
        explicit_operands(args).len > 0 {
        return explicit_fetch_command(args)
    }
    if args.len > 0 && args[0] == "pull" { return pull_command(args) }
    if args.len > 0 && args[0] == "fetch" && configured_form(args) {
        return fetch_with_submodules(args)
    }
    execute_status(args)
}

// A configured fetch, then its submodules as git-fetch(1)'s
// --recurse-submodules and the configuration select them (vc25).
fn fetch_with_submodules(args: List[str]) -> int {
    var rest = List[str](), cli = "", quiet = false
    for arg in args {
        let flag = recursion_flag(arg)
        if flag.len == 1 {
            if flag[0] == "invalid" {
                eprint("fatal: bad recurse-submodules argument: {arg[21..]}")
                return 128
            }
            cli = copy flag[0]
            continue
        }
        if arg == "-q" || arg == "--quiet" { quiet = true }
        (mut rest).push(copy arg)
    }
    let found = repository.discover(".") else |_| { return execute_status(rest) }
    if cli == "" && setting(found.config["submodule.recurse"] else "false") == "yes" { cli = "yes" }
    let before = tips(found) else |e| {
        eprint("den: wire: Unsupported(submodule fetch: {e})")
        return 2
    }
    let status = execute_status(rest)
    if status != 0 { return status }
    recurse(before, cli, quiet) else |e| {
        eprint("den: wire: Unsupported(submodule fetch: {transport.redact("{e}")})")
        return 2
    }
}

fn execute_status(args: List[str]) -> int {
    execute(args) else |e| match e {
        Unsupported(message) => {
            if startup_diagnostic(message) || limit_diagnostic(message) { return 128 }
            // Git's own fatal diagnostics, printed as Git prints them.
            if message.starts_with("fatal: ") { eprint(transport.redact(message)); return 128 }
            eprint("den: wire: Unsupported({transport.redact(message)})")
            return 2
        },
        _ => { eprint("den: wire: {transport.redact("{e}")}"); return 2 },
    }
    0
}
