use std.fs
use object
use repository
use transport

fn execute(args: List[str]) -> () ! object.StoreErrors {
    if args.len == 0 { return invalid }
    if args[0] == "upload-pack" {
        var version2 = false
        for item in (env_get("GIT_PROTOCOL") else "").split(":") {
            if item == "version=2" { version2 = true }
        }
        if !version2 {
            return Unsupported("upload-pack requires protocol v2")
        }
        var path = ""
        for i in 1..args.len {
            if args[i] == "--strict" { continue }
            if args[i].starts_with("-") || path != "" { return Unsupported("upload-pack option") }
            path = copy args[i]
        }
        if path == "" { return invalid }
        let admin = if fs.is_dir("{path}/.git") then "{path}/.git" else copy path
        let repo = repository.open(admin)?
        var channel = transport.stdio()
        upload(repo, mut channel)?
        return
    }
    var quiet = false, bare = false, operands = List[str]()
    for i in 1..args.len {
        let arg = args[i]
        if arg == "-q" || arg == "--quiet" {
            quiet = true
        } else if arg == "--bare" {
            bare = true
        } else if arg.starts_with("-") {
            return Unsupported("{args[0]} option {arg}")
        } else {
            (mut operands).push(copy arg)
        }
    }
    if args[0] == "clone" {
        if !bare { return Unsupported("clone currently requires --bare") }
        if operands.len != 2 { return invalid }
        if !quiet { eprint("Cloning into bare repository '{operands[1]}'...") }
        clone_bare(operands[0], operands[1])?
        return
    }
    if args[0] == "fetch" {
        if !quiet || bare || operands.len != 2 {
            return Unsupported("fetch requires -q URL SRC:DST")
        }
        let pair = operands[1].split(":")
        if pair.len != 2 { return invalid }
        let repo = repository.discover(".")?
        fetch_into(repo, operands[0], pair[0], pair[1])?
        return
    }
    Unsupported("wire command {args[0]}")
}

/// Dispatch the measured bounded wire CLI; print named refusals and return 2 on any failed operation.
pub fn run(args: List[str]) -> int {
    execute(args) else |e| { eprint("den: wire: {e}"); return 2 }
    0
}
