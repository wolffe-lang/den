// git-fetch/git-push OUTPUT, measured under the fixed C-locale environment.
use history
use object
use oid
use repository

struct TransportRow { flag: str, summary: str, source: str, destination: str, reason: str }

/// The least short-name length: core.abbrev, or when it is unset or "auto",
/// Git's length for the repository's packed object count.
fn report_abbrev(repo: repository.Repo) -> int ! object.StoreErrors {
    let value = repo.config["core.abbrev"] else "auto"
    if value == "auto" { return object.default_abbrev(repo)? }
    value.to_int() else |_| { return Unsupported("transport core.abbrev") }
}

fn report_id(repo: repository.Repo, value: str) -> str ! object.StoreErrors {
    let minimum = report_abbrev(repo)?
    history.abbreviate(repo, oid.parse("sha1", value)?, minimum) else |e| {
        return Unsupported("transport abbreviation: {e}")
    }
}

fn pad_report(text: str, width: int) -> str {
    var out = copy text
    while out.len < width { out = "{out} " }
    out
}

fn short_ref(name: str) -> str {
    if name.starts_with("refs/heads/") { return name[11..] }
    if name.starts_with("refs/tags/") { return name[10..] }
    if name.starts_with("refs/remotes/") { return name[13..] }
    copy name
}

fn fetch_url(url: str) -> str {
    var out = copy url
    while out.ends_with("/") { out = out[0..out.len - 1] }
    if out.ends_with(".git") { out = out[0..out.len - 4] }
    out
}

/// The summary column's least width, as Git pads it: two short names of the
/// default length and the "..." between them (17 at seven digits).
fn summary_least(repo: repository.Repo) -> int ! object.StoreErrors { 2 * report_abbrev(repo)? + 3 }

fn fetch_report(
    repo: repository.Repo,
    url: str,
    rows: List[TransportRow],
) -> () ! object.StoreErrors {
    fetch_report_width(url, rows, summary_least(repo)?)
}

// least is the least width of the summary column (summary_least, or 0 for a
// report Git prints unpadded, one with a rejection).
fn fetch_report_width(url: str, rows: List[TransportRow], least: int) {
    if rows.len == 0 { return }
    var summary_width = least, source_width = 10
    for row in rows {
        if least > 0 && row.summary.len > summary_width { summary_width = row.summary.len }
        if row.source.len > source_width { source_width = row.source.len }
    }
    eprint("From {fetch_url(url)}")
    for row in rows {
        let suffix = if row.reason == "" then "" else "  ({row.reason})"
        eprint(
            " {row.flag} {pad_report(row.summary, summary_width)} {pad_report(row.source, source_width)} -> {row.destination}{suffix}",
        )
    }
}
