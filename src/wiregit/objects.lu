use std.fs
use object
use oid
use pack
use packcmd
use pktline
use repository
use transport
use wire

/// den#73: a closure in walk order as bytes and ints: 40 hex bytes a name, a
/// type code (kind_code) and a size each, so a walk of any length keeps no
/// string for an object.
pub struct Plan { names: List[byte], kinds: List[int], sizes: List[int] }

fn plan_empty() -> Plan { Plan { names: List[byte](), kinds: List[int](), sizes: List[int]() } }

/// The number of objects planned.
pub fn plan_len(p: Plan) -> int { p.kinds.len }

/// The name of the i-th object planned.
pub fn plan_name(p: Plan, i: int) -> str ! object.StoreErrors {
    if i < 0 || i >= p.kinds.len { return invalid }
    str_from_utf8(p.names[i * 40..i * 40 + 40]) else |_| { return invalid }
}

// A walk's state, all bytes, ints and hashed sets: queue holds every name
// ever queued (40 bytes each) and queued the same as a set; expect the first
// type a link gave a name; kinds a read object's type. Every link to a name is
// checked against its type, whichever comes first.
struct Walk {
    queue: List[byte],
    queued: pack.NameSet,
    expect: pack.NameSet,
    kinds: pack.NameSet,
}

fn walk_queue(mut w: Walk, name: str) -> () ! object.StoreErrors {
    if name.len != 40 { return invalid }
    if pack.names_add(mut w.queued, name, "") { for b in name.bytes() { (mut w.queue).push(b) } }
}

// One step: read name, check it and its links' types, queue its unseen links
// and append it to the plan.
fn walk_one(
    mut reader: object.Reader,
    name: str,
    mut w: Walk,
    mut plan: Plan,
) -> () ! object.StoreErrors {
    let body = object.read_cached(mut reader, oid.parse("sha1", name)?, pack.object_limit())?
    let expected = pack.names_value(w.expect, name)
    if expected != "" && expected != body.kind { return invalid }
    let _ = pack.names_add(mut w.kinds, name, body.kind)
    for child in packcmd.links(body)? {
        let known = pack.names_value(w.kinds, child.name)
        if known != "" {
            if child.kind != "" && child.kind != known { return invalid }
        } else if child.kind != "" {
            if !pack.names_add(mut w.expect, child.name, child.kind) &&
                pack.names_value(w.expect, child.name) != child.kind {
                return invalid
            }
        }
        walk_queue(mut w, child.name)?
    }
    for b in name.bytes() { (mut plan.names).push(b) }
    (mut plan.kinds).push(kind_code(body.kind))
    (mut plan.sizes).push(body.data.len)
}

/// Typed closure rooted only at explicitly requested objects, less the names
/// in omit. Shared validator parsers enforce link types. den#73: one reader
/// serves every read (one pack-index parse, bases through its cache), the
/// queued, typed and omitted names are hashed sets, and each step is a region
/// of its own, so the walk is linear in objects and keeps only bytes and ints
/// for each; there is no count bound.
pub fn walk_plan(
    repo: repository.Repo,
    roots: List[str],
    omit: pack.NameSet,
) -> Plan ! object.StoreErrors {
    var reader = object.reader_batch(repo)
    var w = Walk {
        queue: List[byte](),
        queued: pack.nameset(),
        expect: pack.nameset(),
        kinds: pack.nameset(),
    }
    var plan = plan_empty()
    for name in roots { walk_queue(mut w, name)? }
    var pos = 0
    while pos < w.queue.len {
        region step {
            let name = str_from_utf8(w.queue[pos..pos + 40]) else |_| { return invalid }
            pos += 40
            if !pack.names_has(omit, name) { walk_one(mut reader, name, mut w, mut plan)? }
        }
    }
    plan
}

/// Add a plan's names to a set.
pub fn plan_into(p: Plan, mut set: pack.NameSet) {
    for i in 0..p.kinds.len {
        region one {
            let name = str_from_utf8(p.names[i * 40..i * 40 + 40]) else ""
            let _ = pack.names_add(mut set, name, "")
        }
    }
}

/// The closure of haves, as the set a walk omits.
pub fn have_set(repo: repository.Repo, haves: List[str]) -> pack.NameSet ! object.StoreErrors {
    var set = pack.nameset()
    if haves.len == 0 { return set }
    plan_into(walk_plan(repo, haves, pack.nameset())?, mut set)
    set
}

/// walk_plan's names, in walk order, less excluded's.
pub fn closure(
    repo: repository.Repo,
    roots: List[str],
    excluded: List[str],
) -> List[str] ! object.StoreErrors {
    var omit = pack.nameset()
    for name in excluded { let _ = pack.names_add(mut omit, name, "") }
    let plan = walk_plan(repo, roots, omit)?
    var names = List[str]()
    for i in 0..plan_len(plan) { (mut names).push(plan_name(plan, i)?) }
    names
}

/// den#73: a written pack, a temporary the caller removes.
pub struct PackFile { path: str, size: int }

// Where an outgoing pack is written: TMPDIR, as a served repository may be
// read-only.
fn out_dir() -> str { env_get("TMPDIR") else "/tmp" }

// Planned objects ordered by type (in the order of the type names: blob,
// commit, tag, tree), then size descending: a stable bottom-up merge sort of
// positions (encode's order, in n log n).
fn type_rank(code: int) -> int {
    match code {
        3 => 0,
        1 => 1,
        4 => 2,
        _ => 3,
    }
}

fn planned_order(plan: Plan) -> List[int] {
    var order = List[int](), kinds = List[int](), sizes = List[int]()
    for i in 0..plan.kinds.len {
        (mut order).push(i)
        (mut kinds).push(type_rank(plan.kinds[i]))
        (mut sizes).push(plan.sizes[i])
    }
    var scratch = copy order
    var width = 1
    while width < order.len {
        var lo = 0
        while lo < order.len {
            let mid = if lo + width < order.len then lo + width else order.len
            let hi = if lo + 2 * width < order.len then lo + 2 * width else order.len
            var i = lo, j = mid, k = lo
            while i < mid && j < hi {
                let a = order[i], b = order[j]
                if kinds[b] < kinds[a] || kinds[b] == kinds[a] && sizes[b] > sizes[a] {
                    scratch[k] = order[j]
                    j += 1
                } else {
                    scratch[k] = order[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                scratch[k] = order[i]
                i += 1
                k += 1
            }
            while j < hi {
                scratch[k] = order[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        for n in 0..order.len { order[n] = scratch[n] }
        width *= 2
    }
    order
}

/// The pack of roots minus the closure of haves, written to a temporary by
/// pack.Writer: each body read through one reader, one at a time, so a
/// served or pushed pack holds no aggregate of bodies (den#73).
pub fn pack_file(
    repo: repository.Repo,
    roots: List[str],
    haves: List[str],
    mode: str,
) -> PackFile ! object.StoreErrors {
    write_plan(repo, walk_plan(repo, roots, have_set(repo, haves)?)?, mode)?
}

/// A planned closure written as pack_file writes it.
pub fn write_plan(repo: repository.Repo, plan: Plan, mode: str) -> PackFile ! object.StoreErrors {
    let order = planned_order(plan)
    var w = pack.writer_begin(out_dir(), plan_len(plan), mode)?
    var finished = false
    defer { if !finished { pack.writer_discard(mut w) } }
    var reader = object.reader_batch(repo)
    for i in order {
        region one {
            let name = plan_name(plan, i)?
            write_one(mut w, mut reader, name)?
        }
    }
    let (path, size) = pack.writer_finish(mut w)?
    finished = true
    PackFile { path: path, size: size }
}

/// plan with walk_plan's closure of more roots appended, less omit and the
/// names already planned.
pub fn plan_more(
    repo: repository.Repo,
    plan: Plan,
    roots: List[str],
    omit: pack.NameSet,
) -> Plan ! object.StoreErrors {
    var seen = copy omit
    plan_into(plan, mut seen)
    let more = walk_plan(repo, roots, seen)?
    var out = copy plan
    for b in more.names { (mut out.names).push(b) }
    for k in more.kinds { (mut out.kinds).push(k) }
    for n in more.sizes { (mut out.sizes).push(n) }
    out
}

// One object read through the writer's batch reader and appended.
fn write_one(mut w: pack.Writer, mut reader: object.Reader, name: str) -> () ! object.StoreErrors {
    let body = object.read_cached(mut reader, oid.parse("sha1", name)?, pack.object_limit())?
    pack.writer_add(mut w, pack.Body { kind: body.kind, data: body.data }, name)?
}

/// pack_file's bytes, for a transport that sends a request whole (HTTP);
/// the temporary is removed.
pub fn pack_for(
    repo: repository.Repo,
    roots: List[str],
    haves: List[str],
    mode: str,
) -> List[byte] ! object.StoreErrors {
    let file = pack_file(repo, roots, haves, mode)?
    defer fs.remove(file.path) else |_| {}
    repository.read_bytes(file.path, file.size)?
}

/// Decode and validate the whole stream before any object is published. Loose
/// installation preserves the canonical identities, never persists a thin pack.
pub fn import_pack(repo: repository.Repo, bytes: List[byte]) -> () ! object.StoreErrors {
    var bases = List[pack.Body](), total = 0
    for name in pack.stream_refs(bytes)? {
        let id = oid.parse("sha1", name)?
        let body = object.read_object(repo, id, 16777216) else |e| match e {
            not_found => { continue },
            invalid => { return invalid },
            invalid_oid => { return invalid_oid },
            unsupported_format => { return unsupported_format },
            bad_header => { return bad_header },
            bad_size => { return bad_size },
            bad_oid => { return bad_oid },
            truncated => { return truncated },
            dictionary => { return dictionary },
            checksum => { return checksum },
            limit => { return limit },
            trailing => { return trailing },
            unsupported_level => { return unsupported_level },
            denied => { return denied },
            io => { return io },
            exists => { return exists },
            unsupported => { return unsupported },
            ambiguous => { return ambiguous },
            cross_device => { return cross_device },
            Unsupported(text) => { return Unsupported(text) },
        }
        if body.data.len > 134217728 - total {
            return Unsupported("limit: more than 134217728 bytes of thin pack bases")
        }
        total += body.data.len
        (mut bases).push(pack.Body { kind: copy body.kind, data: copy body.data })
    }
    let bodies = pack.decode(bytes, bases)?
    for body in bodies { let _ = object.write_object(repo, body.kind, body.data)? }
}

/// den#73: a pushed pack through the streamed indexer that fetch uses: it is
/// installed (a pack of 100 objects or more is kept, as Git's receive-pack
/// keeps one), then the typed closure of the pushed tips is checked, and the
/// answer is true. A thin pack, whose bases are local objects, takes the
/// whole-stream decoder, which resolves them, and the answer is false: its
/// tips' closure is the caller's to check.
pub fn receive_import(
    repo: repository.Repo,
    bytes: List[byte],
    roots: List[str],
) -> bool ! object.StoreErrors {
    var receiver = pack.receive_begin(repo.gitdir)?
    defer pack.receive_abort(mut receiver)
    var pos = 0
    while pos < bytes.len {
        let end = if bytes.len - pos > 1048576 then pos + 1048576 else bytes.len
        pack.receive_write(mut receiver, bytes[pos..end])?
        pos = end
    }
    let ix = pack.received_index(mut receiver) else |e| match e {
        Unsupported(text) => {
            if text == "pack delta base missing" {
                import_pack(repo, bytes)?
                return false
            }
            return Unsupported(text)
        },
        denied => { return denied },
        io => { return io },
        not_found => { return not_found },
    }
    // As fetch does: install (the walk reads received objects through the
    // store), then check the pushed tips' typed closure.
    publish_received(repo, ix, false)?
    closure_received(repo, roots, ix)?
    true
}

/// Test commit ancestry with shared header parsing and bounded graph traversal; not a general revision evaluator.
pub fn ancestor(repo: repository.Repo, older: str, newer: str) -> bool ! object.StoreErrors {
    if older == newer { return true }
    // den#73: one reader and a hashed seen set; no count bound.
    let reader = object.reader_batch(repo)
    var pending = [newer], seen = pack.nameset(), pos = 0
    let _ = pack.names_add(mut seen, newer, "")
    while pos < pending.len {
        let name = copy pending[pos]
        pos += 1
        var found = false, commit = true
        region commit_read {
            let body = object.read_loaded(reader, oid.parse("sha1", name)?, 16777216)?
            if body.kind != "commit" {
                commit = false
            } else {
                let headers = object.parse_commit(body.data, "sha1") else |_| { return invalid }
                for field in headers.fields {
                    if field.key != "parent" { continue }
                    let parent = str_from_utf8(field.value) else |_| { return invalid }
                    if parent == older { found = true }
                    if pack.names_add(mut seen, parent, "") { (mut pending).push(copy parent) }
                }
            }
        }
        if !commit { return false }
        if found { return true }
    }
    false
}

/// vc23: stream a fetch response's packfile section into a temporary under
/// objects/pack and index it there; progress is dropped, a fatal band
/// refuses, and nothing of the pack is held in memory (den#61).
pub fn receive_pack(
    repo: repository.Repo,
    mut s: transport.Stream,
) -> pack.Indexed ! object.StoreErrors {
    var receiver = pack.receive_begin(repo.gitdir)?
    defer pack.receive_abort(mut receiver)
    let first = transport.stream_packet(mut s)?
    // A server that will not serve a want answers ERR (gitprotocol-v2(5)).
    if first.kind == 4 && wire.error_payload(first.data) {
        let line = pktline.text(first.data)?
        return Unsupported("remote error: {line[4..].trim()}")
    }
    if first.kind != 4 || pktline.text(first.data)? != "packfile" { return invalid }
    var finished = false
    while !finished {
        region packet {
            finished = receive_packet(mut s, mut receiver)?
        }
    }
    pack.received_index(mut receiver)?
}

// One packet of the packfile section: band 1 to the temporary, band 2
// dropped, band 3 fatal. True at the section's flush.
fn receive_packet(
    mut s: transport.Stream,
    mut receiver: pack.Receiver,
) -> bool ! object.StoreErrors {
    let p = transport.stream_packet(mut s)?
    if p.kind == 0 { return true }
    if p.kind != 4 || p.data.len == 0 { return invalid }
    if p.data[0] == 1 as byte {
        pack.receive_write(mut receiver, p.data[1..])?
    } else if p.data[0] == 3 as byte {
        return Unsupported("remote fatal sideband")
    } else if p.data[0] != 2 as byte {
        return invalid
    }
    false
}

/// Install a received pack as Git does: a clone keeps it, and so does a
/// fetch of at least 100 objects (git-config(1): fetch.unpackLimit, by
/// default transfer.unpackLimit, 100); a smaller fetch becomes loose
/// objects, one rebuilt at a time. The temporary never outlives the call.
pub fn publish_received(
    repo: repository.Repo,
    ix: pack.Indexed,
    keep: bool,
) -> () ! object.StoreErrors {
    defer pack.received_discard(ix)
    if keep || pack.received_count(ix) >= 100 {
        let _ = pack.received_install(ix)?
        return
    }
    for slot in 0..pack.received_count(ix) {
        region one {
            let body = pack.received_body(ix, slot)?
            let _ = object.write_object(repo, body.kind, body.data)?
        }
    }
}

/// The typed closure check after a received pack, without the aggregate
/// body cap: commits, trees and tags are read one at a time and their links
/// followed; a link into the received pack is typed from its table, so a
/// blob there is never read. Objects outside it are read and typed. The
/// walk queues received objects by rank (an int each) and does each step in
/// its own region, so it keeps no per-link name (den#63).
pub fn closure_received(
    repo: repository.Repo,
    roots: List[str],
    ix: pack.Indexed,
) -> () ! object.StoreErrors {
    var reader = object.reader_open(repo)?
    let count = pack.received_count(ix)
    var seen = List[bool]()
    (mut seen).reserve(count)
    for _ in 0..count { (mut seen).push(false) }
    // Received objects wait by rank with the type their link expects
    // (kind_code; 0 for a root), others by link.
    var ranks = List[int](), expected = List[int](), outside = List[packcmd.Link]()
    // den#73: the objects outside the pack, read and typed, in a hashed set
    // with no count bound.
    var other = pack.nameset()
    for name in roots {
        let rank = pack.received_rank(ix, name)?
        if rank >= 0 {
            (mut ranks).push(rank)
            (mut expected).push(0)
        } else {
            (mut outside).push(packcmd.Link { name: copy name, kind: "" })
        }
    }
    while ranks.len > 0 || outside.len > 0 {
        region step {
            if ranks.len > 0 {
                let rank = (mut ranks).pop() else |_| { return invalid }
                let wanted = (mut expected).pop() else |_| { return invalid }
                let kind = pack.received_rank_kind(ix, rank)
                if wanted != 0 && wanted != kind_code(kind) { return invalid }
                if !seen[rank] {
                    seen[rank] = true
                    if kind != "blob" {
                        let name = pack.received_rank_name(ix, rank)?
                        let link = packcmd.Link { name: name, kind: kind }
                        follow(
                            mut reader,
                            ix,
                            link,
                            rank,
                            kind,
                            seen,
                            mut other,
                            mut ranks,
                            mut expected,
                            mut outside,
                        )?
                    }
                }
            } else {
                let link = (mut outside).pop() else |_| { return invalid }
                let prior = pack.names_value(other, link.name)
                if prior != "" {
                    if link.kind != "" && link.kind != prior { return invalid }
                } else {
                    follow(
                        mut reader,
                        ix,
                        link,
                        -1,
                        "",
                        seen,
                        mut other,
                        mut ranks,
                        mut expected,
                        mut outside,
                    )?
                }
            }
        }
    }
}

// kind_code's inverse.
fn kind_name(code: int) -> str {
    match code {
        1 => "commit",
        2 => "tree",
        3 => "blob",
        4 => "tag",
        _ => "",
    }
}

// A link's expected type as a small int, so a queued link holds no string.
fn kind_code(kind: str) -> int {
    match kind {
        "commit" => 1,
        "tree" => 2,
        "blob" => 3,
        "tag" => 4,
        _ => 0,
    }
}

// Read one closure object, check its type, and queue its unseen links.
fn follow(
    mut reader: object.Reader,
    ix: pack.Indexed,
    link: packcmd.Link,
    rank: int,
    kind: str,
    seen: List[bool],
    mut other: pack.NameSet,
    mut ranks: List[int],
    mut expected: List[int],
    mut outside: List[packcmd.Link],
) -> () ! object.StoreErrors {
    let body = object.read_cached(mut reader, oid.parse("sha1", link.name)?, pack.object_limit())?
    if link.kind != "" && link.kind != body.kind { return invalid }
    if rank >= 0 && body.kind != kind { return invalid }
    if rank < 0 { let _ = pack.names_add(mut other, link.name, body.kind) }
    for child in packcmd.links(body)? {
        let at = pack.received_rank(ix, child.name)?
        if at >= 0 {
            if child.kind != "" && child.kind != pack.received_rank_kind(ix, at) { return invalid }
            if seen[at] { continue }
            (mut ranks).push(at)
            (mut expected).push(kind_code(child.kind))
        } else {
            (mut outside).push(copy child)
        }
    }
}
