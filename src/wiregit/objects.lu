use object
use oid
use pack
use packcmd
use pktline
use repository
use transport
use wire

/// Typed closure rooted only at explicitly requested objects. Shared validator
/// parsers enforce link types; excluded objects are validated separately first.
pub fn closure(
    repo: repository.Repo,
    roots: List[str],
    excluded: List[str],
) -> List[str] ! object.StoreErrors {
    var pending = List[packcmd.Link](), seen = Map[str, str](), omit = Map[str, bool]()
    for name in excluded { omit[name] = true }
    for name in roots { (mut pending).push(packcmd.Link { name: copy name, kind: "" }) }
    var pos = 0, out = List[str]()
    while pos < pending.len {
        let link = copy pending[pos]
        pos += 1
        if omit[link.name] else false { continue }
        let prior = seen[link.name] else ""
        if prior != "" {
            if link.kind != "" && link.kind != prior { return invalid }
            continue
        }
        if out.len >= 10000 || pending.len > 100000 { return limit }
        // vc23: each body lives in its own region, so no aggregate cap; the
        // per-object cap is the pack reader's. A link to an object already
        // seen is type-checked here, not queued again.
        region body_read {
            let body = object.read_object(repo, oid.parse("sha1", link.name)?, pack.object_limit())?
            if link.kind != "" && link.kind != body.kind { return invalid }
            seen[link.name] = copy body.kind
            for child in packcmd.links(body)? {
                let known = seen[child.name] else ""
                if known != "" {
                    if child.kind != "" && child.kind != known { return invalid }
                    continue
                }
                (mut pending).push(copy child)
            }
        }
        (mut out).push(copy link.name)
    }
    out
}

/// Validate selected typed closures and encode only roots minus common-have closure; shared pack bounds apply.
pub fn pack_for(
    repo: repository.Repo,
    roots: List[str],
    haves: List[str],
    mode: str,
) -> List[byte] ! object.StoreErrors {
    let omitted = closure(repo, haves, [])?
    let names = closure(repo, roots, omitted)?
    var bodies = List[pack.Body]()
    for name in names {
        let body = object.read_object(repo, oid.parse("sha1", name)?, 16777216)?
        (mut bodies).push(pack.Body { kind: copy body.kind, data: copy body.data })
    }
    let encoded = pack.encode(bodies, mode)?
    copy encoded.data
}

/// Decode and validate the whole stream before any object is published. Loose
/// installation preserves the canonical identities, never persists a thin pack.
pub fn import_pack(repo: repository.Repo, bytes: List[byte]) -> () ! object.StoreErrors {
    var bases = List[pack.Body](), total = 0
    for name in pack.stream_refs(bytes)? {
        let id = oid.parse("sha1", name)?
        let body = object.read_object(repo, id, 16777216) else |e| match e {
            not_found => { continue },
            invalid => { return invalid },
            invalid_oid => { return invalid_oid },
            unsupported_format => { return unsupported_format },
            bad_header => { return bad_header },
            bad_size => { return bad_size },
            bad_oid => { return bad_oid },
            truncated => { return truncated },
            dictionary => { return dictionary },
            checksum => { return checksum },
            limit => { return limit },
            trailing => { return trailing },
            unsupported_level => { return unsupported_level },
            denied => { return denied },
            io => { return io },
            exists => { return exists },
            unsupported => { return unsupported },
            ambiguous => { return ambiguous },
            cross_device => { return cross_device },
            Unsupported(text) => { return Unsupported(text) },
        }
        if body.data.len > 134217728 - total { return limit }
        total += body.data.len
        (mut bases).push(pack.Body { kind: copy body.kind, data: copy body.data })
    }
    let bodies = pack.decode(bytes, bases)?
    for body in bodies { let _ = object.write_object(repo, body.kind, body.data)? }
}

/// Test commit ancestry with shared header parsing and bounded graph traversal; not a general revision evaluator.
pub fn ancestor(repo: repository.Repo, older: str, newer: str) -> bool ! object.StoreErrors {
    if older == newer { return true }
    var pending = [newer], seen = Map[str, bool](), pos = 0
    while pos < pending.len {
        let name = copy pending[pos]
        pos += 1
        if seen[name] else false { continue }
        seen[name] = true
        if pos > 10000 || pending.len > 100000 { return limit }
        let body = object.read_object(repo, oid.parse("sha1", name)?, 16777216)?
        if body.kind != "commit" { return false }
        let headers = object.parse_commit(body.data, "sha1") else |_| { return invalid }
        for field in headers.fields {
            if field.key != "parent" { continue }
            let parent = str_from_utf8(field.value) else |_| { return invalid }
            if parent == older { return true }
            (mut pending).push(parent)
        }
    }
    false
}

/// vc23: stream a fetch response's packfile section into a temporary under
/// objects/pack and index it there; progress is dropped, a fatal band
/// refuses, and nothing of the pack is held in memory (den#61).
pub fn receive_pack(
    repo: repository.Repo,
    mut s: transport.Stream,
) -> pack.Indexed ! object.StoreErrors {
    var receiver = pack.receive_begin(repo.gitdir)?
    defer pack.receive_abort(mut receiver)
    let first = transport.stream_packet(mut s)?
    // A server that will not serve a want answers ERR (gitprotocol-v2(5)).
    if first.kind == 4 && wire.error_payload(first.data) {
        let line = pktline.text(first.data)?
        return Unsupported("remote error: {line[4..].trim()}")
    }
    if first.kind != 4 || pktline.text(first.data)? != "packfile" { return invalid }
    var finished = false
    while !finished {
        region packet {
            finished = receive_packet(mut s, mut receiver)?
        }
    }
    pack.received_index(mut receiver)?
}

// One packet of the packfile section: band 1 to the temporary, band 2
// dropped, band 3 fatal. True at the section's flush.
fn receive_packet(
    mut s: transport.Stream,
    mut receiver: pack.Receiver,
) -> bool ! object.StoreErrors {
    let p = transport.stream_packet(mut s)?
    if p.kind == 0 { return true }
    if p.kind != 4 || p.data.len == 0 { return invalid }
    if p.data[0] == 1 as byte {
        pack.receive_write(mut receiver, p.data[1..])?
    } else if p.data[0] == 3 as byte {
        return Unsupported("remote fatal sideband")
    } else if p.data[0] != 2 as byte {
        return invalid
    }
    false
}

/// Install a received pack as Git does: a clone keeps it, and so does a
/// fetch of at least 100 objects (git-config(1): fetch.unpackLimit, by
/// default transfer.unpackLimit, 100); a smaller fetch becomes loose
/// objects, one rebuilt at a time. The temporary never outlives the call.
pub fn publish_received(
    repo: repository.Repo,
    ix: pack.Indexed,
    keep: bool,
) -> () ! object.StoreErrors {
    defer pack.received_discard(ix)
    if keep || pack.received_count(ix) >= 100 {
        let _ = pack.received_install(ix)?
        return
    }
    for slot in 0..pack.received_count(ix) {
        region one {
            let body = pack.received_body(ix, slot)?
            let _ = object.write_object(repo, body.kind, body.data)?
        }
    }
}

/// The typed closure check after a received pack, without the aggregate
/// body cap: commits, trees and tags are read one at a time and their links
/// followed; a link into the received pack is typed from its table, so a
/// blob there is never read. Objects outside it are read and typed. The
/// walk queues received objects by rank (an int each) and does each step in
/// its own region, so it keeps no per-link name (den#63).
pub fn closure_received(
    repo: repository.Repo,
    roots: List[str],
    ix: pack.Indexed,
) -> () ! object.StoreErrors {
    let reader = object.reader_open(repo)?
    let count = pack.received_count(ix)
    var seen = List[bool]()
    (mut seen).reserve(count)
    for _ in 0..count { (mut seen).push(false) }
    // Received objects wait by rank with the type their link expects
    // (kind_code; 0 for a root), others by link.
    var ranks = List[int](), expected = List[int](), outside = List[packcmd.Link]()
    var other = Map[str, str]()
    for name in roots {
        let rank = pack.received_rank(ix, name)?
        if rank >= 0 {
            (mut ranks).push(rank)
            (mut expected).push(0)
        } else {
            (mut outside).push(packcmd.Link { name: copy name, kind: "" })
        }
    }
    while ranks.len > 0 || outside.len > 0 {
        region step {
            if ranks.len > 0 {
                let rank = (mut ranks).pop() else |_| { return invalid }
                let wanted = (mut expected).pop() else |_| { return invalid }
                let kind = pack.received_rank_kind(ix, rank)
                if wanted != 0 && wanted != kind_code(kind) { return invalid }
                if !seen[rank] {
                    seen[rank] = true
                    if kind != "blob" {
                        let name = pack.received_rank_name(ix, rank)?
                        let link = packcmd.Link { name: name, kind: kind }
                        follow(
                            reader,
                            ix,
                            link,
                            rank,
                            kind,
                            seen,
                            mut other,
                            mut ranks,
                            mut expected,
                            mut outside,
                        )?
                    }
                }
            } else {
                let link = (mut outside).pop() else |_| { return invalid }
                let prior = other[link.name] else ""
                if prior != "" {
                    if link.kind != "" && link.kind != prior { return invalid }
                } else {
                    if other.len >= 10000 { return limit }
                    follow(
                        reader,
                        ix,
                        link,
                        -1,
                        "",
                        seen,
                        mut other,
                        mut ranks,
                        mut expected,
                        mut outside,
                    )?
                }
            }
        }
    }
}

// A link's expected type as a small int, so a queued link holds no string.
fn kind_code(kind: str) -> int {
    match kind {
        "commit" => 1,
        "tree" => 2,
        "blob" => 3,
        "tag" => 4,
        _ => 0,
    }
}

// Read one closure object, check its type, and queue its unseen links.
fn follow(
    reader: object.Reader,
    ix: pack.Indexed,
    link: packcmd.Link,
    rank: int,
    kind: str,
    seen: List[bool],
    mut other: Map[str, str],
    mut ranks: List[int],
    mut expected: List[int],
    mut outside: List[packcmd.Link],
) -> () ! object.StoreErrors {
    let body = object.read_loaded(reader, oid.parse("sha1", link.name)?, pack.object_limit())?
    if link.kind != "" && link.kind != body.kind { return invalid }
    if rank >= 0 && body.kind != kind { return invalid }
    if rank < 0 { other[copy link.name] = copy body.kind }
    for child in packcmd.links(body)? {
        let at = pack.received_rank(ix, child.name)?
        if at >= 0 {
            if child.kind != "" && child.kind != pack.received_rank_kind(ix, at) { return invalid }
            if seen[at] { continue }
            (mut ranks).push(at)
            (mut expected).push(kind_code(child.kind))
        } else {
            (mut outside).push(copy child)
        }
    }
}
