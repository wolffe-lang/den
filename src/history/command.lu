// Git 2.56.0 git-log/git-show/pretty-formats documentation and binary witnesses.
use std.fs
use diff
use notes
use object
use oid
use pretty
use repository
use revision
use revset
use walk
use worktree

fn add(mut out: List[byte], value: List[byte]) { for b in value { (mut out).push(b) } }

fn number(value: str) -> int ! worktree.WorkErrors {
    let n = value.to_int() else |_| { return invalid }
    if n < 0 || n > 100000 { return invalid }
    n
}

/// Unique loose-object abbreviation. No fixed seven-digit collision assumption.
pub fn abbreviate(repo: repository.Repo, id: oid.Oid, minimum: int) -> str ! worktree.WorkErrors {
    if minimum < 4 || minimum > 40 { return invalid }
    let full = oid.hex(id)?
    for length in minimum..40 {
        let found = object.lookup(repo, full[0..length]) else |e| match e {
            ambiguous => { continue },
            _ => { return invalid },
        }
        if oid.equal(found, id) { return full[0..length] }
    }
    full
}

fn root_files(ctx: worktree.Context, id: oid.Oid) -> List[diff.File] ! worktree.WorkErrors {
    var out = List[diff.File](), total = 0
    for entry in worktree.flatten_tree(ctx.repo, id)? {
        if entry.mode == 0o160000 { return Unsupported("history submodule diff") }
        let value = object.read_object(ctx.repo, entry.id, 16777216)?
        if value.kind != "blob" { return invalid_tree }
        total += value.data.len
        if total > 134217728 { return limit }
        (mut out).push(diff.File {
            path: copy entry.path,
            mode: entry.mode,
            id: copy entry.id,
            data: copy value.data,
        })
    }
    out
}

/// Read-only patch/stat consumer. Roots compare to empty, never write an empty
/// tree or call index.write_tree. Ordinary history uses diff.collect/render.
pub fn patch(
    ctx: worktree.Context,
    value: walk.Commit,
    options: diff.Options,
    first_parent: bool,
) -> List[byte] ! worktree.WorkErrors {
    if !options.patch && !options.stat { return List[byte]() }
    if value.parents.len > 1 && !first_parent { return List[byte]() }
    var display = copy options
    var changes = List[diff.Change]()
    if value.parents.len == 0 {
        if fs.exists("{ctx.root}/.gitattributes") ||
            fs.exists("{ctx.repo.gitdir}/info/attributes") ||
            (ctx.repo.config["core.attributesfile"] else "") != "" {
            return Unsupported("diff attributes")
        }
        changes = diff.changes(List[diff.File](), root_files(ctx, value.tree)?, display)?
    } else {
        display.revisions = [oid.hex(value.parents[0])?, oid.hex(value.id)?]
        changes = diff.collect(ctx, display)?
    }
    diff.render(ctx, changes, display)?
}

fn dispatch(args: List[str]) -> int ! worktree.WorkErrors {
    let repo = repository.discover(".")?
    let ctx = if (repo.config["core.bare"] else "false") == "true" {
        worktree.Context { repo: repo, root: "", cwd: ".", prefix: "" }
    } else {
        worktree.discover(".")?
    }
    let show = args[0] == "show"
    var display = diff.configured(ctx)?
    display.patch = show
    var format = ctx.repo.config["format.pretty"] else "medium"
    var date_style = ctx.repo.config["log.date"] else "default"
    var abbrev = worktree.config_bool(ctx, "log.abbrevcommit", false)?,
        first_parent = false,
        reverse = false,
        explicit_patch = false
    var mailmap = true, show_notes = true, explicit_notes = false, format_given = false
    var decoration = ctx.repo.config["log.decorate"] else "auto"
    let root_diff = worktree.config_bool(ctx, "log.showroot", true)?
    var count = 100000, skip = 0, minimum = display.abbreviate
    var revisions = List[str](), i = 1
    while i < args.len {
        let arg = args[i]
        if show &&
            (
                arg == "--reverse" ||
                    arg.starts_with("--skip=") ||
                    arg.starts_with("--max-count") ||
                    arg.starts_with("-n") ||
                    arg.len > 1 &&
                        arg.bytes()[0] == 45 as byte &&
                        arg.bytes()[1] >= 48 as byte &&
                        arg.bytes()[1] <= 57 as byte
            ) {
            return Unsupported("show revision limiting")
        }
        if arg == "--oneline" {
            format = "oneline"
            abbrev = true
            format_given = true
        } else if arg.starts_with("--pretty=") {
            format = arg[9..]
            format_given = true
        } else if arg.starts_with("--format=") {
            format = arg[9..]
            format_given = true
        } else if arg == "--abbrev-commit" {
            abbrev = true
        } else if arg == "--no-abbrev-commit" {
            abbrev = false
        } else if arg.starts_with("--abbrev=") {
            minimum = number(arg[9..])?
            if minimum < 4 { minimum = 4 }
            if minimum > 40 { minimum = 40 }
        } else if arg.starts_with("--date=") {
            date_style = arg[7..]
        } else if arg == "-p" || arg == "--patch" {
            display.patch = true
            explicit_patch = true
        } else if arg == "-s" || arg == "--no-patch" {
            display.patch = false
            display.stat = false
            explicit_patch = true
        } else if arg == "--stat" {
            display.stat = true
            if !explicit_patch { display.patch = false }
        } else if arg.starts_with("-U") {
            display.context = number(arg[2..])?
            display.patch = true
            explicit_patch = true
        } else if arg == "--binary" {
            display.binary_patch = true
            display.patch = true
            explicit_patch = true
        } else if arg == "--no-renames" {
            display.renames = false
        } else if arg == "--first-parent" {
            first_parent = true
        } else if arg == "--reverse" {
            reverse = true
        } else if arg == "-n" || arg == "--max-count" {
            i += 1
            if i >= args.len { return invalid }
            count = number(args[i])?
        } else if arg.starts_with("--max-count=") {
            count = number(arg[12..])?
        } else if arg.starts_with("--skip=") {
            skip = number(arg[7..])?
        } else if arg.starts_with("-n") {
            count = number(arg[2..])?
        } else if arg.len > 1 &&
            arg.bytes()[0] == 45 as byte &&
            arg.bytes()[1] >= 48 as byte &&
            arg.bytes()[1] <= 57 as byte {
            count = number(arg[1..])?
        } else if arg == "--" {
            if i + 1 < args.len { return Unsupported("history path limiting") }
        } else if arg == "--no-decorate" {
            decoration = "no"
        } else if arg == "--no-notes" {
            show_notes = false
            explicit_notes = false
        } else if arg == "--notes" {
            show_notes = true
            explicit_notes = true
        } else if arg == "--no-mailmap" {
            mailmap = false
        } else if arg == "--no-color" || arg == "--color=never" {} else if arg.starts_with("-") {
            return Unsupported("{args[0]} option {arg}")
        } else {
            (mut revisions).push(arg)
        }
        i += 1
    }
    if date_style == "local" || date_style.ends_with("-local") {
        let tz = env_get("TZ") else "UTC"
        if tz != "UTC" && tz != "UTC0" && tz != "Etc/UTC" && tz != "GMT" {
            return Unsupported("history local timezone {tz}")
        }
    }
    if decoration != "no" && decoration != "false" && decoration != "auto" ||
        decoration == "auto" && (os_isatty(fs.stdout().fd) else false) {
        return Unsupported("history decorations")
    }
    if worktree.config_bool(ctx, "log.showsignature", false)? {
        return Unsupported("history signatures")
    }
    if (ctx.repo.config["log.diffmerges"] else "") != "" {
        return Unsupported("history log.diffMerges")
    }
    for path in ["refs/replace", "info/grafts"] {
        if fs.exists("{ctx.repo.gitdir}/{path}") { return Unsupported("history {path}") }
    }
    // Notes are the default without --pretty/--format/--oneline (pretty-options
    // --notes); only the default ref is displayed, other refs refuse by name.
    let displayed = show_notes && (explicit_notes || !format_given)
    var annotations = notes.Notes { reference: "", tip: [], notes: [] }
    if displayed {
        for name in ["GIT_NOTES_REF", "GIT_NOTES_DISPLAY_REF"] {
            if (env_get(name) else "") != "" { return Unsupported("history notes {name}") }
        }
        for key in ["core.notesref", "notes.displayref"] {
            if (ctx.repo.config[key] else "") != "" { return Unsupported("history notes {key}") }
        }
        annotations = notes.read(ctx.repo, "refs/notes/commits")?
    }
    if fs.exists("{ctx.repo.gitdir}/shallow") { return Unsupported("history shallow repository") }
    if mailmap &&
        (
            fs.exists("{ctx.root}/.mailmap") ||
                (ctx.repo.config["mailmap.file"] else "") != "" ||
                (ctx.repo.config["mailmap.blob"] else "") != ""
        ) {
        return Unsupported("history mailmap")
    }
    if (ctx.repo.config["i18n.logoutputencoding"] else "UTF-8") != "UTF-8" {
        return Unsupported("history output encoding")
    }
    if revisions.len == 0 {
        let head = worktree.head(ctx)?
        if head.commits.len == 0 {
            return Fatal("your current branch '{head.branch}' does not have any commits yet")
        }
        (mut revisions).push("HEAD")
    }
    var starts = List[oid.Oid]()
    for name in revisions {
        if name == ".." {
            return Fatal("..: '..' is outside repository at '{ctx.root}'")
        }
        if show { (mut starts).push(revision.resolve(ctx.repo, name)?) }
    }
    var commits = List[walk.Commit](), out = List[byte](), printed_commit = false
    if !show {
        commits = revset.collect(
            ctx.repo,
            revset.expand(ctx.repo, revisions)?,
            count,
            skip,
            first_parent,
        )?
    }
    let length = if show then starts.len else commits.len
    for n in 0..length {
        let at = if reverse then length - n - 1 else n
        var id = if show then copy starts[at] else copy commits[at].id
        let value = if show {
            var stored = object.read_object(ctx.repo, id, 16777216)?
            var tag_depth = 0
            while stored.kind == "tag" {
                tag_depth += 1
                if tag_depth > 64 { return limit }
                let headers = object.parse_tag(stored.data, "sha1")?
                for field in headers.fields {
                    if field.key == "tag" {
                        add(mut out, "tag ".bytes())
                        add(mut out, field.value)
                        (mut out).push(10 as byte)
                    }
                }
                for field in headers.fields {
                    if field.key == "object" {
                        id = oid.parse("sha1", str_from_utf8(field.value)?)?
                    }
                    if field.key == "tagger" && format != "oneline" {
                        let (person, seconds, zone) = pretty.identity(field.value)?
                        add(
                            mut out,
                            "Tagger: {person}\nDate:   {pretty.date(seconds, zone, date_style)?}\n".
                                bytes(),
                        )
                    }
                }
                (mut out).push(10 as byte)
                for b in headers.message { if b == 0 as byte { break }; (mut out).push(b) }
                if format != "oneline" { (mut out).push(10 as byte) }
                if out.len > 134217728 { return limit }
                stored = object.read_object(ctx.repo, id, 16777216)?
            }
            if stored.kind == "blob" {
                add(mut out, stored.data)
                if out.len > 134217728 { return limit }
                continue
            }
            if stored.kind == "tree" {
                if printed_commit && format != "oneline" { (mut out).push(10 as byte) }
                let name = if tag_depth == 0 then revisions[at] else oid.hex(id)?
                add(mut out, "tree {name}\n\n".bytes())
                for entry in object.parse_tree(stored.data, "sha1")? {
                    add(mut out, entry.name)
                    if entry.mode == 0o40000 { (mut out).push(47 as byte) }
                    (mut out).push(10 as byte)
                }
                if out.len > 134217728 { return limit }
                continue
            }
            if stored.kind != "commit" { return Unsupported("show {stored.kind}") }
            walk.parse(id, stored.data)?
        } else {
            copy commits[at]
        }
        if show && value.parents.len > 1 && (display.patch || display.stat) && !first_parent {
            return Unsupported("show combined merge diff")
        }
        if printed_commit && format != "oneline" { (mut out).push(10 as byte) }
        printed_commit = true
        var ids = [abbreviate(ctx.repo, value.id, minimum)?]
        for parent in value.parents { (mut ids).push(abbreviate(ctx.repo, parent, minimum)?) }
        let formatted = pretty.render(value, format, date_style, ids, abbrev) else |e| match e {
            Fatal(message) => {
                let id = if abbrev then ids[0] else oid.hex(value.id)?
                add(mut out, "commit {id}\n".bytes())
                var stdout = fs.stdout()
                fs.write_chunk(mut stdout, out)?
                eprint("fatal: {message}")
                return 128
            },
            Unsupported(feature) => { return Unsupported(feature) },
            _ => { return invalid },
        }
        add(mut out, formatted)
        if displayed && notes.find(annotations, value.id).len > 0 {
            if format != "medium" { return Unsupported("history notes in {format} format") }
            if display.patch && display.stat {
                return Unsupported("history notes with patch and stat")
            }
            add(mut out, notes.display(ctx.repo, annotations, value.id)?)
        }
        let changes = if !show && !root_diff && value.parents.len == 0 {
            List[byte]()
        } else {
            patch(ctx, value, display, first_parent)?
        }
        if changes.len > 0 {
            if display.patch && display.stat {
                add(mut out, "---\n".bytes())
            } else if format != "oneline" {
                (mut out).push(10 as byte)
            }
            add(mut out, changes)
        }
        if out.len > 134217728 { return limit }
    }
    var stdout = fs.stdout()
    fs.write_chunk(mut stdout, out)?
    0
}

/// CLI boundary: exact measured output or an explicit unsupported feature.
pub fn run(args: List[str]) -> int {
    repository.check_config(".") else |e| match e {
        ConfigDiagnostic(message) => { eprint(message); return 128 },
        _ => {},
    }
    dispatch(args) else |e| match e {
        Unsupported(feature) => { eprint("den: not yet implemented: {feature}"); 2 },
        Fatal(message) => { eprint("fatal: {message}"); 128 },
        _ => { eprint("fatal: {e}"); 128 },
    }
}
