// Git's documented namespaces and measured reverse-refname decoration order.
use object
use oid
use refs
use repository
use revision
use worktree

struct Decoration { name: str, id: oid.Oid, kind: str }

fn tag_target(
    repo: repository.Repo,
    original: oid.Oid,
    mut charged: int,
) -> List[oid.Oid] ! worktree.WorkErrors {
    var id = copy original
    for _ in 0..64 {
        let value = object.read_object(repo, id, 16777216)?
        charged += value.data.len
        if charged > 134217728 { return limit }
        if value.kind == "commit" { return [copy id] }
        if value.kind != "tag" { return List[oid.Oid]() }
        let headers = object.parse_tag(value.data, "sha1")?
        var found = false
        for field in headers.fields {
            if field.key == "object" {
                id = oid.parse("sha1", str_from_utf8(field.value)?)?
                found = true
            }
        }
        if !found { return invalid_header }
    }
    limit
}

fn decorations(repo: repository.Repo) -> List[Decoration] ! worktree.WorkErrors {
    var out = List[Decoration](), charged = 0
    let origin = revision.provenance(repo)?
    if !origin.unborn {
        (mut out).push(Decoration {
            name: if origin.detached then "HEAD" else origin.reference,
            id: refs.read(repo, "HEAD")?,
            kind: if origin.detached then "detached" else "head",
        })
    }
    let names = refs.list(repo, "refs/")?
    for n in 0..names.len {
        let record = copy names[names.len - 1 - n]
        if !origin.detached && record.name == origin.reference { continue }
        let kind = if record.name.starts_with("refs/tags/") {
            "tag"
        } else if record.name.starts_with("refs/remotes/") {
            "remote"
        } else if record.name.starts_with("refs/heads/") {
            "branch"
        } else if record.name == "refs/stash" {
            "stash"
        } else {
            continue
        }
        let targets = if kind == "tag" {
            tag_target(repo, record.id, mut charged)?
        } else {
            [copy record.id]
        }
        if targets.len > 0 {
            (mut out).push(Decoration { name: record.name, id: copy targets[0], kind: kind })
        }
    }
    out
}

fn painted(text: str, code: str, color: bool) -> str {
    if color then "\u{1b}[{code}m{text}\u{1b}[m" else text
}

fn decorated_name(name: str, full: bool) -> str {
    if !full {
        for prefix in ["refs/heads/", "refs/tags/", "refs/remotes/"] {
            if name.starts_with(prefix) { return name[prefix.len..] }
        }
    }
    name
}

fn decoration_text(
    values: List[Decoration],
    id: oid.Oid,
    full: bool,
    color: bool,
) -> str ! worktree.WorkErrors {
    var out = "", count = 0
    for value in values {
        if !oid.equal(value.id, id) { continue }
        if count > 0 { out += painted(", ", "33", color) }
        let name = decorated_name(value.name, full)
        out += match value.kind {
            "head" =>
                painted("HEAD", "1;36", color) +
                    painted(" -> ", "33", color) +
                    painted(name, "1;32", color),
            "detached" => painted("HEAD", "1;36", color),
            "tag" => painted("tag: ", "1;33", color) + painted(name, "1;33", color),
            "remote" => painted(name, "1;31", color),
            "branch" => painted(name, "1;32", color),
            _ => painted(name, "1;35", color),
        }
        count += 1
    }
    if count == 0 { return "" }
    painted(" (", "33", color) + out + painted(")", "33", color)
}

fn history_header(
    formatted: List[byte],
    id: oid.Oid,
    format: str,
    values: List[Decoration],
    full: bool,
    color: bool,
) -> List[byte] ! worktree.WorkErrors {
    // pretty.render stays a pure API with its existing signature. Only the
    // command edge replaces its first ID/header, preserving every body byte.
    var end = 0
    if format == "oneline" {
        while end < formatted.len && formatted[end] != 32 as byte && formatted[end] != 10 as byte {
            end += 1
        }
    } else {
        while end < formatted.len && formatted[end] != 10 as byte { end += 1 }
    }
    let first = str_from_utf8(formatted[0..end])?
    let prefix = painted(first, "33", color) + decoration_text(values, id, full, color)?
    var out = List[byte]()
    add(mut out, prefix.bytes())
    add(mut out, formatted[end..])
    out
}
