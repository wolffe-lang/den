// vc23 (den#84): the local zone, as the pinned Git takes it from TZ.
//
// Git stamps a date it is not given (and reads a date written without a
// zone) in the zone its C library reads from TZ, or from /etc/localtime
// when TZ is unset. Every rule below was measured black-box on the pinned
// Git (notes/vc23-local-time-zones.md); no Git or C library source was
// read. std.time does the reading: this file only chooses the spelling it
// is given, for the TZ values std.time refuses but the C library reads.

use std.fs
use std.time

/// A TZ value as den reads it: the spelling std.time is given (`spec`, ""
/// for UTC), or, when den cannot read it as Git does, the reason it refuses
/// the value by name (`refusal`).
pub struct LocalZone {
    spec: str,
    refusal: str,
}

fn utc_zone() -> LocalZone {
    LocalZone { spec: "", refusal: "" }
}

fn zone_spec(spec: str) -> LocalZone {
    LocalZone { spec: spec, refusal: "" }
}

fn zone_refused(value: str, why: str) -> LocalZone {
    LocalZone { spec: "", refusal: "commit local timezone {value}: {why}" }
}

/// The zone database root the C library and std.time both read.
pub fn zone_dir() -> str {
    env_get("TZDIR") else "/usr/share/zoneinfo"
}

/// The local zone: TZ, or /etc/localtime when TZ is unset.
pub fn local_zone() -> LocalZone ! CommitErrors {
    let value = env_get("TZ") else |e| match e {
        missing => { return zone_spec(":/etc/localtime") },
        utf8 => { return Unsupported("commit non-UTF-8 TZ") },
    }
    zone_reading(value, zone_dir())
}

fn readable(spec: str) -> bool {
    let _ = time.offset_at(spec, 0) else |_| { return false }
    true
}

/// A TZ value as the C library under the pinned Git reads it, given the
/// zone directory `dir` (measured): empty is UTC; `:name` and a path name a
/// file (a relative one below `dir`, never the working directory); a value
/// std.time reads is read as std.time reads it; any other value is read as
/// `lenient` describes. A file that cannot be read is UTC.
pub fn zone_reading(value: str, dir: str) -> LocalZone {
    if value == "" { return utc_zone() }
    if value.starts_with(":") {
        let name = value[1..]
        if name == "" { return utc_zone() }
        if name.starts_with("/") { return zone_spec(value) }
        return zone_spec(":{dir}/{name}")
    }
    if readable(value) { return zone_spec(value) }
    lenient(value, fs.exists("{dir}/posixrules"))
}

struct Cursor {
    s: str,
    i: int,
}

fn at(c: Cursor) -> int {
    if c.i >= c.s.len { return -1 }
    c.s.bytes()[c.i] as int
}

fn letter(ch: int) -> bool {
    ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122
}

fn digit(ch: int) -> bool {
    ch >= 48 && ch <= 57
}

// A designation: three or more letters, or three or more letters, digits,
// `+` and `-` between `<` and `>`. "" when there is none, the cursor where
// it was.
fn designation(mut c: Cursor) -> str {
    let start = c.i
    if at(c) == 60 {
        c.i += 1
        while at(c) >= 0 && at(c) != 62 {
            let ch = at(c)
            if !(letter(ch) || digit(ch) || ch == 43 || ch == 45) {
                c.i = start
                return ""
            }
            c.i += 1
        }
        if at(c) != 62 || c.i - start - 1 < 3 {
            c.i = start
            return ""
        }
        c.i += 1
        return c.s[start..c.i]
    }
    while letter(at(c)) { c.i += 1 }
    if c.i - start < 3 {
        c.i = start
        return ""
    }
    c.s[start..c.i]
}

// Decimal digits, their value held at 1000000; -1 when there are none.
fn number(mut c: Cursor) -> int {
    var n = 0, any = false
    while digit(at(c)) {
        if n < 1000000 { n = n * 10 + at(c) - 48 }
        c.i += 1
        any = true
    }
    if any then n else -1
}

// An offset `[+-]h[:mm[:ss]]`: (read, seconds as written, held). As the C
// library reads one (measured): a sign is taken even when no digit follows,
// and a `+` between it and the hours is skipped (JST-+9 is +0900); a `:`
// that no digit follows ends the offset before it; hours above 24 are held
// at 24, minutes or seconds above 59 at 59 (EST25 is -2400, EST5:60 is
// -0559), and `held` says so. Not read when no hour digit follows the sign.
fn offset(mut c: Cursor) -> (bool, int, bool) {
    var sign = 1
    if at(c) == 43 {
        c.i += 1
    } else if at(c) == 45 {
        sign = -1
        c.i += 1
    }
    if at(c) == 43 && c.i + 1 < c.s.len && digit(c.s.bytes()[c.i + 1] as int) { c.i += 1 }
    var hours = number(mut c)
    if hours < 0 { return (false, 0, false) }
    var held = false
    if hours > 24 {
        hours = 24
        held = true
    }
    var minutes = 0, seconds = 0
    if colon_digit(c) {
        c.i += 1
        minutes = number(mut c)
        if minutes > 59 {
            minutes = 59
            held = true
        }
        if colon_digit(c) {
            c.i += 1
            seconds = number(mut c)
            if seconds > 59 {
                seconds = 59
                held = true
            }
        }
    }
    (true, sign * (hours * 3600 + minutes * 60 + seconds), held)
}

fn colon_digit(c: Cursor) -> bool {
    at(c) == 58 && c.i + 1 < c.s.len && digit(c.s.bytes()[c.i + 1] as int)
}

fn two(n: int) -> str {
    if n < 10 then "0{n}" else "{n}"
}

fn offset_spelling(west: int) -> str {
    let sign = if west < 0 then "-" else ""
    let size = if west < 0 then -west else west
    "{sign}{size / 3600}:{two(size / 60 % 60)}:{two(size % 60)}"
}

// A change rule at the cursor: `Mm.w.d`, `Jn` or `n` in range, then an
// optional `/time` (hours to 167; minutes and seconds count as they add up,
// measured: /2:60 is 3:00). (read, the rule as std.time takes it, timed).
fn rule(mut c: Cursor) -> (bool, str, bool) {
    var text = ""
    if at(c) == 77 {
        c.i += 1
        let m = number(mut c)
        if at(c) != 46 { return (false, "", false) }
        c.i += 1
        let w = number(mut c)
        if at(c) != 46 { return (false, "", false) }
        c.i += 1
        let d = number(mut c)
        if m < 1 || m > 12 || w < 1 || w > 5 || d < 0 || d > 6 { return (false, "", false) }
        text = "M{m}.{w}.{d}"
    } else if at(c) == 74 {
        c.i += 1
        let n = number(mut c)
        if n < 1 || n > 365 { return (false, "", false) }
        text = "J{n}"
    } else {
        let n = number(mut c)
        if n < 0 || n > 365 { return (false, "", false) }
        text = "{n}"
    }
    if at(c) != 47 { return (true, text, false) }
    c.i += 1
    var sign = 1
    if at(c) == 43 {
        c.i += 1
    } else if at(c) == 45 {
        sign = -1
        c.i += 1
    }
    let h = number(mut c)
    if h < 0 || h > 167 { return (false, "", false) }
    var total = h * 3600
    if at(c) == 58 {
        c.i += 1
        let m = number(mut c)
        if m < 0 || m > 999 { return (false, "", false) }
        total += m * 60
        if at(c) == 58 {
            c.i += 1
            let s = number(mut c)
            if s < 0 || s > 999 { return (false, "", false) }
            total += s
        }
    }
    if total > 604799 { return (false, "", false) }
    (true, "{text}/{offset_spelling(sign * total)}", true)
}

// A day number past 365 at the start of `text`.
fn day_past(text: str) -> bool {
    var c = Cursor { s: text, i: 0 }
    number(mut c) > 365
}

/// The C library's reading of a TZ value std.time refuses, as measured on
/// the pinned Git (`posixrules`: the zone directory holds that file):
/// - no designation of three or more letters, or no offset after it: UTC;
/// - out-of-range offset fields, with nothing after them: held in range;
/// - no daylight designation after the offset, but something else: daylight
///   saving at UTC (`<+00>0`), under the rules below;
/// - daylight saving with no change rules: the US rules `M3.2.0,M11.1.0`
///   (refused by name when the C library would read `posixrules` instead);
/// - after the daylight part, anything but `,` or the `M` or `J` of a first
///   rule, or a first rule that is no rule at all: both changes at 00:00 on
///   day 0 (`0/0,0/0`), so a zone west
///   of Greenwich reads as UTC all year but its first hours, one east of it
///   as its standard offset;
/// - a complete first rule and no second (or one trailing `,`): `M11.1.0`;
///   a second rule that is no rule at all: `0/0`;
/// - both rules complete, then a `,` and anything: the rest is ignored;
///   then any other byte: the second change, its time not written, at 00:00.
/// Any other value (held offsets with daylight saving, malformed change
/// rules) is refused by name: the C library reads such rules in ways den
/// does not reproduce.
pub fn lenient(value: str, posixrules: bool) -> LocalZone {
    var c = Cursor { s: value, i: 0 }
    let std_name = designation(mut c)
    if std_name == "" { return utc_zone() }
    let (std_read, std_west, std_held) = offset(mut c)
    if !std_read { return utc_zone() }
    let std_text = "{std_name}{offset_spelling(std_west)}"
    if c.i == value.len { return checked(value, std_text) }
    if std_held { return zone_refused(value, "an out-of-range offset with daylight saving") }
    var dst_text = "<+00>0"
    let dst_name = designation(mut c)
    if dst_name != "" {
        dst_text = dst_name
        let (dst_read, dst_west, dst_held) = offset(mut c)
        if dst_held { return zone_refused(value, "an out-of-range daylight-saving offset") }
        if dst_read { dst_text = "{dst_name}{offset_spelling(dst_west)}" }
    }
    let prefix = "{std_text}{dst_text}"
    // Measured: the comma before the first rule may be left out.
    var rules = ""
    if at(c) == 44 {
        rules = value[c.i + 1..]
    } else if at(c) == 77 || at(c) == 74 {
        rules = value[c.i..]
    } else if c.i < value.len {
        return checked(value, "{prefix},0/0,0/0")
    }
    if rules == "" {
        if posixrules {
            return zone_refused(
                value,
                "daylight saving with no change rules, read from the zone database's posixrules",
            )
        }
        return checked(value, "{prefix},M3.2.0,M11.1.0")
    }
    var r = Cursor { s: rules, i: 0 }
    // Measured: a first rule whose first byte is not a rule's, or a day
    // number past 365, is no rule at all.
    if !(at(r) == 77 || at(r) == 74 || digit(at(r))) || digit(at(r)) && day_past(rules) {
        return checked(value, "{prefix},0/0,0/0")
    }
    let (start_read, start, _) = rule(mut r)
    if !start_read || r.i < rules.len && at(r) != 44 {
        return zone_refused(value, "a malformed daylight-saving rule")
    }
    if r.i < rules.len { r.i += 1 }
    if r.i == rules.len { return checked(value, "{prefix},{start},M11.1.0") }
    if !(at(r) == 77 || at(r) == 74 || digit(at(r))) {
        return checked(value, "{prefix},{start},0/0")
    }
    let (end_read, end, end_timed) = rule(mut r)
    if !end_read { return zone_refused(value, "a malformed daylight-saving rule") }
    // Measured: after a complete second rule a `,` ends the value; any other
    // byte makes a change time that was not written 00:00.
    if r.i == rules.len || at(r) == 44 || end_timed {
        return checked(value, "{prefix},{start},{end}")
    }
    checked(value, "{prefix},{start},{end}/0")
}

// The spelling std.time is given for `value`, when std.time reads it.
fn checked(value: str, spec: str) -> LocalZone {
    if readable(spec) { return zone_spec(spec) }
    zone_refused(value, "a rule den cannot read as the C library does")
}

/// Seconds east of UTC in force at `unix_s` in `zone`. A file std.time
/// cannot open or read is UTC, as the C library reads one (measured).
pub fn zone_offset(zone: LocalZone, unix_s: int) -> int ! CommitErrors {
    if zone.refusal != "" { return Unsupported(zone.refusal) }
    if zone.spec == "" { return 0 }
    time.offset_at(zone.spec, unix_s) else 0
}

/// The local offset in force at `unix_s`: Git's offset for a date it is
/// not given (measured exact at the instant, both sides of a change).
pub fn local_offset(unix_s: int) -> int ! CommitErrors {
    zone_offset(local_zone()?, unix_s)?
}

/// The instant and offset Git gives a wall-clock reading in the local zone,
/// `wall` its fields counted as if UTC (measured over the changes of POSIX
/// rules and zone files, east and west of Greenwich): the offset in force at
/// `wall` read as an instant, corrected once and checked; a reading inside
/// a change's skipped hour takes the offset in force before the change, the
/// smaller of the two. The instant is the reading less the offset in whole
/// minutes (measured: 00:00 at -0:44:30 is 00:44 UTC). Git reads a zone-less
/// `@N` as the reading `N`, keeping N as its instant.
pub fn wall_instant(wall: int) -> (int, int) ! CommitErrors {
    let zone = local_zone()?
    let first = zone_offset(zone, wall)?
    let second = zone_offset(zone, wall - first)?
    var chosen = second
    if second != first {
        let third = zone_offset(zone, wall - second)?
        if third != second { chosen = if first < second then first else second }
    }
    (wall - whole_minutes(chosen), chosen)
}

// An offset in seconds cut to whole minutes, toward zero.
fn whole_minutes(east: int) -> int {
    if east < 0 then -(-east / 60 * 60) else east / 60 * 60
}

/// Git's `+HHMM` for an offset in seconds east: whole minutes, toward zero
/// (measured: an offset of -0:44:30 is written -0044); zero is +0000.
pub fn offset_text(east: int) -> str {
    let minutes = (if east < 0 then -east else east) / 60
    if minutes == 0 { return "+0000" }
    let sign = if east < 0 then "-" else "+"
    "{sign}{two(minutes / 60)}{two(minutes % 60)}"
}
