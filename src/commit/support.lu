use std.fs
use std.time
use commit_format
use object
use oid
use repository
use worktree

fn output(bytes: List[byte]) -> () ! CommitErrors {
    var file = fs.stdout()
    fs.write_chunk(mut file, bytes)?
}

fn message_input(path: str) -> List[byte] ! CommitErrors {
    if path != "-" {
        return repository.read_bytes(path, 16777216) else |e| match e {
            not_found => {
                return Fatal("could not read log file '{path}': No such file or directory")
            },
            denied => { return Fatal("could not read log file '{path}': Permission denied") },
            io => { return io },
            invalid => { return invalid },
            exists => { return exists },
            unsupported => { return unsupported },
            limit => { return limit },
            Unsupported(reason) => { return Unsupported(reason) },
        }
    }
    var file = fs.stdin()
    var out = List[byte]()
    loop {
        region chunk {
            let data = fs.read_chunk(mut file, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if data.len > 16777216 - out.len { return limit }
            add_bytes(mut out, data)
        }
    }
    out
}

fn text(bytes: List[byte]) -> str ! CommitErrors {
    str_from_utf8(bytes) else |_| { return Unsupported("commit non-UTF-8 header") }
}

fn header(headers: object.Headers, key: str) -> str ! CommitErrors {
    for field in headers.fields { if field.key == key { return text(field.value)? } }
    invalid_header
}

fn owned_id(id: oid.Oid) -> oid.Oid {
    oid.Oid { algorithm: id.algorithm, bytes: owned(id.bytes) }
}

fn owned_flat(entries: List[worktree.FlatEntry]) -> List[worktree.FlatEntry] {
    var out = List[worktree.FlatEntry]()
    for entry in entries {
        (mut out).push(worktree.
            FlatEntry { path: owned(entry.path), mode: entry.mode, id: owned_id(entry.id) })
    }
    out
}

fn read_commit(repo: repository.Repo, id: oid.Oid) -> object.Headers ! CommitErrors {
    let stored = object.read_object(repo, id, 16777216)?
    if stored.kind != "commit" { return invalid_header }
    // Materialize nested borrowed views before handing them to owned builders.
    let bytes = owned(stored.data)
    let parsed = object.parse_commit(bytes, "sha1")?
    var fields = List[object.Header]()
    for field in parsed.fields { (mut fields).push(object.Header { key: field.key, value: owned(field.value) }) }
    object.Headers { fields: fields, message: owned(parsed.message) }
}

fn parents_of(headers: object.Headers) -> List[oid.Oid] ! CommitErrors {
    var parents = List[oid.Oid]()
    for field in headers.fields {
        if field.key == "parent" { (mut parents).push(oid.parse("sha1", text(field.value)?)?) }
    }
    parents
}

fn selected_date(value: str) -> commit_format.Date ! CommitErrors {
    commit_format.parse_date(value, "+0000") else |e| match e {
        Unsupported(reason) => { return Unsupported(reason) },
        _ => { return Fatal("invalid date format: {value}") },
    }
}

fn identity_environment(name: str) -> str ! {missing, Unsupported(str)} {
    env_get(name) else |e| match e {
        missing => { return missing },
        utf8 => { return Unsupported("commit non-UTF-8 {name}") },
    }
}

fn environment_or(name: str, fallback: str) -> str ! CommitErrors {
    identity_environment(name) else |e| match e {
        missing => fallback,
        Unsupported(reason) => { return Unsupported(reason) },
    }
}

fn validate_identity_environment() -> () ! CommitErrors {
    for name in [
        "GIT_AUTHOR_NAME",
        "GIT_AUTHOR_EMAIL",
        "GIT_AUTHOR_DATE",
        "GIT_COMMITTER_NAME",
        "GIT_COMMITTER_EMAIL",
        "GIT_COMMITTER_DATE",
    ] {
        let _ = identity_environment(name) else |e| match e {
            missing => "",
            Unsupported(reason) => { return Unsupported(reason) },
        }
    }
}

fn configured_email(ctx: worktree.Context, role: str) -> str ! {missing} {
    ctx.repo.config["{role}.email"] else (ctx.repo.config["user.email"] else { return missing })
}

fn role_date(role: str) -> commit_format.Date ! CommitErrors {
    var date = environment_or("GIT_{role}_DATE", "")?
    if date == "" { date = "@{time.unix_ms() / 1000} +0000" }
    selected_date(date)?
}

/// Resolve identity from environment/config using the commit date parser.
/// The caller supplies a worktree context only for its repository configuration.
pub fn environment_identity(
    ctx: worktree.Context,
    role: str,
    override_date: str,
) -> commit_format.Identity ! CommitErrors {
    let key = role.lower()
    var from_environment = true, configured = true
    let name = identity_environment("GIT_{role}_NAME") else |e| match e {
        missing => {
            from_environment = false
            ctx.repo.config["{key}.name"] else (
                ctx.repo.config["user.name"] else {
                    configured = false
                    ""
                }
            )
        },
        Unsupported(reason) => { return Unsupported(reason) },
    }
    let email = identity_environment("GIT_{role}_EMAIL") else |e| match e {
        missing =>
            configured_email(ctx, key) else |_| {
                identity_environment("EMAIL") else |f| match f {
                    missing => {
                        configured = false
                        ""
                    },
                    Unsupported(reason) => { return Unsupported(reason) },
                }
            },
        Unsupported(reason) => { return Unsupported(reason) },
    }
    // No identity is guessed from the host; Git's measured refusals of an
    // explicitly empty or disallowed name are kept (vc26).
    if !configured { return Unsupported("commit missing {key} identity") }
    empty_name_check(role, name, email, !from_environment)?
    let date = if override_date != "" then selected_date(override_date)? else role_date(role)?
    commit_format.make_identity(name, email, date)?
}

/// vc26: Git's refusals of a name it cannot write, as measured: an empty
/// name is `empty ident name (for <EMAIL>) not allowed`, after Git's
/// "identity unknown" advice when the name came from configuration; a name
/// of disallowed characters alone is refused naming them.
pub fn empty_name_check(role: str, name: str, email: str, advice: bool) -> () ! CommitErrors {
    if name == "" {
        if advice {
            let who = if role == "AUTHOR" then "Author" else "Committer"
            eprint(
                "{who} identity unknown\n\n*** Please tell me who you are.\n\nRun\n\n  git config --global user.email \"you@example.com\"\n  git config --global user.name \"Your Name\"\n\nto set your account's default identity.\nOmit --global to set the identity only in this repository.\n",
            )
        }
        return Fatal("empty ident name (for <{commit_format.ident_clean(email)?}>) not allowed")
    }
    if commit_format.ident_clean(name)? == "" {
        return Fatal("name consists only of disallowed characters: {name}")
    }
}

// An explicit --author `Name <email>`: an empty name part is Git's
// empty-name refusal (measured: `--author=' <a@x>'`).
fn author_option(text: str, date: commit_format.Date) -> commit_format.Identity ! CommitErrors {
    let left = text.find("<") else |_| { return commit_format.parse_author(text, date)? }
    let right = text.rfind(">") else |_| { return commit_format.parse_author(text, date)? }
    if right > left && text[0..left].trim() == "" {
        return Fatal(
            "empty ident name (for <{commit_format.ident_clean(text[left + 1..right])?}>) not allowed",
        )
    }
    commit_format.parse_author(text, date)?
}

fn header_bytes(headers: object.Headers, key: str) -> List[byte] ! CommitErrors {
    for field in headers.fields { if field.key == key { return owned(field.value) } }
    invalid_header
}

/// vc26: stored identity bytes as Git writes them back: unchanged when they
/// are UTF-8, else repaired (repaired_message) with Git's warning owed.
pub struct Kept { bytes: List[byte], repaired: bool }

/// Stored bytes kept for writing back: unchanged, or repaired when they
/// are not UTF-8 (Git's measured repair of a Latin-1 author).
pub fn kept_bytes(value: List[byte]) -> Kept {
    let _ = str_from_utf8(value) else |_| {
        return Kept { bytes: repaired_message(value), repaired: true }
    }
    Kept { bytes: owned(value), repaired: false }
}

// vc26: an amended commit's author as Git re-reads and re-writes it
// (measured): the name and email of Git's split, cleaned as on any commit;
// the stored date re-read as `@SECONDS ZONE`, where a zone of other than
// four digits is the local one; with no readable date, the commit's own.
fn preserved_identity(kept: Kept) -> commit_format.Identity ! CommitErrors {
    let raw = commit_format.raw_identity(kept.bytes)
    if !raw.split { return Fatal("commit 'HEAD' has malformed author line") }
    let name = text(raw.name)?, email = text(raw.email)?
    empty_name_check("AUTHOR", name, email, false)?
    if !raw.dated { return commit_format.make_identity(name, email, role_date("AUTHOR")?)? }
    let zone_text = text(raw.zone_text)?
    if !raw.fits {
        if raw.seconds_text == "18446744073709551615" {
            return Fatal("invalid date format: @{text(raw.stamp)?} {zone_text}")
        }
        return Unsupported("commit amend date past 9223372036854775807")
    }
    let zone = if zone_text.len == 5 then zone_text else "+0000"
    commit_format.make_identity(name, email, selected_date("@{raw.seconds} {zone}")?)?
}

fn commit_author(ctx: worktree.Context, value: Options, previous: List[object.Headers]) -> (
    commit_format.Identity,
    bool,
) ! CommitErrors {
    var repaired = false
    var author = if value.amend && !value.reset_author {
        if previous.len != 1 { return invalid_header }
        let kept = kept_bytes(header_bytes(previous[0], "author")?)
        repaired = kept.repaired
        preserved_identity(kept)?
    } else if value.author != "" {
        let date = if value.date != "" then selected_date(value.date)? else role_date("AUTHOR")?
        author_option(value.author, date)?
    } else {
        environment_identity(ctx, "AUTHOR", value.date)?
    }
    if value.date != "" { author.date = selected_date(value.date)? }
    if value.author != "" { author = author_option(value.author, author.date)? }
    (author, repaired)
}

// Inherited own-code policy from src/plumbing/plumbing.lu (R-vc02-2): keep
// valid UTF-8 sequences, encode isolated invalid octets as Latin-1 scalars.
/// Valid UTF-8 kept, each other byte written as the Latin-1 character it
/// names: Git's repair of a commit that does not conform to UTF-8.
pub fn repaired_message(data: List[byte]) -> List[byte] {
    var out = List[byte]()
    var pos = 0
    while pos < data.len {
        let b = data[pos] as int
        var width = if b < 128 {
            1
        } else if b >= 194 && b <= 223 {
            2
        } else if b >= 224 && b <= 239 {
            3
        } else if b >= 240 && b <= 244 {
            4
        } else {
            0
        }
        if width > data.len - pos { width = 0 }
        if width > 0 {
            region validate {
                let check = str_from_utf8(data[pos..pos + width]) else ""
                if check.len == 0 { width = 0 }
            }
        }
        if width == 0 {
            (mut out).push((192 + b / 64) as byte)
            (mut out).push((128 + b % 64) as byte)
            pos += 1
        } else {
            for i in pos..pos + width { (mut out).push(data[i]) }
            pos += width
        }
    }
    out
}

/// Render the first nonempty paragraph for human summaries: trim trailing
/// ASCII whitespace on each line, preserve its leading/internal bytes, and
/// join adjacent nonblank lines with one SP. No decoding or repair occurs.
pub fn subject(message: List[byte]) -> List[byte] ! CommitErrors {
    object.subject(message)?
}

/// Normalize only the first physical line for a reflog, trimming/collapsing
/// ASCII whitespace. A leading LF produces an empty subject, not line two.
/// The command supplies its cleaned message before any UTF-8 repair.
pub fn reflog_subject(message: List[byte]) -> List[byte] ! CommitErrors {
    if message.len > 16777216 { return limit }
    var out = List[byte]()
    var space = false
    for b in message {
        if b == 10 as byte { break }
        if b == 32 as byte || b as int >= 9 && b as int <= 13 {
            if out.len > 0 { space = true }
        } else {
            if space { (mut out).push(32 as byte); space = false }
            (mut out).push(b)
        }
    }
    out
}

fn summary_date(date: commit_format.Date) -> str ! CommitErrors {
    // Bound before std's documented checked seconds+offset arithmetic.
    if date.seconds < 0 || date.seconds > 253401938459 {
        return Unsupported("commit summary date range")
    }
    let raw = commit_format.date_text(date)?
    let parts = raw.split(" ")
    let zone = parts[1]
    let cut = zone.len - 2
    let hours = zone[1..cut].to_int() else |_| { return invalid_date }
    let minutes = zone[cut..].to_int() else |_| { return invalid_date }
    let magnitude = hours * 3600 + minutes * 60
    let offset = if zone.starts_with("-") then -magnitude else magnitude
    let local = time.local_in("UTC0", date.seconds + offset) else |_| { return invalid_date }
    let civil = time.format(local, "%a %b %-d %H:%M:%S %Y") else |_| { return invalid_date }
    "{civil} {zone}"
}

/// UTC spellings or an unresolvable zone use UTC; valid non-UTC zones retain
/// their existing named refusal. UTC0 itself needs no zone-database file.
pub fn utc_timezone(zone: str) -> bool ! {io} {
    if zone == "" || zone == "UTC" || zone == "UTC0" || zone == "Etc/UTC" || zone == "GMT" {
        return true
    }
    let _ = time.offset_at(zone, 0) else |e| match e {
        zone => { return true },
        io => { return io },
    }
    false
}

fn hooks_empty(ctx: worktree.Context) -> () ! CommitErrors {
    let path = ctx.repo.config["core.hookspath"] else "{ctx.repo.gitdir}/hooks"
    let root = if path.starts_with("/") then path else "{ctx.root}/{path}"
    if fs.is_dir(root) && fs.entries(root)?.len > 0 {
        return Unsupported("commit nonempty hooks directory")
    }
    if worktree.config_bool(ctx, "commit.gpgsign", false)? { return Unsupported("commit signing") }
    if (env_get("GIT_INDEX_FILE") else "") != "" { return Unsupported("commit GIT_INDEX_FILE") }
    let zone = env_get("TZ") else "UTC"
    if !utc_timezone(zone)? {
        return Unsupported("commit implicit local timezone {zone}")
    }
}
