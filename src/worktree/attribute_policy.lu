use std.map
use ignore
use index
use object

/// Effective per-path attributes. Empty driver strings mean Git defaults;
/// '-' and '+' are unset/set for diff/merge. Text: -1 unset, 0 default,
/// 1 forced, 2 auto. Eol: -1 unset, 0 default, 1 LF, 2 CRLF. The legacy crlf
/// field is kept apart (-1 unset, 0 default, 1 set or valued): a specified
/// text field wins over it in either order, as the pinned Git stores it.
pub struct Attributes {
    text: int,
    eol: int,
    diff: str,
    merge: str,
    filter: str,
    conflict_marker_size: int,
    ident: bool,
    encoding: str,
    crlf: int,
}

/// One compiled file rule, shared by the directory cache and target preflight.
pub struct AttributeRule { pattern: ignore.Rule, tokens: List[List[byte]] }

/// Operation-local compiled metadata and one batch object reader. No cache is
/// persisted across commands or used as evidence that a worktree file is clean.
pub struct AttributeCache {
    rules: Map[str, List[AttributeRule]],
    info: List[AttributeRule],
    ignore_case: bool,
    reader: object.Reader,
}

/// Default fields before any path rules match.
pub fn attributes_empty() -> Attributes {
    Attributes {
        text: 0,
        eol: 0,
        diff: "",
        merge: "",
        filter: "",
        conflict_marker_size: 7,
        ident: false,
        encoding: "",
        crlf: 0,
    }
}

/// Consult the already merged system/global/repository/runtime config layer;
/// no renderer, merge driver or filter process reads another configuration file.
pub fn configured_attribute_driver(ctx: Context, family: str, name: str) -> bool {
    if name == "" || name == "-" || name == "+" { return false }
    let prefix = "{family}.{name}."
    for key in map.keys(ctx.repo.config) { if key.starts_with(prefix) { return true } }
    false
}

/// A diff driver as counts and binary rendering see it: a named driver whose
/// `diff.<name>.binary` is true is binary ('-'); any other name keeps Git's
/// content detection. Patch consumers refuse configured drivers separately.
pub fn diff_driver_binary(ctx: Context, driver: str) -> str ! WorkErrors {
    if driver == "" || driver == "-" || driver == "+" { return driver }
    if config_bool(ctx, "diff.{driver}.binary", false)? { return "-" }
    driver
}

fn attribute_pattern(raw: List[byte]) -> List[byte] ! WorkErrors {
    if raw.len == 0 || raw[0] != 34 as byte { return copy raw }
    if raw.len < 2 || raw[raw.len - 1] != 34 as byte {
        return Unsupported("worktree attributes: invalid quoted pattern")
    }
    var out = List[byte](), pos = 1
    while pos < raw.len - 1 {
        var b = raw[pos]
        pos += 1
        if b == 92 as byte {
            if pos >= raw.len - 1 {
                return Unsupported("worktree attributes: invalid quoted pattern")
            }
            b = raw[pos]
            pos += 1
            if b == 110 as byte {
                b = 10 as byte
            } else if b == 116 as byte {
                b = 9 as byte
            } else if b == 114 as byte {
                b = 13 as byte
            } else if b == 98 as byte {
                b = 8 as byte
            } else if b == 102 as byte {
                b = 12 as byte
            } else if b == 118 as byte {
                b = 11 as byte
            } else if b == 97 as byte {
                b = 7 as byte
            } else if b >= 48 as byte && b <= 55 as byte {
                var value = b as int - 48, count = 1
                while count < 3 &&
                    pos < raw.len - 1 &&
                    raw[pos] >= 48 as byte &&
                    raw[pos] <= 55 as byte {
                    value = value * 8 + raw[pos] as int - 48
                    pos += 1
                    count += 1
                }
                if value > 255 { return Unsupported("worktree attributes: invalid quoted pattern") }
                b = value as byte
            } else if b != 34 as byte && b != 92 as byte {
                return Unsupported("worktree attributes: invalid quoted pattern")
            }
        }
        (mut out).push(b)
    }
    out
}

fn compile_attributes(
    data: List[byte],
    base: List[byte],
    fold: bool,
) -> List[AttributeRule] ! WorkErrors {
    var out = List[AttributeRule](), first = true
    for raw in attribute_lines(data) {
        var line = copy raw
        if first &&
            line.len >= 3 &&
            line[0] == 239 as byte &&
            line[1] == 187 as byte &&
            line[2] == 191 as byte {
            line = copy line[3..]
        }
        first = false
        let tokens = attribute_tokens(line)
        if tokens.len < 2 || tokens[0][0] == 35 as byte { continue }
        let pattern = attribute_pattern(tokens[0])?
        if pattern.len >= 6 && compare(pattern[0..6], "[attr]".bytes()) == 0 {
            return Unsupported("worktree attributes: macro definition")
        }
        if pattern.len == 0 || pattern[0] == 33 as byte { continue }
        let directory = if fold then attribute_fold(base) else copy base
        let rule = ignore.attribute_rule("attributes", directory, pattern, fold)?
        var fields = List[List[byte]]()
        for i in 1..tokens.len { (mut fields).push(copy tokens[i]) }
        (mut out).push(AttributeRule { pattern: rule, tokens: fields })
    }
    out
}

fn attribute_marker_size(argument: str) -> int {
    if argument == "" { return 7 }
    var value = 0
    for b in argument.bytes() {
        if b < 48 as byte || b > 57 as byte { return 7 }
        if value > 100000000 { return 2147483647 }
        value = value * 10 + b as int - 48
    }
    if value > 0 then value else 7
}

fn attribute_apply(mut value: Attributes, raw: List[byte]) -> () ! WorkErrors {
    let token = str_from_utf8(raw) else |_| { return }
    var start = 0, state = 1
    if token.starts_with("-") {
        start = 1
        state = -1
    } else if token.starts_with("!") {
        start = 1
        state = 0
    }
    var end = token.len
    let bytes = token.bytes()
    for i in start..bytes.len { if bytes[i] == 61 as byte { end = i; break } }
    let name = token[start..end]
    let assigned = end < token.len
    let argument = if assigned then token[end + 1..] else ""
    if name == "binary" && state == 1 && !assigned {
        value.diff = "-"
        value.merge = "-"
        value.text = -1
    } else if name == "text" {
        value.text = if state <= 0 {
            state
        } else if !assigned {
            1
        } else if argument == "auto" {
            2
        } else {
            3
        }
    } else if name == "eol" {
        value.eol = if state <= 0 {
            state
        } else if argument == "lf" {
            1
        } else if argument == "crlf" {
            2
        } else {
            3
        }
    } else if name == "diff" || name == "merge" {
        let field = if state == 0 {
            ""
        } else if state == -1 {
            "-"
        } else if !assigned {
            "+"
        } else {
            copy argument
        }
        if name == "diff" { value.diff = copy field } else { value.merge = copy field }
    } else if name == "filter" {
        value.filter = if state <= 0 || !assigned then "" else copy argument
    } else if name == "conflict-marker-size" {
        value.conflict_marker_size = if state <= 0 then 7 else attribute_marker_size(argument)
        if value.conflict_marker_size < 1 { value.conflict_marker_size = 7 }
    } else if name == "ident" {
        value.ident = state == 1
    } else if name == "working-tree-encoding" {
        value.encoding = if state <= 0 then "" else if assigned then copy argument else "+"
    } else if name == "crlf" {
        value.crlf = if state <= 0 then state else 1
    }
}

fn apply_attribute_rules(
    rules: List[AttributeRule],
    path: List[byte],
    fold: bool,
    mut value: Attributes,
) -> () ! WorkErrors {
    if rules.len == 0 { return }
    let candidate = if fold then attribute_fold(path) else copy path
    for rule in rules {
        if ignore.matches(rule.pattern, candidate, false)? {
            for token in rule.tokens { attribute_apply(mut value, token)? }
        }
    }
}

/// Prepare an operation-local resolver with compiled info metadata.
pub fn attribute_cache(ctx: Context) -> AttributeCache ! WorkErrors {
    let fold = config_bool(ctx, "core.ignorecase", false)?
    AttributeCache {
        rules: Map[str, List[AttributeRule]](),
        info: compile_attributes(attributes_data("{ctx.repo.gitdir}/info/attributes")?, [], fold)?,
        ignore_case: fold,
        reader: object.reader_batch(ctx.repo),
    }
}

fn ensure_attribute_base(
    ctx: Context,
    value: index.Index,
    base: List[byte],
    mut cache: AttributeCache,
) -> () ! WorkErrors {
    let key = text(base)?
    if map.has(cache.rules, key) { return }
    let data = attributes_source_reader(ctx, base, value, cache.reader)?
    let rules = compile_attributes(data, base, cache.ignore_case)?
    cache.rules[key] = copy rules
}

fn apply_attribute_base(
    cache: AttributeCache,
    key: str,
    path: List[byte],
    mut result: Attributes,
) -> () ! WorkErrors {
    let rules = cache.rules[key] else List[AttributeRule]()
    apply_attribute_rules(rules, path, cache.ignore_case, mut result)?
}

/// Resolve root-to-leaf fields, then info metadata; later fields override macro
/// expansion independently. No diff/merge policy refusal occurs here.
pub fn attribute_policy_cached(
    ctx: Context,
    path: List[byte],
    value: index.Index,
    mut cache: AttributeCache,
) -> Attributes ! WorkErrors {
    var result = attributes_empty()
    if ctx.root != "" {
        ensure_attribute_base(ctx, value, [], mut cache)?
        apply_attribute_base(cache, "", path, mut result)?
        for i in 0..path.len {
            if path[i] != 47 as byte { continue }
            let base = path[0..i]
            ensure_attribute_base(ctx, value, base, mut cache)?
            apply_attribute_base(cache, text(base)?, path, mut result)?
        }
    }
    apply_attribute_rules(cache.info, path, cache.ignore_case, mut result)?
    result
}

/// Resolve a single path. Batch consumers should use attribute_policy_cached.
pub fn attribute_policy(
    ctx: Context,
    path: List[byte],
    value: index.Index,
) -> Attributes ! WorkErrors {
    var cache = attribute_cache(ctx)?
    attribute_policy_cached(ctx, path, value, mut cache)?
}

/// The text state a decision uses: the text field when specified, otherwise
/// `-crlf` as `-text`. A set or valued crlf alone refuses in identity checks.
pub fn attribute_text(value: Attributes) -> int {
    if value.text != 0 { return value.text }
    if value.crlf < 0 { return -1 }
    0
}

fn check_attribute_identity(ctx: Context, path: List[byte], value: Attributes) -> () ! WorkErrors {
    if value.eol > 1 && attribute_text(value) != -1 {
        return Unsupported("worktree attributes: eol at {text(path)?}")
    }
    if value.text > 2 { return Unsupported("worktree attributes: text at {text(path)?}") }
    if value.crlf > 0 && value.text == 0 {
        return Unsupported("worktree attributes: crlf at {text(path)?}")
    }
    if value.ident { return Unsupported("worktree attributes: ident at {text(path)?}") }
    if value.encoding != "" {
        return Unsupported("worktree attributes: working-tree-encoding at {text(path)?}")
    }
    if configured_attribute_driver(ctx, "filter", value.filter) {
        return Unsupported("worktree attributes: filter {value.filter} at {text(path)?}")
    }
}
