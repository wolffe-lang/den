use revision

fn status_upstream(snapshot: Snapshot, counts: bool) -> revision.Upstream ! WorkErrors {
    revision.upstream(
        snapshot.context.repo,
        if snapshot.head.detached then "" else snapshot.head.branch,
        snapshot.head.commits,
        counts,
    )?
}

fn upstream_summary(tracking: revision.Upstream) -> str {
    if tracking.ids.len == 0 { return "gone" }
    if tracking.ahead > 0 && tracking.behind > 0 {
        return "ahead {tracking.ahead}, behind {tracking.behind}"
    }
    if tracking.ahead > 0 { return "ahead {tracking.ahead}" }
    if tracking.behind > 0 { return "behind {tracking.behind}" }
    ""
}

fn tracking_short(snapshot: Snapshot) -> str ! WorkErrors {
    let tracking = status_upstream(snapshot, true)?
    if tracking.reference == "" { return "" }
    let summary = upstream_summary(tracking)
    "...{tracking.name}{if summary == "" then "" else " [{summary}]"}"
}

fn tracking_long(mut out: List[byte], snapshot: Snapshot, hints: bool) -> () ! WorkErrors {
    if snapshot.head.commits.len == 0 { return }
    let tracking = status_upstream(snapshot, true)?
    if tracking.reference == "" { return }
    let name = tracking.name, ahead = tracking.ahead, behind = tracking.behind
    if tracking.ids.len == 0 {
        line(mut out, "Your branch is based on '{name}', but the upstream is gone.")
        if hints { line(mut out, "  (use \"git branch --unset-upstream\" to fixup)") }
    } else if ahead == 0 && behind == 0 {
        line(mut out, "Your branch is up to date with '{name}'.")
    } else if behind == 0 {
        line(
            mut out,
            "Your branch is ahead of '{name}' by {ahead} {if ahead == 1 then "commit" else "commits"}.",
        )
        if hints { line(mut out, "  (use \"git push\" to publish your local commits)") }
    } else if ahead == 0 {
        line(
            mut out,
            "Your branch is behind '{name}' by {behind} {if behind == 1 then "commit" else "commits"}, and can be fast-forwarded.",
        )
        if hints { line(mut out, "  (use \"git pull\" to update your local branch)") }
    } else {
        line(mut out, "Your branch and '{name}' have diverged,")
        line(mut out, "and have {ahead} and {behind} different commits each, respectively.")
        if hints {
            line(
                mut out,
                "  (use \"git pull\" if you want to integrate the remote branch with yours)",
            )
        }
    }
    line(mut out, "")
}

/// How a tracked path's worktree differs from HEAD, staged or not, as
/// checkout lists it: "" when it does not (a path added and then deleted).
fn head_letter(x: str, y: str) -> str {
    if x == "A" { return if y == "D" then "" else "A" }
    if y == "D" || y == "T" { return copy y }
    if x != " " { return copy x }
    if y == " " { return "" }
    copy y
}

/// What checkout and switch print on stdout after moving HEAD (vc25, measured
/// against the pinned Git): each local change as `<code>\t<path>`, the code
/// saying how the worktree differs from HEAD whether staged or not, a staged
/// rename as its two paths, in path order; then the branch's tracking lines,
/// without status's trailing blank line. CHANGES false leaves the list out,
/// for the moves Git prints none after.
pub fn checkout_report(snapshot: Snapshot, changes: bool, hints: bool) -> List[byte] ! WorkErrors {
    var out = List[byte]()
    var paths = List[List[byte]](), letters = List[str]()
    for row in snapshot.rows {
        if !changes || row.untracked || row.ignored { continue }
        if row.x == "R" {
            (mut paths).push(owned_bytes(row.original_path))
            (mut letters).push("D")
            if row.y != "D" {
                (mut paths).push(owned_bytes(row.path))
                (mut letters).push("A")
            }
            continue
        }
        let letter = head_letter(row.x, row.y)
        if letter == "" { continue }
        (mut paths).push(owned_bytes(row.path))
        (mut letters).push(letter)
    }
    for i in path_order(paths) {
        bytes_add(mut out, "{letters[i]}\t".bytes())
        bytes_add(mut out, owned_bytes(paths[i]))
        (mut out).push(10 as byte)
    }
    var tracking = List[byte]()
    tracking_long(mut tracking, snapshot, hints)?
    if tracking.len > 0 { tracking = owned_bytes(tracking[0..tracking.len - 1]) }
    bytes_add(mut out, tracking)
    out
}
