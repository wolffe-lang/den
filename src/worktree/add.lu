use std.fs
use ignore
use index
use object
use oid

/// Add policy independent of command parsing; chmod is -1 (unchanged), 0 or 1.
pub struct AddOptions {
    all: bool,
    update: bool,
    ignore_removal: bool,
    force: bool,
    intent: bool,
    chmod: int,
    verbose: bool,
    dry_run: bool,
}

/// Default add stages exactly the selected paths, including their deletions.
pub fn add_options() -> AddOptions {
    AddOptions {
        all: false,
        update: false,
        ignore_removal: false,
        force: false,
        intent: false,
        chmod: -1,
        verbose: false,
        dry_run: false,
    }
}

fn ensure_filters(ctx: Context) -> () ! WorkErrors {
    let autocrlf = ctx.repo.config["core.autocrlf"] else "false"
    if autocrlf != "false" && autocrlf != "0" { return Unsupported("core.autocrlf={autocrlf}") }
    let eol = (ctx.repo.config["core.eol"] else "native").lower()
    if eol != "lf" && eol != "native" { return Unsupported("core.eol={eol}") }
    check_attributes(ctx)?
}

fn entry_for(
    file: FileState,
    prior: List[index.Entry],
    options: AddOptions,
) -> index.Entry ! WorkErrors {
    if prior.len > 1 { return unmerged }
    var mode = file.mode
    if options.chmod >= 0 {
        if mode != 0o100644 && mode != 0o100755 {
            return Unsupported("--chmod on a non-regular entry")
        }
        mode = if options.chmod == 1 then 0o100755 else 0o100644
    }
    let flags = if prior.len == 1 then prior[0].flags else 0
    var extended = if prior.len == 1 then prior[0].extended & 0x4000 else 0
    if options.intent { extended = extended | 0x2000 }
    let id = if options.intent then object.identify("blob", [])? else copy file.id
    var entry = if file.mode == 0o160000 {
        index.entry_from_directory(file.stat, file.path, id, flags, extended)?
    } else if file.kind == 3 {
        index.entry_from_lstat(file.stat, file.path, id, flags, extended)?
    } else {
        index.entry_from_stat(
            file.stat,
            file.path,
            id,
            if mode == 0o120000 then 0o100644 else mode,
            flags,
            extended,
        )?
    }
    entry.stat[6] = mode
    if options.intent { entry.stat = [0, 0, 0, 0, 0, 0, mode, 0, 0, 0] }
    entry
}

fn path_present(ctx: Context, path: List[byte]) -> bool ! WorkErrors {
    let _ = fs_lstat(absolute(ctx, path)?) else |e| match e {
        not_found => { return false },
        denied => { return denied },
        io => { return io },
    }
    true
}

// The walk's warnings, copied into the caller's list (which outlives the
// walk's region) as ignore's queries add one: once per message.
fn keep_warnings(mut into: List[str], found: List[str]) {
    for warning in found {
        var seen = false
        for previous in into { if previous == warning { seen = true; break } }
        if !seen { (mut into).push(copy warning) }
    }
}

// A walk that found nothing: what add starts from, and what a failed walk's
// handler yields while its diagnostic is carried out of the walk's region.
fn no_walk() -> Walk {
    Walk {
        files: List[FileState](),
        directories: List[List[byte]](),
        lookups: no_lookups(),
        sorted: no_lookups(),
    }
}

// A tracked regular file or symlink whose lstat equals its stage-zero entry
// and is not racily clean (scan's stat_clean): Git's add leaves it alone.
// add's racy test is coarser than status's: the pinned Git stages an entry
// again when its mtime falls in the index file's own second or later, even
// a fraction of a second before the index was written.
fn unchanged(entry: index.Entry, file: FileState, written: List[int]) -> bool {
    if index.stage(entry) != 0 || entry.stat.len != 10 || entry.stat[6] == 0o160000 { return false }
    if file.kind != 0 && file.kind != 3 { return false }
    if written[0] < 0 || entry.stat[2] >= written[0] { return false }
    stat_clean(entry, file.stat, file.mode, written)
}

/// Apply Git add's measured cache policy without IO. Every actually staged
/// entry invalidates its TREE ancestors, even with identical stat/mode/oid.
/// stage_paths bypasses assume-valid/skip entries before reaching this helper;
/// the generic index.replace_entry intentionally retains stat-only caches.
pub fn stage_entry(value: index.Index, entry: index.Entry) -> index.Index ! WorkErrors {
    let result = index.replace_entry(value, entry)?
    index.invalidate_tree(result, entry.path)?
}

/// Stage into an owned, already-locked index value. Caller owns begin/commit;
/// no lock is acquired here. All pathspec/ignore checks precede object writes.
/// Empty paths selects all only with all/update; otherwise it changes nothing.
pub fn stage_paths(
    ctx: Context,
    mut value: index.Index,
    paths: List[List[byte]],
    options: AddOptions,
) -> List[List[byte]] ! WorkErrors {
    var warnings = List[str]()
    stage_paths_with_warnings(ctx, mut value, paths, options, mut warnings)?
}

/// Stage with nonfatal ignore diagnostics collected in the caller's operation
/// list. Only actual untracked-file/directory ignore queries can append a
/// warning; tracked-only selections and update=true never load ignore sources.
/// Never emits stderr, including on an ignored-path or other error return.
pub fn stage_paths_with_warnings(
    ctx: Context,
    mut value: index.Index,
    paths: List[List[byte]],
    options: AddOptions,
    mut warnings: List[str],
) -> List[List[byte]] ! WorkErrors {
    validate_specs(paths)?
    let _ = index.serialize(value)?
    // A path inside a submodule belongs to the submodule's own index (vc25
    // work rows).
    for path in paths {
        for entry in value.entries {
            if entry.stat[6] == 0o160000 &&
                path.len > entry.path.len + 1 &&
                under(path, entry.path) {
                return Fatal("Pathspec '{text(path)?}' is in submodule '{text(entry.path)?}'")
            }
        }
    }
    if options.chmod < -1 || options.chmod > 1 { return invalid }
    if paths.len == 0 && !options.all && !options.update { return List[List[byte]]() }
    ensure_filters(ctx)?
    let current = copy value
    var sparse = List[List[byte]]()
    if paths.len > 0 {
        for entry in current.entries {
            if entry.extended & 0x4000 != 0 && selected(entry.path, paths) {
                (mut sparse).push(copy entry.path)
            }
        }
    }
    if sparse.len > 0 {
        var message = "The following paths and/or pathspecs matched paths that exist\noutside of your sparse-checkout definition, so will not be\nupdated in the index:\n"
        for path in sparse { message += "{text(path)?}\n" }
        if config_bool(ctx, "advice.updatesparsepath", true)? {
            message += "hint: If you intend to update such entries, try one of the following:\nhint: * Use the --sparse option.\nhint: * Disable or modify the sparsity rules.\nhint: Disable this message with \"git config set advice.updateSparsePath false\""
        } else {
            message = message[0..message.len - 1]
        }
        return Failure(message)
    }
    // den#91: the walk's scratch (lstat records, parent checks, hash states,
    // its sorted copy) lives in its own region; only what it found is kept.
    var walked = no_walk()
    // A diagnostic built in a scratch region below is copied out of it (raised:
    // 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
    // is freed.
    var error_payload = "", raised = 0
    region walking {
        var found_warnings = List[str]()
        errdefer keep_warnings(mut warnings, found_warnings)
        let found = walk(
            ctx,
            current,
            !options.update,
            paths,
            !options.force,
            mut found_warnings,
        ) else |e| match e {
            invalid_index => { return invalid_index },
            unmerged => { return unmerged },
            invalid_tree => { return invalid_tree },
            duplicate_name => { return duplicate_name },
            invalid => { return invalid },
            invalid_oid => { return invalid_oid },
            unsupported_format => { return unsupported_format },
            bad_header => { return bad_header },
            bad_size => { return bad_size },
            bad_oid => { return bad_oid },
            truncated => { return truncated },
            dictionary => { return dictionary },
            checksum => { return checksum },
            limit => { return limit },
            trailing => { return trailing },
            unsupported_level => { return unsupported_level },
            not_found => { return not_found },
            denied => { return denied },
            io => { return io },
            exists => { return exists },
            unsupported => { return unsupported },
            Unsupported(message) => {
                error_payload = copy message
                raised = 1
                no_walk()
            },
            ambiguous => { return ambiguous },
            cross_device => { return cross_device },
            invalid_header => { return invalid_header },
            utf8 => { return utf8 },
            Pathspec(message) => {
                error_payload = copy message
                raised = 2
                no_walk()
            },
            Fatal(message) => {
                error_payload = copy message
                raised = 3
                no_walk()
            },
            Failure(message) => {
                error_payload = copy message
                raised = 4
                no_walk()
            },
        }
        keep_warnings(mut warnings, found_warnings)
        for file in found.files { (mut walked.files).push(copy file) }
        for directory in found.directories { (mut walked.directories).push(copy directory) }
    }
    if raised == 1 { return Unsupported(error_payload) }
    if raised == 2 { return Pathspec(error_payload) }
    if raised == 3 { return Fatal(error_payload) }
    if raised == 4 { return Failure(error_payload) }
    supported_attributes(ctx, walked.files)?
    var candidates = List[List[byte]]()
    for entry in current.entries {
        if !selected(entry.path, paths) { continue }
        if entry.extended & 0x4000 != 0 || entry.flags & 0x8000 != 0 { continue }
        var already = false
        for path in candidates { if compare(path, entry.path) == 0 { already = true } }
        if !already { (mut candidates).push(copy entry.path) }
    }
    var ignored = List[List[byte]]()
    if !options.force && !options.update {
        for path in paths {
            if path.len == 0 { continue }
            var tracked = false
            for entry in current.entries { if under(entry.path, path) { tracked = true; break } }
            if tracked { continue }
            let info = fs_lstat(absolute(ctx, path)?) else |e| match e {
                not_found => { continue },
                denied => { return denied },
                io => { return io },
            }
            if info[0] == 1 &&
                ignore.query_with_warnings(
                    ctx.repo,
                    ctx.root,
                    text(path)?,
                    true,
                    mut warnings,
                )?.ignored {
                (mut ignored).push(owned_bytes(path))
            }
        }
    }
    if !options.update {
        for file in walked.files {
            // A child-only selection of an opaque repository is normally a
            // no-op, but an excluded parent still names Git's ignored-path
            // error. Query the directory, never the embedded ignore files.
            if file.kind == 1 &&
                !selected(file.path, paths) &&
                selector_inside(paths, file.path) &&
                !options.force &&
                ignore.query_with_warnings(
                    ctx.repo,
                    ctx.root,
                    text(file.path)?,
                    true,
                    mut warnings,
                )?.ignored {
                (mut ignored).push(copy file.path)
            }
            if !selected(file.path, paths) || index_at(current.entries, file.path) >= 0 { continue }
            let result = ignore.query_with_warnings(
                ctx.repo,
                ctx.root,
                text(file.path)?,
                file.kind == 1,
                mut warnings,
            )?
            if result.ignored && !options.force {
                for path in paths {
                    if compare(path, file.path) == 0 { (mut ignored).push(copy file.path) }
                }
                continue
            }
            (mut candidates).push(copy file.path)
        }
    }
    if ignored.len > 0 {
        var message = "The following paths are ignored by one of your .gitignore files:\n"
        for path in ignored { message += "{text(path)?}\n" }
        if config_bool(ctx, "advice.addignoredfile", true)? {
            message += "hint: Use -f if you really want to add them.\nhint: Disable this message with \"git config set advice.addIgnoredFile false\""
        } else {
            message = message[0..message.len - 1]
        }
        return Failure(message)
    }
    for path in paths {
        var matched = false
        for candidate in candidates { if under(candidate, path) { matched = true; break } }
        for entry in current.entries { if under(entry.path, path) { matched = true; break } }
        if !matched && (options.update || !path_present(ctx, path)?) {
            return Pathspec(text(path)?)
        }
    }
    // Resolve every newly selected embedded repository before writing any
    // outer object or index entry. A child pathspec alone selects no entry,
    // just as Git's untracked-embedded-repository add does. Existing gitlinks
    // keep their own scan/staging path above.
    for i in 0..walked.files.len {
        let file = copy walked.files[i]
        if file.kind != 1 || file.mode != 0 { continue }
        var adding = false
        for path in candidates { if compare(path, file.path) == 0 { adding = true; break } }
        if !adding { continue }
        let full = fs.realpath(absolute(ctx, file.path)?)?
        let sub = discover(full)?
        if sub.root != full { return Unsupported("embedded repository {text(file.path)?}") }
        let current_head = head(sub)?
        if current_head.commits.len != 1 {
            (mut warnings).push("error: '{text(file.path)?}/' does not have a commit checked out")
            (mut warnings).push("error: unable to index file '{text(file.path)?}/'")
            return Fatal("adding files failed")
        }
        walked.files[i].mode = 0o160000
        walked.files[i].id = copy current_head.commits[0]
        (mut warnings).push("warning: adding embedded git repository: {text(file.path)?}")
    }
    var changed = List[List[byte]]()
    // den#91: each path's object is written in its own region, so its deflate
    // tables, framing and copies die with it, and the index is changed once,
    // after the loop (index.stage_all), never copied whole per path.
    var staged = List[index.Entry]()
    var removed = List[List[byte]]()
    let written = index_time(ctx)
    for path in candidates {
        let at = index_at(current.entries, path)
        let disk = file_at(walked.files, path)
        if disk < 0 {
            if options.ignore_removal || options.intent { continue }
            if !options.dry_run { (mut removed).push(copy path) }
            (mut changed).push(copy path)
            continue
        }
        if options.intent && at >= 0 { continue }
        var staging = true
        region one {
            let file = copy walked.files[disk]
            // Git leaves a stat-clean entry alone: not staged again, so its
            // cache-tree ancestors stay valid. A stat-dirty one is staged again
            // even with the same contents, and invalidates them (den#91 rows).
            if at >= 0 && options.chmod < 0 && unchanged(current.entries[at], file, written) {
                staging = false
            } else {
                var prior = List[index.Entry]()
                if at >= 0 && index.stage(current.entries[at]) == 0 {
                    (mut prior).push(copy current.entries[at])
                }
                if file.mode == 0o160000 {
                    // A gitlink stages its submodule's HEAD and writes no object; an
                    // unchanged one keeps its entry, stat and all (vc25 work rows).
                    if prior.len == 1 &&
                        prior[0].stat[6] == 0o160000 &&
                        oid.equal(prior[0].id, file.id) {
                        staging = false
                    } else {
                        let entry = entry_for(file, prior, options)?
                        if !options.dry_run { (mut staged).push(copy entry) }
                    }
                } else {
                    let entry = entry_for(file, prior, options)?
                    if !options.dry_run {
                        let _ = object.write_object(
                            ctx.repo,
                            "blob",
                            if options.intent then List[byte]() else file.data,
                        ) else |e| match e {
                            invalid => { return invalid },
                            invalid_oid => { return invalid_oid },
                            unsupported_format => { return unsupported_format },
                            bad_header => { return bad_header },
                            bad_size => { return bad_size },
                            bad_oid => { return bad_oid },
                            truncated => { return truncated },
                            dictionary => { return dictionary },
                            checksum => { return checksum },
                            limit => { return limit },
                            trailing => { return trailing },
                            unsupported_level => { return unsupported_level },
                            not_found => { return not_found },
                            denied => { return denied },
                            io => { return io },
                            exists => { return exists },
                            unsupported => { return unsupported },
                            Unsupported(message) => {
                                error_payload = copy message
                                raised = 1
                                break
                            },
                            ambiguous => { return ambiguous },
                            cross_device => { return cross_device },
                        }
                        (mut staged).push(copy entry)
                    }
                }
            }
        }
        if staging { (mut changed).push(copy path) }
    }
    if raised == 1 { return Unsupported(error_payload) }
    if staged.len > 0 || removed.len > 0 { value = index.stage_all(value, staged, removed)? }
    changed
}
