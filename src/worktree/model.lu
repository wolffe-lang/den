// Clean-room worktree boundary from Git 2.56.0 porcelain documentation.
use std.fs
use index
use object
use oid
use refs
use repository

/// Format/object/IO rows plus named pathspec and command-edge refusals.
pub error WorkErrors = {
    invalid_index,
    unmerged,
    invalid_tree,
    duplicate_name,
    invalid,
    invalid_oid,
    unsupported_format,
    bad_header,
    bad_size,
    bad_oid,
    truncated,
    dictionary,
    checksum,
    limit,
    trailing,
    unsupported_level,
    not_found,
    denied,
    io,
    exists,
    unsupported,
    Unsupported(str),
    ambiguous,
    cross_device,
    invalid_header,
    utf8,
    Pathspec(str),
    Fatal(str),
    Failure(str),
}

/// Canonical absolute repository root/cwd and root-relative cwd prefix.
pub struct Context { repo: repository.Repo, root: str, cwd: str, prefix: str }

/// A flattened tree leaf owns its raw full pathname and identifier.
pub struct FlatEntry { path: List[byte], mode: int, id: oid.Oid }

/// Last checkout reflog record plus a display label resolved when HEAD is read.
/// target is the original checkout operand; id is that record's new commit.
pub struct CheckoutOrigin { target: str, id: oid.Oid, label: str }

/// commits is empty on an unborn branch and contains exactly one id otherwise.
/// reference is empty when detached; branch is the short refs/heads name.
/// checkout is empty without a checkout record, otherwise its most recent one.
pub struct Head {
    reference: str,
    branch: str,
    detached: bool,
    commits: List[oid.Oid],
    checkout: List[CheckoutOrigin],
}

/// An actual regular file or symbolic link; stat is the full 20-word record.
/// data is file content or link target bytes, never a followed link's content.
pub struct FileState {
    path: List[byte],
    mode: int,
    id: oid.Oid,
    data: List[byte],
    stat: List[int],
    kind: int,
    /// A gitlink's submodule worktree (vc25): 1 modified content, 2 untracked.
    dirt: int,
}

/// Reusable status codes; original_path is populated only for a rename/copy.
pub struct StatusRow {
    path: List[byte],
    original_path: List[byte],
    x: str,
    y: str,
    ignored: bool,
    untracked: bool,
    /// An unstaged gitlink change (vc25): 1 new commits, 2 modified content,
    /// 4 untracked content, as git-status(1) reports a submodule.
    sub: int,
}

/// Owned snapshot; scan never acquires a write lock or refreshes the index.
pub struct Snapshot {
    context: Context,
    head: Head,
    index: index.Index,
    head_entries: List[FlatEntry],
    files: List[FileState],
    directories: List[List[byte]],
    rows: List[StatusRow],
    /// The walk's and the rows' index lookups (none outside a status scan).
    walk_lookups: Lookups,
    row_lookups: Lookups,
    /// The rows' merge of HEAD's entries with the index's: its steps, and its
    /// path compares and change checks.
    merge_counts: Lookups,
}

/// Path work a status scan does, counted: calls (index lookups by path, or
/// steps of the rows' merge) and the compares they took. probes/status-phases
/// prints the counts and a worktree row bounds each per call. Counting is one
/// add a compare; nothing reads it in a command.
pub struct Lookups { calls: int, compares: int }

/// No lookups: the count of a scan that does not count them.
pub fn no_lookups() -> Lookups { Lookups { calls: 0, compares: 0 } }

fn owned_bytes(bytes: List[byte]) -> List[byte] {
    var out = List[byte]()
    (mut out).reserve(bytes.len)
    for b in bytes { (mut out).push(b) }
    out
}

fn valid_relative(path: List[byte]) -> bool {
    if path.len == 0 { return false }
    var start = 0
    for i in 0..=path.len {
        if i < path.len && path[i] == 0 as byte { return false }
        if i == path.len || path[i] == 47 as byte {
            let component = path[start..i]
            if component.len == 0 ||
                compare(component, ".".bytes()) == 0 ||
                compare(component, "..".bytes()) == 0 ||
                compare(component, ".git".bytes()) == 0 {
                return false
            }
            start = i + 1
        }
    }
    true
}

fn validate_specs(paths: List[List[byte]]) -> () ! WorkErrors {
    for path in paths { if path.len != 0 && !valid_relative(path) { return invalid } }
}

fn bytes_add(mut out: List[byte], bytes: List[byte]) { for b in bytes { (mut out).push(b) } }

fn compare(a: List[byte], b: List[byte]) -> int {
    var i = 0
    while i < a.len && i < b.len {
        if a[i] != b[i] { return a[i] as int - b[i] as int }
        i += 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    0
}

fn text(path: List[byte]) -> str ! WorkErrors {
    str_from_utf8(path) else |_| {
        return Unsupported("non-UTF-8 filesystem path (wolf-lang#687/#912)")
    }
}

fn under(path: List[byte], directory: List[byte]) -> bool {
    if directory.len == 0 { return true }
    if path.len < directory.len { return false }
    for i in 0..directory.len { if path[i] != directory[i] { return false } }
    path.len == directory.len || path[directory.len] == 47 as byte
}

/// Parse Git boolean spellings; invalid values are explicit, not silently false.
pub fn config_bool(ctx: Context, key: str, fallback: bool) -> bool ! WorkErrors {
    let value = ctx.repo.config[key] else |_| { return fallback }
    let lower = value.lower()
    if lower == "true" || lower == "yes" || lower == "on" || lower == "1" {
        return true
    }
    if lower == "false" || lower == "no" || lower == "off" || lower == "0" || lower == "" {
        return false
    }
    return Unsupported("boolean configuration {key}={value}")
}

/// ctx with its repository's packs opened once for the command (den#101,
/// object.opened): every object read through it shares one parse of each
/// pack index. For commands that read objects and write no pack.
pub fn opened(ctx: Context) -> Context {
    var out = copy ctx
    out.repo = object.opened(ctx.repo)
    out
}

/// Resolve root without assuming gitdir's parent is the worktree (gitfiles and
/// explicit GIT_DIR/GIT_WORK_TREE are distinct). Bare repositories are refused.
pub fn discover(start: str) -> Context ! WorkErrors {
    if (env_get("GIT_INDEX_FILE") else "") != "" { return Unsupported("GIT_INDEX_FILE") }
    let cwd = fs.realpath(start)?
    let repo = repository.discover(cwd)?
    let explicit = env_get("GIT_WORK_TREE") else ""
    var root = ""
    if explicit != "" {
        root = fs.realpath(explicit)?
    } else {
        let configured = repo.config["core.worktree"] else ""
        if configured != "" {
            root = fs.realpath(
                if configured.starts_with("/") then configured else "{repo.gitdir}/{configured}",
            )?
        } else if (repo.config["core.bare"] else "false").lower() == "true" {
            return Fatal("this operation must be run in a work tree")
        } else {
            var directory = cwd
            loop {
                if fs.is_dir("{directory}/.git") || fs.is_file("{directory}/.git") {
                    root = directory
                    break
                }
                let parent = fs.parent(directory) else |_| { break }
                if parent == directory { break }
                directory = parent
            }
            if root == "" && (env_get("GIT_DIR") else "") != "" { root = cwd }
            if root == "" { return Fatal("this operation must be run in a work tree") }
        }
    }
    if cwd != root && !cwd.starts_with(if root == "/" then "/" else "{root}/") {
        return Fatal("current directory is outside the work tree")
    }
    let prefix = if cwd == root then "" else if root == "/" then cwd[1..] else cwd[root.len + 1..]
    Context { repo: repo, root: root, cwd: cwd, prefix: prefix }
}

/// Normalize a literal user pathname relative to cwd, including missing paths.
/// Empty output names the root. No symlink is followed during normalization.
pub fn normalize(ctx: Context, path: str) -> List[byte] ! WorkErrors {
    normalize_inner(ctx, path, true)?
}

fn normalize_literal(ctx: Context, path: str) -> List[byte] ! WorkErrors {
    normalize_inner(ctx, path, false)?
}

fn normalize_inner(ctx: Context, path: str, pathspec: bool) -> List[byte] ! WorkErrors {
    if path == "" || path.contains("\0") { return invalid }
    var raw = path
    if pathspec && path == ":/" { return List[byte]() }
    if pathspec && path.starts_with(":") { return Unsupported("pathspec magic {path}") }
    if path.starts_with("/") {
        if path == ctx.root { return List[byte]() }
        let prefix = if ctx.root == "/" then "/" else "{ctx.root}/"
        if !path.starts_with(prefix) {
            return Fatal("'{path}' is outside repository at '{ctx.root}'")
        }
        raw = path[prefix.len..]
    } else if ctx.prefix != "" {
        raw = "{ctx.prefix}/{path}"
    }
    var parts = List[str]()
    for part in raw.split("/") {
        if part == "" || part == "." { continue }
        if part == ".." {
            let _ = (mut parts).pop() else |_| {
                return Fatal("'{path}' is outside repository at '{ctx.root}'")
            }
        } else {
            if part == ".git" { return Fatal("pathspec '{path}' is inside the git directory") }
            if pathspec && (part.contains("*") || part.contains("?") || part.contains("[")) {
                return Unsupported("wildcard pathspec {path}")
            }
            (mut parts).push(part)
        }
    }
    var out = List[byte]()
    for i in 0..parts.len {
        if i > 0 { (mut out).push(47 as byte) }
        bytes_add(mut out, parts[i].bytes())
    }
    out
}

fn absolute(ctx: Context, path: List[byte]) -> str ! WorkErrors {
    if path.len == 0 { return ctx.root }
    "{ctx.root}/{text(path)?}"
}

// Inspect each ancestor with lstat, never authorize traversal through a link.
fn safe_parents(ctx: Context, path: List[byte], create: bool) -> () ! WorkErrors {
    if !valid_relative(path) { return invalid }
    for i in 0..path.len {
        if path[i] != 47 as byte { continue }
        let parent = absolute(ctx, path[0..i])?
        let info = fs_lstat(parent) else |e| match e {
            not_found => {
                if create { fs.create_dir(parent)?; continue }
                return not_found
            },
            denied => { return denied },
            io => { return io },
        }
        if info[0] == 3 { return Fatal("'{text(path)?}' is beyond a symbolic link") }
        if info[0] != 1 { return not_found }
    }
}

/// Get the configured index version for a new write; zero preserves an existing
/// version. Invalid values are named rather than silently falling back.
pub fn index_version(ctx: Context) -> int ! WorkErrors {
    let configured = ctx.repo.config["index.version"] else |_| { return 0 }
    let version = configured.to_int() else |_| { return Unsupported("index.version={configured}") }
    if version < 2 || version > 4 { return Unsupported("index.version={configured}") }
    version
}

/// Read the existing index, or an owned empty v2 index for an unborn worktree.
pub fn read_index(ctx: Context) -> index.Index ! WorkErrors {
    let bytes = repository.read_bytes("{ctx.repo.gitdir}/index", 1000000000) else |e| match e {
        not_found => { return index.empty(2)? },
        denied => { return denied },
        io => { return io },
        invalid => { return invalid },
        exists => { return exists },
        unsupported => { return unsupported },
        limit => { return limit },
        Unsupported(name) => { return Unsupported(name) },
    }
    index.parse(bytes)?
}

/// Read symbolic/unborn/detached HEAD with loose-over-packed resolution.
/// A genuinely missing symbolic target is unborn; malformed targets fail.
pub fn head(ctx: Context) -> Head ! WorkErrors {
    let raw = repository.read_bytes("{ctx.repo.gitdir}/HEAD", 4096)?
    let line = (str_from_utf8(raw) else |_| { return invalid_oid }).trim()
    var reference = ""
    var branch = ""
    var commits = List[oid.Oid]()
    if line.starts_with("ref: ") {
        reference = line[5..]
        if !reference.starts_with("refs/") || reference.contains("..") { return invalid_oid }
        branch = if reference.starts_with("refs/heads/") then reference[11..] else reference
        if refs.optional(ctx.repo, reference)?.len == 0 {
            return Head {
                reference: reference,
                branch: branch,
                detached: false,
                commits: commits,
                checkout: List[CheckoutOrigin](),
            }
        }
    }
    (mut commits).push(object.resolve(ctx.repo, "HEAD")?)
    let checkout = if reference == "" then read_checkout(ctx.repo)? else List[CheckoutOrigin]()
    Head {
        reference: reference,
        branch: branch,
        detached: reference == "",
        commits: commits,
        checkout: checkout,
    }
}

fn tree_id(repo: repository.Repo, id: oid.Oid) -> oid.Oid ! WorkErrors {
    // One reader for the chain (commit or tag, then the tree): one idx parse,
    // reclaimed with the walk's region (den#63).
    var found = List[oid.Oid]()
    region walk {
        var current = copy id
        var reader = object.reader(repo)
        for _ in 0..64 {
            let stored = object.read_with(mut reader, current, 1000000000)?
            if stored.kind == "tree" {
                (mut found).push(copy current)
                break
            }
            if stored.kind != "commit" && stored.kind != "tag" { return invalid_tree }
            let headers = if stored.kind == "commit" {
                object.parse_commit(stored.data, "sha1")?
            } else {
                object.parse_tag(stored.data, "sha1")?
            }
            let key = if stored.kind == "commit" then "tree" else "object"
            var linked = false
            for field in headers.fields {
                if field.key == key {
                    current = oid.parse("sha1", text(field.value)?)?
                    linked = true
                    break
                }
            }
            if !linked { return invalid_header }
        }
    }
    if found.len == 0 { return Fatal("limit: more than 64 tags and commits before a tree") }
    copy found[0]
}

struct PendingTree { path: List[byte], id: oid.Oid, ancestors: List[oid.Oid] }

/// Flatten a tree/commit/tag into unsigned full-path order, retaining raw names.
/// Detect cycles and reject .git entries before any consumer can reach disk.
/// One pack session serves every tree of the walk; one stable sort orders it.
pub fn flatten_tree(repo: repository.Repo, id: oid.Oid) -> List[FlatEntry] ! WorkErrors {
    let root = tree_id(repo, id)?
    var result = List[FlatEntry](), too_deep = false
    // The walk's reader, trees and scratch live in a region, so its idx parse
    // is reclaimed when the walk ends (den#63); only the result is kept.
    region walk {
        var pending = [
            PendingTree { path: List[byte](), id: copy root, ancestors: List[oid.Oid]() },
        ]
        var reader = object.reader(repo)
        var entries = List[FlatEntry]()
        while pending.len > 0 {
            let next = (mut pending).pop() else |_| { return invalid_tree }
            for ancestor in next.ancestors {
                if oid.equal(ancestor, next.id) { return invalid_tree }
            }
            var ancestors = copy next.ancestors
            (mut ancestors).push(copy next.id)
            if ancestors.len > 1024 {
                too_deep = true
                break
            }
            let stored = object.read_with(mut reader, next.id, 1000000000)?
            if stored.kind != "tree" { return invalid_tree }
            let children = object.parse_tree(stored.data, "sha1")?
            for child in children {
                if compare(child.name, ".git".bytes()) == 0 { return invalid_tree }
                var path = copy next.path
                if path.len > 0 { (mut path).push(47 as byte) }
                bytes_add(mut path, child.name)
                if child.mode == 0o40000 {
                    (mut pending).push(PendingTree {
                        path: path,
                        id: copy child.id,
                        ancestors: copy ancestors,
                    })
                } else {
                    (mut entries).push(FlatEntry {
                        path: path,
                        mode: child.mode,
                        id: copy child.id,
                    })
                }
            }
        }
        var paths = List[List[byte]]()
        for entry in entries { (mut paths).push(copy entry.path) }
        (mut result).reserve(entries.len)
        for i in path_order(paths) { (mut result).push(copy entries[i]) }
    }
    if too_deep { return Fatal("limit: a tree nested more than 1024 deep") }
    result
}

/// Stable bottom-up merge sort of positions by unsigned path order: the
/// order the former per-insert insertion sorts produced, in O(n log n).
fn path_order(paths: List[List[byte]]) -> List[int] {
    var order = List[int]()
    for i in 0..paths.len { (mut order).push(i) }
    var scratch = copy order
    var width = 1
    while width < order.len {
        var lo = 0
        while lo < order.len {
            let mid = if lo + width < order.len then lo + width else order.len
            let hi = if lo + 2 * width < order.len then lo + 2 * width else order.len
            var i = lo, j = mid, k = lo
            while i < mid && j < hi {
                if compare(paths[order[j]], paths[order[i]]) < 0 {
                    scratch[k] = order[j]
                    j += 1
                } else {
                    scratch[k] = order[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                scratch[k] = order[i]
                i += 1
                k += 1
            }
            while j < hi {
                scratch[k] = order[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        order = copy scratch
        width *= 2
    }
    order
}

// Lookups over path-sorted lists (the index is validated in path/stage order;
// flattened trees and walked files are sorted by path_order): the first
// position whose path equals path, as the former linear scans answered.
fn index_lower(entries: List[index.Entry], path: List[byte]) -> int {
    var lo = 0, hi = entries.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if compare(entries[mid].path, path) < 0 { lo = mid + 1 } else { hi = mid }
    }
    lo
}

fn index_at(entries: List[index.Entry], path: List[byte]) -> int {
    let at = index_lower(entries, path)
    if at < entries.len && compare(entries[at].path, path) == 0 { return at }
    -1
}

/// compare's answer for two paths that share their first skip bytes, read
/// from byte skip on.
fn compare_from(a: List[byte], b: List[byte], skip: int) -> int {
    var i = skip
    while i < a.len && i < b.len {
        if a[i] != b[i] { return a[i] as int - b[i] as int }
        i += 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    0
}

/// compare's answer, one compare counted.
fn compare_counted(a: List[byte], b: List[byte], mut counts: Lookups) -> int {
    counts.compares += 1
    compare(a, b)
}

/// Whether a orders below b, one compare counted.
fn below(a: List[byte], b: List[byte], mut counts: Lookups) -> bool {
    counts.compares += 1
    compare(a, b) < 0
}

/// The first position in [lo, hi) whose path is not below path, or hi: the
/// bracket holds that position, and its entries share path's first skip
/// bytes, so each compare reads from there on. Its compares are counted.
fn lower_within(
    entries: List[index.Entry],
    path: List[byte],
    lo: int,
    hi: int,
    skip: int,
    mut counts: Lookups,
) -> int {
    var l = lo, r = hi
    let from = skip
    while l < r {
        let mid = (l + r) / 2
        counts.compares += 1
        if compare_from(entries[mid].path, path, from) < 0 { l = mid + 1 } else { r = mid }
    }
    l
}

/// index_at's answer for a path the walk visits, searched only among its
/// directory's entries, [lo, hi), which share its first skip bytes (the
/// directory and its slash): about five compares among 32 entries where the
/// whole index took about ten, each over the name alone.
fn index_within(
    entries: List[index.Entry],
    path: List[byte],
    lo: int,
    hi: int,
    skip: int,
    mut counts: Lookups,
) -> int {
    counts.calls += 1
    let at = lower_within(entries, path, lo, hi, skip, mut counts)
    if at < hi {
        counts.compares += 1
        if compare_from(entries[at].path, path, skip) == 0 { return at }
    }
    -1
}

/// The entries beneath directory, as [first, end): found within [lo, hi),
/// its parent's own entries, which share directory's first skip bytes.
fn range_beneath(
    entries: List[index.Entry],
    directory: List[byte],
    lo: int,
    hi: int,
    skip: int,
    mut counts: Lookups,
) -> List[int] {
    // directory/ starts the range; directory0 ('/' + 1) is past its end.
    var key = copy directory
    (mut key).push(47 as byte)
    let first = lower_within(entries, key, lo, hi, skip, mut counts)
    key[key.len - 1] = 48 as byte
    [first, lower_within(entries, key, first, hi, skip, mut counts)]
}

/// index_at's answer for the rows, which ask in path order: the search
/// gallops from hint, the position the last lookup found, to a bracket around
/// path and searches only that; hint becomes this lookup's position. A path
/// next to the last costs about three compares; any order is still answered.
fn index_after(
    entries: List[index.Entry],
    path: List[byte],
    mut hint: int,
    mut counts: Lookups,
) -> int {
    counts.calls += 1
    let n = entries.len
    var h = hint
    if h < 0 { h = 0 }
    if h > n { h = n }
    var lo = 0, hi = n
    if h < n && below(entries[h].path, path, mut counts) {
        lo = h + 1
        var step = 1
        while h + step < n && below(entries[h + step].path, path, mut counts) {
            lo = h + step + 1
            step *= 2
        }
        hi = if h + step < n then h + step else n
    } else {
        hi = h
        var step = 1
        while h - step >= 0 && !below(entries[h - step].path, path, mut counts) {
            hi = h - step
            step *= 2
        }
        lo = if h - step >= 0 then h - step + 1 else 0
    }
    let at = lower_within(entries, path, lo, hi, 0, mut counts)
    hint = at
    if at < n {
        counts.compares += 1
        if compare(entries[at].path, path) == 0 { return at }
    }
    -1
}

/// Seam for the worktree unit test only: index_after's answer for path from
/// hint, so the test can hold it to a plain scan from every hint.
pub fn index_after_seam(entries: List[index.Entry], path: List[byte], hint: int) -> int {
    var h = hint
    var counts = no_lookups()
    index_after(entries, path, mut h, mut counts)
}

/// Seam for the worktree unit test only: index_within's answer for path in
/// the range of its parent directory, found as the walk finds it.
pub fn index_within_seam(entries: List[index.Entry], path: List[byte]) -> int {
    var counts = no_lookups()
    var lo = 0, hi = entries.len, skip = 0, i = 0
    // Each directory on path's way narrows the range, as the walk's stack does.
    while i < path.len {
        if path[i] == 47 as byte {
            let range = range_beneath(entries, path[0..i], lo, hi, skip, mut counts)
            lo = range[0]
            hi = range[1]
            skip = i + 1
        }
        i += 1
    }
    index_within(entries, path, lo, hi, skip, mut counts)
}

/// Whether any index entry is path itself or lies beneath it.
fn tracked_under(entries: List[index.Entry], path: List[byte]) -> bool {
    if path.len == 0 { return entries.len > 0 }
    if index_at(entries, path) >= 0 { return true }
    var prefix = copy path
    (mut prefix).push(47 as byte)
    let at = index_lower(entries, prefix)
    at < entries.len && under(entries[at].path, path)
}

fn flat_at(entries: List[FlatEntry], path: List[byte]) -> int {
    var lo = 0, hi = entries.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if compare(entries[mid].path, path) < 0 { lo = mid + 1 } else { hi = mid }
    }
    if lo < entries.len && compare(entries[lo].path, path) == 0 { return lo }
    -1
}

fn file_at(entries: List[FileState], path: List[byte]) -> int {
    var lo = 0, hi = entries.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if compare(entries[mid].path, path) < 0 { lo = mid + 1 } else { hi = mid }
    }
    if lo < entries.len && compare(entries[lo].path, path) == 0 { return lo }
    -1
}
