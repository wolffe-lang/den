use std.fs
use std.os
use ignore
use index
use object
use oid

fn same_flat(a: List[FlatEntry], ai: int, b: List[FlatEntry], bi: int) -> bool {
    if ai < 0 || bi < 0 { return ai < 0 && bi < 0 }
    a[ai].mode == b[bi].mode && oid.equal(a[ai].id, b[bi].id)
}

/// Apply a whole-tree switch or reset under the caller's index transaction.
/// switch preserves compatible local modifications; hard discards tracked
/// changes; mixed changes only the index. All source blobs are verified first.
/// This API never publishes refs, objects or the index transaction itself.
pub fn transition(
    ctx: Context,
    mut value: index.Index,
    target: List[FlatEntry],
    mode: str,
) -> () ! WorkErrors {
    transition_mode(ctx, mut value, target, mode, false, Map[str, List[byte]](), false)?
}

/// transition for a caller that may hold value validated: as index.parse
/// returned it, or as a scan validated it, unchanged since (scan_index_held).
pub fn transition_held(
    ctx: Context,
    mut value: index.Index,
    target: List[FlatEntry],
    mode: str,
    validated: bool,
) -> () ! WorkErrors {
    transition_mode(ctx, mut value, target, mode, false, Map[str, List[byte]](), validated)?
}

/// Validate merge worktree/index safety without publishing blobs or entries.
pub fn merge_check(ctx: Context, value: index.Index, target: List[FlatEntry]) -> () ! WorkErrors {
    merge_check_supplied(ctx, value, target, Map[str, List[byte]]())?
}

/// merge_check, answering the scan its checks read: a fast-forward passes it
/// to transition_scanned, which makes the same checks again from it before
/// any write, so the work tree is scanned once (each of two scans hashed
/// every stat-dirty tracked file).
pub fn merge_check_scan(
    ctx: Context,
    value: index.Index,
    target: List[FlatEntry],
    validated: bool,
) -> List[Snapshot] ! WorkErrors {
    let scanned = [scan_index_held(ctx, value, validated)?]
    var scratch = copy value
    transition_staged(
        ctx,
        mut scratch,
        target,
        "merge",
        true,
        Map[str, List[byte]](),
        false,
        scanned,
    )?
    scanned
}

/// transition from a merge_check_scan of the same index value, with nothing
/// written between them: no second scan. scanned is the list merge_check_scan
/// answered, holding its one Snapshot.
pub fn transition_scanned(
    ctx: Context,
    mut value: index.Index,
    target: List[FlatEntry],
    mode: str,
    scanned: List[Snapshot],
) -> () ! WorkErrors {
    if mode != "switch" && mode != "merge" && mode != "hard" && mode != "mixed" { return invalid }
    if scanned.len != 1 { return invalid }
    transition_staged(ctx, mut value, target, mode, false, Map[str, List[byte]](), false, scanned)?
}

/// Validate merge safety before publishing newly synthesized blob bodies. Map
/// keys are full blob OIDs; supplied bytes are identity-checked and never stored.
pub fn merge_check_supplied(
    ctx: Context,
    value: index.Index,
    target: List[FlatEntry],
    supplied: Map[str, List[byte]],
) -> () ! WorkErrors {
    var scratch = copy value
    transition_mode(ctx, mut scratch, target, "merge", true, supplied, false)?
}

// Install one target path (unless mixed) and return its index entry, stat
// data refreshed from the written file when it matches the target.
fn transition_path(
    ctx: Context,
    reader: object.Reader,
    snapshot: Snapshot,
    previous: index.Index,
    at: int,
    target: FlatEntry,
    path: List[byte],
    mode: str,
    filemode: bool,
    symlinks: bool,
) -> index.Entry ! WorkErrors {
    let desired = copy target
    var prior = List[index.Entry]()
    if at >= 0 { (mut prior).push(copy previous.entries[at]) }
    var entry = cached_entry(desired, prior)
    // A gitlink (vc25): its directory is made when missing, never entered;
    // the entry takes the directory's lstat, as the pinned Git's clone does.
    if desired.mode == 0o160000 {
        if mode == "mixed" { return entry }
        safe_parents(ctx, path, true)?
        let full = absolute(ctx, path)?
        let existed = fs.exists(full)
        if !existed { fs.create_dir(full)? }
        let record = fs_lstat(full)?
        if record[0] != 1 { return Unsupported("submodule path {text(path)?} is not a directory") }
        if prior.len == 1 && same_entry(prior[0], desired) && prior[0].stat[0] != 0 { return entry }
        // A gitlink moved over its existing directory, by a reset or a
        // checkout, keeps no stat, as Git's does (vc25 work rows); only a
        // directory made here takes its lstat.
        if existed { return entry }
        // So does one whose submodule a recursing command fills right after
        // (vc25 recurse rows): only a clone's checkout keeps the lstat.
        if (env_get("DEN_SUBMODULE_RECURSING") else "") == "1" { return entry }
        return index.entry_from_directory(record, path, desired.id, 0, 0)?
    }
    if mode != "mixed" {
        // Only a tracked path's scanned id is real: an untracked one is a
        // placeholder the scan never read, so its path is always written.
        let disk = file_at(snapshot.files, path)
        if disk < 0 ||
            at < 0 ||
            snapshot.files[disk].mode != desired.mode ||
            !oid.equal(snapshot.files[disk].id, desired.id) {
            install(ctx, reader, desired)?
        }
    }
    // The written file is hashed as it streams, never held.
    let file = hash_file(ctx, path, [copy entry], filemode, symlinks, false) else |e| match e {
        not_found => { return entry },
        Fatal(message) => { return Fatal(message) },
        _ => { return Unsupported("tree transition unreadable path {text(path)?}: {e}") },
    }
    if file.mode == desired.mode && oid.equal(file.id, desired.id) {
        entry = entry_for(file, [copy entry], add_options())?
        entry.stat[6] = desired.mode
    }
    entry
}

fn transition_mode(
    ctx: Context,
    mut value: index.Index,
    target: List[FlatEntry],
    mode: str,
    dry: bool,
    supplied: Map[str, List[byte]],
    validated: bool,
) -> () ! WorkErrors {
    if mode != "switch" && mode != "merge" && mode != "hard" && mode != "mixed" { return invalid }
    transition_staged(ctx, mut value, target, mode, dry, supplied, validated, List[Snapshot]())?
}

// What a transition's scratch region hands on. kind 0: nothing (a dry run
// checks only); 1: mixed, next whole, its previous cache tree invalidated
// where the entries changed; 2: switch, merge or hard, next's entries in path
// order, its cache tree built after the region, and stale the kept staged
// paths whose trees that build leaves invalid.
struct Prepared {
    kind: int,
    next: index.Index,
    stale: List[List[byte]],
}

// A transition up to its cache tree runs in one region: the scan (unless
// scanned holds one already), the checks, the writes and the next index's
// entries. Only what the build and the invalidations after it read is copied
// out, so the transition's scratch (the Snapshot, the flat lists of the
// index's and the target's paths, the keep map, the previous index, the
// entries before their sort) is freed before the build, at whose end the
// transition's peak was. The region writes files, so a failure inside is
// never run again: a diagnostic built there is copied out (raised:
// 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
// is freed, and the work tree and index are left as the failure left them.
fn transition_staged(
    ctx: Context,
    mut value: index.Index,
    target: List[FlatEntry],
    mode: str,
    dry: bool,
    supplied: Map[str, List[byte]],
    validated: bool,
    scanned: List[Snapshot],
) -> () ! WorkErrors {
    var error_payload = "", raised = 0
    var kind = 0
    var next = index.Index {
        version: value.version,
        entries: List[index.Entry](),
        extensions: List[index.Extension](),
    }
    var stale = List[List[byte]]()
    region staged {
        var one = List[Prepared]()
        prepare_into(
            ctx,
            value,
            target,
            mode,
            dry,
            supplied,
            validated,
            scanned,
            mut one,
        ) else |e| match e {
            invalid_index => { return invalid_index },
            unmerged => { return unmerged },
            invalid_tree => { return invalid_tree },
            duplicate_name => { return duplicate_name },
            invalid => { return invalid },
            invalid_oid => { return invalid_oid },
            unsupported_format => { return unsupported_format },
            bad_header => { return bad_header },
            bad_size => { return bad_size },
            bad_oid => { return bad_oid },
            truncated => { return truncated },
            dictionary => { return dictionary },
            checksum => { return checksum },
            limit => { return limit },
            trailing => { return trailing },
            unsupported_level => { return unsupported_level },
            not_found => { return not_found },
            denied => { return denied },
            io => { return io },
            exists => { return exists },
            unsupported => { return unsupported },
            ambiguous => { return ambiguous },
            cross_device => { return cross_device },
            invalid_header => { return invalid_header },
            utf8 => { return utf8 },
            Unsupported(message) => {
                error_payload = copy message
                raised = 1
            },
            Pathspec(message) => {
                error_payload = copy message
                raised = 2
            },
            Fatal(message) => {
                error_payload = copy message
                raised = 3
            },
            Failure(message) => {
                error_payload = copy message
                raised = 4
            },
        }
        if raised == 0 && one[0].kind != 0 {
            kind = one[0].kind
            next = copy one[0].next
            stale = copy one[0].stale
        }
    }
    if raised == 1 { return Unsupported(error_payload) }
    if raised == 2 { return Pathspec(error_payload) }
    if raised == 3 { return Fatal(error_payload) }
    if raised == 4 { return Failure(error_payload) }
    if kind == 0 { return }
    value = next
    if kind == 1 { return }
    let tree = index.build_trees(value)?
    value.extensions = [index.Extension { signature: "TREE", data: copy tree.cache }]
    // A staged change kept through a switch, to a gitlink or a file, an
    // addition or a removal, leaves its trees invalid, as Git's does
    // (vc25 work and report rows).
    for path in stale {
        value = index.invalidate_tree(value, path)?
    }
}

// prepare's Prepared pushed onto out, for transition_staged's region: from
// the one Snapshot scanned holds, or from a scan of value made here.
fn prepare_into(
    ctx: Context,
    value: index.Index,
    target: List[FlatEntry],
    mode: str,
    dry: bool,
    supplied: Map[str, List[byte]],
    validated: bool,
    scanned: List[Snapshot],
    mut out: List[Prepared],
) -> () ! WorkErrors {
    if scanned.len == 1 {
        let prepared = prepare(ctx, value, target, mode, dry, supplied, scanned[0])?
        (mut out).push(prepared)
        return
    }
    // The scan's walk of the work tree is scratch: the scan runs in a region of
    // its own and only its Snapshot is copied out. A scan that fails there is
    // run again outside, where its error's message can leave (a message built
    // inside would be freed); the scan writes nothing.
    var failed = false
    let held = copy region {
        var one = List[Snapshot]()
        scan_into(ctx, value, validated, mut one) else |_| { failed = true }
        one
    }
    if failed {
        let snapshot = scan_index_held(ctx, value, validated)?
        let prepared = prepare(ctx, value, target, mode, dry, supplied, snapshot)?
        (mut out).push(prepared)
        return
    }
    let prepared = prepare(ctx, value, target, mode, dry, supplied, held[0])?
    (mut out).push(prepared)
}

// scan_index_held's Snapshot pushed onto out, for prepare_into's scan region.
fn scan_into(
    ctx: Context,
    value: index.Index,
    validated: bool,
    mut out: List[Snapshot],
) -> () ! WorkErrors {
    let snapshot = scan_index_held(ctx, value, validated)?
    (mut out).push(snapshot)
}

// A transition up to its cache tree, from a scan of value: the checks, the
// writes (unless dry) and the next index's entries in path order. value is
// read only.
fn prepare(
    ctx: Context,
    value: index.Index,
    target: List[FlatEntry],
    mode: str,
    dry: bool,
    supplied: Map[str, List[byte]],
    snapshot: Snapshot,
) -> Prepared ! WorkErrors {
    if mode != "switch" && mode != "merge" && mode != "hard" && mode != "mixed" { return invalid }
    // A diagnostic built in a scratch region below is copied out of it (raised:
    // 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
    // is freed.
    var error_payload = "", raised = 0
    var indexed = List[FlatEntry]()
    for entry in value.entries {
        if index.stage(entry) != 0 { return Unsupported("unmerged tree transition") }
        if entry.extended != 0 || entry.flags & 0x8000 != 0 {
            return Unsupported("flagged tree transition")
        }
        (mut indexed).push(FlatEntry {
            path: copy entry.path,
            mode: entry.stat[6],
            id: copy entry.id,
        })
    }
    // One reader for the whole transition (den#63): its pack indexes are
    // parsed once, where a read per blob parsed them once a file.
    let reader = object.reader_batch(ctx.repo)
    var ignores = ignore.cache()
    var warnings = List[str]()
    var paths = List[List[byte]]()
    for entry in indexed { (mut paths).push(copy entry.path) }
    for entry in target {
        if flat_at(indexed, entry.path) < 0 { (mut paths).push(copy entry.path) }
    }
    var keep = Map[str, bool]()
    var dirty = List[List[byte]](), untracked = List[List[byte]]()
    // What stands in a new path's way (den#185), found here, before any write:
    // lost, the untracked directories where the target puts a file; expendable,
    // what Git removes from the way (an ignored file or directory, or under
    // hard anything untracked), removed with the removals; seen, each leading
    // path decided once.
    var lost = List[List[byte]](), expendable = List[List[byte]]()
    var seen = Map[str, bool]()
    for path in paths {
        let old = flat_at(snapshot.head_entries, path)
        let next = flat_at(target, path)
        let at = flat_at(indexed, path)
        let disk = file_at(snapshot.files, path)
        if mode == "hard" && at < 0 && next >= 0 {
            let led = leading_way(
                ctx,
                path,
                indexed,
                snapshot,
                mode,
                mut keep,
                mut seen,
                mut untracked,
                mut expendable,
                mut ignores,
                mut warnings,
            )?
            if !led && target[next].mode != 0o160000 {
                let _ = directory_way(
                    ctx,
                    path,
                    indexed,
                    mode,
                    mut lost,
                    mut expendable,
                    mut ignores,
                    mut warnings,
                )?
            }
            continue
        }
        if mode == "hard" && at >= 0 && next >= 0 {
            let _ = tracked_way(ctx, path, snapshot, disk, mode, mut expendable)?
            continue
        }
        if mode == "switch" || mode == "merge" {
            if same_flat(snapshot.head_entries, old, target, next) ||
                same_flat(indexed, at, target, next) {
                keep[text(path)?] = true
                continue
            }
            // A tracked path the target writes, with something else where it
            // or a directory it needs was: a local change, as Git lists it.
            if at >= 0 &&
                next >= 0 &&
                tracked_way(ctx, path, snapshot, disk, mode, mut expendable)? {
                (mut dirty).push(copy path)
                continue
            }
            // A tracked path the target removes, become a directory: Git's
            // "would lose untracked files" when it holds one, else removed.
            if at >= 0 &&
                next < 0 &&
                (disk < 0 || snapshot.files[disk].kind == 1) &&
                directory_way(
                    ctx,
                    path,
                    indexed,
                    mode,
                    mut lost,
                    mut expendable,
                    mut ignores,
                    mut warnings,
                )? {
                continue
            }
            if at < 0 && next >= 0 {
                let led = leading_way(
                    ctx,
                    path,
                    indexed,
                    snapshot,
                    mode,
                    mut keep,
                    mut seen,
                    mut untracked,
                    mut expendable,
                    mut ignores,
                    mut warnings,
                )?
                if led { continue }
                if target[next].mode != 0o160000 &&
                    directory_way(
                        ctx,
                        path,
                        indexed,
                        mode,
                        mut lost,
                        mut expendable,
                        mut ignores,
                        mut warnings,
                    )? {
                    continue
                }
            }
            var present = disk >= 0
            if at < 0 && next >= 0 && !present {
                // Opaque directories (an embedded repository, or an untracked
                // directory with no tracked path below it) omit their children
                // from the scan. Probe a target by name before any transition
                // write, so their untracked files still block a safe switch
                // or merge; an ignored one is expendable, as Git's is. Hard
                // reset retains Git's destructive semantics.
                for file in snapshot.files {
                    if file.kind == 1 &&
                        file.mode == 0 &&
                        under(path, file.path) &&
                        path_present(ctx, path)? {
                        let decision = ignore.query_cached(
                            ctx.repo,
                            ctx.root,
                            mut ignores,
                            text(path)?,
                            false,
                            mut warnings,
                        )?
                        present = !decision.ignored
                        break
                    }
                }
            }
            if at < 0 && next >= 0 && present {
                (mut untracked).push(copy path)
                continue
            }
            // A submodule's own worktree never blocks a superproject switch
            // (vc25 probe 1, co-old): only its staged gitlink can.
            let clean = disk < 0 ||
                at >= 0 && indexed[at].mode == 0o160000 ||
                at >= 0 &&
                    snapshot.files[disk].mode == indexed[at].mode &&
                    oid.equal(snapshot.files[disk].id, indexed[at].id)
            if !same_flat(indexed, at, snapshot.head_entries, old) || !clean {
                (mut dirty).push(copy path)
            }
        }
    }
    if dirty.len > 0 || untracked.len > 0 || lost.len > 0 {
        var message = ""
        if dirty.len > 0 {
            message = "Your local changes to the following files would be overwritten by checkout:\n"
            for path in dirty { message += "\t{text(path)?}\n" }
            message += "Please commit your changes or stash them before you switch branches.\n"
        }
        if lost.len > 0 {
            if message != "" { message += "error: " }
            message += "Updating the following directories would lose untracked files in them:\n"
            for path in lost { message += "\t{text(path)?}\n" }
            message += "\n"
        }
        if untracked.len > 0 {
            if message != "" { message += "error: " }
            message += "The following untracked working tree files would be overwritten by checkout:\n"
            for path in untracked { message += "\t{text(path)?}\n" }
            message += "Please move or remove them before you switch branches.\n"
        }
        if mode == "merge" {
            message = message.replace("checkout:", "merge:").replace("switch branches.", "merge.")
        }
        return Failure("{message}Aborting")
    }
    let attributes = planned_tree_attributes(ctx, reader, target, supplied)?
    // Incoming rules can require a refusal even for a kept path. A policy-free
    // safety-only check still avoids reading unchanged bodies, as before.
    for entry in target {
        if entry.mode == 0o160000 { continue }
        if !attributes.possible && (dry || (keep[text(entry.path)?] else false)) { continue }
        var crlf = false, binary = false
        // One blob at a time (vc23): a clone's checkout holds one file's
        // body, never the whole worktree's.
        region verify {
            let data = planned_object(reader, entry.id, supplied, 1000000000) else |e| match e {
                invalid_index => { return invalid_index },
                unmerged => { return unmerged },
                invalid_tree => { return invalid_tree },
                duplicate_name => { return duplicate_name },
                invalid => { return invalid },
                invalid_oid => { return invalid_oid },
                unsupported_format => { return unsupported_format },
                bad_header => { return bad_header },
                bad_size => { return bad_size },
                bad_oid => { return bad_oid },
                truncated => { return truncated },
                dictionary => { return dictionary },
                checksum => { return checksum },
                limit => { return limit },
                trailing => { return trailing },
                unsupported_level => { return unsupported_level },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
                exists => { return exists },
                unsupported => { return unsupported },
                Unsupported(message) => {
                    error_payload = copy message
                    raised = 1
                    break
                },
                ambiguous => { return ambiguous },
                cross_device => { return cross_device },
                invalid_header => { return invalid_header },
                utf8 => { return utf8 },
                Pathspec(message) => {
                    error_payload = copy message
                    raised = 2
                    break
                },
                Fatal(message) => {
                    error_payload = copy message
                    raised = 3
                    break
                },
                Failure(message) => {
                    error_payload = copy message
                    raised = 4
                    break
                },
            }
            if data.kind != "blob" { return bad_oid }
            if attributes.possible && (entry.mode == 0o100644 || entry.mode == 0o100755) {
                let content = text_content_bytes(data.data)
                crlf = content.crlf
                binary = text_content_binary(content)
            }
        }
        if (crlf || attributes.identity) && (entry.mode == 0o100644 || entry.mode == 0o100755) {
            planned_check_content(ctx, attributes, entry.path, crlf, binary)?
        }
    }
    if raised == 1 { return Unsupported(error_payload) }
    if raised == 2 { return Pathspec(error_payload) }
    if raised == 3 { return Fatal(error_payload) }
    if raised == 4 { return Failure(error_payload) }
    if dry {
        return Prepared {
            kind: 0,
            next: index.Index {
                version: value.version,
                entries: List[index.Entry](),
                extensions: List[index.Extension](),
            },
            stale: List[List[byte]](),
        }
    }
    let filemode = config_bool(ctx, "core.filemode", true)?
    let symlinks = config_bool(ctx, "core.symlinks", true)?
    let previous = copy value
    // Remove first so a tracked directory-to-file change can be installed; what
    // Git removes from a new path's way goes before anything else (den#185).
    if mode != "mixed" {
        for path in expendable { remove_in_way(ctx, path)? }
        for path in paths {
            if keep[text(path)?] else false { continue }
            if flat_at(target, path) < 0 {
                let was = flat_at(indexed, path)
                if was >= 0 && indexed[was].mode == 0o160000 {
                    remove_gitlink_directory(ctx, path)?
                } else if mode == "hard" && is_directory(ctx, path)? {
                    // Git's reset --hard cannot unlink a directory and says so
                    // in the host's words, keeping it and what it holds.
                    let reason = if os.name() == "linux" {
                        "Is a directory"
                    } else {
                        "Operation not permitted"
                    }
                    eprint("warning: unable to unlink '{text(path)?}': {reason}")
                } else {
                    remove_file(ctx, path)?
                }
            }
        }
    }
    var entries = List[index.Entry]()
    for path in paths {
        let at = index_at(previous.entries, path)
        let next = flat_at(target, path)
        if keep[text(path)?] else false {
            if at >= 0 {
                var entry = copy previous.entries[at]
                // An unchanged gitlink keeps its entry, stat and all (vc25).
                if entry.stat[6] == 0o160000 { (mut entries).push(entry); continue }
                let disk = file_at(snapshot.files, path)
                if disk >= 0 &&
                    snapshot.files[disk].mode == entry.stat[6] &&
                    oid.equal(snapshot.files[disk].id, entry.id) {
                    entry = entry_for(snapshot.files[disk], [copy entry], add_options())?
                }
                (mut entries).push(entry)
            }
            continue
        }
        if next < 0 { continue }
        // Each path's blob, written file and read-back live in one region.
        region one {
            let entry = transition_path(
                ctx,
                reader,
                snapshot,
                previous,
                at,
                target[next],
                path,
                mode,
                filemode,
                symlinks,
            ) else |e| match e {
                invalid_index => { return invalid_index },
                unmerged => { return unmerged },
                invalid_tree => { return invalid_tree },
                duplicate_name => { return duplicate_name },
                invalid => { return invalid },
                invalid_oid => { return invalid_oid },
                unsupported_format => { return unsupported_format },
                bad_header => { return bad_header },
                bad_size => { return bad_size },
                bad_oid => { return bad_oid },
                truncated => { return truncated },
                dictionary => { return dictionary },
                checksum => { return checksum },
                limit => { return limit },
                trailing => { return trailing },
                unsupported_level => { return unsupported_level },
                not_found => { return not_found },
                denied => { return denied },
                io => { return io },
                exists => { return exists },
                unsupported => { return unsupported },
                Unsupported(message) => {
                    error_payload = copy message
                    raised = 1
                    break
                },
                ambiguous => { return ambiguous },
                cross_device => { return cross_device },
                invalid_header => { return invalid_header },
                utf8 => { return utf8 },
                Pathspec(message) => {
                    error_payload = copy message
                    raised = 2
                    break
                },
                Fatal(message) => {
                    error_payload = copy message
                    raised = 3
                    break
                },
                Failure(message) => {
                    error_payload = copy message
                    raised = 4
                    break
                },
            }
            (mut entries).push(copy entry)
        }
    }
    if raised == 1 { return Unsupported(error_payload) }
    if raised == 2 { return Pathspec(error_payload) }
    if raised == 3 { return Fatal(error_payload) }
    if raised == 4 { return Failure(error_payload) }
    // Preserve the index's unsigned pathname order independent of target
    // order: a stable sort of positions, its keys in a region of their own,
    // then each entry moved once into place. An insertion sort that copied
    // every entry it shifted kept each copy to the end of the command: a
    // pull adding 440 paths through a 10,000-entry index held 2.6 GB of
    // them (den#138).
    var order = copy region {
        var names = List[List[byte]]()
        (mut names).reserve(entries.len)
        for entry in entries { (mut names).push(copy entry.path) }
        path_order(names)
    }
    var sorted = List[index.Entry]()
    (mut sorted).reserve(entries.len)
    for i in order {
        (mut sorted).push(take entries[i])
        entries[i] = index.Entry {
            stat: List[int](),
            id: oid.Oid { algorithm: "", bytes: List[byte]() },
            flags: 0,
            extended: 0,
            path: List[byte](),
        }
    }
    var result = index.Index {
        version: value.version,
        entries: sorted,
        extensions: List[index.Extension](),
    }
    if mode == "mixed" {
        result.extensions = copy previous.extensions
        for path in paths {
            if !same_flat(indexed, flat_at(indexed, path), target, flat_at(target, path)) {
                result = index.invalidate_tree(result, path)?
            }
        }
        return Prepared { kind: 1, next: result, stale: List[List[byte]]() }
    }
    // The kept staged paths whose trees the build will leave invalid, found
    // here, before it, so that indexed, paths and keep are not read after the
    // region.
    var stale = List[List[byte]]()
    for path in paths {
        if !(keep[text(path)?] else false) { continue }
        if !same_flat(indexed, flat_at(indexed, path), target, flat_at(target, path)) {
            (mut stale).push(copy path)
        }
    }
    Prepared { kind: 2, next: result, stale: stale }
}

// A new path's leading directories, before any write (den#185). The first that
// is not a directory on disk stands in its way, decided once (seen): an index
// entry the transition removes first is no obstruction; a staged addition it
// keeps is dropped when its file is unchanged and refuses when changed, as
// Git's; an untracked file or symlink refuses, unless ignored, and an ignored
// one is removed with the removals; under hard, anything untracked is removed.
// Answers whether something stood in the way.
fn leading_way(
    ctx: Context,
    path: List[byte],
    indexed: List[FlatEntry],
    snapshot: Snapshot,
    mode: str,
    mut keep: Map[str, bool],
    mut seen: Map[str, bool],
    mut untracked: List[List[byte]],
    mut expendable: List[List[byte]],
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> bool ! WorkErrors {
    for i in 0..path.len {
        if path[i] != 47 as byte { continue }
        let prefix = path[0..i]
        // A staged addition the work tree no longer holds, where a new path
        // needs a directory: dropped, as Git drops it.
        if mode != "hard" && flat_at(indexed, prefix) >= 0 && file_at(snapshot.files, prefix) < 0 {
            let gone = text(prefix)?
            if keep[gone] else false {
                keep[gone] = false
                return true
            }
        }
        let info = fs_lstat(absolute(ctx, prefix)?) else |e| match e {
            not_found => { return false },
            denied => { return denied },
            io => { return io },
        }
        if info[0] == 1 { continue }
        let key = text(prefix)?
        if seen[key] else false { return true }
        seen[key] = true
        let at = flat_at(indexed, prefix)
        if at >= 0 {
            if mode == "hard" || !(keep[key] else false) { return true }
            let disk = file_at(snapshot.files, prefix)
            let clean = disk >= 0 &&
                snapshot.files[disk].mode == indexed[at].mode &&
                oid.equal(snapshot.files[disk].id, indexed[at].id)
            if clean {
                keep[key] = false
            } else {
                (mut untracked).push(copy prefix)
            }
            return true
        }
        if mode == "hard" {
            return true
        }
        let decision = ignore.query_cached(
            ctx.repo,
            ctx.root,
            mut ignores,
            key,
            false,
            mut warnings,
        )?
        if decision.ignored {
            (mut expendable).push(copy prefix)
        } else {
            (mut untracked).push(copy prefix)
        }
        return true
    }
    false
}

// A directory on disk where the target puts a file (den#185), when no tracked
// path lies below it: one holding an untracked file that is not ignored is
// lost (Git's "would lose untracked files"); one holding only ignored files,
// or nothing, is removed with the removals; under hard, it is removed.
// Answers whether a directory stood there.
fn directory_way(
    ctx: Context,
    path: List[byte],
    indexed: List[FlatEntry],
    mode: str,
    mut lost: List[List[byte]],
    mut expendable: List[List[byte]],
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> bool ! WorkErrors {
    let info = fs_lstat(absolute(ctx, path)?) else |e| match e {
        not_found => { return false },
        denied => { return denied },
        io => { return io },
    }
    if info[0] != 1 || tracked_below(indexed, path) { return false }
    if mode == "hard" {
        (mut expendable).push(copy path)
        return true
    }
    let whole = ignore.query_cached(
        ctx.repo,
        ctx.root,
        mut ignores,
        text(path)?,
        true,
        mut warnings,
    )?
    if whole.ignored {
        (mut expendable).push(copy path)
        return true
    }
    var queue = [copy path]
    var i = 0
    while i < queue.len {
        let dir = copy queue[i]
        i += 1
        let names = fs.read_dir(absolute(ctx, dir)?) else |e| match e {
            not_found => { continue },
            denied => { return denied },
            utf8 => { return utf8 },
            io => { return io },
        }
        for name in names {
            var child = copy dir
            (mut child).push(47 as byte)
            for b in name.bytes() { (mut child).push(b) }
            let record = fs_lstat(absolute(ctx, child)?) else |e| match e {
                not_found => { continue },
                denied => { return denied },
                io => { return io },
            }
            let directory = record[0] == 1
            let decision = ignore.query_cached(
                ctx.repo,
                ctx.root,
                mut ignores,
                text(child)?,
                directory,
                mut warnings,
            )?
            if decision.ignored { continue }
            if directory {
                (mut queue).push(child)
                continue
            }
            (mut lost).push(copy path)
            return true
        }
    }
    (mut expendable).push(copy path)
    true
}

// Whether an index entry lies below path: the first entry at or after
// "path/" in index order starts with it.
fn tracked_below(indexed: List[FlatEntry], path: List[byte]) -> bool {
    var key = copy path
    (mut key).push(47 as byte)
    var lo = 0, hi = indexed.len
    while lo < hi {
        let mid = (lo + hi) / 2
        if compare(indexed[mid].path, key) < 0 { lo = mid + 1 } else { hi = mid }
    }
    lo < indexed.len && indexed[lo].path.len > path.len && under(indexed[lo].path, path)
}

// A tracked path the transition writes, when the scan did not see it as a file
// (den#185): a file or symlink where a directory it needs was, or a directory
// where it was, stands in its way. Under hard that is removed with the
// removals. The directories it needs are probed first, so the path itself is
// read only below real directories. Answers whether something stood there.
fn tracked_way(
    ctx: Context,
    path: List[byte],
    snapshot: Snapshot,
    disk: int,
    mode: str,
    mut expendable: List[List[byte]],
) -> bool ! WorkErrors {
    if disk >= 0 && snapshot.files[disk].kind != 1 { return false }
    for i in 0..path.len {
        if path[i] != 47 as byte { continue }
        let prefix = path[0..i]
        let info = fs_lstat(absolute(ctx, prefix)?) else |e| match e {
            not_found => { return false },
            denied => { return denied },
            io => { return io },
        }
        if info[0] == 1 { continue }
        if mode == "hard" { (mut expendable).push(copy prefix) }
        return true
    }
    if !is_directory(ctx, path)? { return false }
    if mode == "hard" { (mut expendable).push(copy path) }
    true
}

// Whether path is a directory on disk (not through a symlink).
fn is_directory(ctx: Context, path: List[byte]) -> bool ! WorkErrors {
    let info = fs_lstat(absolute(ctx, path)?) else |e| match e {
        not_found => { return false },
        denied => { return denied },
        io => { return io },
    }
    info[0] == 1
}

// What Git removes from a new path's way (den#185): an ignored file or
// directory, or under hard anything untracked.
fn remove_in_way(ctx: Context, path: List[byte]) -> () ! WorkErrors {
    let full = absolute(ctx, path)?
    let info = fs_lstat(full) else |e| match e {
        not_found => { return },
        denied => { return denied },
        io => { return io },
    }
    if info[0] == 1 {
        fs.remove_dir_all(full)?
    } else {
        fs.remove(full)?
    }
}

// A disappearing gitlink's directory goes only when empty; a populated one
// stays with Git's warning (vc25 probe 2, co-remove).
fn remove_gitlink_directory(ctx: Context, path: List[byte]) -> () ! WorkErrors {
    let full = absolute(ctx, path)?
    let record = fs_lstat(full) else |e| match e {
        not_found => { return },
        denied => { return denied },
        io => { return io },
    }
    if record[0] != 1 { return remove_file(ctx, path)? }
    if fs.entries(full)?.len == 0 {
        fs.remove_dir(full)?
        clean_parents(ctx, path)
        return
    }
    eprint("warning: unable to rmdir '{text(path)?}': Directory not empty")
}
