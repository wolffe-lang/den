// Clean-room: Git v2.56.0 Documentation/gitattributes.adoc (DESCRIPTION,
// EFFECTS: text, eol, crlf, ident, filter, working-tree-encoding, diff,
// merge, whitespace, export-ignore, export-subst, delta; USING MACRO
// ATTRIBUTES; DEFINING MACRO ATTRIBUTES), measured against the pinned Git.
// No implementation consulted.
use repository

// The attribute in one `name`, `-name`, `!name` or `name=value` token that den
// would have to act on, or "" when den behaves as Git does without acting:
// - text and crlf unset or unspecified: no line-ending conversion, which is
//   den's only behaviour (core.autocrlf other than false is refused apart);
// - diff, merge, eol, filter, ident, working-tree-encoding,
//   conflict-marker-size and the binary macro unspecified (`!name`): Git's
//   default, den's;
// - whitespace, export-ignore, export-subst and delta in any form, and any
//   name Git gives no meaning: they change apply, archive or pack choices
//   only, never what checkout, status, add, merge or pull do.
fn attribute_refused(token: List[byte]) -> str ! WorkErrors {
    var start = 0, state = "set"
    if token.len > 0 && token[0] == 45 as byte {
        state = "unset"
        start = 1
    } else if token.len > 0 && token[0] == 33 as byte {
        state = "unspecified"
        start = 1
    }
    var end = token.len
    for i in start..token.len {
        if token[i] == 61 as byte {
            end = i
            if state == "set" { state = "value" }
            break
        }
    }
    let name = str_from_utf8(token[start..end]) else |_| { return "" }
    if name == "text" || name == "crlf" {
        return if state == "unset" || state == "unspecified" then "" else "{name}"
    }
    for acting in [
        "diff",
        "merge",
        "eol",
        "filter",
        "ident",
        "working-tree-encoding",
        "conflict-marker-size",
        "binary",
    ] {
        if name == acting { return if state == "unspecified" then "" else "{name}" }
    }
    ""
}

/// The first attribute in an attributes file's bytes that den would have to
/// act on, "macro definition" for an `[attr]` line, or "" when there is none.
pub fn attributes_refusal(data: List[byte]) -> str ! WorkErrors {
    var lines = List[List[byte]](), line = List[byte]()
    for b in data {
        if b == 10 as byte {
            (mut lines).push(copy line)
            line = List[byte]()
        } else {
            (mut line).push(b)
        }
    }
    (mut lines).push(copy line)
    for raw in lines {
        // Tokens split at blanks; a quoted pattern keeps its blanks.
        var tokens = List[List[byte]](), current = List[byte](), quoted = false
        for b in raw {
            if b == 34 as byte { quoted = !quoted }
            if !quoted && (b == 32 as byte || b == 9 as byte || b == 13 as byte) {
                if current.len > 0 {
                    (mut tokens).push(copy current)
                    current = List[byte]()
                }
            } else {
                (mut current).push(b)
            }
        }
        if current.len > 0 { (mut tokens).push(copy current) }
        if tokens.len == 0 || tokens[0][0] == 35 as byte { continue }
        let first = copy tokens[0]
        let head = if first.len >= 6 then (str_from_utf8(first[0..6]) else "") else ""
        if head == "[attr]" { return "macro definition" }
        for i in 1..tokens.len {
            let refused = attribute_refused(copy tokens[i])?
            if refused != "" { return refused }
        }
    }
    ""
}

/// Refuse, by attribute and file, an attributes file that sets what den does
/// not do; one that sets only what den need not act on is accepted. shown is
/// the name the refusal prints.
fn attributes_file(full: str, shown: str) -> () ! WorkErrors {
    let named = fs_lstat(full) else |e| match e {
        not_found => { return },
        denied => { return denied },
        io => { return io },
    }
    if named[0] != 0 { return Unsupported("worktree attributes: {shown} is not a regular file") }
    let data = repository.read_bytes(full, 1048576) else |e| match e {
        not_found => { return },
        limit => { return Fatal("limit: '{shown}' is larger than 1048576 bytes") },
        denied => { return denied },
        io => { return io },
        _ => { return Unsupported("worktree attributes: {shown} unreadable") },
    }
    let refused = attributes_refusal(data)?
    if refused != "" { return Unsupported("worktree attributes: {refused} in {shown}") }
}

/// Every .gitattributes a walk listed, checked as attributes_file checks it.
fn supported_attributes(ctx: Context, files: List[FileState]) -> () ! WorkErrors {
    for file in files {
        if file.kind == 1 { continue }
        let path = text(file.path)?
        if path != ".gitattributes" && !path.ends_with("/.gitattributes") { continue }
        attributes_file(absolute(ctx, file.path)?, path)?
    }
}
