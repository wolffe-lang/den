// Clean-room: Git v2.56.0 Documentation/gitattributes.adoc (DESCRIPTION,
// EFFECTS: text, eol, crlf, ident, filter, working-tree-encoding, diff,
// merge, whitespace, export-ignore, export-subst, delta; USING MACRO
// ATTRIBUTES; DEFINING MACRO ATTRIBUTES), measured against the pinned Git.
// No implementation consulted.
use ignore
use index
use object
use repository

// The refusal for one `name`, `-name`, `!name` or `name=value` token that
// den would have to act on, or "" when den behaves as Git does without acting:
// - text and crlf unset or unspecified: no line-ending conversion, which is
//   den's only behaviour (core.autocrlf other than false is refused apart);
// - diff, merge, eol, filter, ident, working-tree-encoding,
//   conflict-marker-size and the binary macro unspecified (`!name`): Git's
//   default, den's;
// - whitespace, export-ignore, export-subst and delta in any form, and any
//   name Git gives no meaning: they change apply, archive or pack choices
//   only, never what checkout, status, add, merge or pull do.
fn attribute_refused(token: List[byte]) -> str ! WorkErrors {
    var start = 0, state = "set"
    if token.len > 0 && token[0] == 45 as byte {
        state = "unset"
        start = 1
    } else if token.len > 0 && token[0] == 33 as byte {
        state = "unspecified"
        start = 1
    }
    var end = token.len
    for i in start..token.len {
        if token[i] == 61 as byte {
            end = i
            if state == "set" { state = "value" }
            break
        }
    }
    let name = str_from_utf8(token[start..end]) else |_| { return "" }
    // Literals only: a refusal can leave the region its scan ran in (a
    // rebase step's), and a message built at run time would leave with it.
    if name == "text" || name == "crlf" {
        if state == "unset" || state == "unspecified" { return "" }
        if name == "text" && (state == "set" || compare(token, "text=auto".bytes()) == 0) {
            return ""
        }
        return if name == "text" then "worktree attributes: text" else "worktree attributes: crlf"
    }
    if state == "unspecified" { return "" }
    if name == "diff" { return "worktree attributes: diff" }
    if name == "merge" { return "worktree attributes: merge" }
    if name == "eol" {
        if compare(token, "eol=lf".bytes()) == 0 { return "" }
        return "worktree attributes: eol"
    }
    if name == "filter" { return "worktree attributes: filter" }
    if name == "ident" { return "worktree attributes: ident" }
    if name == "working-tree-encoding" { return "worktree attributes: working-tree-encoding" }
    if name == "conflict-marker-size" { return "worktree attributes: conflict-marker-size" }
    if name == "binary" { return "worktree attributes: binary" }
    ""
}

// Only an initial double quote quotes the pattern. A literal quote within an
// unquoted name must not swallow the attributes; escaped quotes inside a
// quoted pattern must not end it. Preserve pattern bytes for the CR-LF guard.
fn attribute_tokens(raw: List[byte]) -> List[List[byte]] {
    var tokens = List[List[byte]](), current = List[byte](), quoted = false, escaped = false
    for b in raw {
        if b == 0 as byte { break }
        if quoted {
            (mut current).push(b)
            if escaped {
                escaped = false
            } else if b == 92 as byte {
                escaped = true
            } else if b == 34 as byte {
                quoted = false
                (mut tokens).push(copy current)
                current = List[byte]()
            }
            continue
        }
        if tokens.len == 0 && current.len == 0 && b == 34 as byte { quoted = true }
        if !quoted && (b == 32 as byte || b == 9 as byte || b == 13 as byte) {
            if current.len > 0 {
                (mut tokens).push(copy current)
                current = List[byte]()
            }
        } else {
            (mut current).push(b)
        }
    }
    if current.len > 0 { (mut tokens).push(current) }
    tokens
}

fn attribute_lines(data: List[byte]) -> List[List[byte]] {
    var lines = List[List[byte]](), line = List[byte]()
    for b in data {
        if b == 10 as byte {
            (mut lines).push(copy line)
            line = List[byte]()
        } else {
            (mut line).push(b)
        }
    }
    (mut lines).push(copy line)
    lines
}

/// The refusal for the first attribute in an attributes file's bytes that
/// den would have to act on (a macro definition counts), or "" for none.
pub fn attributes_refusal(data: List[byte]) -> str ! WorkErrors {
    for raw in attribute_lines(data) {
        let tokens = attribute_tokens(raw)
        if tokens.len == 0 || tokens[0][0] == 35 as byte { continue }
        let first = copy tokens[0]
        let head = if first.len >= 6 then (str_from_utf8(first[0..6]) else "") else ""
        if head == "[attr]" { return "worktree attributes: macro definition" }
        for i in 1..tokens.len {
            let refused = attribute_refused(copy tokens[i])?
            if refused != "" { return refused }
        }
    }
    ""
}

/// Refuse, by attribute, an attributes file that sets what den does not do;
/// one that sets only what den need not act on is accepted.
fn attributes_data(full: str) -> List[byte] ! WorkErrors {
    let named = fs_lstat(full) else |e| match e {
        not_found => { return List[byte]() },
        denied => { return denied },
        io => { return io },
    }
    if named[0] != 0 { return Unsupported("worktree attributes: not a regular file") }
    let data = repository.read_bytes(full, 1048576) else |e| match e {
        not_found => { return List[byte]() },
        limit => { return Fatal("limit: an attributes file larger than 1048576 bytes") },
        denied => { return denied },
        io => { return io },
        Unsupported(reason) => {
            if reason.starts_with("limit: ") {
                return Fatal("limit: an attributes file larger than 1048576 bytes")
            }
            return Unsupported("worktree attributes: unreadable")
        },
        _ => { return Unsupported("worktree attributes: unreadable") },
    }
    let refused = attributes_refusal(data)?
    if refused != "" { return Unsupported(refused) }
    data
}

fn attributes_file(full: str) -> () ! WorkErrors {
    let _ = attributes_data(full)?
}

/// Every .gitattributes a walk listed, checked as attributes_file checks it.
fn supported_attributes(ctx: Context, files: List[FileState]) -> () ! WorkErrors {
    for file in files {
        if file.kind == 1 { continue }
        let path = text(file.path)?
        if path != ".gitattributes" && !path.ends_with("/.gitattributes") { continue }
        attributes_file(absolute(ctx, file.path)?)?
    }
}

// text: -1 unset, 0 unspecified, 1 set/auto. eol: 0 unspecified, 1 LF.
// This is an identity-only guard, not a text detector or normalizer. In
// particular text=auto bodies with NUL and CR-LF still refuse conservatively.
fn attribute_basename(name: List[byte]) -> bool {
    let wanted = ".gitattributes".bytes()
    if name.len != wanted.len { return false }
    for i in 0..name.len {
        let b = name[i]
        let folded = if b >= 65 as byte && b <= 90 as byte then (b as int + 32) as byte else b
        if folded != wanted[i] { return false }
    }
    true
}

// A read-only alias check on the worktree's own administrative entry avoids
// assuming that a manually overridden core.ignorecase describes its filesystem.
fn attributes_fs_casefold(ctx: Context) -> bool ! WorkErrors {
    if ctx.root == "" { return false }
    let original = fs_lstat("{ctx.root}/.git") else |_| { return false }
    let alias = fs_lstat("{ctx.root}/.GIT") else |_| { return false }
    original.len == 20 &&
        alias.len == 20 &&
        (original[9] != 0 || original[10] != 0) &&
        original[9] == alias[9] &&
        original[10] == alias[10]
}

fn attribute_fold(data: List[byte]) -> List[byte] {
    var out = List[byte]()
    for b in data {
        (mut out).push(if b >= 65 as byte && b <= 90 as byte then (b as int + 32) as byte else b)
    }
    out
}

fn text_rules_case(
    data: List[byte],
    base: List[byte],
    path: List[byte],
    mut state: List[int],
    ignore_case: bool,
) -> () ! WorkErrors {
    let source = str_from_utf8(data) else |_| {
        return Unsupported("worktree attributes: text at {text(path)?}")
    }
    for raw in source.split("\n") {
        var tokens = List[str]()
        for token in attribute_tokens(raw.bytes()) {
            (mut tokens).push(str_from_utf8(token) else "")
        }
        if tokens.len < 2 || tokens[0].starts_with("#") { continue }
        var changes = false
        for token in tokens {
            if token == "text" ||
                token == "text=auto" ||
                token == "-text" ||
                token == "!text" ||
                token == "eol=lf" ||
                token == "!eol" {
                changes = true
            }
        }
        if !changes { continue }
        // Quoted/escaped patterns need Git's C quoting, not ignore's escape
        // syntax. They are safely outside this first conversion guard.
        if tokens[0].contains("\"") ||
            tokens[0].contains("\\") ||
            ignore_case && tokens[0].contains("[") {
            return Unsupported("worktree attributes: text at {text(path)?}")
        }
        let pattern = if ignore_case {
            attribute_fold("{tokens[0]}\n".bytes())
        } else {
            "{tokens[0]}\n".bytes()
        }
        let directory = if ignore_case then attribute_fold(base) else copy base
        let candidate = if ignore_case then attribute_fold(path) else copy path
        let rules = ignore.parse("attributes", directory, pattern)?
        var matched = false
        for rule in rules { if ignore.matches(rule, candidate, false)? { matched = true } }
        if !matched { continue }
        for i in 1..tokens.len {
            let token = tokens[i]
            if token == "text" || token == "text=auto" { state[0] = 1 }
            if token == "-text" { state[0] = -1 }
            if token == "!text" { state[0] = 0 }
            if token == "eol=lf" { state[1] = 1 }
            if token == "!eol" { state[1] = 0 }
        }
    }
}

// Git falls back to the index when a worktree attributes file is absent.
// In particular deleting .gitattributes must not enable an unsafe raw add.
fn attributes_source(
    ctx: Context,
    base: List[byte],
    value: index.Index,
) -> List[byte] ! WorkErrors {
    var path = copy base
    if path.len > 0 { (mut path).push(47 as byte) }
    bytes_add(mut path, ".gitattributes".bytes())
    let full = absolute(ctx, path)?
    let named = fs_lstat(full) else |e| match e {
        not_found => { List[int]() },
        denied => { return denied },
        io => { return io },
    }
    if named.len > 0 { return attributes_data(full)? }
    let at = index_at(value.entries, path)
    if at < 0 { return List[byte]() }
    let entry = copy value.entries[at]
    if entry.stat[6] != 0o100644 && entry.stat[6] != 0o100755 {
        return Unsupported("worktree attributes: not a regular file")
    }
    let stored = object.read_object(ctx.repo, entry.id, 1048576)?
    if stored.kind != "blob" { return invalid_tree }
    let refused = attributes_refusal(stored.data)?
    if refused != "" { return Unsupported(refused) }
    stored.data
}

// Only a CR-LF body pays for path matching. LF bodies retain their existing
// byte/hash path, and a CR at a chunk's end is carried into the next chunk.
fn check_crlf(ctx: Context, path: List[byte]) -> () ! WorkErrors {
    var state = [0, 0]
    let value = read_index(ctx)?
    let ignore_case = config_bool(ctx, "core.ignorecase", false)?
    if ctx.root != "" {
        text_rules_case(attributes_source(ctx, [], value)?, [], path, mut state, ignore_case)?
        for i in 0..path.len {
            if path[i] != 47 as byte { continue }
            let base = path[0..i]
            text_rules_case(
                attributes_source(ctx, base, value)?,
                base,
                path,
                mut state,
                ignore_case,
            )?
        }
    }
    text_rules_case(
        attributes_data("{ctx.repo.gitdir}/info/attributes")?,
        [],
        path,
        mut state,
        ignore_case,
    )?
    if state[0] > 0 || state[0] == 0 && state[1] == 1 {
        return Unsupported("worktree attributes: text at {text(path)?} (CR-LF conversion)")
    }
}

/// Refuse a CR-LF body by path when its effective text/eol rules would clean
/// it. LF-only bodies are identity; filesystem/index/parser errors propagate.
pub fn check_text_content(ctx: Context, path: List[byte], data: List[byte]) -> () ! WorkErrors {
    if has_crlf(data) { check_crlf(ctx, path)? }
}

// A newly introduced text rule can invalidate an otherwise stat-clean entry:
// stat equality is not evidence that its bytes contain no CR-LF. Check once
// per directory, not per path. Inert attributes keep the old stat fast path.
fn text_tokens(data: List[byte]) -> bool {
    for line in attribute_lines(data) {
        let tokens = attribute_tokens(line)
        if tokens.len == 0 || tokens[0][0] == 35 as byte { continue }
        for i in 1..tokens.len {
            let token = copy tokens[i]
            if compare(token, "text".bytes()) == 0 ||
                compare(token, "text=auto".bytes()) == 0 ||
                compare(token, "eol=lf".bytes()) == 0 {
                return true
            }
        }
    }
    false
}

/// Validate all attribute sources applying below directory. True means a
/// text rule may invalidate a stat-clean entry; it does not mean every path
/// matches that rule. Directory-scoped callers cache this result.
pub fn attributes_directory(
    ctx: Context,
    directory: List[byte],
    value: index.Index,
) -> bool ! WorkErrors {
    var possible = false
    region attributes {
        possible = text_tokens(attributes_data("{ctx.repo.gitdir}/info/attributes")?)
    }
    if ctx.root == "" { return possible }
    var bases = [List[byte]()]
    for i in 0..=directory.len {
        if i == directory.len || directory[i] == 47 as byte {
            if i > 0 { (mut bases).push(copy directory[0..i]) }
        }
    }
    for base in bases {
        region attributes {
            if text_tokens(attributes_source(ctx, base, value)?) { possible = true }
        }
    }
    possible
}

/// Read the shared attribute sources without acquiring unrelated worktree
/// conversion-configuration limits for pure index/tree history readers.
pub fn check_attributes(ctx: Context) -> () ! WorkErrors {
    if (ctx.repo.config["core.attributesfile"] else "") != "" {
        return Unsupported("worktree attributes: core.attributesFile")
    }
    attributes_file("{ctx.repo.gitdir}/info/attributes")?
    if ctx.root != "" { attributes_file("{ctx.root}/.gitattributes")? }
}

/// Directory-scoped policy cache for readers of tree/index endpoints.
pub fn text_path_policy(
    ctx: Context,
    path: List[byte],
    value: index.Index,
    mut cache: Map[str, bool],
) -> bool ! WorkErrors {
    var end = 0
    for i in 0..path.len { if path[i] == 47 as byte { end = i } }
    let directory = path[0..end]
    let key = text(directory)?
    let cached = cache[key] else |_| {
        let possible = attributes_directory(ctx, directory, value)?
        cache[key] = possible
        return possible
    }
    cached
}

/// Whether bytes contain adjacent CR and LF; NUL and bare CR are ordinary bytes.
pub fn has_crlf(data: List[byte]) -> bool {
    for i in 1..data.len {
        if data[i - 1] == 13 as byte && data[i] == 10 as byte { return true }
    }
    false
}
