use std.fs
use gitmodules
use hash
use ignore
use index
use object
use oid
use repository

fn stable(a: List[int], b: List[int]) -> bool {
    if a.len != 20 || b.len != 20 { return false }
    for i in [0, 1, 4, 6, 7, 9, 10, 14, 15, 16, 17] { if a[i] != b[i] { return false } }
    true
}

/// The file's bytes, in one buffer of the size its fstat gave: grown a chunk
/// at a time, a 16 MB file kept every smaller buffer it outgrew, about twice
/// its size (den#145). A file that grows after the fstat still reads whole.
fn read_held(fd: int, path: List[byte], size: int) -> List[byte] ! WorkErrors {
    var out = List[byte](), exceeded = false
    if size > 0 && size <= 1000000000 { (mut out).reserve(size) }
    loop {
        region chunk {
            let part = fs_read_chunk(fd, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > 1000000000 - out.len {
                exceeded = true
                break
            }
            for b in part { (mut out).push(b) }
        }
    }
    if exceeded { return Fatal("limit: a work tree file larger than 1000000000 bytes") }
    out
}

/// Read actual bytes with before/after metadata agreement. Final symlinks use
/// lstat/read_link/lstat; regular files use NOFOLLOW plus one held descriptor.
/// prior has zero or one stage-zero entry and controls fileMode/symlinks policy.
pub fn read_file(
    ctx: Context,
    path: List[byte],
    prior: List[index.Entry],
) -> FileState ! WorkErrors {
    if prior.len > 1 { return invalid }
    if prior.len == 1 {
        var checked = index.empty(2)?
        (mut checked.entries).push(copy prior[0])
        let _ = index.serialize(checked)?
        if index.stage(prior[0]) != 0 || compare(prior[0].path, path) != 0 { return invalid_index }
    }
    safe_parents(ctx, path, false)?
    let full = absolute(ctx, path)?
    let named = fs_lstat(full)?
    var record = copy named
    var data = List[byte]()
    var mode = 0o100644
    if named[0] == 3 {
        data = fs.read_link(full)?
        if !stable(named, fs_lstat(full)?) {
            return Failure("'{text(path)?}' changed while reading")
        }
        mode = 0o120000
    } else if named[0] == 0 {
        var file = fs.File { fd: fs_open_mode(full, 21)? }
        defer fs.close(take file) else |_| {}
        let before = fs_fstat_record(file.fd)?
        if !stable(named, before) { return Failure("'{text(path)?}' changed while opening") }
        data = read_held(file.fd, path, before[1])?
        record = fs_fstat_record(file.fd)?
        if !stable(before, record) || !stable(record, fs_lstat(full)?) {
            return Failure("'{text(path)?}' changed while reading")
        }
        if before[4] & 0o100 != 0 { mode = 0o100755 }
        if !config_bool(ctx, "core.filemode", true)? {
            mode = if prior.len == 1 &&
                (prior[0].stat[6] == 0o100644 || prior[0].stat[6] == 0o100755) {
                prior[0].stat[6]
            } else {
                0o100644
            }
        }
        if !config_bool(ctx, "core.symlinks", true)? &&
            prior.len == 1 &&
            prior[0].stat[6] == 0o120000 {
            mode = 0o120000
        }
    } else {
        return Unsupported("worktree file kind {named[0]} at {text(path)?}")
    }
    FileState {
        path: owned_bytes(path),
        mode: mode,
        id: object.identify("blob", data)?,
        data: data,
        stat: record,
        kind: named[0],
        dirt: 0,
    }
}

/// read_file's checks for a regular file, hashing the body as it streams
/// instead of keeping it: status needs the blob id, never the bytes. Size,
/// identity and times must agree before, during and after the read.
fn hash_file(
    ctx: Context,
    path: List[byte],
    prior: List[index.Entry],
    filemode: bool,
    symlinks: bool,
    text_check: bool,
) -> FileState ! WorkErrors {
    safe_parents(ctx, path, false)?
    let full = absolute(ctx, path)?
    let named = fs_lstat(full)?
    if named[0] != 0 { return read_file(ctx, path, prior)? }
    var file = fs.File { fd: fs_open_mode(full, 21)? }
    defer fs.close(take file) else |_| {}
    let before = fs_fstat_record(file.fd)?
    if !stable(named, before) { return Failure("'{text(path)?}' changed while opening") }
    if before[1] < 0 { return invalid }
    var digest = hash.new1()
    hash.update1(mut digest, "blob {before[1]}\0".bytes())
    var total = 0, grew = false
    var content = text_content()
    loop {
        region chunk {
            let part = fs_read_chunk(file.fd, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > before[1] - total { grew = true; break }
            total += part.len
            if text_check { text_content_add(mut content, part) }
            hash.update1(mut digest, part)
        }
    }
    let record = fs_fstat_record(file.fd)?
    if grew || total != before[1] || !stable(before, record) || !stable(record, fs_lstat(full)?) {
        return Failure("'{text(path)?}' changed while reading")
    }
    if content.crlf { check_crlf(ctx, path, text_content_binary(content))? }
    let id = oid.from_bytes("sha1", hash.final1(take digest)) else |_| { return invalid }
    FileState {
        path: owned_bytes(path),
        mode: disk_mode(before, prior, filemode, symlinks),
        id: id,
        data: List[byte](),
        stat: record,
        kind: 0,
        dirt: 0,
    }
}

/// A tracked path's worktree side, as a diff against the index needs it
/// (den#101). present is false for a path that is absent or a directory now.
/// clean: its lstat is stat-clean against the entry (status's rule: all ten
/// stat words equal and not racily clean), so its id is the entry's own and
/// nothing was read. Otherwise its id is its content's, hashed as it streams
/// (hash_file; a symbolic link through read_file), with that read's stat.
pub struct Tracked { state: FileState, present: bool, clean: bool }

/// The index file's mtime, for tracked's racy rule; [-1, -1] when unknown.
pub fn index_written(ctx: Context) -> List[int] { index_time(ctx) }

/// What the tracked stat pass spends on paths (tracked_stat_counted): checks,
/// each call that checks a path's components again, and bytes, the path bytes
/// it builds or copies. An owned path or a prefix costs its length; an
/// absolute path costs the path twice (its validated text, then the joined
/// string) and the root and a slash. probes/status-phases ROOT path-work
/// prints them for a warm diff --quiet's pass.
pub struct PathWork { checks: int, bytes: int }

/// No path work yet.
pub fn path_work() -> PathWork { PathWork { checks: 0, bytes: 0 } }

/// Each ancestor of path checked as safe_parents checks it, once per distinct
/// ancestor across a sorted walk: verified holds the ancestors checked for
/// the previous path, outermost first. path came from a parsed index, whose
/// read has checked its components (index.parse), so they are not checked
/// again; only the components past the deepest verified ancestor it lies
/// under are looked at (in a sorted walk, usually the last).
fn parents_verified(
    ctx: Context,
    path: List[byte],
    mut verified: List[List[byte]],
    mut work: PathWork,
) -> () ! WorkErrors {
    var depth = verified.len
    while depth > 0 && !beneath(path, verified[depth - 1]) { depth -= 1 }
    while verified.len > depth {
        let _ = (mut verified).pop() else |_| { return invalid }
    }
    let from = if depth == 0 then 0 else verified[depth - 1].len + 1
    for i in from..path.len {
        if path[i] != 47 as byte { continue }
        work.bytes += i
        let prefix = path[0..i]
        work.bytes += ctx.root.len + 1 + 2 * i
        let info = fs_lstat(absolute(ctx, prefix)?) else |e| match e {
            not_found => { return not_found },
            denied => { return denied },
            io => { return io },
        }
        if info[0] == 3 { return Fatal("'{text(path)?}' is beyond a symbolic link") }
        if info[0] != 1 { return not_found }
        (mut verified).push(prefix)
    }
}

/// Whether path lies under directory: directory's bytes, then a slash.
fn beneath(path: List[byte], directory: List[byte]) -> bool {
    if path.len <= directory.len || path[directory.len] != 47 as byte { return false }
    for i in 0..directory.len { if path[i] != directory[i] { return false } }
    true
}

/// An entry's worktree side unread: its path and the entry's id, no stat.
fn unread(entry: index.Entry, mut work: PathWork) -> FileState {
    work.bytes += entry.path.len
    FileState {
        path: copy entry.path,
        mode: 0,
        id: copy entry.id,
        data: List[byte](),
        stat: List[int](),
        kind: -1,
        dirt: 0,
    }
}

/// entry's worktree side (Tracked) from its lstat alone. An absent path or a
/// directory is not present. A regular file or symbolic link whose lstat
/// matches the entry is clean and unread, whatever its attributes say, as Git
/// takes it; anything else is present and not clean, its state unread, for
/// tracked_read. Its ancestors are checked as read_file checks them, each
/// once across a sorted walk (verified). entry comes from a parsed index, so
/// its path's components are not checked again.
pub fn tracked_stat(
    ctx: Context,
    entry: index.Entry,
    written: List[int],
    filemode: bool,
    symlinks: bool,
    mut verified: List[List[byte]],
) -> Tracked ! WorkErrors {
    var work = path_work()
    tracked_stat_counted(ctx, entry, written, filemode, symlinks, mut verified, mut work)?
}

/// tracked_stat, adding to work what it spends on paths.
pub fn tracked_stat_counted(
    ctx: Context,
    entry: index.Entry,
    written: List[int],
    filemode: bool,
    symlinks: bool,
    mut verified: List[List[byte]],
    mut work: PathWork,
) -> Tracked ! WorkErrors {
    work.bytes += ctx.root.len + 1 + 2 * entry.path.len
    let full = absolute(ctx, entry.path)?
    let info = fs_lstat(full) else |e| match e {
        not_found => {
            return Tracked { state: unread(entry, mut work), present: false, clean: false }
        },
        _ => { return io },
    }
    if info[0] == 1 {
        return Tracked { state: unread(entry, mut work), present: false, clean: false }
    }
    parents_verified(ctx, entry.path, mut verified, mut work)?
    if info[0] == 0 || link_judged(info, entry.stat[6], symlinks) {
        let kind = info[0]
        let mode = if kind == 3 {
            0o120000
        } else {
            entry_disk_mode(info, entry.stat[6], filemode, symlinks)
        }
        if stat_clean(entry, info, mode, written) {
            work.bytes += entry.path.len
            return Tracked {
                state: FileState {
                    path: copy entry.path,
                    mode: mode,
                    id: copy entry.id,
                    data: List[byte](),
                    stat: info,
                    kind: kind,
                    dirt: 0,
                },
                present: true,
                clean: true,
            }
        }
    }
    Tracked { state: unread(entry, mut work), present: true, clean: false }
}

/// A present entry tracked_stat did not find clean, read and hashed with
/// read_file's errors, and with its CR-LF guard when text_check (a text rule
/// may apply), as the status walk hashes it.
pub fn tracked_read(
    ctx: Context,
    entry: index.Entry,
    filemode: bool,
    symlinks: bool,
    text_check: bool,
) -> Tracked ! WorkErrors {
    let state = hash_file(ctx, entry.path, [copy entry], filemode, symlinks, text_check)?
    Tracked { state: state, present: true, clean: false }
}

/// head_flat for a caller outside status: value must be the index read_index
/// parsed, as status passes it (den#101: diff --cached).
pub fn head_tree(
    ctx: Context,
    value: index.Index,
    commit: oid.Oid,
) -> List[FlatEntry] ! WorkErrors {
    var copied = false
    head_flat(ctx, value, commit, mut copied)?
}

/// HEAD's flattened tree for status (value straight from read_index). When the index's valid cache-tree root
/// names HEAD's own tree, HEAD holds exactly the index's entries, so no tree
/// object is read; otherwise the full walk. copied says which: true when the
/// answer is the index's entries, copied in order.
fn head_flat(
    ctx: Context,
    value: index.Index,
    commit: oid.Oid,
    mut copied: bool,
) -> List[FlatEntry] ! WorkErrors {
    // status passes the index read_index just parsed and validated.
    let root = index.parsed_root(value)?
    if root.len == 1 && oid.equal(root[0], tree_id(ctx.repo, commit)?) {
        copied = true
        var out = List[FlatEntry]()
        (mut out).reserve(value.entries.len)
        for entry in value.entries {
            // The entry's own copies move into the list: a plain push would copy them again.
            let flat = FlatEntry { path: copy entry.path, mode: entry.stat[6], id: copy entry.id }
            (mut out).push(take flat)
        }
        return out
    }
    flatten_tree(ctx.repo, commit)?
}

struct Walk {
    files: List[FileState],
    directories: List[List[byte]],
    lookups: Lookups,
    sorted: Lookups,
}

// Attribute presence follows the traversal stack. An ordinary directory with
// no inherited, indexed or listed attributes needs no extra filesystem probe.
// [lo, hi) holds the index entries beneath the directory: its visits are
// looked up there alone (index_within).
struct PendingWalk { path: List[byte], attributes: bool, lo: int, hi: int }

// One path the walk visits: an entry a directory listed (`kind` its own kind
// from the listing), or a tracked path below a directory that could not be
// listed (`probe`), looked up by its own name.
struct Visit { path: List[byte], kind: int, probe: bool }

// A path strictly below `directory` that one of `paths` names.
fn selector_inside(paths: List[List[byte]], directory: List[byte]) -> bool {
    for selector in paths {
        if selector.len > directory.len && under(selector, directory) { return true }
    }
    false
}

/// The index file's own mtime (seconds, nanoseconds). An entry whose mtime is
/// at or after it is racily clean and must be content-checked, git's documented
/// racy-git rule; [-1, -1] when unknown makes every entry content-checked.
fn index_time(ctx: Context) -> List[int] {
    let record = fs_lstat("{ctx.repo.gitdir}/index") else |_| { return [-1, -1] }
    if record.len != 20 { return [-1, -1] }
    [record[14] & 4294967295, record[15] & 4294967295]
}

/// read_file's mode policy for a regular file, from the lstat permission bits.
fn disk_mode(record: List[int], prior: List[index.Entry], filemode: bool, symlinks: bool) -> int {
    entry_disk_mode(record, if prior.len == 1 then prior[0].stat[6] else -1, filemode, symlinks)
}

/// disk_mode given the stage-zero entry's mode, or -1 when there is none.
fn entry_disk_mode(record: List[int], prior: int, filemode: bool, symlinks: bool) -> int {
    var mode = if record[4] & 0o100 != 0 then 0o100755 else 0o100644
    if !filemode { mode = if prior == 0o100644 || prior == 0o100755 then prior else 0o100644 }
    if !symlinks && prior == 0o120000 { mode = 0o120000 }
    mode
}

/// Whether an lstat record is a symbolic link the stat shortcut judges: one
/// tracked as a link (mode 120000) while core.symlinks is on.
fn link_judged(record: List[int], prior: int, symlinks: bool) -> bool {
    record[0] == 3 && prior == 0o120000 && symlinks
}

/// A tracked path whose lstat matches its stage-zero entry, as the pinned Git
/// compares them, and is not racily clean is taken as the entry's blob
/// unread. Git compares the ctime and mtime by whole seconds (measured: a
/// change that moved only their nanoseconds, same inode, is not seen), the
/// inode (a change written as a new file is seen), mode and size; den compares
/// those and uid, gid and dev too. A symbolic link is judged the same way
/// (measured: Git trusts a retargeted link of the same length whose inode was
/// reused within the second). Any missing or differing word, or an unknown
/// index time, reads the content.
fn stat_clean(entry: index.Entry, record: List[int], mode: int, written: List[int]) -> bool {
    if record.len != 20 || entry.stat.len != 10 || written[0] < 0 { return false }
    let required: int = 247507
    if record[3] & required != required { return false }
    let m: int = 4294967295
    if entry.stat[6] != mode ||
        entry.stat[0] != record[16] & m ||
        entry.stat[2] != record[14] & m ||
        entry.stat[4] != record[9] & m ||
        entry.stat[5] != record[10] & m ||
        entry.stat[7] != record[6] & m ||
        entry.stat[8] != record[7] & m ||
        entry.stat[9] != record[1] & m {
        return false
    }
    // Racily clean by whole seconds, as the pinned Git judges it: an entry
    // whose mtime falls in the index file's own second is read even when its
    // nanoseconds are earlier (measured: tools/diff-racy-test.py).
    if entry.stat[2] >= written[0] { return false }
    true
}

fn walk(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    skip_ignored: bool,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    var ignores = ignore.cache()
    walk_submodules(
        ctx,
        value,
        include_untracked,
        paths,
        false,
        false,
        "",
        skip_ignored,
        false,
        mut ignores,
        mut warnings,
    )?
}

/// The walk a tree transition's safety check needs (merge, checkout, switch,
/// reset, pull, and the replay commands): tracked files are compared by
/// their index stat or hashed as they stream, never held. An untracked
/// directory with no tracked path below it is one opaque entry, never
/// entered; the transition looks up its own target paths below it by name.
/// Ignored files and directories are left out: Git overwrites them, so
/// they never block, and their bodies are never read.
fn walk_transition(ctx: Context, value: index.Index, mut warnings: List[str]) -> Walk ! WorkErrors {
    var ignores = ignore.cache()
    walk_submodules(ctx, value, true, [], false, false, "", false, true, mut ignores, mut warnings)?
}

/// status=false keeps the full snapshot every mutation consumer needs: every
/// observed file's body, read and hashed. status=true serves status only:
/// stat-clean tracked files reuse their entry id, other tracked files are
/// hashed and their bodies dropped, untracked and ignored files are never
/// read, and an ignored directory with no tracked descendant is not entered
/// unless ignored rows were asked for (git does not descend there either).
fn walk_mode(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    status: bool,
    show_ignored: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    walk_submodules(
        ctx,
        value,
        include_untracked,
        paths,
        status,
        show_ignored,
        "",
        false,
        false,
        mut ignores,
        mut warnings,
    )?
}

// walk_mode with --ignore-submodules' value (empty when not given). A gitlink
// directory becomes one entry holding its submodule's HEAD and dirt, never
// descended (vc25); .gitmodules is read once, at the first gitlink met.
// skip_ignored: a full walk (add) leaves an ignored directory with no tracked
// path below it unopened, as status does and as Git does.
//
// den#80, as measured on the pinned Git: a directory that cannot be listed is
// `warning: could not open directory 'DIR/': Permission denied` when untracked
// files are looked for, and the walk goes on as if it were empty; the tracked
// paths below it are looked up by name. One whose lookup is denied is, for
// status, `PATH: Permission denied`, printed before the walk's warnings, and
// unchanged; a full walk refuses it by name. An entry a directory lists but
// that cannot be looked up is, for status, an untracked path of the kind the
// listing gave; for a full walk, `fatal: unable to stat 'PATH': Permission
// denied`.
fn walk_submodules(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    status: bool,
    show_ignored: bool,
    ignore_option: str,
    skip_ignored: bool,
    transition: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    let mark = warnings.len
    var notices = List[str]()
    // A diagnostic built in a scratch region below is copied out of it (raised:
    // 1 Unsupported, 2 Pathspec, 3 Fatal, 4 Failure) and raised once the region
    // is freed.
    var error_payload = "", raised = 0
    // One identity resolver for the walk, created only in a directory whose
    // attribute sources hold identity-breaking metadata.
    var identity_caches = List[AttributeCache]()
    for entry in value.entries {
        if entry.stat.len != 10 { return invalid_index }
    }
    var parsed = List[gitmodules.Parsed]()
    // status and transition walks hash or stat-compare; neither holds a body.
    let hashing = status || transition
    let written = if hashing then index_time(ctx) else [-1, -1]
    // Read once per hashing walk; the full walk keeps read_file's own reads.
    let filemode = if hashing then config_bool(ctx, "core.filemode", true)? else true
    let symlinks = if hashing then config_bool(ctx, "core.symlinks", true)? else true
    let empty = object.identify("blob", List[byte]())?
    var total_bytes: int = 0
    var pending = [
        PendingWalk {
            path: List[byte](),
            attributes: fs.exists("{ctx.repo.gitdir}/info/attributes"),
            lo: 0,
            hi: value.entries.len,
        },
    ]
    var files = List[FileState]()
    // A worktree mostly holds what its index lists: one buffer for the files.
    (mut files).reserve(value.entries.len)
    // Each file's sort key, from the index position its lookup found: twice
    // the position of a tracked path, plus one; twice the position an
    // untracked path would take. The keys order the files as their paths do,
    // but for untracked paths at one position (key_order).
    var keys = List[int]()
    (mut keys).reserve(value.entries.len)
    var directories = List[List[byte]]()
    // The visits' index lookups, counted (Snapshot.walk_lookups).
    var lookups = no_lookups()
    while pending.len > 0 {
        let todo = (mut pending).pop() else |_| { return invalid }
        let parent = copy todo.path
        // Every path beneath parent starts with parent and its slash.
        let skip = if parent.len > 0 then parent.len + 1 else 0
        var attributes_seen = todo.attributes
        var attribute_path = copy parent
        if attribute_path.len > 0 { (mut attribute_path).push(47 as byte) }
        bytes_add(mut attribute_path, ".gitattributes".bytes())
        if index_at(value.entries, attribute_path) >= 0 { attributes_seen = true }
        var listed = true
        // The listing's own rows live in a region; only the visits are kept.
        var visits = copy region {
            let items = fs.entries(absolute(ctx, parent)?) else |e| match e {
                denied => {
                    if parent.len == 0 { return denied }
                    listed = false
                    List[fs.Entry]()
                },
                not_found => { return not_found },
                io => { return io },
            }
            var listing = List[Visit]()
            (mut listing).reserve(items.len)
            for item in items {
                if attribute_basename(item.name) { attributes_seen = true }
                if compare(item.name, ".git".bytes()) == 0 { continue }
                var path = List[byte]()
                (mut path).reserve(parent.len + 1 + item.name.len)
                bytes_add(mut path, parent)
                if path.len > 0 { (mut path).push(47 as byte) }
                bytes_add(mut path, item.name)
                let visit = Visit { path: path, kind: item.kind, probe: false }
                (mut listing).push(take visit)
            }
            listing
        }
        if !listed {
            if include_untracked {
                (mut warnings).push(
                    "warning: could not open directory '{text(parent)?}/': Permission denied",
                )
            }
            for entry in value.entries {
                if index.stage(entry) != 0 ||
                    entry.path.len <= parent.len ||
                    !under(entry.path, parent) {
                    continue
                }
                (mut visits).push(Visit { path: copy entry.path, kind: -1, probe: true })
            }
        }
        let attribute_modes = if listed && attributes_seen {
            attributes_directory_modes(ctx, parent, value)?
        } else {
            [false, false]
        }
        let text_check = attribute_modes[0]
        let identity_check = attribute_modes[1]
        // Subdirectories are entered depth first in the order the host lists
        // them, as Git enters them, so the warnings come in Git's order.
        var deeper = List[List[byte]]()
        var at_visit = 0
        while at_visit < visits.len {
            // Each visit's path moves out of this directory's listing (a
            // binding moves), and an empty path takes its place, so the
            // element is whole again before the next one moves. The listing
            // is dropped with the directory: no second copy of a path is made.
            let visit_kind = visits[at_visit].kind
            let visit_probe = visits[at_visit].probe
            let path = visits[at_visit].path
            visits[at_visit].path = List[byte]()
            at_visit += 1
            // A selected leaf may need its ancestors traversed, but unrelated
            // paths must not be opened incidentally by add <tracked> or -u.
            var relevant = selected(path, paths)
            if !relevant {
                for selector in paths { if under(selector, path) { relevant = true; break } }
            }
            if !relevant { continue }
            if !include_untracked {
                var tracked = false
                if paths.len == 0 {
                    tracked = tracked_under(value.entries, path)
                } else {
                    for entry in value.entries {
                        if under(entry.path, path) && selected(entry.path, paths) {
                            tracked = true
                            break
                        }
                    }
                }
                if !tracked { continue }
            }
            var looked = true, gone = false
            var kind = -1, wanted = false, at = -1, file_lower = 0
            var staged = -1, mode = 0, clean = false, submodule = false
            // The lstat record stays in the region its call and the absolute
            // path were made in. A file's index lookup, mode and stat check
            // are made there, and the record is copied out only where the
            // walk keeps it: a directory's, and for status a tracked file it
            // reads (its refresh writes the record); full walks keep every
            // file's.
            let info = copy region {
                let record = fs_lstat(absolute(ctx, path)?) else |e| match e {
                    not_found => {
                        gone = true
                        List[int]()
                    },
                    denied => {
                        looked = false
                        List[int]()
                    },
                    io => { return io },
                }
                if gone || !looked {
                    List[int]()
                } else if (record[0] == 0 || record[0] == 3) && selected(path, paths) {
                    kind = record[0]
                    wanted = true
                    at = index_lower_within(
                        value.entries,
                        path,
                        todo.lo,
                        todo.hi,
                        skip,
                        mut file_lower,
                        mut lookups,
                    )
                    if at >= 0 {
                        // A gitlink is refused after the region: an error
                        // value built in it could not outlive it.
                        if value.entries[at].stat[6] == 0o160000 {
                            submodule = true
                        } else if index.stage(value.entries[at]) == 0 {
                            staged = at
                        }
                    }
                    let prior_mode = if staged >= 0 then value.entries[staged].stat[6] else -1
                    mode = if kind == 0 {
                        entry_disk_mode(record, prior_mode, filemode, symlinks)
                    } else {
                        0o120000
                    }
                    // A tracked file whose stat data matches its entry is
                    // taken as the entry's blob unread.
                    clean = hashing &&
                        staged >= 0 &&
                        (kind == 0 || link_judged(record, prior_mode, symlinks)) &&
                        stat_clean(value.entries[staged], record, mode, written)
                    if status && (clean || staged < 0) then List[int]() else record
                } else {
                    kind = record[0]
                    record
                }
            }
            if gone { continue }
            if !looked {
                var tracked_lower = 0
                let tracked_at = index_lower_within(
                    value.entries,
                    path,
                    todo.lo,
                    todo.hi,
                    skip,
                    mut tracked_lower,
                    mut lookups,
                )
                if tracked_at >= 0 && index.stage(value.entries[tracked_at]) == 0 {
                    if !status {
                        return Unsupported("worktree tracked path {text(path)?}: Permission denied")
                    }
                    if !selected(path, paths) { continue }
                    (mut notices).push("{text(path)?}: Permission denied")
                    if files.len >= 1000000 {
                        return Fatal("limit: more than 1000000 paths in the work tree scan")
                    }
                    (mut keys).push(2 * tracked_at + 1)
                    (mut files).push(FileState {
                        path: owned_bytes(path),
                        mode: value.entries[tracked_at].stat[6],
                        id: copy value.entries[tracked_at].id,
                        data: List[byte](),
                        stat: List[int](),
                        kind: -1,
                        dirt: 0,
                    })
                    continue
                }
                if visit_probe || tracked_at >= 0 { continue }
                if !status {
                    // Git reads the directory's ignore file before the entry.
                    if include_untracked {
                        let _ = ignore.query_cached(
                            ctx.repo,
                            ctx.root,
                            mut ignores,
                            text(path)?,
                            false,
                            mut warnings,
                        )?
                    }
                    return Fatal("unable to stat '{text(path)?}': Permission denied")
                }
                if visit_kind == 1 {
                    if include_untracked && !show_ignored && !tracked_under(value.entries, path) {
                        let decision = ignore.query_cached(
                            ctx.repo,
                            ctx.root,
                            mut ignores,
                            text(path)?,
                            true,
                            mut warnings,
                        )?
                        if decision.ignored { continue }
                    }
                    if directories.len >= 1000000 {
                        return Fatal("limit: more than 1000000 directories in the work tree scan")
                    }
                    (mut directories).push(copy path)
                    (mut deeper).push(path)
                    continue
                }
                if visit_kind != 0 && visit_kind != 3 || !selected(path, paths) { continue }
                if files.len >= 1000000 {
                    return Fatal("limit: more than 1000000 paths in the work tree scan")
                }
                (mut keys).push(2 * tracked_lower)
                (mut files).push(FileState {
                    path: owned_bytes(path),
                    mode: if visit_kind == 3 then 0o120000 else 0o100644,
                    id: copy empty,
                    data: List[byte](),
                    stat: List[int](),
                    kind: visit_kind,
                    dirt: 0,
                })
                continue
            }
            // A tracked path looked up by name is a file or nothing.
            if visit_probe && kind == 1 && gitlink_at(value, path) < 0 { continue }
            if kind == 1 && gitlink_at(value, path) >= 0 {
                if !selected(path, paths) { continue }
                let at = gitlink_at(value, path)
                if parsed.len == 0 { (mut parsed).push(modules(ctx)?) }
                let name = text(path)?
                // A full walk (add, commit) stages only the HEAD; commit's
                // status shows modified content but never untracked content,
                // as Git's does (vc25 work rows).
                let configured = ignore_for(ctx, parsed[0], name, ignore_option)
                let setting = if status || configured != "" then configured else "untracked"
                let state = if setting == "all" {
                    unpopulated(value.entries[at].id)
                } else {
                    submodule_state(ctx, name, value.entries[at].id, setting)?
                }
                var dirt = 0
                if state.modified { dirt = 1 }
                if state.untracked { dirt = dirt | 2 }
                if files.len >= 1000000 {
                    return Fatal("limit: more than 1000000 paths in the work tree scan")
                }
                (mut keys).push(2 * at + 1)
                (mut files).push(FileState {
                    path: owned_bytes(path),
                    mode: 0o160000,
                    id: copy state.head,
                    data: List[byte](),
                    stat: copy info,
                    kind: 1,
                    dirt: dirt,
                })
                continue
            }
            if kind == 1 && transition && !tracked_under(value.entries, path) {
                let decision = ignore.query_cached(
                    ctx.repo,
                    ctx.root,
                    mut ignores,
                    text(path)?,
                    true,
                    mut warnings,
                )?
                if decision.ignored { continue }
                // Opaque, as an embedded repository already is: no inner
                // path is listed, read or counted.
                if files.len >= 1000000 {
                    return Fatal("limit: more than 1000000 paths in the work tree scan")
                }
                (mut keys).push(
                    2 * lower_within(value.entries, path, todo.lo, todo.hi, skip, mut lookups),
                )
                (mut files).push(FileState {
                    path: copy path,
                    mode: 0,
                    id: copy empty,
                    data: [],
                    stat: copy info,
                    kind: 1,
                    dirt: 0,
                })
                continue
            }
            if kind == 1 {
                if (status || skip_ignored && !selector_inside(paths, path)) &&
                    include_untracked &&
                    !show_ignored &&
                    !tracked_under(value.entries, path) {
                    let decision = ignore.query_cached(
                        ctx.repo,
                        ctx.root,
                        mut ignores,
                        text(path)?,
                        true,
                        mut warnings,
                    )?
                    if decision.ignored { continue }
                }
                if directories.len >= 1000000 {
                    return Fatal("limit: more than 1000000 directories in the work tree scan")
                }
                (mut directories).push(copy path)
                // An untracked repository is one opaque directory, including
                // under -uall. Keep its plain path here for add/path selection;
                // only status appends '/'. No inner HEAD or file is read.
                if !tracked_under(value.entries, path) &&
                    repository.embedded(absolute(ctx, path)?)? {
                    if files.len >= 1000000 {
                        return Fatal("limit: more than 1000000 paths in the work tree scan")
                    }
                    (mut keys).push(
                        2 * lower_within(value.entries, path, todo.lo, todo.hi, skip, mut lookups),
                    )
                    (mut files).push(FileState {
                        path: copy path,
                        mode: 0,
                        id: copy empty,
                        data: [],
                        stat: copy info,
                        kind: 1,
                        dirt: 0,
                    })
                    continue
                }
                (mut deeper).push(path)
            } else if kind == 0 || kind == 3 {
                if !wanted { continue }
                if submodule { return Unsupported("submodule worktree") }
                var file = FileState {
                    // The visit's path is this walk's own: it moves into the file.
                    path: path,
                    mode: mode,
                    id: if clean then copy value.entries[staged].id else copy empty,
                    data: List[byte](),
                    // status renders paths and modes only, and keeps the record
                    // only of a tracked file it reads (its refresh writes it);
                    // full walks keep every record: info is empty otherwise.
                    stat: info,
                    kind: kind,
                    dirt: 0,
                }
                if transition && at < 0 {
                    // Untracked: its lstat alone; never read, and its id is a
                    // placeholder no transition trusts. Ignored: left out.
                    let decision = ignore.query_cached(
                        ctx.repo,
                        ctx.root,
                        mut ignores,
                        text(file.path)?,
                        false,
                        mut warnings,
                    )?
                    if decision.ignored { continue }
                } else if status && kind == 0 && at < 0 {
                    // Untracked or ignored: status renders the path alone.
                } else if clean {
                    // A stat-clean entry is its blob, unread whatever its
                    // attributes say, as Git takes it: its id is given above.
                } else if hashing {
                    if identity_check && kind == 0 {
                        check_path_identity(ctx, file.path, value, mut identity_caches)?
                    }
                    // Each read's scratch lives in its own region and only
                    // its FileState is kept, so a walk that reads every
                    // tracked file (racily clean by whole seconds) holds no
                    // more than one that trusts their stat data (den#101).
                    region one {
                        var prior = List[index.Entry]()
                        if staged >= 0 { (mut prior).push(copy value.entries[staged]) }
                        let hashed = hash_file(
                            ctx,
                            file.path,
                            prior,
                            filemode,
                            symlinks,
                            text_check,
                        ) else |e| match e {
                            invalid_index => { return invalid_index },
                            unmerged => { return unmerged },
                            invalid_tree => { return invalid_tree },
                            duplicate_name => { return duplicate_name },
                            invalid => { return invalid },
                            invalid_oid => { return invalid_oid },
                            unsupported_format => { return unsupported_format },
                            bad_header => { return bad_header },
                            bad_size => { return bad_size },
                            bad_oid => { return bad_oid },
                            truncated => { return truncated },
                            dictionary => { return dictionary },
                            checksum => { return checksum },
                            limit => { return limit },
                            trailing => { return trailing },
                            unsupported_level => { return unsupported_level },
                            not_found => { return not_found },
                            denied => { return denied },
                            io => { return io },
                            exists => { return exists },
                            unsupported => { return unsupported },
                            Unsupported(message) => {
                                error_payload = copy message
                                raised = 1
                                break
                            },
                            ambiguous => { return ambiguous },
                            cross_device => { return cross_device },
                            invalid_header => { return invalid_header },
                            utf8 => { return utf8 },
                            Pathspec(message) => {
                                error_payload = copy message
                                raised = 2
                                break
                            },
                            Fatal(message) => {
                                error_payload = copy message
                                raised = 3
                                break
                            },
                            Failure(message) => {
                                error_payload = copy message
                                raised = 4
                                break
                            },
                        }
                        file = copy hashed
                    }
                } else {
                    var prior = List[index.Entry]()
                    if staged >= 0 { (mut prior).push(copy value.entries[staged]) }
                    if identity_check && kind == 0 {
                        check_path_identity(ctx, file.path, value, mut identity_caches)?
                    }
                    file = read_file(ctx, file.path, prior)?
                }
                if (text_check || identity_check) &&
                    !hashing &&
                    (file.mode == 0o100644 || file.mode == 0o100755) {
                    check_text_content(ctx, file.path, file.data)?
                }
                if file.data.len > 1000000000 - total_bytes {
                    return Fatal(
                        "limit: more than 1000000000 bytes of file content in the work tree scan",
                    )
                }
                if files.len >= 1000000 {
                    return Fatal("limit: more than 1000000 paths in the work tree scan")
                }
                total_bytes += file.data.len
                (mut keys).push(if at >= 0 then 2 * at + 1 else 2 * file_lower)
                // The file moves into the list: a plain push would copy its four lists.
                (mut files).push(take file)
            } else if index_within(value.entries, path, todo.lo, todo.hi, skip, mut lookups) >= 0 {
                return Unsupported("tracked worktree file kind {kind} at {text(path)?}")
            }
        }
        if raised == 1 { return Unsupported(error_payload) }
        if raised == 2 { return Pathspec(error_payload) }
        if raised == 3 { return Fatal(error_payload) }
        if raised == 4 { return Failure(error_payload) }
        while deeper.len > 0 {
            let next = (mut deeper).pop() else |_| { return invalid }
            let range = range_beneath(value.entries, next, todo.lo, todo.hi, skip, mut lookups)
            (mut pending).push(PendingWalk {
                path: next,
                attributes: attributes_seen,
                lo: range[0],
                hi: range[1],
            })
        }
    }
    // Git refreshes the tracked paths before it looks for untracked ones:
    // their notices come before the walk's own warnings.
    if notices.len > 0 {
        var later = List[str]()
        while warnings.len > mark {
            let last = (mut warnings).pop() else |_| { return invalid }
            (mut later).push(last)
        }
        for notice in notices { (mut warnings).push(notice) }
        while later.len > 0 {
            let next = (mut later).pop() else |_| { return invalid }
            (mut warnings).push(next)
        }
    }
    // The files move into path order by their keys; only untracked paths that
    // share a key are compared.
    var sorted_counts = no_lookups()
    let order = key_order(keys, files, mut sorted_counts)
    var sorted = List[FileState]()
    (mut sorted).reserve(files.len)
    for i in order {
        (mut sorted).push(take files[i])
        files[i] = FileState {
            path: List[byte](),
            mode: 0,
            id: oid.Oid { algorithm: "", bytes: List[byte]() },
            data: List[byte](),
            stat: List[int](),
            kind: 0,
            dirt: 0,
        }
    }
    Walk { files: sorted, directories: directories, lookups: lookups, sorted: sorted_counts }
}

/// Positions of files in path order, from keys that order them but for ties
/// (see walk_submodules' keys): a stable merge sort of the keys, a tie decided
/// by the two paths. The files and the path compares are added to counts.
fn key_order(keys: List[int], files: List[FileState], mut counts: Lookups) -> List[int] {
    counts.calls += files.len
    var order = List[int]()
    for i in 0..files.len { (mut order).push(i) }
    var scratch = copy order
    var width = 1
    while width < order.len {
        var lo = 0
        while lo < order.len {
            let mid = if lo + width < order.len then lo + width else order.len
            let hi = if lo + 2 * width < order.len then lo + 2 * width else order.len
            var i = lo, j = mid, k = lo
            while i < mid && j < hi {
                if key_below(keys, files, order[j], order[i], mut counts) {
                    scratch[k] = order[j]
                    j += 1
                } else {
                    scratch[k] = order[i]
                    i += 1
                }
                k += 1
            }
            while i < mid {
                scratch[k] = order[i]
                i += 1
                k += 1
            }
            while j < hi {
                scratch[k] = order[j]
                j += 1
                k += 1
            }
            lo = hi
        }
        order = copy scratch
        width *= 2
    }
    order
}

/// Whether file a orders below file b: by key, a tie by path (counted).
fn key_below(keys: List[int], files: List[FileState], a: int, b: int, mut counts: Lookups) -> bool {
    if keys[a] != keys[b] { return keys[a] < keys[b] }
    compare_counted(files[a].path, files[b].path, mut counts) < 0
}

fn status_row(path: List[byte], x: str, y: str) -> StatusRow {
    StatusRow {
        path: owned_bytes(path),
        original_path: [],
        x: x,
        y: y,
        ignored: false,
        untracked: false,
        sub: 0,
    }
}

fn change(old_mode: int, old: oid.Oid, mode: int, id: oid.Oid) -> str {
    if old_mode / 4096 != mode / 4096 { return "T" }
    if old_mode != mode || !oid.equal(old, id) { return "M" }
    " "
}

fn unmerged_code(bits: int) -> (str, str) {
    match bits {
        2 => ("D", "D"),
        4 => ("A", "U"),
        6 => ("U", "D"),
        8 => ("U", "A"),
        10 => ("D", "U"),
        12 => ("A", "A"),
        _ => ("U", "U"),
    }
}

/// Compare three owned snapshots without filesystem writes. Unmerged entries,
/// ITA, assume-valid and skip-worktree are represented explicitly.
pub fn compare_status(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
) -> List[StatusRow] ! WorkErrors {
    var warnings = List[str]()
    compare_status_with_warnings(ctx, value, tree, files, true, mut warnings)?
}

/// Compare snapshots while collecting operation-wide ignore diagnostics. False
/// include_untracked bypasses all ignore-source queries, not just their output,
/// and returns tracked rows only. Existing warnings are retained on every exit.
pub fn compare_status_with_warnings(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
    include_untracked: bool,
    mut warnings: List[str],
) -> List[StatusRow] ! WorkErrors {
    let _ = index.serialize(value)?
    var ignores = ignore.cache()
    var counts = no_lookups()
    var merged = no_lookups()
    status_rows(
        ctx,
        value,
        tree,
        files,
        include_untracked,
        mut ignores,
        mut warnings,
        mut counts,
        mut merged,
        false,
    )?
}

/// The position of path's file at or after the cursor fi, or -1. The rows'
/// merge asks in increasing path order, so files below path are passed, the
/// last compare says whether the cursor's file is path, and a match is passed
/// too; compares are counted.
fn file_at_cursor(
    files: List[FileState],
    path: List[byte],
    mut fi: int,
    mut merged: Lookups,
) -> int {
    var order = 1
    while fi < files.len {
        order = compare_counted(files[fi].path, path, mut merged)
        if order >= 0 { break }
        fi += 1
    }
    if fi < files.len && order == 0 {
        fi += 1
        return fi - 1
    }
    -1
}

/// compare_status_with_warnings without its validation pass, for an index
/// that index.parse has just validated (the same entry, extension and
/// cache-span checks serialize repeats).
fn status_rows(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
    include_untracked: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
    mut counts: Lookups,
    mut merged: Lookups,
    same: bool,
) -> List[StatusRow] ! WorkErrors {
    // HEAD's entries and the index's are merged where they lie, both in path
    // order; a path is copied only into a row. The file cursor finds each
    // path's file as file_at did. merged counts the steps, path compares and
    // change checks.
    var rows = List[StatusRow]()
    var ti = 0, ni = 0, fi = 0
    while ti < tree.len || ni < value.entries.len {
        merged.calls += 1
        // The next path is the smaller of the two cursors' (on a tie, both).
        var old = -1, staged = -1
        if ni >= value.entries.len {
            old = ti
        } else if ti >= tree.len {
            staged = ni
        } else if same && ti == ni {
            // same: tree is the index's entries, copied in order (head_flat),
            // so one position holds one path on both sides.
            old = ti
            staged = ni
        } else {
            let order = compare_counted(tree[ti].path, value.entries[ni].path, mut merged)
            if order <= 0 { old = ti }
            if order >= 0 { staged = ni }
        }
        // An unmerged path's stages follow one another: staged..next.
        var next = ni
        if staged >= 0 {
            next = ni + 1
            // index.parse refuses a stage-0 path beside any other entry for it:
            // only a conflict's stages can follow.
            if index.stage(value.entries[ni]) != 0 {
                while next < value.entries.len &&
                    compare_counted(value.entries[next].path, value.entries[ni].path, mut merged) ==
                        0 {
                    next += 1
                }
            }
        }
        if old >= 0 { ti = old + 1 }
        ni = next
        let disk = if staged >= 0 {
            file_at_cursor(files, value.entries[staged].path, mut fi, mut merged)
        } else {
            file_at_cursor(files, tree[old].path, mut fi, mut merged)
        }
        if staged < 0 { (mut rows).push(status_row(tree[old].path, "D", " ")); continue }
        if index.stage(value.entries[staged]) != 0 {
            var bits = 0
            for k in staged..next { bits = bits | 1 << index.stage(value.entries[k]) }
            let (x, y) = unmerged_code(bits)
            (mut rows).push(status_row(value.entries[staged].path, x, y))
            continue
        }
        let mode = value.entries[staged].stat[6]
        let intent = value.entries[staged].extended & 0x2000 != 0
        let x = if intent {
            " "
        } else if old < 0 {
            "A"
        } else if same && old == staged {
            // HEAD's entry is this entry's copy: no staged change.
            " "
        } else {
            merged.compares += 1
            change(tree[old].mode, tree[old].id, mode, value.entries[staged].id)
        }
        var y = " "
        var sub = 0
        if value.entries[staged].flags & 0x8000 == 0 &&
            value.entries[staged].extended & 0x4000 == 0 {
            y = if disk < 0 {
                "D"
            } else if intent {
                "A"
            } else {
                merged.compares += 1
                change(mode, value.entries[staged].id, files[disk].mode, files[disk].id)
            }
            if disk >= 0 && mode == 0o160000 && files[disk].mode == 0o160000 {
                if y == "M" { sub = 1 }
                if files[disk].dirt & 1 != 0 { sub = sub | 2 }
                if files[disk].dirt & 2 != 0 { sub = sub | 4 }
                if sub != 0 { y = "M" }
            }
        }
        if x != " " || y != " " {
            var row = status_row(value.entries[staged].path, x, y)
            row.sub = sub
            (mut rows).push(take row)
        }
    }
    // The files come in path order: each lookup starts where the last landed.
    var hint = 0
    for file in files {
        if !include_untracked { break }
        if index_after(value.entries, file.path, mut hint, mut counts) >= 0 { continue }
        let decision = ignore.query_cached(
            ctx.repo,
            ctx.root,
            mut ignores,
            text(file.path)?,
            file.kind == 1,
            mut warnings,
        )?
        var path = copy file.path
        if file.kind == 1 { (mut path).push(47 as byte) }
        var row = status_row(
            path,
            if decision.ignored then "!" else "?",
            if decision.ignored then "!" else "?",
        )
        row.ignored = decision.ignored
        row.untracked = !decision.ignored
        (mut rows).push(take row)
    }
    // Stable unsigned path order, independent of directory enumeration order.
    var names = List[List[byte]]()
    for row in rows {
        let name = copy row.path
        (mut names).push(take name)
    }
    var sorted = List[StatusRow]()
    for i in path_order(names) { (mut sorted).push(copy rows[i]) }
    sorted
}

/// Scan against a caller's already-locked index snapshot. This function itself
/// remains read-only. Its files are walk_transition's: tracked ids without
/// bodies, untracked paths by lstat (an untracked directory as one opaque
/// entry), ignored paths absent. Every caller compares ids, modes and stat
/// words only; commit and stash, which store bodies, use
/// scan_index_with_warnings.
pub fn scan_index(ctx: Context, value: index.Index) -> Snapshot ! WorkErrors {
    var warnings = List[str]()
    let _ = index.serialize(value)?
    let current_head = head(ctx)?
    var entries = List[FlatEntry]()
    var copied = false
    if current_head.commits.len == 1 {
        entries = head_flat(ctx, value, current_head.commits[0], mut copied)?
    }
    ensure_filters(ctx)?
    let walked = walk_transition(ctx, value, mut warnings)?
    supported_attributes(ctx, walked.files)?
    let rows = compare_status_with_warnings(ctx, value, entries, walked.files, true, mut warnings)?
    Snapshot {
        context: copy ctx,
        head: current_head,
        index: copy value,
        head_entries: entries,
        files: walked.files,
        directories: walked.directories,
        rows: rows,
        walk_lookups: no_lookups(),
        row_lookups: no_lookups(),
        merge_counts: no_lookups(),
        sort_counts: no_lookups(),
    }
}

/// Read-only scan with explicit warning collection. include_untracked=false
/// skips ignore queries, untracked/ignored rows and untracked file-body reads.
/// files then contains observed tracked files only. Existing scan_index keeps
/// the full silent snapshot. Never prints or clears caller diagnostics.
pub fn scan_index_with_warnings(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    let _ = index.serialize(value)?
    let current_head = head(ctx)?
    var entries = List[FlatEntry]()
    if current_head.commits.len == 1 { entries = flatten_tree(ctx.repo, current_head.commits[0])? }
    ensure_filters(ctx)?
    let walked = walk(ctx, value, include_untracked, [], false, mut warnings)?
    supported_attributes(ctx, walked.files)?
    let rows = compare_status_with_warnings(
        ctx,
        value,
        entries,
        walked.files,
        include_untracked,
        mut warnings,
    )?
    Snapshot {
        context: copy ctx,
        head: current_head,
        index: copy value,
        head_entries: entries,
        files: walked.files,
        directories: walked.directories,
        rows: rows,
        walk_lookups: no_lookups(),
        row_lookups: no_lookups(),
        merge_counts: no_lookups(),
        sort_counts: no_lookups(),
    }
}

/// scan_index_with_warnings' snapshot without the bodies its walk read, for a
/// caller that reads its rows, ids, modes and stat words alone (commit): a
/// racily clean file is read whole, and a scan kept every such body until
/// its command ended (den#145). The scan runs in a region of its own and
/// only the snapshot without bodies, and its warnings, are copied out; a
/// scan that fails runs again outside, where its message can leave.
pub fn scan_index_without_bodies(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    var held = List[Snapshot](), failed = false
    region scanning {
        var found_warnings = List[str]()
        let found = scan_listed(ctx, value, include_untracked, mut found_warnings) else |_| {
            failed = true
            List[Snapshot]()
        }
        if !failed {
            for warning in found_warnings { (mut warnings).push(copy warning) }
            var files = List[FileState]()
            for file in found[0].files {
                (mut files).push(FileState {
                    path: copy file.path,
                    mode: file.mode,
                    id: copy file.id,
                    data: List[byte](),
                    stat: copy file.stat,
                    kind: file.kind,
                    dirt: file.dirt,
                })
            }
            (mut held).push(
                copy Snapshot {
                    context: copy found[0].context,
                    head: copy found[0].head,
                    index: copy found[0].index,
                    head_entries: copy found[0].head_entries,
                    files: files,
                    directories: copy found[0].directories,
                    rows: copy found[0].rows,
                    walk_lookups: no_lookups(),
                    row_lookups: no_lookups(),
                    merge_counts: no_lookups(),
                    sort_counts: no_lookups(),
                },
            )
        }
    }
    if failed { return scan_index_with_warnings(ctx, value, include_untracked, mut warnings)? }
    copy held[0]
}

fn scan_listed(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    mut warnings: List[str],
) -> List[Snapshot] ! WorkErrors {
    [scan_index_with_warnings(ctx, value, include_untracked, mut warnings)?]
}

/// status's own snapshot (walk_mode status=true): FileState bodies are empty,
/// rows and modes are exactly scan_with_warnings'. show_ignored keeps every
/// ignored directory walked so ignored rows can be rendered.
pub fn scan_status(
    ctx: Context,
    include_untracked: bool,
    show_ignored: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    scan_status_ignoring(ctx, include_untracked, show_ignored, "", mut warnings)?
}

/// scan_status with --ignore-submodules' value (empty when not given).
pub fn scan_status_ignoring(
    ctx: Context,
    include_untracked: bool,
    show_ignored: bool,
    ignore_option: str,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    // read_index's parse validates exactly what serialize would re-check.
    let value = read_index(ctx)?
    let current_head = head(ctx)?
    var entries = List[FlatEntry]()
    var same = false
    if current_head.commits.len == 1 {
        entries = head_flat(ctx, value, current_head.commits[0], mut same)?
    }
    ensure_filters(ctx)?
    var ignores = ignore.cache()
    let walked = walk_submodules(
        ctx,
        value,
        include_untracked,
        [],
        true,
        show_ignored,
        ignore_option,
        false,
        false,
        mut ignores,
        mut warnings,
    )?
    supported_attributes(ctx, walked.files)?
    var row_lookups = no_lookups()
    var merge_counts = no_lookups()
    let rows = status_rows(
        ctx,
        value,
        entries,
        walked.files,
        include_untracked,
        mut ignores,
        mut warnings,
        mut row_lookups,
        mut merge_counts,
        same,
    )?
    Snapshot {
        context: copy ctx,
        head: current_head,
        index: value,
        head_entries: entries,
        files: walked.files,
        directories: walked.directories,
        rows: rows,
        walk_lookups: copy walked.lookups,
        row_lookups: row_lookups,
        merge_counts: merge_counts,
        sort_counts: copy walked.sorted,
    }
}

/// A read-only owned status snapshot; does not perform optional index refresh.
pub fn scan(ctx: Context) -> Snapshot ! WorkErrors { scan_index(ctx, read_index(ctx)?)? }

/// Read the index and collect ignore warnings without emitting them. The caller
/// shares one list across related scans and emits it at its command boundary.
pub fn scan_with_warnings(
    ctx: Context,
    include_untracked: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    scan_index_with_warnings(ctx, read_index(ctx)?, include_untracked, mut warnings)?
}
