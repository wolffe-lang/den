use std.fs
use gitmodules
use hash
use ignore
use index
use object
use oid

fn stable(a: List[int], b: List[int]) -> bool {
    if a.len != 20 || b.len != 20 { return false }
    for i in [0, 1, 4, 6, 7, 9, 10, 14, 15, 16, 17] { if a[i] != b[i] { return false } }
    true
}

fn read_held(fd: int) -> List[byte] ! WorkErrors {
    var out = List[byte]()
    loop {
        region chunk {
            let part = fs_read_chunk(fd, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > 1000000000 - out.len { return limit }
            for b in part { (mut out).push(b) }
        }
    }
    out
}

/// Read actual bytes with before/after metadata agreement. Final symlinks use
/// lstat/read_link/lstat; regular files use NOFOLLOW plus one held descriptor.
/// prior has zero or one stage-zero entry and controls fileMode/symlinks policy.
pub fn read_file(
    ctx: Context,
    path: List[byte],
    prior: List[index.Entry],
) -> FileState ! WorkErrors {
    if prior.len > 1 { return invalid }
    if prior.len == 1 {
        var checked = index.empty(2)?
        (mut checked.entries).push(copy prior[0])
        let _ = index.serialize(checked)?
        if index.stage(prior[0]) != 0 || compare(prior[0].path, path) != 0 { return invalid_index }
    }
    safe_parents(ctx, path, false)?
    let full = absolute(ctx, path)?
    let named = fs_lstat(full)?
    var record = copy named
    var data = List[byte]()
    var mode = 0o100644
    if named[0] == 3 {
        data = fs.read_link(full)?
        if !stable(named, fs_lstat(full)?) {
            return Failure("'{text(path)?}' changed while reading")
        }
        mode = 0o120000
    } else if named[0] == 0 {
        var file = fs.File { fd: fs_open_mode(full, 21)? }
        defer fs.close(take file) else |_| {}
        let before = fs_fstat_record(file.fd)?
        if !stable(named, before) { return Failure("'{text(path)?}' changed while opening") }
        data = read_held(file.fd)?
        record = fs_fstat_record(file.fd)?
        if !stable(before, record) || !stable(record, fs_lstat(full)?) {
            return Failure("'{text(path)?}' changed while reading")
        }
        if before[4] & 0o100 != 0 { mode = 0o100755 }
        if !config_bool(ctx, "core.filemode", true)? {
            mode = if prior.len == 1 &&
                (prior[0].stat[6] == 0o100644 || prior[0].stat[6] == 0o100755) {
                prior[0].stat[6]
            } else {
                0o100644
            }
        }
        if !config_bool(ctx, "core.symlinks", true)? &&
            prior.len == 1 &&
            prior[0].stat[6] == 0o120000 {
            mode = 0o120000
        }
    } else {
        return Unsupported("worktree file kind {named[0]} at {text(path)?}")
    }
    FileState {
        path: owned_bytes(path),
        mode: mode,
        id: object.identify("blob", data)?,
        data: data,
        stat: record,
        kind: named[0],
        dirt: 0,
    }
}

/// read_file's checks for a regular file, hashing the body as it streams
/// instead of keeping it: status needs the blob id, never the bytes. Size,
/// identity and times must agree before, during and after the read.
fn hash_file(
    ctx: Context,
    path: List[byte],
    prior: List[index.Entry],
    filemode: bool,
    symlinks: bool,
) -> FileState ! WorkErrors {
    safe_parents(ctx, path, false)?
    let full = absolute(ctx, path)?
    let named = fs_lstat(full)?
    if named[0] != 0 { return read_file(ctx, path, prior)? }
    var file = fs.File { fd: fs_open_mode(full, 21)? }
    defer fs.close(take file) else |_| {}
    let before = fs_fstat_record(file.fd)?
    if !stable(named, before) { return Failure("'{text(path)?}' changed while opening") }
    if before[1] < 0 || before[1] > 1000000000 { return limit }
    var digest = hash.new1()
    hash.update1(mut digest, "blob {before[1]}\0".bytes())
    var total = 0, grew = false
    loop {
        region chunk {
            let part = fs_read_chunk(file.fd, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > before[1] - total { grew = true; break }
            total += part.len
            hash.update1(mut digest, part)
        }
    }
    let record = fs_fstat_record(file.fd)?
    if grew || total != before[1] || !stable(before, record) || !stable(record, fs_lstat(full)?) {
        return Failure("'{text(path)?}' changed while reading")
    }
    let id = oid.from_bytes("sha1", hash.final1(take digest)) else |_| { return invalid }
    FileState {
        path: owned_bytes(path),
        mode: disk_mode(before, prior, filemode, symlinks),
        id: id,
        data: List[byte](),
        stat: record,
        kind: 0,
        dirt: 0,
    }
}

/// HEAD's flattened tree for status (value straight from read_index). When the index's valid cache-tree root
/// names HEAD's own tree, HEAD holds exactly the index's entries, so no tree
/// object is read; otherwise the full walk.
fn head_flat(ctx: Context, value: index.Index, commit: oid.Oid) -> List[FlatEntry] ! WorkErrors {
    // status passes the index read_index just parsed and validated.
    let root = index.parsed_root(value)?
    if root.len == 1 && oid.equal(root[0], tree_id(ctx.repo, commit)?) {
        var out = List[FlatEntry]()
        for entry in value.entries {
            (mut out).push(FlatEntry {
                path: copy entry.path,
                mode: entry.stat[6],
                id: copy entry.id,
            })
        }
        return out
    }
    flatten_tree(ctx.repo, commit)?
}

struct Walk { files: List[FileState], directories: List[List[byte]] }

// One path the walk visits: an entry a directory listed (`kind` its own kind
// from the listing), or a tracked path below a directory that could not be
// listed (`probe`), looked up by its own name.
struct Visit { path: List[byte], kind: int, probe: bool }

// A path strictly below `directory` that one of `paths` names.
fn selector_inside(paths: List[List[byte]], directory: List[byte]) -> bool {
    for selector in paths {
        if selector.len > directory.len && under(selector, directory) { return true }
    }
    false
}

/// The index file's own mtime (seconds, nanoseconds). An entry whose mtime is
/// at or after it is racily clean and must be content-checked, git's documented
/// racy-git rule; [-1, -1] when unknown makes every entry content-checked.
fn index_time(ctx: Context) -> List[int] {
    let record = fs_lstat("{ctx.repo.gitdir}/index") else |_| { return [-1, -1] }
    if record.len != 20 { return [-1, -1] }
    [record[14] & 4294967295, record[15] & 4294967295]
}

/// read_file's mode policy for a regular file, from the lstat permission bits.
fn disk_mode(record: List[int], prior: List[index.Entry], filemode: bool, symlinks: bool) -> int {
    entry_disk_mode(record, if prior.len == 1 then prior[0].stat[6] else -1, filemode, symlinks)
}

/// disk_mode given the stage-zero entry's mode, or -1 when there is none.
fn entry_disk_mode(record: List[int], prior: int, filemode: bool, symlinks: bool) -> int {
    var mode = if record[4] & 0o100 != 0 then 0o100755 else 0o100644
    if !filemode { mode = if prior == 0o100644 || prior == 0o100755 then prior else 0o100644 }
    if !symlinks && prior == 0o120000 { mode = 0o120000 }
    mode
}

/// A regular file whose lstat equals its stage-zero entry in all ten words
/// (ctime, mtime, dev, ino, mode, uid, gid, size) and is not racily clean
/// cannot differ from the entry's blob, so status need not read it. Any
/// missing or differing word, or an unknown index time, reads the content.
fn stat_clean(entry: index.Entry, record: List[int], mode: int, written: List[int]) -> bool {
    if record.len != 20 || entry.stat.len != 10 || written[0] < 0 { return false }
    let required: int = 247507
    if record[3] & required != required { return false }
    let m: int = 4294967295
    if entry.stat[6] != mode ||
        entry.stat[0] != record[16] & m ||
        entry.stat[1] != record[17] & m ||
        entry.stat[2] != record[14] & m ||
        entry.stat[3] != record[15] & m ||
        entry.stat[4] != record[9] & m ||
        entry.stat[5] != record[10] & m ||
        entry.stat[7] != record[6] & m ||
        entry.stat[8] != record[7] & m ||
        entry.stat[9] != record[1] & m {
        return false
    }
    let seconds = entry.stat[2], nanoseconds = entry.stat[3]
    if seconds > written[0] || seconds == written[0] && nanoseconds >= written[1] { return false }
    true
}

fn walk(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    skip_ignored: bool,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    var ignores = ignore.cache()
    walk_submodules(
        ctx,
        value,
        include_untracked,
        paths,
        false,
        false,
        "",
        skip_ignored,
        mut ignores,
        mut warnings,
    )?
}

/// status=false keeps the full snapshot every mutation consumer needs: every
/// observed file's body, read and hashed. status=true serves status only:
/// stat-clean tracked files reuse their entry id, other tracked files are
/// hashed and their bodies dropped, untracked and ignored files are never
/// read, and an ignored directory with no tracked descendant is not entered
/// unless ignored rows were asked for (git does not descend there either).
fn walk_mode(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    status: bool,
    show_ignored: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    walk_submodules(
        ctx,
        value,
        include_untracked,
        paths,
        status,
        show_ignored,
        "",
        false,
        mut ignores,
        mut warnings,
    )?
}

// walk_mode with --ignore-submodules' value (empty when not given). A gitlink
// directory becomes one entry holding its submodule's HEAD and dirt, never
// descended (vc25); .gitmodules is read once, at the first gitlink met.
// skip_ignored: a full walk (add) leaves an ignored directory with no tracked
// path below it unopened, as status does and as Git does.
//
// den#80, as measured on the pinned Git: a directory that cannot be listed is
// `warning: could not open directory 'DIR/': Permission denied` when untracked
// files are looked for, and the walk goes on as if it were empty; the tracked
// paths below it are looked up by name. One whose lookup is denied is, for
// status, `PATH: Permission denied`, printed before the walk's warnings, and
// unchanged; a full walk refuses it by name. An entry a directory lists but
// that cannot be looked up is, for status, an untracked path of the kind the
// listing gave; for a full walk, `fatal: unable to stat 'PATH': Permission
// denied`.
fn walk_submodules(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    paths: List[List[byte]],
    status: bool,
    show_ignored: bool,
    ignore_option: str,
    skip_ignored: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> Walk ! WorkErrors {
    let mark = warnings.len
    var notices = List[str]()
    for entry in value.entries {
        if entry.stat.len != 10 { return invalid_index }
    }
    var parsed = List[gitmodules.Parsed]()
    let written = if status then index_time(ctx) else [-1, -1]
    // Read once per walk in status mode; the full walk keeps read_file's own reads.
    let filemode = if status then config_bool(ctx, "core.filemode", true)? else true
    let symlinks = if status then config_bool(ctx, "core.symlinks", true)? else true
    let empty = object.identify("blob", List[byte]())?
    var total_bytes: int = 0
    var pending = [List[byte]()]
    var files = List[FileState]()
    var directories = List[List[byte]]()
    while pending.len > 0 {
        let parent = (mut pending).pop() else |_| { return invalid }
        var listed = true
        let items = fs.entries(absolute(ctx, parent)?) else |e| match e {
            denied => {
                if parent.len == 0 { return denied }
                listed = false
                List[fs.Entry]()
            },
            not_found => { return not_found },
            io => { return io },
        }
        var visits = List[Visit]()
        if !listed {
            if include_untracked {
                (mut warnings).push(
                    "warning: could not open directory '{text(parent)?}/': Permission denied",
                )
            }
            for entry in value.entries {
                if index.stage(entry) != 0 ||
                    entry.path.len <= parent.len ||
                    !under(entry.path, parent) {
                    continue
                }
                (mut visits).push(Visit { path: copy entry.path, kind: -1, probe: true })
            }
        }
        for item in items {
            if compare(item.name, ".git".bytes()) == 0 {
                if parent.len > 0 { return Unsupported("embedded repository {text(parent)?}") }
                continue
            }
            var path = copy parent
            if path.len > 0 { (mut path).push(47 as byte) }
            bytes_add(mut path, item.name)
            (mut visits).push(Visit { path: path, kind: item.kind, probe: false })
        }
        // Subdirectories are entered depth first in the order the host lists
        // them, as Git enters them, so the warnings come in Git's order.
        var deeper = List[List[byte]]()
        for visit in visits {
            let path = copy visit.path
            // A selected leaf may need its ancestors traversed, but unrelated
            // paths must not be opened incidentally by add <tracked> or -u.
            var relevant = selected(path, paths)
            if !relevant {
                for selector in paths { if under(selector, path) { relevant = true; break } }
            }
            if !relevant { continue }
            if !include_untracked {
                var tracked = false
                if paths.len == 0 {
                    tracked = tracked_under(value.entries, path)
                } else {
                    for entry in value.entries {
                        if under(entry.path, path) && selected(entry.path, paths) {
                            tracked = true
                            break
                        }
                    }
                }
                if !tracked { continue }
            }
            let full = absolute(ctx, path)?
            var looked = true
            let info = fs_lstat(full) else |e| match e {
                not_found => { continue },
                denied => {
                    looked = false
                    List[int]()
                },
                io => { return io },
            }
            if !looked {
                let tracked_at = index_at(value.entries, path)
                if tracked_at >= 0 && index.stage(value.entries[tracked_at]) == 0 {
                    if !status {
                        return Unsupported("worktree tracked path {text(path)?}: Permission denied")
                    }
                    if !selected(path, paths) { continue }
                    (mut notices).push("{text(path)?}: Permission denied")
                    if files.len >= 1000000 { return limit }
                    (mut files).push(FileState {
                        path: owned_bytes(path),
                        mode: value.entries[tracked_at].stat[6],
                        id: copy value.entries[tracked_at].id,
                        data: List[byte](),
                        stat: List[int](),
                        kind: -1,
                        dirt: 0,
                    })
                    continue
                }
                if visit.probe || tracked_at >= 0 { continue }
                if !status {
                    // Git reads the directory's ignore file before the entry.
                    if include_untracked {
                        let _ = ignore.query_cached(
                            ctx.repo,
                            ctx.root,
                            mut ignores,
                            text(path)?,
                            false,
                            mut warnings,
                        )?
                    }
                    return Fatal("unable to stat '{text(path)?}': Permission denied")
                }
                if visit.kind == 1 {
                    if include_untracked && !show_ignored && !tracked_under(value.entries, path) {
                        let decision = ignore.query_cached(
                            ctx.repo,
                            ctx.root,
                            mut ignores,
                            text(path)?,
                            true,
                            mut warnings,
                        )?
                        if decision.ignored { continue }
                    }
                    if directories.len >= 1000000 { return limit }
                    (mut directories).push(copy path)
                    (mut deeper).push(path)
                    continue
                }
                if visit.kind != 0 && visit.kind != 3 || !selected(path, paths) { continue }
                if files.len >= 1000000 { return limit }
                (mut files).push(FileState {
                    path: owned_bytes(path),
                    mode: if visit.kind == 3 then 0o120000 else 0o100644,
                    id: copy empty,
                    data: List[byte](),
                    stat: List[int](),
                    kind: visit.kind,
                    dirt: 0,
                })
                continue
            }
            // A tracked path looked up by name is a file or nothing.
            if visit.probe && info[0] == 1 && gitlink_at(value, path) < 0 { continue }
            if info[0] == 1 && gitlink_at(value, path) >= 0 {
                if !selected(path, paths) { continue }
                let at = gitlink_at(value, path)
                if parsed.len == 0 { (mut parsed).push(modules(ctx)?) }
                let name = text(path)?
                // A full walk (add, commit) stages only the HEAD; commit's
                // status shows modified content but never untracked content,
                // as Git's does (vc25 work rows).
                let configured = ignore_for(ctx, parsed[0], name, ignore_option)
                let setting = if status || configured != "" then configured else "untracked"
                let state = if setting == "all" {
                    unpopulated(value.entries[at].id)
                } else {
                    submodule_state(ctx, name, value.entries[at].id, setting)?
                }
                var dirt = 0
                if state.modified { dirt = 1 }
                if state.untracked { dirt = dirt | 2 }
                if files.len >= 1000000 { return limit }
                (mut files).push(FileState {
                    path: owned_bytes(path),
                    mode: 0o160000,
                    id: copy state.head,
                    data: List[byte](),
                    stat: copy info,
                    kind: 1,
                    dirt: dirt,
                })
                continue
            }
            if info[0] == 1 {
                if (status || skip_ignored && !selector_inside(paths, path)) &&
                    include_untracked &&
                    !show_ignored &&
                    !tracked_under(value.entries, path) {
                    let decision = ignore.query_cached(
                        ctx.repo,
                        ctx.root,
                        mut ignores,
                        text(path)?,
                        true,
                        mut warnings,
                    )?
                    if decision.ignored { continue }
                }
                if directories.len >= 1000000 { return limit }
                (mut directories).push(copy path)
                (mut deeper).push(path)
            } else if info[0] == 0 || info[0] == 3 {
                if !selected(path, paths) { continue }
                let at = index_at(value.entries, path)
                var staged = -1
                if at >= 0 {
                    if value.entries[at].stat[6] == 0o160000 {
                        return Unsupported("submodule worktree")
                    }
                    if index.stage(value.entries[at]) == 0 { staged = at }
                }
                let prior_mode = if staged >= 0 then value.entries[staged].stat[6] else -1
                let mode = if info[0] == 0 {
                    entry_disk_mode(info, prior_mode, filemode, symlinks)
                } else {
                    0o120000
                }
                var file = FileState {
                    path: owned_bytes(path),
                    mode: mode,
                    id: copy empty,
                    data: List[byte](),
                    // status renders paths and modes only; full walks keep the record.
                    stat: if status then List[int]() else copy info,
                    kind: info[0],
                    dirt: 0,
                }
                if status && info[0] == 0 && at < 0 {
                    // Untracked or ignored: status renders the path alone.
                } else if status &&
                    info[0] == 0 &&
                    staged >= 0 &&
                    stat_clean(value.entries[staged], info, mode, written) {
                    file.id = copy value.entries[staged].id
                } else {
                    var prior = List[index.Entry]()
                    if staged >= 0 { (mut prior).push(copy value.entries[staged]) }
                    file = if status {
                        hash_file(ctx, path, prior, filemode, symlinks)?
                    } else {
                        read_file(ctx, path, prior)?
                    }
                }
                if file.data.len > 1000000000 - total_bytes || files.len >= 1000000 { return limit }
                total_bytes += file.data.len
                (mut files).push(file)
            } else if index_at(value.entries, path) >= 0 {
                return Unsupported("tracked worktree file kind {info[0]} at {text(path)?}")
            }
        }
        while deeper.len > 0 {
            let next = (mut deeper).pop() else |_| { return invalid }
            (mut pending).push(next)
        }
    }
    // Git refreshes the tracked paths before it looks for untracked ones:
    // their notices come before the walk's own warnings.
    if notices.len > 0 {
        var later = List[str]()
        while warnings.len > mark {
            let last = (mut warnings).pop() else |_| { return invalid }
            (mut later).push(last)
        }
        for notice in notices { (mut warnings).push(notice) }
        while later.len > 0 {
            let next = (mut later).pop() else |_| { return invalid }
            (mut warnings).push(next)
        }
    }
    var names = List[List[byte]]()
    for file in files { (mut names).push(copy file.path) }
    var sorted = List[FileState]()
    for i in path_order(names) { (mut sorted).push(copy files[i]) }
    Walk { files: sorted, directories: directories }
}

fn status_row(path: List[byte], x: str, y: str) -> StatusRow {
    StatusRow {
        path: owned_bytes(path),
        original_path: [],
        x: x,
        y: y,
        ignored: false,
        untracked: false,
        sub: 0,
    }
}

fn change(old_mode: int, old: oid.Oid, mode: int, id: oid.Oid) -> str {
    if old_mode / 4096 != mode / 4096 { return "T" }
    if old_mode != mode || !oid.equal(old, id) { return "M" }
    " "
}

fn unmerged_code(bits: int) -> (str, str) {
    match bits {
        2 => ("D", "D"),
        4 => ("A", "U"),
        6 => ("U", "D"),
        8 => ("U", "A"),
        10 => ("D", "U"),
        12 => ("A", "A"),
        _ => ("U", "U"),
    }
}

/// Compare three owned snapshots without filesystem writes. Unmerged entries,
/// ITA, assume-valid and skip-worktree are represented explicitly.
pub fn compare_status(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
) -> List[StatusRow] ! WorkErrors {
    var warnings = List[str]()
    compare_status_with_warnings(ctx, value, tree, files, true, mut warnings)?
}

/// Compare snapshots while collecting operation-wide ignore diagnostics. False
/// include_untracked bypasses all ignore-source queries, not just their output,
/// and returns tracked rows only. Existing warnings are retained on every exit.
pub fn compare_status_with_warnings(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
    include_untracked: bool,
    mut warnings: List[str],
) -> List[StatusRow] ! WorkErrors {
    let _ = index.serialize(value)?
    var ignores = ignore.cache()
    status_rows(ctx, value, tree, files, include_untracked, mut ignores, mut warnings)?
}

/// compare_status_with_warnings without its validation pass, for an index
/// that index.parse has just validated (the same entry, extension and
/// cache-span checks serialize repeats).
fn status_rows(
    ctx: Context,
    value: index.Index,
    tree: List[FlatEntry],
    files: List[FileState],
    include_untracked: bool,
    mut ignores: ignore.Cache,
    mut warnings: List[str],
) -> List[StatusRow] ! WorkErrors {
    // The sorted, deduplicated union of HEAD and index paths; rows are put in
    // path order below, so the union's own order only needs to be stable.
    var paths = List[List[byte]]()
    var t = 0, n = 0
    while t < tree.len || n < value.entries.len {
        var candidate = List[byte]()
        if n >= value.entries.len ||
            t < tree.len && compare(tree[t].path, value.entries[n].path) <= 0 {
            candidate = copy tree[t].path
            t += 1
        } else {
            candidate = copy value.entries[n].path
            n += 1
        }
        if paths.len == 0 || compare(paths[paths.len - 1], candidate) != 0 {
            (mut paths).push(candidate)
        }
    }
    var rows = List[StatusRow]()
    // paths, tree, index entries and files are all in path order: one cursor
    // each finds the first equal position, as index_at/flat_at/file_at did.
    var ti = 0, ni = 0, fi = 0
    for path in paths {
        while ti < tree.len && compare(tree[ti].path, path) < 0 { ti += 1 }
        while ni < value.entries.len && compare(value.entries[ni].path, path) < 0 { ni += 1 }
        while fi < files.len && compare(files[fi].path, path) < 0 { fi += 1 }
        let staged = if ni < value.entries.len && compare(value.entries[ni].path, path) == 0 {
            ni
        } else {
            -1
        }
        let old = if ti < tree.len && compare(tree[ti].path, path) == 0 then ti else -1
        let disk = if fi < files.len && compare(files[fi].path, path) == 0 then fi else -1
        if staged < 0 { (mut rows).push(status_row(path, "D", " ")); continue }
        let entry = copy value.entries[staged]
        if index.stage(entry) != 0 {
            var bits = 0
            for item in value.entries {
                if compare(item.path, path) == 0 { bits = bits | 1 << index.stage(item) }
            }
            let (x, y) = unmerged_code(bits)
            (mut rows).push(status_row(path, x, y))
            continue
        }
        let intent = entry.extended & 0x2000 != 0
        let x = if intent {
            " "
        } else if old < 0 {
            "A"
        } else {
            change(tree[old].mode, tree[old].id, entry.stat[6], entry.id)
        }
        var y = " "
        var sub = 0
        if entry.flags & 0x8000 == 0 && entry.extended & 0x4000 == 0 {
            y = if disk < 0 {
                "D"
            } else if intent {
                "A"
            } else {
                change(entry.stat[6], entry.id, files[disk].mode, files[disk].id)
            }
            if disk >= 0 && entry.stat[6] == 0o160000 && files[disk].mode == 0o160000 {
                if y == "M" { sub = 1 }
                if files[disk].dirt & 1 != 0 { sub = sub | 2 }
                if files[disk].dirt & 2 != 0 { sub = sub | 4 }
                if sub != 0 { y = "M" }
            }
        }
        if x != " " || y != " " {
            var row = status_row(path, x, y)
            row.sub = sub
            (mut rows).push(row)
        }
    }
    for file in files {
        if !include_untracked { break }
        if index_at(value.entries, file.path) >= 0 { continue }
        let decision = ignore.query_cached(
            ctx.repo,
            ctx.root,
            mut ignores,
            text(file.path)?,
            false,
            mut warnings,
        )?
        var row = status_row(
            file.path,
            if decision.ignored then "!" else "?",
            if decision.ignored then "!" else "?",
        )
        row.ignored = decision.ignored
        row.untracked = !decision.ignored
        (mut rows).push(row)
    }
    // Stable unsigned path order, independent of directory enumeration order.
    var names = List[List[byte]]()
    for row in rows { (mut names).push(copy row.path) }
    var sorted = List[StatusRow]()
    for i in path_order(names) { (mut sorted).push(copy rows[i]) }
    sorted
}

/// Scan against a caller's already-locked index snapshot. This function itself
/// remains read-only, allowing commit/add/status consumers to choose ownership.
pub fn scan_index(ctx: Context, value: index.Index) -> Snapshot ! WorkErrors {
    var warnings = List[str]()
    scan_index_with_warnings(ctx, value, true, mut warnings)?
}

/// Read-only scan with explicit warning collection. include_untracked=false
/// skips ignore queries, untracked/ignored rows and untracked file-body reads.
/// files then contains observed tracked files only. Existing scan_index keeps
/// the full silent snapshot. Never prints or clears caller diagnostics.
pub fn scan_index_with_warnings(
    ctx: Context,
    value: index.Index,
    include_untracked: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    let _ = index.serialize(value)?
    let current_head = head(ctx)?
    var entries = List[FlatEntry]()
    if current_head.commits.len == 1 { entries = flatten_tree(ctx.repo, current_head.commits[0])? }
    ensure_filters(ctx)?
    let walked = walk(ctx, value, include_untracked, [], false, mut warnings)?
    for file in walked.files {
        let path = text(file.path)?
        if path == ".gitattributes" || path.ends_with("/.gitattributes") {
            return Unsupported("worktree attributes")
        }
    }
    let rows = compare_status_with_warnings(
        ctx,
        value,
        entries,
        walked.files,
        include_untracked,
        mut warnings,
    )?
    Snapshot {
        context: copy ctx,
        head: current_head,
        index: copy value,
        head_entries: entries,
        files: walked.files,
        directories: walked.directories,
        rows: rows,
    }
}

/// status's own snapshot (walk_mode status=true): FileState bodies are empty,
/// rows and modes are exactly scan_with_warnings'. show_ignored keeps every
/// ignored directory walked so ignored rows can be rendered.
pub fn scan_status(
    ctx: Context,
    include_untracked: bool,
    show_ignored: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    scan_status_ignoring(ctx, include_untracked, show_ignored, "", mut warnings)?
}

/// scan_status with --ignore-submodules' value (empty when not given).
pub fn scan_status_ignoring(
    ctx: Context,
    include_untracked: bool,
    show_ignored: bool,
    ignore_option: str,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    // read_index's parse validates exactly what serialize would re-check.
    let value = read_index(ctx)?
    let current_head = head(ctx)?
    var entries = List[FlatEntry]()
    if current_head.commits.len == 1 { entries = head_flat(ctx, value, current_head.commits[0])? }
    ensure_filters(ctx)?
    var ignores = ignore.cache()
    let walked = walk_submodules(
        ctx,
        value,
        include_untracked,
        [],
        true,
        show_ignored,
        ignore_option,
        false,
        mut ignores,
        mut warnings,
    )?
    for file in walked.files {
        let path = text(file.path)?
        if path == ".gitattributes" || path.ends_with("/.gitattributes") {
            return Unsupported("worktree attributes")
        }
    }
    let rows = status_rows(
        ctx,
        value,
        entries,
        walked.files,
        include_untracked,
        mut ignores,
        mut warnings,
    )?
    Snapshot {
        context: copy ctx,
        head: current_head,
        index: copy value,
        head_entries: entries,
        files: walked.files,
        directories: walked.directories,
        rows: rows,
    }
}

/// A read-only owned status snapshot; does not perform optional index refresh.
pub fn scan(ctx: Context) -> Snapshot ! WorkErrors { scan_index(ctx, read_index(ctx)?)? }

/// Read the index and collect ignore warnings without emitting them. The caller
/// shares one list across related scans and emits it at its command boundary.
pub fn scan_with_warnings(
    ctx: Context,
    include_untracked: bool,
    mut warnings: List[str],
) -> Snapshot ! WorkErrors {
    scan_index_with_warnings(ctx, read_index(ctx)?, include_untracked, mut warnings)?
}
