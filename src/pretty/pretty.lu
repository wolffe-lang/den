// Original presentation from Git 2.56.0 pretty-formats and --date documentation.
use commit
use commit_format
use oid
use walk
use worktree

fn add(mut out: List[byte], bytes: List[byte]) { for b in bytes { (mut out).push(b) } }

fn line(mut out: List[byte], text: str) { add(mut out, text.bytes()); (mut out).push(10 as byte) }

fn whitespace(b: byte) -> bool { b == 32 as byte || b as int >= 9 && b as int <= 13 }

fn zone_value(zone: str) -> int ! worktree.WorkErrors {
    if zone.len < 2 || !zone.starts_with("+") && !zone.starts_with("-") { return invalid }
    var magnitude = 0
    for b in zone.bytes()[1..] {
        if b < 48 as byte || b > 57 as byte || magnitude > 99999999 { return invalid }
        magnitude = magnitude * 10 + (b as int - 48)
    }
    if zone.starts_with("-") then -magnitude else magnitude
}

/// Show seconds and a zone value in a --date style as Git does; Git's
/// fatal (a local time before the epoch) is Fatal.
pub fn shown(seconds: int, zone: int, style: str) -> str ! worktree.WorkErrors {
    let value = commit_format.shown_date(seconds, zone, style)?
    if value.fatal != "" { return Fatal(value.fatal) }
    value.text
}

/// Explicit numeric timestamp/offset rendering; no clock-relative output.
pub fn date(seconds: int, zone: str, style: str) -> str ! worktree.WorkErrors {
    shown(seconds, zone_value(zone)?, style)?
}

/// vc26: Git's Author:, Commit: and Tagger: text of a split identity: the
/// stored name, a space, and the stored email in angle brackets.
pub fn person(raw: commit_format.RawIdentity) -> List[byte] {
    var out = List[byte]()
    add(mut out, raw.name)
    add(mut out, " <".bytes())
    add(mut out, raw.email)
    (mut out).push(62 as byte)
    out
}

/// The seconds and zone value Git shows for an identity's date: 0 and 0
/// when it cannot read one, or the date is above 9223372036854775807.
pub fn identity_time(raw: commit_format.RawIdentity) -> (int, int) ! worktree.WorkErrors {
    if !raw.dated || !raw.fits { return (0, 0) }
    if !raw.zone_fits { return Unsupported("history timezone with more than nine digits") }
    (raw.seconds, raw.zone)
}

/// Pure message rendering. Raw storage remains untouched; display truncates at
/// NUL, trims trailing whitespace and expands tabs only for indented formats.
pub fn message(bytes: List[byte], oneline: bool) -> List[byte] ! worktree.WorkErrors {
    if bytes.len > 16777216 { return limit }
    var raw = List[byte]()
    for b in bytes { if b == 0 as byte { break }; (mut raw).push(b) }
    if oneline { return commit.subject(raw) else |_| { return invalid } }
    var lines = List[List[byte]](), pos = 0
    while pos < raw.len {
        let start = pos
        while pos < raw.len && raw[pos] != 10 as byte { pos += 1 }
        var end = pos
        while end > start && whitespace(raw[end - 1]) { end -= 1 }
        var value = List[byte](), col = 0, non_ascii = false
        for i in start..end {
            if raw[i] == 9 as byte {
                if non_ascii { return Unsupported("history non-ASCII tab width") }
                let count = 8 - col % 8
                for _ in 0..count { (mut value).push(32 as byte) }
                col += count
            } else {
                (mut value).push(raw[i])
                if raw[i] >= 128 as byte { non_ascii = true }
                col += 1
            }
        }
        (mut lines).push(value)
        if pos < raw.len { pos += 1 }
    }
    var start = 0, end = lines.len, out = List[byte]()
    while start < end && lines[start].len == 0 { start += 1 }
    while end > start && lines[end - 1].len == 0 { end -= 1 }
    if start < end { (mut out).push(10 as byte) }
    for i in start..end {
        add(mut out, "    ".bytes())
        add(mut out, lines[i])
        (mut out).push(10 as byte)
    }
    out
}

/// Pure pretty header/body with caller-supplied uniquely abbreviated identifiers.
/// short_ids contains the commit followed by its ordered parents.
pub fn render(
    value: walk.Commit,
    format: str,
    date_style: str,
    short_ids: List[str],
    abbreviate: bool,
) -> List[byte] ! worktree.WorkErrors {
    if short_ids.len != value.parents.len + 1 { return invalid }
    for field in value.headers.fields {
        if field.key == "encoding" && str_from_utf8(field.value)?.lower() != "utf-8" {
            return Unsupported("history message encoding")
        }
    }
    for i in 0..short_ids.len {
        let full_id = if i == 0 then oid.hex(value.id)? else oid.hex(value.parents[i - 1])?
        let prefix = oid.prefix("sha1", short_ids[i])?
        if !full_id.starts_with(prefix) { return invalid }
    }
    var out = List[byte]()
    let full = oid.hex(value.id)?
    let id = if abbreviate then short_ids[0] else full
    if format == "oneline" {
        add(mut out, "{id} ".bytes())
        add(mut out, message(value.headers.message, true)?)
        (mut out).push(10 as byte)
        return out
    }
    if format != "medium" && format != "short" && format != "full" && format != "fuller" {
        return Unsupported("history pretty {format}")
    }
    line(mut out, "commit {id}")
    if value.parents.len > 1 {
        add(mut out, "Merge:".bytes())
        for i in 1..short_ids.len { add(mut out, " {short_ids[i]}".bytes()) }
        (mut out).push(10 as byte)
    }
    for field in value.headers.fields {
        if field.key == "encoding" && str_from_utf8(field.value)? != "UTF-8" {
            return Unsupported("history message encoding")
        }
        if field.key != "author" && field.key != "committer" { continue }
        // vc26: a line Git cannot split prints no lines at all.
        let raw = commit_format.raw_identity(field.value)
        if !raw.split { continue }
        let (seconds, zone) = identity_time(raw)?
        if field.key == "author" {
            add(mut out, (if format == "fuller" then "Author:     " else "Author: ").bytes())
            add(mut out, person(raw))
            (mut out).push(10 as byte)
            if format == "medium" { line(mut out, "Date:   {shown(seconds, zone, date_style)?}") }
            if format == "fuller" {
                line(mut out, "AuthorDate: {shown(seconds, zone, date_style)?}")
            }
        } else if format == "full" || format == "fuller" {
            add(mut out, (if format == "fuller" then "Commit:     " else "Commit: ").bytes())
            add(mut out, person(raw))
            (mut out).push(10 as byte)
            if format == "fuller" {
                line(mut out, "CommitDate: {shown(seconds, zone, date_style)?}")
            }
        }
    }
    if format == "short" {
        var pos = 0, started = false
        let raw = value.headers.message
        while pos < raw.len && raw[pos] != 0 as byte {
            let start = pos
            while pos < raw.len && raw[pos] != 10 as byte && raw[pos] != 0 as byte { pos += 1 }
            var end = pos
            while end > start && whitespace(raw[end - 1]) { end -= 1 }
            if end == start {
                if started { break }
            } else {
                if !started { (mut out).push(10 as byte); started = true }
                add(mut out, "    ".bytes())
                for j in start..end { (mut out).push(raw[j]) }
                (mut out).push(10 as byte)
            }
            if pos < raw.len && raw[pos] == 10 as byte { pos += 1 }
        }
    } else {
        add(mut out, message(value.headers.message, false)?)
    }
    out
}

fn until_nul(bytes: List[byte]) -> List[byte] {
    var out = List[byte]()
    for b in bytes { if b == 0 as byte { break }; (mut out).push(b) }
    out
}

// The stored bytes after the subject paragraph and the blank lines after
// it (%b); a line of whitespace alone is blank, as for the subject.
fn body_bytes(message: List[byte]) -> List[byte] {
    var pos = 0, started = false, ended = false
    while pos < message.len {
        let begin = pos
        while pos < message.len && message[pos] != 10 as byte { pos += 1 }
        var blank = true
        for i in begin..pos { if !whitespace(message[i]) { blank = false } }
        if pos < message.len { pos += 1 }
        if !started {
            if !blank { started = true }
        } else if !ended {
            if blank { ended = true }
        } else if !blank {
            var out = List[byte]()
            for i in begin..message.len { (mut out).push(message[i]) }
            return out
        }
    }
    List[byte]()
}

fn local_part(email: List[byte]) -> List[byte] {
    var out = List[byte]()
    for b in email { if b == 64 as byte { break }; (mut out).push(b) }
    out
}

// One identity placeholder (%a? or %c?), as Git expands it: a line it
// cannot split expands %?n and %?e to nothing and leaves %?l, %?N, %?E and
// %?L as written; a date it cannot read expands %?d, %?D, %?t and %?i to
// nothing and leaves %?I and %?s as written.
fn identity_placeholder(
    mut out: List[byte],
    value: walk.Commit,
    role: byte,
    key: byte,
    date_style: str,
) -> () ! worktree.WorkErrors {
    let field_name = if role == 97 as byte then "author" else "committer"
    var raw = commit_format.raw_identity(List[byte]())
    for field in value.headers.fields {
        if field.key == field_name { raw = commit_format.raw_identity(field.value); break }
    }
    var written = List[byte]()
    (mut written).push(37 as byte)
    (mut written).push(role)
    (mut written).push(key)
    let k = key as int
    // n N e E l L d D t i I s
    if k == 110 || k == 78 || k == 101 || k == 69 || k == 108 || k == 76 {
        if !raw.split {
            if k != 110 && k != 101 { add(mut out, written) }
            return
        }
        if k == 110 || k == 78 {
            add(mut out, raw.name)
        } else if k == 101 || k == 69 {
            add(mut out, raw.email)
        } else {
            add(mut out, local_part(raw.email))
        }
        return
    }
    if !raw.split || !raw.dated {
        if k == 73 || k == 115 { add(mut out, written) }
        return
    }
    if k == 116 { add(mut out, raw.stamp); return }
    let (seconds, zone) = identity_time(raw)?
    let style = if k == 100 {
        date_style
    } else if k == 68 {
        "rfc"
    } else if k == 105 {
        "iso"
    } else if k == 73 {
        "iso-strict"
    } else {
        "short"
    }
    add(mut out, shown(seconds, zone, style)?.bytes())
}

/// vc26: a user format (`--format=`, `format:`, `tformat:`) over the
/// placeholders this engine knows: %H %h %T %t %P %p %s %b %B %n %%, the
/// author and committer names, emails and dates (%an %ae %al %aN %aE %aL
/// %ad %aD %at %ai %aI %as, and %c?), and literal text. Every other
/// placeholder, and the clock-relative %ar %ah %cr %ch, is refused by
/// name. short_ids holds the commit then its parents, abbreviated.
pub fn user_format(
    value: walk.Commit,
    format: str,
    date_style: str,
    short_ids: List[str],
    tree_short: str,
) -> List[byte] ! worktree.WorkErrors {
    if short_ids.len != value.parents.len + 1 { return invalid }
    let spec = format.bytes()
    var out = List[byte](), i = 0
    while i < spec.len {
        let b = spec[i]
        i += 1
        if b != 37 as byte { (mut out).push(b); continue }
        if i == spec.len { return Unsupported("history format placeholder %") }
        let c = spec[i] as int
        i += 1
        if c == 110 {
            (mut out).push(10 as byte)
        } else if c == 37 {
            (mut out).push(37 as byte)
        } else if c == 72 {
            add(mut out, oid.hex(value.id)?.bytes())
        } else if c == 104 {
            add(mut out, short_ids[0].bytes())
        } else if c == 84 {
            add(mut out, oid.hex(value.tree)?.bytes())
        } else if c == 116 {
            add(mut out, tree_short.bytes())
        } else if c == 80 || c == 112 {
            for n in 0..value.parents.len {
                if n > 0 { (mut out).push(32 as byte) }
                let id = if c == 80 then oid.hex(value.parents[n])? else short_ids[n + 1]
                add(mut out, id.bytes())
            }
        } else if c == 115 {
            add(mut out, message(value.headers.message, true)?)
        } else if c == 98 {
            add(mut out, body_bytes(until_nul(value.headers.message)))
        } else if c == 66 {
            add(mut out, until_nul(value.headers.message))
        } else if (c == 97 || c == 99) && i < spec.len {
            let k = spec[i] as int
            if k == 110 ||
                k == 78 ||
                k == 101 ||
                k == 69 ||
                k == 108 ||
                k == 76 ||
                k == 100 ||
                k == 68 ||
                k == 116 ||
                k == 105 ||
                k == 73 ||
                k == 115 {
                identity_placeholder(mut out, value, c as byte, spec[i], date_style)?
                i += 1
            } else {
                let name = str_from_utf8(spec[i - 2..i + 1]) else "%?"
                return Unsupported("history format placeholder {name}")
            }
        } else {
            let name = str_from_utf8(spec[i - 2..i]) else "%?"
            return Unsupported("history format placeholder {name}")
        }
    }
    out
}
