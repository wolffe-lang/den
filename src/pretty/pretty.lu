// Original presentation from Git 2.56.0 pretty-formats and --date documentation.
use std.time
use commit
use oid
use walk
use worktree

fn add(mut out: List[byte], bytes: List[byte]) { for b in bytes { (mut out).push(b) } }

fn line(mut out: List[byte], text: str) { add(mut out, text.bytes()); (mut out).push(10 as byte) }

fn whitespace(b: byte) -> bool { b == 32 as byte || b as int >= 9 && b as int <= 13 }

/// Explicit numeric timestamp/offset rendering; no clock-relative output.
pub fn date(seconds: int, zone: str, style: str) -> str ! worktree.WorkErrors {
    if seconds < 0 || seconds > 253401938459 { return Unsupported("history date range") }
    if zone.len != 5 || !zone.starts_with("+") && !zone.starts_with("-") { return invalid }
    for b in zone.bytes()[1..] { if b < 48 as byte || b > 57 as byte { return invalid } }
    let hours = zone[1..3].to_int() else |_| { return invalid }
    let minutes = zone[3..].to_int() else |_| { return invalid }
    if hours < 0 || minutes < 0 || minutes > 59 {
        return Unsupported("history noncanonical timezone")
    }
    let local = style == "local" || style.ends_with("-local")
    let kind = if style == "local" {
        "default"
    } else if local {
        style[0..style.len - 6]
    } else {
        style
    }
    let offset = if local {
        0
    } else {
        (hours * 60 + minutes) * (if zone.starts_with("-") then -60 else 60)
    }
    let z = if local then "+0000" else zone
    if kind == "raw" { return "{seconds} {z}" }
    if kind == "unix" { return "{seconds}" }
    if seconds + offset < 0 {
        let numeric = zone.to_int() else 0
        return Fatal("Timestamp before Unix epoch: {seconds} {numeric}")
    }
    let civil = time.local_in("UTC", seconds + offset) else |_| { return invalid }
    let format = match kind {
        "default" => "%a %b %-d %H:%M:%S %Y",
        "short" => "%Y-%m-%d",
        "iso" | "iso8601" => "%Y-%m-%d %H:%M:%S",
        "iso-strict" | "iso8601-strict" => "%Y-%m-%dT%H:%M:%S",
        "rfc" | "rfc2822" => "%a, %-d %b %Y %H:%M:%S",
        _ => { return Unsupported("history date format {style}") },
    }
    let value = time.format(civil, format) else |_| { return invalid }
    if kind == "short" || kind == "default" && local { return value }
    if kind == "iso-strict" || kind == "iso8601-strict" {
        return if z == "+0000" || z == "-0000" then "{value}Z" else "{value}{z[0..3]}:{z[3..]}"
    }
    "{value} {z}"
}

/// Parse an existing raw identity without commit-creation cleanup.
pub fn identity(value: List[byte]) -> (str, int, str) ! worktree.WorkErrors {
    let text = str_from_utf8(value)?
    let end = text.rfind(">") else |_| { return invalid_header }
    let words = text[end + 1..].words()
    if words.len != 2 { return invalid_header }
    let seconds = words[0].to_int() else |_| { return invalid_header }
    (text[0..end + 1], seconds, words[1])
}

/// Pure message rendering. Raw storage remains untouched; display truncates at
/// NUL, trims trailing whitespace and expands tabs only for indented formats.
pub fn message(bytes: List[byte], oneline: bool) -> List[byte] ! worktree.WorkErrors {
    if bytes.len > 16777216 { return limit }
    var raw = List[byte]()
    for b in bytes { if b == 0 as byte { break }; (mut raw).push(b) }
    if oneline { return commit.subject(raw) else |_| { return invalid } }
    var lines = List[List[byte]](), pos = 0
    while pos < raw.len {
        let start = pos
        while pos < raw.len && raw[pos] != 10 as byte { pos += 1 }
        var end = pos
        while end > start && whitespace(raw[end - 1]) { end -= 1 }
        var value = List[byte](), col = 0, non_ascii = false
        for i in start..end {
            if raw[i] == 9 as byte {
                if non_ascii { return Unsupported("history non-ASCII tab width") }
                let count = 8 - col % 8
                for _ in 0..count { (mut value).push(32 as byte) }
                col += count
            } else {
                (mut value).push(raw[i])
                if raw[i] >= 128 as byte { non_ascii = true }
                col += 1
            }
        }
        (mut lines).push(value)
        if pos < raw.len { pos += 1 }
    }
    var start = 0, end = lines.len, out = List[byte]()
    while start < end && lines[start].len == 0 { start += 1 }
    while end > start && lines[end - 1].len == 0 { end -= 1 }
    if start < end { (mut out).push(10 as byte) }
    for i in start..end {
        add(mut out, "    ".bytes())
        add(mut out, lines[i])
        (mut out).push(10 as byte)
    }
    out
}

/// Pure pretty header/body with caller-supplied uniquely abbreviated identifiers.
/// short_ids contains the commit followed by its ordered parents.
pub fn render(
    value: walk.Commit,
    format: str,
    date_style: str,
    short_ids: List[str],
    abbreviate: bool,
) -> List[byte] ! worktree.WorkErrors {
    if short_ids.len != value.parents.len + 1 { return invalid }
    for field in value.headers.fields {
        if field.key == "encoding" && str_from_utf8(field.value)?.lower() != "utf-8" {
            return Unsupported("history message encoding")
        }
    }
    for i in 0..short_ids.len {
        let full_id = if i == 0 then oid.hex(value.id)? else oid.hex(value.parents[i - 1])?
        let prefix = oid.prefix("sha1", short_ids[i])?
        if !full_id.starts_with(prefix) { return invalid }
    }
    var out = List[byte]()
    let full = oid.hex(value.id)?
    let id = if abbreviate then short_ids[0] else full
    if format == "oneline" {
        add(mut out, "{id} ".bytes())
        add(mut out, message(value.headers.message, true)?)
        (mut out).push(10 as byte)
        return out
    }
    if format != "medium" && format != "short" && format != "full" && format != "fuller" {
        return Unsupported("history pretty {format}")
    }
    line(mut out, "commit {id}")
    if value.parents.len > 1 {
        add(mut out, "Merge:".bytes())
        for i in 1..short_ids.len { add(mut out, " {short_ids[i]}".bytes()) }
        (mut out).push(10 as byte)
    }
    for field in value.headers.fields {
        if field.key == "encoding" && str_from_utf8(field.value)? != "UTF-8" {
            return Unsupported("history message encoding")
        }
        if field.key != "author" && field.key != "committer" { continue }
        let (person, seconds, zone) = identity(field.value)?
        if field.key == "author" {
            line(mut out, if format == "fuller" then "Author:     {person}" else "Writer: {person}")
            if format == "medium" { line(mut out, "Date:   {date(seconds, zone, date_style)?}") }
            if format == "fuller" {
                line(mut out, "AuthorDate: {date(seconds, zone, date_style)?}")
            }
        } else if format == "full" || format == "fuller" {
            line(mut out, if format == "fuller" then "Commit:     {person}" else "Commit: {person}")
            if format == "fuller" {
                line(mut out, "CommitDate: {date(seconds, zone, date_style)?}")
            }
        }
    }
    if format == "short" {
        var pos = 0, started = false
        let raw = value.headers.message
        while pos < raw.len && raw[pos] != 0 as byte {
            let start = pos
            while pos < raw.len && raw[pos] != 10 as byte && raw[pos] != 0 as byte { pos += 1 }
            var end = pos
            while end > start && whitespace(raw[end - 1]) { end -= 1 }
            if end == start {
                if started { break }
            } else {
                if !started { (mut out).push(10 as byte); started = true }
                add(mut out, "    ".bytes())
                for j in start..end { (mut out).push(raw[j]) }
                (mut out).push(10 as byte)
            }
            if pos < raw.len && raw[pos] == 10 as byte { pos += 1 }
        }
    } else {
        add(mut out, message(value.headers.message, false)?)
    }
    out
}
