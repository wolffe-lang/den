//! member: false

use transport

fn bad(url: str, expected: str) -> bool {
    var refused = false
    let _ = transport.ssh_endpoint(url) else |e| {
        refused = "{e}" == expected
        transport.SshEndpoint { host: "", port: 0, path: "" }
    }
    refused
}

// The remote command is the words after the host, which ssh joins with
// spaces. Git sends a plain program word bare (measured black-box against
// the pinned Git with a recording ssh): `git-upload-pack '/path'`.
fn command_is(url: str, program: str, want: str, row: str) -> bool {
    let argv = transport.ssh_argv(url, program) else |e| {
        print("FAIL {row}: {e}")
        return false
    }
    let n = argv.len
    let got = "{argv[n - 2]} {argv[n - 1]}"
    if n < 4 || argv[n - 4] != "--" || argv[n - 3] != "example.invalid" || got != want {
        print("FAIL {row}: {got}")
        return false
    }
    print("PASS {row}")
    true
}

fn command_rows() -> int {
    let url = "ssh://example.invalid/srv/a b'c.git"
    let path = "'/srv/a b'\\''c.git'"
    let rows = [
        ["git-receive-pack", "git-receive-pack {path}", "ssh-command-receive-plain"],
        ["git-upload-pack", "git-upload-pack {path}", "ssh-command-upload-plain"],
        ["/opt/git/bin/git-upload-pack", "/opt/git/bin/git-upload-pack {path}", "ssh-command-override-plain"],
        ["Git_2.56+x/up-load", "Git_2.56+x/up-load {path}", "ssh-command-plain-word-set"],
        ["/opt/my git/git-upload-pack", "'/opt/my git/git-upload-pack' {path}", "ssh-command-override-space"],
        ["it's", "'it'\\''s' {path}", "ssh-command-override-quote"],
        ["git-upload-pack;id", "'git-upload-pack;id' {path}", "ssh-command-override-shell"],
        ["", "'' {path}", "ssh-command-override-empty"],
    ]
    var failed = 0
    for row in rows {
        if !command_is(url, row[0], row[1], row[2]) { failed = failed + 1 }
    }
    if !command_is("example.invalid:srv/repo.git", "git-upload-pack", "git-upload-pack 'srv/repo.git'", "ssh-command-scp") {
        failed = failed + 1
    }
    failed
}

fn main() -> int ! transport.Errors {
    let failed = command_rows()
    let plain = transport.ssh_endpoint("ssh://kasumi/home/user/lanes/vc16/repo.git")?
    if plain.host != "kasumi" || plain.port != 0 || plain.path != "/home/user/lanes/vc16/repo.git" {
        print("FAIL ssh-parser-uri")
        return 1
    }
    let scp = transport.ssh_endpoint("kasumi:lanes/vc16/repo.git")?
    if scp.host != "kasumi" || scp.port != 0 || scp.path != "lanes/vc16/repo.git" {
        print("FAIL ssh-parser-scp")
        return 1
    }
    let port = transport.ssh_endpoint("ssh://user@kasumi:22/a b'c.git")?
    if port.host != "user@kasumi" || port.port != 22 || port.path != "/a b'c.git" {
        print("FAIL ssh-parser-user-port")
        return 1
    }
    if transport.ssh_quote("a b'c;$x")? != "'a b'\\''c;$x'" {
        print("FAIL ssh-parser-quoting")
        return 1
    }
    for url in [
        "ssh:///a",
        "ssh://-kasumi/a",
        "ssh://kasumi:0/a",
        "ssh://kasumi:65536/a",
        "ssh://bad host/a",
        "kasumi:",
        "ssh://kasumi/a\nnext",
    ] {
        if !bad(url, "invalid") { print("FAIL ssh-parser-invalid"); return 1 }
    }
    if !bad("ssh://kasumi/a%20b", "Unsupported(percent-encoded ssh URL)") {
        print("FAIL ssh-parser-encoded")
        return 1
    }
    if failed > 0 {
        print("FAIL ssh-command: {failed} rows")
        return 1
    }
    print("ssh parser: URI/scp/user/port, literal quoting and pre-exec refusals")
    0
}
