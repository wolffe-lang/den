// Command edge for git-notes(1) add/show/list/remove/get-ref with message
// supplied notes. Editor, -F/-C/-c, append/copy/edit/merge/prune, --ref and
// --stdin are named refusals. Output bytes follow the pinned oracle.
use std.fs
use commit
use commit_format
use object
use oid
use refs
use repository
use revision
use worktree

fn target(repo: repository.Repo, name: str) -> oid.Oid ! commit.CommitErrors {
    revision.resolve(repo, name) else |e| match e {
        Unsupported(feature) => { return Unsupported(feature) },
        _ => { return Fatal("failed to resolve '{name}' as a valid ref.") },
    }
}

fn identity(ctx: worktree.Context, role: str) -> str ! commit.CommitErrors {
    commit_format.identity_text(commit.environment_identity(ctx, role, "")?)?
}

/// Write the tree, a notes commit over the previous tip and the ref with its
/// reflog record. Nothing is published before every object exists.
fn publish(
    ctx: worktree.Context,
    value: Notes,
    notes: List[Note],
    message: str,
) -> () ! commit.CommitErrors {
    let tree = write_tree(ctx.repo, notes)?
    let committer = identity(ctx, "COMMITTER")?
    let data = object.build_commit(
        tree,
        value.tip,
        identity(ctx, "AUTHOR")?,
        committer,
        "",
        owned("{message}\n"),
    )?
    let id = object.write_object(ctx.repo, "commit", data)?
    refs.update(
        ctx.repo,
        value.reference,
        value.tip,
        [id],
        committer,
        "notes: {message}",
        false,
    ) else |e| match e {
        exists => {
            return Fatal(
                "update_ref failed for ref '{value.reference}': cannot lock ref '{value.reference}': Unable to create '{ctx.repo.gitdir}/{value.reference}.lock': File exists.\n\nAnother git process seems to be running in this repository, or the lock file may be stale",
            )
        },
        _ => { return Fatal("cannot update ref '{value.reference}': {e}") },
    }
}

fn single(args: List[str], at: int, command: str) -> str ! commit.CommitErrors {
    if at + 1 < args.len { return Unsupported("notes {command} with more than one object") }
    if at < args.len then args[at] else "HEAD"
}

fn add(ctx: worktree.Context, reference: str, args: List[str]) -> int ! commit.CommitErrors {
    var force = false, allow_empty = false, supplied = false
    var messages = List[List[byte]](), objects = List[str]()
    var at = 1
    while at < args.len {
        let arg = args[at]
        at += 1
        if arg == "-f" || arg == "--force" {
            force = true
        } else if arg == "--allow-empty" {
            allow_empty = true
        } else if arg == "-m" || arg == "--message" {
            if at == args.len { return Unsupported("notes add missing message") }
            (mut messages).push(owned(args[at]))
            supplied = true
            at += 1
        } else if arg.starts_with("--message=") {
            (mut messages).push(owned(arg[10..]))
            supplied = true
        } else if arg.starts_with("-m") && arg.len > 2 {
            (mut messages).push(owned(arg[2..]))
            supplied = true
        } else if arg.starts_with("-") {
            return Unsupported("notes add {arg}")
        } else {
            (mut objects).push(arg)
        }
    }
    if !supplied { return Unsupported("notes editor") }
    let name = single(objects, 0, "add")?
    let id = target(ctx.repo, name)?
    let hex = oid.hex(id)?
    let value = read(ctx.repo, reference)?
    let existing = find(value, id)
    if existing.len > 0 && !force {
        return Failure(
            "Cannot add notes. Found existing notes for object {hex}. Use '-f' to overwrite existing notes",
        )
    }
    var input = List[byte]()
    for i in 0..messages.len {
        if i > 0 { (mut input).push(10 as byte); (mut input).push(10 as byte) }
        for b in messages[i] { (mut input).push(b) }
    }
    let message = commit_format.cleanup(input, "whitespace", "#", false)?
    if existing.len > 0 { eprint("Overwriting existing notes for object {hex}") }
    if message.len == 0 && !allow_empty {
        eprint("Removing note for object {hex}")
        if existing.len > 0 {
            publish(ctx, value, with_note(value, id, [])?, "Notes removed by 'git notes add'")?
        }
        return 0
    }
    let blob = object.write_object(ctx.repo, "blob", message)?
    publish(ctx, value, with_note(value, id, [blob])?, "Notes added by 'git notes add'")?
    0
}

fn show(ctx: worktree.Context, reference: str, args: List[str]) -> int ! commit.CommitErrors {
    for arg in args[1..] { if arg.starts_with("-") { return Unsupported("notes show {arg}") } }
    let id = target(ctx.repo, single(args, 1, "show")?)?
    let blob = find(read(ctx.repo, reference)?, id)
    if blob.len == 0 { return Failure("no note found for object {oid.hex(id)?}.") }
    let stored = object.read_object(ctx.repo, blob[0], 16777216)?
    if stored.kind != "blob" { return Unsupported("notes show {stored.kind} note") }
    var stdout = fs.stdout()
    fs.write_chunk(mut stdout, stored.data)?
    0
}

fn list(ctx: worktree.Context, reference: str, args: List[str]) -> int ! commit.CommitErrors {
    let first = if args.len > 0 && args[0] == "list" then 1 else 0
    for arg in args[first..] { if arg.starts_with("-") { return Unsupported("notes list {arg}") } }
    let value = read(ctx.repo, reference)?
    var out = List[byte]()
    if args.len > first {
        let id = target(ctx.repo, single(args, first, "list")?)?
        let blob = find(value, id)
        if blob.len == 0 { return Failure("no note found for object {oid.hex(id)?}.") }
        for b in "{oid.hex(blob[0])?}\n".bytes() { (mut out).push(b) }
    } else {
        for note in value.notes {
            for b in "{oid.hex(note.blob)?} {oid.hex(note.object)?}\n".bytes() { (mut out).push(b) }
        }
    }
    var stdout = fs.stdout()
    fs.write_chunk(mut stdout, out)?
    0
}

fn remove(ctx: worktree.Context, reference: str, args: List[str]) -> int ! commit.CommitErrors {
    var ignore_missing = false
    var names = List[str]()
    for arg in args[1..] {
        if arg == "--ignore-missing" {
            ignore_missing = true
        } else if arg.starts_with("-") {
            return Unsupported("notes remove {arg}")
        } else {
            (mut names).push(arg)
        }
    }
    if names.len == 0 { (mut names).push("HEAD") }
    let value = read(ctx.repo, reference)?
    var current = Notes { reference: reference, tip: copy value.tip, notes: copy value.notes }
    var status = 0, removed = 0
    for name in names {
        let id = revision.resolve(ctx.repo, name) else |e| match e {
            Unsupported(feature) => { return Unsupported(feature) },
            _ => { return Failure("Failed to resolve '{name}' as a valid ref.") },
        }
        if find(current, id).len == 0 {
            eprint("Object {name} has no note")
            if !ignore_missing { status = 1 }
            continue
        }
        eprint("Removing note for object {name}")
        current.notes = with_note(current, id, [])?
        removed += 1
    }
    // Measured: one missing object without --ignore-missing commits nothing.
    if removed > 0 && status == 0 {
        publish(ctx, value, current.notes, "Notes removed by 'git notes remove'")?
    }
    status
}

fn dispatch(args: List[str]) -> int ! commit.CommitErrors {
    var rest = List[str]()
    for i in 1..args.len { (mut rest).push(args[i]) }
    if rest.len > 0 && rest[0].starts_with("--ref") { return Unsupported("notes --ref") }
    let ctx = worktree.discover(".")?
    let reference = default_ref(ctx.repo)?
    if rest.len == 0 || rest[0] == "list" { return list(ctx, reference, rest)? }
    if rest[0] == "add" { return add(ctx, reference, rest)? }
    if rest[0] == "show" { return show(ctx, reference, rest)? }
    if rest[0] == "remove" { return remove(ctx, reference, rest)? }
    if rest[0] == "get-ref" && rest.len == 1 { print(reference); return 0 }
    Unsupported("notes {rest[0]}")
}

/// CLI boundary: measured output or an explicit unsupported feature.
pub fn run(args: List[str]) -> int {
    repository.check_config(".") else |e| match e {
        ConfigDiagnostic(message) => { eprint(message); return 128 },
        _ => {},
    }
    dispatch(args) else |e| match e {
        Fatal(message) => { eprint("fatal: {message}"); 128 },
        Failure(message) => { eprint("error: {message}"); 1 },
        Unsupported(message) => { eprint("den: not yet implemented: {message}"); 2 },
        _ => { eprint("fatal: {e}"); 128 },
    }
}
