// Clean-room: Git v2.56.0 Documentation/git-notes.adoc (Description,
// Subcommands, Options, Discussion, Configuration, Environment) and
// black-box runs of the pinned oracle. No implementation source consulted.
// Store-facing read/write over the pure notestree layer (R-vc12-2).
use notestree
use object
use oid
use refs
use repository
use worktree

/// Owned notes state of one ref: its zero or one tip commit and every note,
/// sorted by the annotated object's lowercase hex name.
pub struct Notes { reference: str, tip: List[oid.Oid], notes: List[notestree.Note] }

struct Pending { prefix: str, id: oid.Oid }

fn owned(text: str) -> List[byte] {
    var out = List[byte]()
    for b in text.bytes() { (mut out).push(b) }
    out
}

fn hex_name(name: List[byte]) -> bool {
    if name.len == 0 { return false }
    for b in name {
        if !(b >= 48 as byte && b <= 57 as byte || b >= 97 as byte && b <= 102 as byte) {
            return false
        }
    }
    true
}

/// The default notes ref. Other refs (--ref, GIT_NOTES_REF, core.notesRef)
/// are named refusals rather than silently ignored overrides.
pub fn default_ref(repo: repository.Repo) -> str ! worktree.WorkErrors {
    if (env_get("GIT_NOTES_REF") else "") != "" { return Unsupported("notes GIT_NOTES_REF") }
    if (repo.config["core.notesref"] else "") != "" { return Unsupported("notes core.notesRef") }
    "refs/notes/commits"
}

/// Read every note of reference. Any permitted pathname fan-out (a sequence of
/// two-hex directories followed by the rest of the name) is accepted. An absent
/// ref is an empty set. Other entries and a ref naming a tree refuse by name.
pub fn read(repo: repository.Repo, reference: str) -> Notes ! worktree.WorkErrors {
    let tip = refs.optional(repo, reference)?
    var notes = List[notestree.Note]()
    if tip.len == 0 { return Notes { reference: reference, tip: tip, notes: notes } }
    let stored = object.read_object(repo, tip[0], 16777216)?
    if stored.kind != "commit" { return Unsupported("notes ref to a {stored.kind}") }
    let headers = object.parse_commit(stored.data, "sha1")?
    var root = List[oid.Oid]()
    for field in headers.fields {
        if field.key == "tree" && root.len == 0 {
            (mut root).push(oid.parse("sha1", str_from_utf8(field.value)?)?)
        }
    }
    if root.len != 1 { return invalid_header }
    var pending = [Pending { prefix: "", id: copy root[0] }]
    var trees = 0
    while pending.len > 0 {
        let next = (mut pending).pop() else |_| { return invalid }
        trees += 1
        if trees > 70000 { return Unsupported("notes tree limit") }
        let body = object.read_object(repo, next.id, 16777216)?
        if body.kind != "tree" { return invalid_tree }
        for entry in object.parse_tree(body.data, "sha1")? {
            if !hex_name(entry.name) {
                return Unsupported("notes tree entry {str_from_utf8(entry.name) else "<bytes>"}")
            }
            let name = "{next.prefix}{str_from_utf8(entry.name)?}"
            if entry.mode == 0o40000 && entry.name.len == 2 && name.len < 40 {
                (mut pending).push(Pending { prefix: name, id: copy entry.id })
            } else if entry.mode == 0o100644 && name.len == 40 {
                notestree.insert(mut notes, notestree.
                    Note { object: oid.parse("sha1", name)?, blob: copy entry.id })?
            } else {
                return Unsupported("notes tree entry {name}")
            }
        }
    }
    Notes { reference: reference, tip: tip, notes: notes }
}

/// Empty when object has no note, otherwise its one note blob.
pub fn find(value: Notes, object: oid.Oid) -> List[oid.Oid] { notestree.find(value.notes, object) }

/// The set with object's note replaced, inserted or (empty blob list) removed.
pub fn with_note(
    value: Notes,
    object: oid.Oid,
    blob: List[oid.Oid],
) -> List[notestree.Note] ! worktree.WorkErrors {
    notestree.with_note(value.notes, object, blob)?
}

/// The measured default-format history block for target's note, or empty.
pub fn display(
    repo: repository.Repo,
    value: Notes,
    target: oid.Oid,
) -> List[byte] ! worktree.WorkErrors {
    let blob = notestree.find(value.notes, target)
    if blob.len == 0 { return List[byte]() }
    let stored = object.read_object(repo, blob[0], 16777216)?
    if stored.kind != "blob" { return Unsupported("history notes {stored.kind} note") }
    notestree.display(stored.data)?
}

/// Write the notes tree in the oracle's measured shape; returns the root id.
pub fn write_tree(
    repo: repository.Repo,
    notes: List[notestree.Note],
) -> oid.Oid ! worktree.WorkErrors {
    let level = notestree.fanout(notes)?
    var root = List[object.TreeEntry]()
    if level == 0 {
        for note in notes {
            (mut root).push(object.TreeEntry {
                mode: 0o100644,
                name: owned(oid.hex(note.object)?),
                id: copy note.blob,
            })
        }
    } else {
        var at = 0
        while at < notes.len {
            let first = oid.hex(notes[at].object)?
            let key = first[0..2]
            var leaves = List[object.TreeEntry]()
            while at < notes.len {
                let hex = oid.hex(notes[at].object)?
                if hex[0..2] != key { break }
                (mut leaves).push(object.TreeEntry {
                    mode: 0o100644,
                    name: owned(hex[2..]),
                    id: copy notes[at].blob,
                })
                at += 1
            }
            let sub = object.write_object(repo, "tree", object.build_tree(leaves, "sha1")?)?
            (mut root).push(object.TreeEntry { mode: 0o40000, name: owned(key), id: sub })
        }
    }
    object.write_object(repo, "tree", object.build_tree(root, "sha1")?)?
}
