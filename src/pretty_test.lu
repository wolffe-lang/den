//! member: false

use oid
use pretty
use walk
use worktree

fn same(a: List[byte], b: List[byte]) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if a[i] != b[i] { return false } }
    true
}

fn main() -> int ! worktree.WorkErrors {
    assert(pretty.date(1700000000, "+0530", "default")? == "Wed Nov 15 03:43:20 2023 +0530")
    assert(pretty.date(0, "+0000", "iso-strict")? == "1970-01-01T00:00:00Z")
    assert(pretty.date(1700000000, "-0330", "raw")? == "1700000000 -0330")
    assert(
        same(pretty.message("\n hello \nworld\n\nbody\n".bytes(), true)?, " hello world".bytes()),
    )
    assert(
        same(
            pretty.message("\nhello\n\tworld\n\n".bytes(), false)?,
            "\n    hello\n            world\n".bytes(),
        ),
    )
    let id = oid.parse("sha1", "0123456789012345678901234567890123456789")?
    let raw = "tree 0123456789012345678901234567890123456789\nauthor A <a@b> 1700000000 +0530\ncommitter C <c@d> 1700000001 +0000\n\nsubject\n"
    let value = walk.parse(id, raw.bytes())?
    assert(value.timestamp == 1700000001 && value.parents.len == 0)
    assert(
        same(
            pretty.render(value, "oneline", "default", ["0123456"], true)?,
            "0123456 subject\n".bytes(),
        ),
    )
    assert(same(value.headers.message, "subject\n".bytes()))
    0
}
