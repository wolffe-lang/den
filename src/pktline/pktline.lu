// Original binary-clean framing from Git 2.56.0 gitprotocol-common/v2.
/// Framing failures: invalid syntax, incomplete bytes, or the documented size limit; never traps.
pub error Errors = {invalid, truncated, limit, Unsupported(str)}

/// kind 0/1/2 are flush/delimiter/response-end; 4 is data (including empty).
pub struct Packet { kind: int, data: List[byte], next: int }

/// Read exactly four lowercase hex digits; preserve special lengths 0/1/2, reject 3 and values above 65520.
pub fn header(bytes: List[byte]) -> int ! Errors {
    if bytes.len != 4 { return truncated }
    var n = 0
    for b in bytes {
        let c = b as int
        if c >= 48 && c <= 57 {
            n = n * 16 + c - 48
        } else if c >= 97 && c <= 102 {
            n = n * 16 + c - 87
        } else {
            return invalid
        }
    }
    if n == 3 { return invalid }
    if n > 65520 { return Unsupported("limit: a pkt-line longer than 65520 bytes") }
    n
}

/// Encode arbitrary binary payload with its inclusive length; limit above 65516 data bytes, never traps.
pub fn encode(data: List[byte]) -> List[byte] ! Errors {
    if data.len > 65516 { return Unsupported("limit: a pkt-line payload longer than 65516 bytes") }
    let n = data.len + 4
    let digits = "0123456789abcdef".bytes()
    var out = List[byte]()
    for shift in [12, 8, 4, 0] { (mut out).push(digits[n >> shift & 15]) }
    for b in data { (mut out).push(b) }
    out
}

/// Decode one packet, preserving a next offset for concatenated streams.
pub fn decode(bytes: List[byte], start: int) -> Packet ! Errors {
    if start < 0 || start > bytes.len { return invalid }
    if bytes.len - start < 4 { return truncated }
    let n = header(bytes[start..start + 4])?
    if n < 4 { return Packet { kind: n, data: List[byte](), next: start + 4 } }
    if n > bytes.len - start { return truncated }
    Packet { kind: 4, data: copy bytes[start + 4..start + n], next: start + n }
}

/// UTF-8 text adapter; framing itself is binary-clean. LF is optional, never
/// strip other bytes. Non-UTF-8 names remain an explicit caller-level refusal.
pub fn text(bytes: List[byte]) -> str ! Errors {
    for b in bytes { if b == 0 as byte { return invalid } }
    let end = if bytes.len > 0 && bytes[bytes.len - 1] == 10 as byte {
        bytes.len - 1
    } else {
        bytes.len
    }
    str_from_utf8(bytes[0..end]) else |_| { return invalid }
}
