//! member: false

use commit_format

fn bytes_equal(left: List[byte], right: List[byte]) -> bool {
    if left.len != right.len { return false }
    for i in 0..left.len { if left[i] != right[i] { return false } }
    true
}

fn date_rejected(text: str) -> bool {
    var rejected = false
    let _ = commit_format.parse_date(text, "+0000") else |_| {
        rejected = true
        commit_format.Date { seconds: 0, offset: "+0000" }
    }
    rejected
}

fn raw_case(
    value: str,
    split: bool,
    name: str,
    email: str,
    stamp: str,
    seconds: str,
    zone: str,
    problem: str,
) {
    let r = commit_format.raw_identity(value.bytes())
    let (id, _) = commit_format.identity_problem(value.bytes())
    let good = r.split == split &&
        bytes_equal(r.name, name.bytes()) &&
        bytes_equal(r.email, email.bytes()) &&
        r.dated == (stamp != "") &&
        bytes_equal(r.stamp, stamp.bytes()) &&
        r.seconds_text == (if stamp == "" then "0" else seconds) &&
        bytes_equal(r.zone_text, zone.bytes()) &&
        id == problem
    if !good { print("FAIL raw identity row: {value} -> {id}") }
    assert(good)
}

fn shown_case(seconds: int, zone: int, style: str, text: str, fatal: str) -> () ! {
    Unsupported(str),
} {
    let shown = commit_format.shown_date(seconds, zone, style)?
    let good = shown.text == text && shown.fatal == fatal
    if !good {
        print("FAIL shown date row: {seconds} {zone} {style} -> {shown.text} / {shown.fatal}")
    }
    assert(good)
}

// vc26: identities split and checked as the pinned Git reads them back
// (notes/vc26-evidence/measured-base.txt), and dates shown as it shows them.
fn raw_rows() -> () ! commit_format.FormatErrors {
    let full = "1700000000"
    raw_case(
        "A U Thor <author@example.invalid> 1700000000 +0000",
        true,
        "A U Thor",
        "author@example.invalid",
        full,
        full,
        "+0000",
        "",
    )
    raw_case(
        "walker0643 <> 1519250155 -0500",
        true,
        "walker0643",
        "",
        "1519250155",
        "1519250155",
        "-0500",
        "",
    )
    raw_case(" <e@x> 1700000000 +0000", true, "", "e@x", full, full, "+0000", "")
    raw_case("   <e@x> 1700000000 +0000", true, "", "e@x", full, full, "+0000", "")
    raw_case(
        "<e@x> 1700000000 +0000",
        true,
        "",
        "e@x",
        full,
        full,
        "+0000",
        "missingNameBeforeEmail",
    )
    raw_case("<> 1700000000 +0000", true, "", "", full, full, "+0000", "missingNameBeforeEmail")
    raw_case("A U Thor 1700000000 +0000", false, "", "", "", "", "", "missingEmail")
    raw_case(
        "A U Thor<a@x> 1700000000 +0000",
        true,
        "A U Thor",
        "a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeEmail",
    )
    raw_case(
        "A U Thor\t<a@x> 1700000000 +0000",
        true,
        "A U Thor",
        "a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeEmail",
    )
    raw_case(
        "  A U Thor   <a@x> 1700000000 +0000",
        true,
        "  A U Thor",
        "a@x",
        full,
        full,
        "+0000",
        "",
    )
    raw_case(
        "A <a@x>1700000000 +0000",
        true,
        "A",
        "a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeDate",
    )
    raw_case(
        "A <a@x>\t1700000000 +0000",
        true,
        "A",
        "a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeDate",
    )
    raw_case("A <a@x>  1700000000 +0000", true, "A", "a@x", full, full, "+0000", "")
    raw_case("A <a@x> \t1700000000 +0000", true, "A", "a@x", full, full, "+0000", "")
    raw_case("A <a@x>", true, "A", "a@x", "", "", "", "missingSpaceBeforeDate")
    raw_case("A <a@x> ", true, "A", "a@x", "", "", "", "badDate")
    raw_case("A <a@x> 0 +0000", true, "A", "a@x", "0", "0", "+0000", "")
    raw_case("A <a@x> 0", true, "A", "a@x", "", "", "", "zeroPaddedDate")
    raw_case("A <a@x> 00 +0000", true, "A", "a@x", "00", "0", "+0000", "zeroPaddedDate")
    raw_case(
        "A <a@x> 01700000000 +0000",
        true,
        "A",
        "a@x",
        "01700000000",
        full,
        "+0000",
        "zeroPaddedDate",
    )
    raw_case(
        "A <a@x>  01700000000 +0000",
        true,
        "A",
        "a@x",
        "01700000000",
        full,
        "+0000",
        "zeroPaddedDate",
    )
    raw_case("A <a@x> -1 +0000", true, "A", "a@x", "", "", "", "badDate")
    raw_case("A <a@x> 1700000000", true, "A", "a@x", "", "", "", "badDate")
    raw_case("A <a@x> 1700000000+0000", true, "A", "a@x", full, full, "+0000", "badDate")
    raw_case(
        "A <a@x> 9223372036854775807 +0000",
        true,
        "A",
        "a@x",
        "9223372036854775807",
        "9223372036854775807",
        "+0000",
        "",
    )
    raw_case(
        "A <a@x> 9223372036854775808 +0000",
        true,
        "A",
        "a@x",
        "9223372036854775808",
        "9223372036854775808",
        "+0000",
        "badDateOverflow",
    )
    raw_case(
        "A <a@x> 18446744073709551616 -0500",
        true,
        "A",
        "a@x",
        "18446744073709551616",
        "18446744073709551615",
        "-0500",
        "badDateOverflow",
    )
    raw_case("A <a@x> 1700000000 +00000", true, "A", "a@x", full, full, "+00000", "badTimezone")
    raw_case("A <a@x> 1700000000 +000", true, "A", "a@x", full, full, "+000", "badTimezone")
    raw_case("A <a@x> 1700000000 0000", true, "A", "a@x", "", "", "", "badTimezone")
    raw_case("A <a@x> 1700000000 +00a0", true, "A", "a@x", full, full, "+00", "badTimezone")
    raw_case("A <a@x> 1700000000  +0000", true, "A", "a@x", full, full, "+0000", "badTimezone")
    raw_case(
        "A <a@x> 1700000000 +0000 garbage",
        true,
        "A",
        "a@x",
        full,
        full,
        "+0000",
        "badTimezone",
    )
    raw_case("A <a@x> 1700000000 +0000\r", true, "A", "a@x", full, full, "+0000", "badTimezone")
    raw_case("A <a@x> 1700000000 +0099", true, "A", "a@x", full, full, "+0099", "")
    raw_case(
        "Jo<e <a@x> 1700000000 +0000",
        true,
        "Jo",
        "e <a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeEmail",
    )
    raw_case("Jo>e <a@x> 1700000000 +0000", true, "Jo>e", "a@x", full, full, "+0000", "badName")
    raw_case("A <a<b@x> 1700000000 +0000", true, "A", "a<b@x", full, full, "+0000", "badEmail")
    raw_case(
        "A <a>b@x> 1700000000 +0000",
        true,
        "A",
        "a",
        full,
        full,
        "+0000",
        "missingSpaceBeforeDate",
    )
    raw_case(
        "A <a@x>> 1700000000 +0000",
        true,
        "A",
        "a@x",
        full,
        full,
        "+0000",
        "missingSpaceBeforeDate",
    )
    raw_case("A <a@x 1700000000 +0000", false, "", "", "", "", "", "badEmail")
    let five = commit_format.raw_identity("A <a@x> 1 +12345".bytes())
    let minus = commit_format.raw_identity("A <a@x> 1 -5".bytes())
    assert(five.zone == 12345 && minus.zone == -5 && five.fits && five.seconds == 1)
    assert(!commit_format.raw_identity("A <a@x> 9223372036854775808 +0000".bytes()).fits)

    shown_case(1700000000, 0, "default", "Tue Nov 14 22:13:20 2023 +0000", "")?
    shown_case(1700000000, 99, "default", "Tue Nov 14 23:52:20 2023 +0099", "")?
    shown_case(1700000000, 1, "rfc", "Tue, 14 Nov 2023 22:14:20 +0001", "")?
    shown_case(1700000000, -5, "iso", "2023-11-14 22:08:20 -0005", "")?
    shown_case(1700000000, 12345, "iso-strict", "2023-11-20T01:58:20+123:45", "")?
    shown_case(1700000000, -1230, "iso-strict", "2023-11-14T09:43:20-12:30", "")?
    shown_case(1700000000, 0, "iso-strict", "2023-11-14T22:13:20Z", "")?
    shown_case(1700000000, 9999, "short", "2023-11-19", "")?
    shown_case(253402300800, 0, "default", "Sat Jan 1 00:00:00 10000 +0000", "")?
    shown_case(100000000000000, 0, "default", "Sat Nov 7 09:46:40 3170843 +0000", "")?
    shown_case(67767976233532799, 0, "iso", "2147483647-12-31 23:59:59 +0000", "")?
    shown_case(67767976233532800, 0, "default", "Wed Jan 1 00:00:00 -2147483648 +0000", "")?
    shown_case(67768036191676799, 0, "default", "Wed Dec 31 23:59:59 -2147481749 +0000", "")?
    shown_case(67768036191676800, 0, "default", "Thu Jan 1 00:00:00 1970 +0000", "")?
    shown_case(9223372036854775807, -500, "rfc", "Thu, 1 Jan 1970 00:00:00 +0000", "")?
    shown_case(9223372036854775807, -500, "raw", "9223372036854775807 -0500", "")?
    shown_case(0, -500, "default", "", "Timestamp before Unix epoch: 0 -500")?
    shown_case(0, -500, "raw", "0 -0500", "")?
    shown_case(1700000000, 530, "default-local", "Tue Nov 14 22:13:20 2023", "")?
    assert(commit_format.zone_shown(0) == "+0000" && commit_format.zone_shown(-1230) == "-1230")
    print("PASS vc26 raw identities, Git's identity checks and shown dates")
}

fn main() -> int ! commit_format.FormatErrors {
    raw_rows()?
    assert(
        commit_format.identity_text(commit_format.parse_identity("Name <n> 1 +10039")?)? ==
            "Name <n> 1 +10039",
    )

    for (input, expected) in [
        ("@0 +0000", "0 +0000"),
        ("@0 -0000", "0 +0000"),
        ("@1 -0000", "1 +0000"),
        ("@1 +0530", "1 +0530"),
        ("@1 +2400", "1 +2400"),
        ("@1 +2460", "1 +2500"),
        ("@1 -2460", "1 -2500"),
        ("@1 +9999", "1 +10039"),
        ("@1 -9999", "1 -10039"),
        ("@0 +0060", "0 +0100"),
        ("@1700000000", "1700000000 +0000"),
        ("1700000000 -0700", "1700000000 -0700"),
        ("2005-04-07T22:13:13+02:00", "1112904793 +0200"),
        ("2005-04-07T22:13:13 +0200", "1112904793 +0200"),
        ("2005-04-07 22:13:13 +0200", "1112904793 +0200"),
        ("2005-04-07T20:13:13Z", "1112904793 +0000"),
        ("2005-04-07T20:13:13.019Z", "1112904793 +0000"),
        ("2005.04.07 22:13:13 +0200", "1112904793 +0200"),
        ("04/07/2005 22:13:13 +0200", "1112904793 +0200"),
        ("07.04.2005 22:13:13 +0200", "1112904793 +0200"),
        ("Thu, 07 Apr 2005 22:13:13 +0200", "1112904793 +0200"),
        ("07 Apr 2005 22:13:13 +0200", "1112904793 +0200"),
        ("Thu, 07 Apr 2005 22:13:13 EDT", "1112926393 -0400"),
        ("2000-02-29T12:00:00Z", "951825600 +0000"),
        ("2000-02-30T12:00:00Z", "951912000 +0000"),
        ("2000-02-31T12:00:00Z", "951998400 +0000"),
        ("2023-02-29T12:00:00Z", "1677672000 +0000"),
        ("2005-04-31T12:00:00Z", "1114948800 +0000"),
        ("2005-13-01T12:00:00Z", "1105617600 +0000"),
        ("2005-04-07T24:00:00Z", "1112918400 +0000"),
        ("2005-04-07T24:01:00Z", "1112918460 +0000"),
        ("2005-04-07T25:00:00Z", "1112832000 +0000"),
        ("2005-04-07T99:00:00Z", "1112832000 +0000"),
        ("2005-04-07T100:00:00Z", "1112832000 +0000"),
        ("2005-04-07T22:60:00Z", "1112911200 +0000"),
        ("2005-04-07T22:61:00Z", "1112911200 +0000"),
        ("2005-04-07T22:99:00Z", "1112911200 +0000"),
        ("2005-04-07T22:100:00Z", "1112911200 +0000"),
        ("2005-04-07T22:13:60Z", "1112912040 +0000"),
        ("2005-04-07T22:13:61Z", "1112911200 +0000"),
        ("2005-04-07T22:13:99Z", "1112911200 +0000"),
        ("2005-04-07T22:13:100Z", "1112911200 +0000"),
        ("2024-02-29T00:00:00Z", "1709164800 +0000"),
        ("2000-01-01 00:00", "946684800 +0000"),
        ("@9223372036854775807 +0000", "9223372036854775807 +0000"),
    ] {
        assert(commit_format.date_text(commit_format.parse_date(input, "+0000")?)? == expected)
    }
    assert(
        commit_format.date_text(commit_format.parse_date("2005-04-07 22:13:13", "+0530")?)? ==
            "1112892193 +0530",
    )
    // Calendar rollover is arithmetic over bounded components, not a table of
    // measured timestamps; cover leap and non-leap centuries independently.
    for (rolled, canonical) in [
        ("2005-02-29T12:00:00Z", "2005-03-01T12:00:00Z"),
        ("2100-02-29T12:00:00Z", "2100-03-01T12:00:00Z"),
        ("2000-02-31T12:00:00Z", "2000-03-02T12:00:00Z"),
    ] {
        assert(
            commit_format.date_text(commit_format.parse_date(rolled, "+0000")?)? ==
                commit_format.date_text(commit_format.parse_date(canonical, "+0000")?)?,
        )
    }
    let expanded = commit_format.parse_date("@1 +9999", "+0000")?
    assert(expanded.offset == "+10039")
    assert(commit_format.date_text(commit_format.Date { seconds: 1, offset: "+10039" })? == "1 +10039")
    assert(commit_format.date_text(commit_format.parse_date("@1", "+9999")?)? == "1 +10039")
    assert(
        commit_format.identity_text(commit_format.make_identity("A", "a", expanded)?)? ==
            "A <a> 1 +10039",
    )
    let long_fraction = "2005-04-07T20:13:13.{"9".repeat(100)}Z"
    assert(commit_format.parse_date(long_fraction, "+0000")?.seconds == 1112904793)
    for input in [
        "",
        "@",
        "@-1 +0000",
        "@9223372036854775808 +0000",
        "@1 +10039",
        "@1 +10000",
        "@1 +123456",
        "@0 +00x0",
        "@0 +0é0",
        "@0 +0000 extra",
        "0 +0000",
        "2005-00-01T12:00:00Z",
        "2005-04-00T12:00:00Z",
        "2005-01-32T12:00:00Z",
        "2000-01-00T00:00:00Z",
        "@1 +5",
        "@1 +005",
        "@1 +00:60",
        "2000-01-01T00:00:00.xZ",
        "2000-01-01T00:00:00.Z",
        "2000-01-01T00:00:00Z +0100",
        "1970-01-01T00:00:00+0100",
        "@0\0 +0000",
        "@0\n+0000",
        "@0 \r+0000",
        "@{"9".repeat(1025)} +0000",
    ] {
        assert(date_rejected(input))
    }
    for input in ["now", "yesterday", "last Friday at noon", "2 days ago", "2005-04-07"] {
        var named = false
        let _ = commit_format.parse_date(input, "+0000") else |e| {
            named = "{e}".starts_with("Unsupported(")
            commit_format.Date { seconds: 0, offset: "+0000" }
        }
        assert(named)
    }
    // Every byte-oriented prefix stays a recoverable row or a parsed date.
    let seed = "2005-04-07T22:13:13.019+02:00"
    for end in 0..=seed.len {
        let _ = commit_format.parse_date(seed[0..end], "+0000") else commit_format.Date {
            seconds: 0,
            offset: "+0000",
        }
    }

    let input = "\n\t \nsubject  \r\n\n\n# comment\nbody\t\n\n".bytes()
    assert(
        bytes_equal(
            commit_format.cleanup(input, "strip", "#", false)?,
            "subject\n\nbody\n".bytes(),
        ),
    )
    assert(
        bytes_equal(
            commit_format.cleanup(input, "whitespace", "#", false)?,
            "subject\n\n# comment\nbody\n".bytes(),
        ),
    )
    assert(bytes_equal(commit_format.cleanup(input, "verbatim", "#", false)?, input))
    assert(
        bytes_equal(
            commit_format.cleanup(input, "default", "#", true)?,
            commit_format.cleanup(input, "strip", "#", true)?,
        ),
    )
    assert(
        bytes_equal(
            commit_format.cleanup(input, "default", "#", false)?,
            commit_format.cleanup(input, "whitespace", "#", false)?,
        ),
    )
    let scissors = "subject\n\n# ------------------------ >8 ------------------------\nremoved\n".
        bytes()
    assert(
        bytes_equal(commit_format.cleanup(scissors, "scissors", "#", true)?, "subject\n".bytes()),
    )
    assert(bytes_equal(commit_format.cleanup(scissors, "scissors", "#", false)?, scissors))
    assert(
        bytes_equal(
            commit_format.cleanup(
                "a\n// ------------------------ >8 ------------------------\nb\n".bytes(),
                "scissors",
                "//",
                true,
            )?,
            "a\n".bytes(),
        ),
    )
    assert(
        bytes_equal(
            commit_format.cleanup(
                "// removed\n# kept\n // kept\né removed\nbody\n".bytes(),
                "strip",
                "//",
                true,
            )?,
            "# kept\n // kept\né removed\nbody\n".bytes(),
        ),
    )
    assert(
        bytes_equal(
            commit_format.cleanup("é comment\nbody".bytes(), "strip", "é", true)?,
            "body\n".bytes(),
        ),
    )
    assert(commit_format.comment_marker("# old\n; old\n".bytes(), "auto")? == "@")
    assert(commit_format.comment_marker(" # indented\n".bytes(), "auto")? == "#")
    assert(
        bytes_equal(
            commit_format.cleanup("a\n\n#only\n\nb".bytes(), "strip", "#", false)?,
            "a\n\nb\n".bytes(),
        ),
    )
    assert(
        bytes_equal(
            commit_format.cleanup([255 as byte, 0 as byte, 32 as byte], "strip", "#", false)?,
            [255 as byte, 0 as byte, 10 as byte],
        ),
    )
    assert(bytes_equal(commit_format.cleanup([], "strip", "#", false)?, []))
    assert(
        commit_format.message_empty(
            commit_format.cleanup(" \n#comment\n".bytes(), "strip", "#", false)?,
            "strip",
            false,
        )?,
    )
    assert(!commit_format.message_empty("#comment\n".bytes(), "whitespace", false)?)
    assert(commit_format.message_empty([], "verbatim", false)?)
    assert(!commit_format.message_empty(" \n".bytes(), "verbatim", false)?)
    assert(commit_format.message_empty(" \n".bytes(), "default", false)?)
    assert(
        bytes_equal(
            commit_format.paragraphs(["one".bytes(), "two\n".bytes()])?,
            "one\n\ntwo\n".bytes(),
        ),
    )
    assert(
        bytes_equal(
            commit_format.paragraphs([[], "one".bytes(), [], "two".bytes()])?,
            "one\n\n\ntwo\n".bytes(),
        ),
    )
    assert(bytes_equal(commit_format.paragraphs([[], []])?, []))
    let source = [255 as byte, 0 as byte, 10 as byte]
    var body = commit_format.file_message(source)?
    body[0] = 1 as byte
    assert(source[0] == 255 as byte)
    var raw = commit_format.cleanup(source, "verbatim", "#", false)?
    raw[0] = 2 as byte
    assert(source[0] == 255 as byte)

    let date = commit_format.parse_date("@1700000000 +0530", "+0000")?
    let ident = commit_format.make_identity("  A U Thor  ", " author@example.invalid ", date)?
    assert(
        commit_format.identity_text(ident)? == "A U Thor <author@example.invalid> 1700000000 +0530",
    )
    let author = commit_format.parse_author("José 名 <j@example.invalid>", date)?
    assert(author.name == "José 名" && author.email == "j@example.invalid")
    let restored = commit_format.parse_identity("A <a> 0 -0000")?
    assert(commit_format.identity_text(restored)? == "A <a> 0 +0000")
    assert(commit_format.make_identity("A\n<B>", "<a>", date)?.name == "AB")
    assert(
        commit_format.identity_text(commit_format.parse_author("A <a b>", date)?)? ==
            "A <a b> 1700000000 +0530",
    )
    var bad_identity = false
    let _ = commit_format.make_identity("A\0B", "a", date) else |e| {
        bad_identity = "{e}" == "invalid_identity"
        copy ident
    }
    assert(bad_identity)
    var pattern = false
    let _ = commit_format.parse_author("author-search", date) else |e| {
        pattern = "{e}" == "Unsupported(commit --author pattern)"
        copy ident
    }
    assert(pattern)
    // vc26: Git writes an explicitly empty email (measured: --author='X <>').
    assert(commit_format.parse_author("A <>", date)?.email == "")
    assert(commit_format.make_identity(",J. R.;", " <e>. ", date)?.name == "J. R.")
    assert(commit_format.make_identity(",J. R.;", " <e>. ", date)?.email == "e>.".replace(">", ""))
    for text in ["A <a", "A <a> suffix", "<a>", "A <a> <b>"] {
        var invalid = false
        let _ = commit_format.parse_author(text, date) else |_| {
            invalid = true
            copy ident
        }
        assert(invalid)
    }
    var bad_mode = false
    let _ = commit_format.cleanup([], "unknown", "#", false) else |e| {
        bad_mode = "{e}" == "invalid_cleanup"
        []
    }
    assert(bad_mode)
    for marker in ["", "\n", "a\rb", "a\0b"] {
        var refused = false
        let _ = commit_format.comment_marker([], marker) else |e| {
            refused = "{e}" == "invalid_comment"
            ""
        }
        assert(refused)
    }
    var exhausted = false
    let _ = commit_format.comment_marker(
        "#\n;\n@\n!\n$\n%\n^\n&\n|\n:\n".bytes(),
        "auto",
    ) else |e| {
        exhausted = "{e}" == "Unsupported(core.commentChar=auto exhausted)"
        ""
    }
    assert(exhausted)
    print(
        "PASS pure commit dates, message cleanup, paragraph/file ownership and explicit identities",
    )
    0
}
