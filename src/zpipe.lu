//! member: false

// Test-only file driver; not linked into the den CLI.
use hash
use std.x.crypto.sha2
use zlib

fn run(args: List[str]) -> () ! {
    invalid,
    io,
    truncated,
    bad_header,
    dictionary,
    checksum,
    limit,
    unsupported_level,
} {
    if args.len != 5 { return invalid }
    let cap = args[3].to_int() else |_| { return invalid }
    let level = args[4].to_int() else |_| { return invalid }
    let input = fs_read_bytes(args[1]) else |_| { return io }
    if args[0] == "hash" {
        print(sha2.to_hex(hash.sum1(input)))
    } else if args[0] == "inflate" || args[0] == "inflate_raw" {
        let result = if args[0] == "inflate" {
            zlib.inflate(input, cap)?
        } else {
            zlib.inflate_raw(input, cap)?
        }
        fs_write_bytes(args[2], result.data) else |_| { return io }
        print("{result.consumed} {result.data.len}")
    } else if args[0] == "inflate_sized" {
        // inflate_sized IN OUT SIZE START: the pack reader's entry point, the
        // stream at START, SIZE its declared size and output cap; it prints
        // the bytes consumed, decoded and reserved up front.
        let result = zlib.inflate_sized(input, level, cap)?
        fs_write_bytes(args[2], result.data) else |_| { return io }
        print("{result.consumed} {result.data.len} {result.reserved}")
    } else if args[0] == "inflate_splits" {
        // inflate_splits IN OUT SIZE 0: the zlib stream IN resumed at every
        // split k from 1 to its length: inflate_resume over IN[0..k), then, if
        // that met the window's end, again over IN from the resume point on.
        // One line a split: k, the first call's answer, the resume point (byte,
        // bit, output made), the final answer, the bytes consumed, the output's
        // length and its SHA-1. OUT is unused.
        for k in 1..input.len + 1 {
            region split {
                var st = zlib.resume_start()
                var out = List[byte](), reserved: int = 0, consumed: int = -1
                var first = "ok", last = "ok"
                var head = List[byte]()
                for i in 0..k { (mut head).push(input[i]) }
                consumed = zlib.inflate_resume(
                    head,
                    0,
                    0,
                    cap,
                    mut st,
                    mut out,
                    mut reserved,
                ) else |e| {
                    first = "{e}"
                    -1
                }
                let at = st.at
                let bit = st.bit
                let made = st.made
                if first == "truncated" {
                    var rest = List[byte]()
                    for i in st.at..input.len { (mut rest).push(input[i]) }
                    consumed = zlib.inflate_resume(
                        rest,
                        0,
                        st.at,
                        cap,
                        mut st,
                        mut out,
                        mut reserved,
                    ) else |e| {
                        last = "{e}"
                        -1
                    }
                } else {
                    last = first
                }
                print(
                    "{k} {first} {at} {bit} {made} {last} {consumed} {out.len} {sha2.to_hex(hash.sum1(out))}",
                )
            }
        }
    } else if args[0] == "deflate" || args[0] == "deflate_raw" {
        let result = if args[0] == "deflate" {
            zlib.deflate(input, level, cap)?
        } else {
            zlib.deflate_raw(input, level, cap)?
        }
        fs_write_bytes(args[2], result) else |_| { return io }
        print("{input.len} {result.len}")
    } else {
        return invalid
    }
}

fn main() -> int {
    run(env_args()) else |e| { eprint("{e}"); return 1 }
    0
}
