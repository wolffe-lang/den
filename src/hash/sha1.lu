// SHA-1 rounds vendored from wolffe-lang/boreutils f87dc76,
// src/checksum/sha.lu:9-49 (org-own, GPL-3.0-or-later + Training Data Permission).
// 575dc7b has no such file: proposed provenance correction R-vc00-1.
// State/streaming adapter follows that revision digest.lu, SHA-1 only.
// FIPS 180-4 sections 4.1.1, 5, 6.1; no other implementation read.
fn sha1_block(mut d: Digest) {
    load_words(mut d, 4, false)
    sha1_rounds(mut d)
}

/// One block straight from data[pos..pos + 64], big-endian words (FIPS 180-4
/// 6.1.2 step 1), with no copy through the partial-block buffer.
fn sha1_block_at(mut d: Digest, data: List[byte], pos: int) {
    var i = 0
    while i < 16 {
        let p = pos + i * 4
        d.w[i] = data[p] as int as wrapping[u64] << 24 |
            data[p + 1] as int as wrapping[u64] << 16 |
            data[p + 2] as int as wrapping[u64] << 8 |
            data[p + 3] as int as wrapping[u64]
        i += 1
    }
    sha1_rounds(mut d)
}

/// The schedule and the 80 rounds (FIPS 180-4 6.1.2 steps 1-4), one loop per
/// round function so no round branches on its index; ROTL^n is spelled inline.
fn sha1_rounds(mut d: Digest) {
    var i = 16
    while i < 80 {
        let x = d.w[i - 3] ^ d.w[i - 8] ^ d.w[i - 14] ^ d.w[i - 16]
        d.w[i] = (x << 1 | x >> 31) & 0xffffffff
        i += 1
    }
    var a = d.h[0]
    var b = d.h[1]
    var c = d.h[2]
    var e = d.h[3]
    var f = d.h[4]
    i = 0
    while i < 20 {
        let t = ((a << 5 | a >> 27) & 0xffffffff) +
            (b & c | (b ^ 0xffffffff) & e) +
            f +
            0x5a827999 +
            d.w[i] &
            0xffffffff
        f = e
        e = c
        c = (b << 30 | b >> 2) & 0xffffffff
        b = a
        a = t
        i += 1
    }
    while i < 40 {
        let t = ((a << 5 | a >> 27) & 0xffffffff) + (b ^ c ^ e) + f + 0x6ed9eba1 + d.w[i] &
            0xffffffff
        f = e
        e = c
        c = (b << 30 | b >> 2) & 0xffffffff
        b = a
        a = t
        i += 1
    }
    while i < 60 {
        let t = ((a << 5 | a >> 27) & 0xffffffff) +
            (b & c | b & e | c & e) +
            f +
            0x8f1bbcdc +
            d.w[i] &
            0xffffffff
        f = e
        e = c
        c = (b << 30 | b >> 2) & 0xffffffff
        b = a
        a = t
        i += 1
    }
    while i < 80 {
        let t = ((a << 5 | a >> 27) & 0xffffffff) + (b ^ c ^ e) + f + 0xca62c1d6 + d.w[i] &
            0xffffffff
        f = e
        e = c
        c = (b << 30 | b >> 2) & 0xffffffff
        b = a
        a = t
        i += 1
    }
    d.h[0] = d.h[0] + a & 0xffffffff
    d.h[1] = d.h[1] + b & 0xffffffff
    d.h[2] = d.h[2] + c & 0xffffffff
    d.h[3] = d.h[3] + e & 0xffffffff
    d.h[4] = d.h[4] + f & 0xffffffff
}

/// Streaming SHA-1 state; construct with new1, feed bytes, finalize once.
pub struct Digest {
    h: List[wrapping[u64]],
    w: List[wrapping[u64]],
    buf: List[byte],
    used: int,
    count: wrapping[u64],
}

/// FIPS 180-4 section 5.3.1 initial state; no failure rows.
pub fn new1() -> Digest {
    var d = Digest {
        h: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
        w: List[wrapping[u64]](),
        buf: List[byte](),
        used: 0,
        count: 0,
    }
    for _ in 0..80 { (mut d.w).push(0) }
    for _ in 0..64 { (mut d.buf).push(0 as byte) }
    d
}

fn load_words(mut d: Digest, width: int, little: bool) {
    var i = 0
    while i < 16 {
        var x: wrapping[u64] = 0
        var j = 0
        while j < width {
            let shift = (if little then j else width - 1 - j) * 8
            x = x | d.buf[i * width + j] as int as wrapping[u64] << shift as wrapping[u64]
            j += 1
        }
        d.w[i] = x
        i += 1
    }
}

/// Feed a byte slice without retaining it; SHA-1 length wraps modulo 2^64 bits.
pub fn update1(mut d: Digest, data: List[byte]) {
    var pos = 0
    while d.used > 0 && pos < data.len {
        d.buf[d.used] = data[pos]
        d.used += 1
        d.count += 1
        pos += 1
        if d.used == 64 { sha1_block(mut d); d.used = 0 }
    }
    // Whole blocks go straight from data; only a final partial block is buffered.
    while data.len - pos >= 64 {
        sha1_block_at(mut d, data, pos)
        d.count += 64
        pos += 64
    }
    while pos < data.len {
        d.buf[d.used] = data[pos]
        d.used += 1
        d.count += 1
        pos += 1
    }
}

/// Consume the state and return the 20-byte SHA-1 digest, big endian.
pub fn final1(take state: Digest) -> List[byte] {
    var d = state
    d.buf[d.used] = 128 as byte
    d.used += 1
    if d.used > 56 {
        while d.used < 64 { d.buf[d.used] = 0 as byte; d.used += 1 }
        sha1_block(mut d)
        d.used = 0
    }
    while d.used < 64 { d.buf[d.used] = 0 as byte; d.used += 1 }
    let bits = d.count << 3
    for j in 0..8 { d.buf[63 - j] = (bits >> (j * 8) as wrapping[u64] & 255) as int as byte }
    sha1_block(mut d)
    var result = List[byte]()
    for j in 0..20 {
        let shift = (3 - j % 4) * 8
        (mut result).push((d.h[j / 4] >> shift as wrapping[u64] & 255) as int as byte)
    }
    result
}

/// SHA-1 of an arbitrary byte slice; no failure rows.
pub fn sum1(data: List[byte]) -> List[byte] {
    var d = new1()
    update1(mut d, data)
    final1(take d)
}
