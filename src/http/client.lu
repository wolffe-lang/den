// Bounded request/response IO over std.net. HTTP bodies are not pkt-line
// streams: all declared framing is consumed before the caller sees a body.
use std.net
use std.x.tls.client

/// Owned connection, explicitly closed once. A response with close semantics
/// releases its descriptor; the next request may open a new connection.
pub struct Connection {
    endpoint: Endpoint,
    fd: int,
    buffer: List[byte],
    cursor: int,
    tls: List[client.Client],
    authorization: str,
    credentials_allowed: bool,
    body_mode: int,
    body_left: int,
    body_close: bool,
}

/// One complete response, with metadata separate from its binary body.
pub struct Response { status: int, content_type: str, location: str, basic: bool, body: List[byte] }

fn dial(mut c: Connection) -> () ! Errors {
    let address = if c.endpoint.host == "::1" {
        "[::1]:{c.endpoint.port}"
    } else {
        "{c.endpoint.host}:{c.endpoint.port}"
    }
    var socket = net.connect(address) else |_| { return io }
    net.set_deadline(mut socket, 30000) else |_| {
        net.close(take socket) else |_| {}
        return io
    }
    c.fd = socket.fd
    var ready = false
    defer { if !ready { close(mut c) } }
    if c.endpoint.scheme == "https" { c.tls = [secure(c.fd, c.endpoint.host)?] }
    (mut c.buffer).reset()
    c.cursor = 0
    ready = true
}

/// Validate the URL and open a deadline-armed connection. No HTTP bytes are
/// written by open, and no credentials are read by this framing layer.
pub fn open(url: str) -> Connection ! Errors {
    var c = Connection {
        endpoint: endpoint(url)?,
        fd: -1,
        buffer: List[byte](),
        cursor: 0,
        tls: List[client.Client](),
        authorization: "",
        credentials_allowed: true,
        body_mode: 0,
        body_left: 0,
        body_close: false,
    }
    dial(mut c)?
    c
}

/// A connection that was never opened: a placeholder for a stream transport.
pub fn idle() -> Connection {
    Connection {
        endpoint: Endpoint { scheme: "", host: "", port: 0, authority: "", path: "" },
        fd: -1,
        buffer: List[byte](),
        cursor: 0,
        tls: List[client.Client](),
        authorization: "",
        credentials_allowed: false,
        body_mode: 0,
        body_left: 0,
        body_close: false,
    }
}

/// Close and invalidate this owned connection, including after a partial read.
pub fn close(mut c: Connection) {
    if c.fd >= 0 {
        if c.tls.len == 1 {
            client.close(take copy c.tls[0]) else |_| {}
        } else {
            net_close(c.fd) else |_| {}
        }
        c.fd = -1
    }
    c.tls = List[client.Client]()
    (mut c.buffer).reset()
    c.cursor = 0
}

/// One socket read appended to the connection's own buffer, its temporary
/// dying with the read's scratch region (see fill_secure).
fn fill_plain(mut c: Connection) -> int {
    var code = 0
    region scratch {
        let data = net_read_bytes(c.fd, 65536) else |e| match e {
            closed => List[byte](),
            timeout => { code = 1; List[byte]() },
            _ => { code = 5; List[byte]() },
        }
        for b in data { (mut c.buffer).push(b) }
    }
    code
}

/// Refill the one long-lived read buffer: reset and refilled, never
/// replaced, since a replaced List keeps its old buffer until the
/// connection's region ends.
fn refill(mut c: Connection) -> bool ! Errors {
    if c.cursor < c.buffer.len { return true }
    (mut c.buffer).reset()
    c.cursor = 0
    let secure = c.tls.len == 1
    let code = if secure then fill_secure(mut c) else fill_plain(mut c)
    if code == 1 && !secure { return Unsupported("HTTP read timeout") }
    if code == 5 && !secure { return io }
    if code == 1 { return Unsupported("TLS timeout") }
    if code == 2 { return Unsupported("TLS bad_record_mac") }
    if code == 3 { return Unsupported("TLS decode_error") }
    if code == 4 { return Unsupported("TLS unexpected_message") }
    if code == 5 { return Unsupported("TLS io") }
    c.buffer.len > 0
}

fn octet(mut c: Connection) -> byte ! Errors {
    if !refill(mut c)? { return truncated }
    let b = c.buffer[c.cursor]
    c.cursor = c.cursor + 1
    b
}

fn append(mut out: List[byte], data: List[byte]) {
    for b in data { (mut out).push(b) }
}

fn line(mut c: Connection) -> List[byte] ! Errors {
    var out = List[byte]()
    loop {
        let b = octet(mut c)?
        if b == 13 as byte {
            if octet(mut c)? != 10 as byte { return invalid }
            return out
        }
        if b == 10 as byte { return invalid }
        if out.len >= 8192 { return limit }
        (mut out).push(b)
    }
}

fn headers(mut c: Connection) -> List[byte] ! Errors {
    var out = List[byte](), count = 0
    loop {
        let bytes = line(mut c)?
        if bytes.len + 2 > 65536 - out.len { return limit }
        append(mut out, bytes)
        append(mut out, "\r\n".bytes())
        if bytes.len == 0 { return out }
        count = count + 1
        if count > 257 { return limit }
    }
}

fn body_exact(mut c: Connection, mut out: List[byte], count: int, cap: int) -> () ! Errors {
    if count < 0 || count > cap - out.len { return limit }
    var left = count
    while left > 0 {
        if !refill(mut c)? { return truncated }
        let available = c.buffer.len - c.cursor
        let amount = if left < available then left else available
        // By index: a slice would be one more copy held for the request.
        for i in c.cursor..c.cursor + amount { (mut out).push(c.buffer[i]) }
        c.cursor = c.cursor + amount
        left = left - amount
    }
}

fn trailers(data: List[byte]) -> () ! Errors {
    // Validate syntax independently, never merge trailers into header metadata.
    var block = "HTTP/1.1 200 OK\r\n".bytes()
    append(mut block, data)
    let lines = header_lines(block)?
    for field in lines[1..] {
        let colon = field.find(":") else { return invalid }
        if colon == 0 { return invalid }
        for b in field[0..colon].bytes() { if !token_byte(b) { return invalid } }
        let name = field[0..colon].lower()
        if name == "content-length" ||
            name == "transfer-encoding" ||
            name == "content-encoding" ||
            name == "content-type" ||
            name == "connection" ||
            name == "location" ||
            name == "www-authenticate" ||
            name == "authorization" {
            return Unsupported("HTTP forbidden trailer")
        }
    }
}

fn receive(mut c: Connection, cap: int) -> Response ! Errors {
    var info = 0
    var h = head(headers(mut c)?, cap)?
    while h.status < 200 {
        info = info + 1
        if info > 8 { return limit }
        h = head(headers(mut c)?, cap)?
    }
    var body = List[byte]()
    if h.chunked {
        var count = 0, metadata = 0
        loop {
            let size_line = line(mut c)?
            if size_line.len + 2 > 1048576 - metadata { return limit }
            metadata = metadata + size_line.len + 2
            let text = str_from_utf8(size_line) else |_| { return invalid }
            let size = chunk_size(text, cap - body.len)?
            if size == 0 { trailers(headers(mut c)?)?; break }
            count = count + 1
            if count > 1000000 { return limit }
            body_exact(mut c, mut body, size, cap)?
            if octet(mut c)? != 13 as byte || octet(mut c)? != 10 as byte { return invalid }
        }
    } else if h.length >= 0 {
        body_exact(mut c, mut body, h.length, cap)?
    } else {
        if c.tls.len == 1 {
            return Unsupported("HTTPS close-delimited body (wolf-std#133)")
        }
        while refill(mut c)? {
            let amount = c.buffer.len - c.cursor
            body_exact(mut c, mut body, amount, cap)?
        }
    }
    // No pipelining: any already-buffered byte beyond this response is invalid,
    // never accepted as the next response to a request not yet written.
    if c.cursor != c.buffer.len { return Unsupported("HTTP trailing response bytes") }
    if h.close { close(mut c) }
    Response {
        status: h.status,
        content_type: h.content_type,
        location: h.location,
        basic: h.basic,
        body: body,
    }
}

fn send_request(
    mut c: Connection,
    method: str,
    target: str,
    service: str,
    body: List[byte],
) -> () ! Errors {
    if method != "GET" && method != "POST" { return invalid }
    if body.len > 140000000 || target.len > 8192 { return limit }
    if method == "GET" && body.len != 0 { return invalid }
    if !target.starts_with("/") { return invalid }
    for b in target.bytes() {
        if b as int <= 32 || b as int >= 127 || b == 35 as byte { return invalid }
    }
    if service != "" && service != "git-upload-pack" && service != "git-receive-pack" {
        return invalid
    }
    var text = "{method} {target} HTTP/1.1\r\nHost: {c.endpoint.authority}\r\nAccept-Encoding: identity\r\n"
    if service == "git-upload-pack" { text = "{text}Git-Protocol: version=2\r\n" }
    if method == "POST" {
        text = "{text}Content-Type: application/x-{service}-request\r\nAccept: application/x-{service}-result\r\nContent-Length: {body.len}\r\n"
    } else {
        text = "{text}Accept: */*\r\n"
    }
    if c.authorization != "" { text = "{text}Authorization: Basic {c.authorization}\r\n" }
    text = "{text}\r\n"
    write_bytes(mut c, text.bytes())?
    if body.len != 0 { write_bytes(mut c, body)? }
}

/// Complete one bounded HTTP transaction. No implicit retries, including POST;
/// failure closes the connection before returning. No protocol status is hidden.
pub fn request_capped(
    mut c: Connection,
    method: str,
    target: str,
    service: str,
    body: List[byte],
    cap: int,
) -> Response ! Errors {
    if cap < 0 || cap > 140000000 { return limit }
    if c.fd < 0 { dial(mut c)? }
    var complete = false
    defer { if !complete { close(mut c) } }
    send_request(mut c, method, target, service, body)?
    var response = receive(mut c, cap)?
    if response.status == 401 && c.authorization == "" {
        if !c.credentials_allowed { return Unsupported("HTTP cross-origin authentication refused") }
        if !response.basic { return Unsupported("HTTP authentication scheme") }
        c.authorization = credentials()?
        if c.fd < 0 { dial(mut c)? }
        send_request(mut c, method, target, service, body)?
        response = receive(mut c, cap)?
    }
    complete = true
    response
}

/// Request with the inherited maximum wire-body cap, for importing clients.
pub fn request(
    mut c: Connection,
    method: str,
    target: str,
    service: str,
    body: List[byte],
) -> Response ! Errors {
    request_capped(mut c, method, target, service, body, 140000000)?
}

// vc23: streamed response bodies. A fetch response is read a pkt-line at a
// time, never whole, so a pack of any size crosses the connection's one
// reused 64 KiB buffer. Framing checks are those of receive above.

/// A streamed response's metadata; its body is read with body_read.
pub struct Streamed { status: int, content_type: str, location: str, basic: bool }

// The largest Content-Length or chunk a streamed body accepts: any size a
// signed 64-bit count holds (R-vc23-1: no whole-body cap).
fn stream_cap() -> int { 4611686018427387903 }

fn stream_head(mut c: Connection) -> Head ! Errors {
    var info = 0
    var h = head(headers(mut c)?, stream_cap())?
    while h.status < 200 {
        info = info + 1
        if info > 8 { return limit }
        h = head(headers(mut c)?, stream_cap())?
    }
    c.body_close = h.close
    c.body_left = 0
    if h.chunked {
        c.body_mode = 2
    } else if h.length >= 0 {
        c.body_mode = 1
        c.body_left = h.length
    } else {
        if c.tls.len == 1 { return Unsupported("HTTPS close-delimited body (wolf-std#133)") }
        c.body_mode = 3
    }
    h
}

/// At most max (1..65536) bytes of the current body; empty at its end.
pub fn body_read(mut c: Connection, max: int) -> List[byte] ! Errors {
    var out = List[byte]()
    if max < 1 || max > 65536 { return invalid }
    if c.body_mode == 2 && c.body_left == 0 {
        let size_line = line(mut c)?
        let text = str_from_utf8(size_line) else |_| { return invalid }
        let size = chunk_size(text, stream_cap())?
        if size == 0 {
            trailers(headers(mut c)?)?
            c.body_mode = 0
            return out
        }
        c.body_left = size
    }
    if c.body_mode == 1 && c.body_left == 0 { c.body_mode = 0 }
    if c.body_mode == 0 { return out }
    if !refill(mut c)? {
        if c.body_mode == 3 { c.body_mode = 0; return out }
        return truncated
    }
    let available = c.buffer.len - c.cursor
    var amount = if max < available then max else available
    if c.body_mode != 3 && c.body_left < amount { amount = c.body_left }
    for i in c.cursor..c.cursor + amount { (mut out).push(c.buffer[i]) }
    c.cursor = c.cursor + amount
    if c.body_mode != 3 { c.body_left = c.body_left - amount }
    if c.body_mode == 2 && c.body_left == 0 {
        if octet(mut c)? != 13 as byte || octet(mut c)? != 10 as byte { return invalid }
    }
    out
}

/// Exactly count bytes of the current body (a pkt-line's header or payload).
pub fn body_take(mut c: Connection, count: int) -> List[byte] ! Errors {
    var out = List[byte]()
    if count < 0 || count > 65536 { return limit }
    while out.len < count {
        region part {
            let more = body_read(mut c, count - out.len)?
            if more.len == 0 { return truncated }
            for b in more { (mut out).push(b) }
        }
    }
    out
}

/// After a streamed body: every byte consumed, nothing pipelined behind it,
/// and a closing response's connection closed.
pub fn body_end(mut c: Connection) -> () ! Errors {
    if c.body_mode != 0 { return Unsupported("HTTP body not consumed") }
    if c.cursor != c.buffer.len { return Unsupported("HTTP trailing response bytes") }
    if c.body_close { close(mut c) }
}

fn drain(mut c: Connection, cap: int) -> () ! Errors {
    var total = 0
    loop {
        var more = 0
        region part {
            more = body_read(mut c, 65536)?.len
        }
        if more == 0 { return }
        total = total + more
        if total > cap { return limit }
    }
}

/// Send one request and read its status line and headers; the body streams
/// through body_read. The single explicit 401 challenge is answered as
/// request_capped answers it (its small body drained first). Failure closes.
pub fn request_streamed(
    mut c: Connection,
    method: str,
    target: str,
    service: str,
    body: List[byte],
) -> Streamed ! Errors {
    if c.fd < 0 { dial(mut c)? }
    var complete = false
    defer { if !complete { close(mut c) } }
    send_request(mut c, method, target, service, body)?
    var h = stream_head(mut c)?
    if h.status == 401 && c.authorization == "" {
        if !c.credentials_allowed { return Unsupported("HTTP cross-origin authentication refused") }
        if !h.basic { return Unsupported("HTTP authentication scheme") }
        drain(mut c, 1048576)?
        body_end(mut c)?
        c.authorization = credentials()?
        if c.fd < 0 { dial(mut c)? }
        send_request(mut c, method, target, service, body)?
        h = stream_head(mut c)?
    }
    complete = true
    Streamed {
        status: h.status,
        content_type: h.content_type,
        location: h.location,
        basic: h.basic,
    }
}
