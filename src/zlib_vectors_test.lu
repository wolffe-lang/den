use zlib

fn error_of(input: List[byte], cap: int, raw: bool) -> str {
    let result = (if raw then zlib.inflate_raw(input, cap) else zlib.inflate(input, cap)) else |e| {
        return "{e}"
    }
    "success {result.consumed}"
}

