//! member: false

use pack

fn check() -> () ! pack.StreamErrors {
    let input = [pack.Body { kind: "blob", data: "before\n".bytes() }, pack.Body { kind: "blob", data: "before\nafter\n".bytes() }]
    for mode in ["none", "ofs", "ref"] {
        let encoded = pack.encode(input, mode) else |_| { return invalid }
        let decoded = pack.decode(encoded.data, [])?
        assert(decoded.len == 2)
        let external = pack.stream_refs(encoded.data)?
        assert(external.len <= 2)
        var bad = copy encoded.data
        bad[bad.len - 1] = bad[bad.len - 1] ^ 1 as byte
        var rejected = false
        let _ = pack.decode(bad, []) else |_| { rejected = true; List[pack.Body]() }
        assert(rejected)
        rejected = false
        let _ = pack.decode(encoded.data[0..encoded.data.len - 1], []) else |_| { rejected = true; List[pack.Body]() }
        assert(rejected)
        var extra = copy encoded.data
        (mut extra).push(0 as byte)
        rejected = false
        let _ = pack.decode(extra, []) else |_| { rejected = true; List[pack.Body]() }
        assert(rejected)
    }
}

fn main() -> int {
    check() else |e| { eprint("{e}"); return 1 }
    print("vc15 pack stream: three representations and checksum/truncation/trailing refusals; zero skips")
    0
}
