use std.fs
use oid
use pack
use refs
use repository

/// Storage errors include repository configuration and filesystem outcomes.
pub error StoreErrors = {
    invalid,
    invalid_oid,
    unsupported_format,
    bad_header,
    bad_size,
    bad_oid,
    truncated,
    dictionary,
    checksum,
    limit,
    trailing,
    unsupported_level,
    not_found,
    denied,
    io,
    exists,
    unsupported,
    Unsupported(str),
    ambiguous,
    cross_device,
}

/// Canonical loose path; validate public Oid values before path construction.
pub fn path(repo: repository.Repo, id: oid.Oid) -> str ! StoreErrors {
    let text = oid.hex(id)?
    if id.algorithm != "sha1" { return unsupported_format }
    "{repo.gitdir}/objects/{text[0..2]}/{text[2..]}"
}

/// A capped read's bound, named as fetch, pull, merge and checkout print it.
// A bound's message is a literal: an error can leave the region the read
// that raised it ran in, and a message built at run time would leave with it.
fn object_limit(cap: int) -> str {
    if cap == 16777216 { return "limit: an object larger than 16777216 bytes" }
    if cap == 67108864 { return "limit: an object larger than 67108864 bytes" }
    if cap == 1000000000 { return "limit: an object larger than 1000000000 bytes" }
    "limit: an object larger than its read allows"
}

fn read_limit() -> str { "limit: an object read above 1000000000 bytes" }

/// decode's answer with its size bound named.
fn decoded(input: List[byte], id: oid.Oid, max_output: int) -> Object ! StoreErrors {
    decode(input, id, max_output) else |e| match e {
        limit => { return Unsupported(object_limit(max_output)) },
        invalid => { return invalid },
        invalid_oid => { return invalid_oid },
        unsupported_format => { return unsupported_format },
        bad_header => { return bad_header },
        bad_size => { return bad_size },
        bad_oid => { return bad_oid },
        truncated => { return truncated },
        dictionary => { return dictionary },
        checksum => { return checksum },
        trailing => { return trailing },
        unsupported_level => { return unsupported_level },
    }
}

/// Read a bounded loose object first; only absence falls back to validated packs.
pub fn read_object(repo: repository.Repo, id: oid.Oid, max_output: int) -> Object ! StoreErrors {
    if max_output < 0 { return invalid }
    if max_output > 1000000000 { return Unsupported(read_limit()) }
    let input = repository.read_bytes(
        path(repo, id)?,
        max_output + max_output / 100 + 65536,
    ) else |e| match e {
        not_found => {
            let value = pack.read_object(repo.gitdir, oid.hex(id)?, max_output)?
            return Object { kind: value.kind, data: copy value.data }
        },
        denied => { return denied },
        io => { return io },
        invalid => { return invalid },
        exists => { return exists },
        unsupported => { return unsupported },
        limit => { return Unsupported(object_limit(max_output)) },
        Unsupported(name) => {
            if name.starts_with("limit: ") { return Unsupported(object_limit(max_output)) }
            return Unsupported(name)
        },
    }
    decoded(input, id, max_output)?
}

/// A batch reader with read_object's precedence: loose first, then packs
/// through one session, so a tree walk parses each pack index once.
pub struct Reader { repo: repository.Repo, packs: pack.Session }

/// A reader over repo; its pack indexes load on the first packed read.
pub fn reader(repo: repository.Repo) -> Reader {
    Reader { repo: copy repo, packs: pack.session(repo.gitdir) }
}

/// read_object's answer and errors, packed reads served by the session.
pub fn read_with(mut r: Reader, id: oid.Oid, max_output: int) -> Object ! StoreErrors {
    if max_output < 0 { return invalid }
    if max_output > 1000000000 { return Unsupported(read_limit()) }
    let input = repository.read_bytes(
        path(r.repo, id)?,
        max_output + max_output / 100 + 65536,
    ) else |e| match e {
        not_found => {
            let value = pack.session_read(mut r.packs, oid.hex(id)?, max_output)?
            return Object { kind: value.kind, data: copy value.data }
        },
        denied => { return denied },
        io => { return io },
        invalid => { return invalid },
        exists => { return exists },
        unsupported => { return unsupported },
        limit => { return Unsupported(object_limit(max_output)) },
        Unsupported(name) => {
            if name.starts_with("limit: ") { return Unsupported(object_limit(max_output)) }
            return Unsupported(name)
        },
    }
    decoded(input, id, max_output)?
}

/// A reader whose pack indexes are loaded now (vc23), for read_loaded.
pub fn reader_open(repo: repository.Repo) -> Reader ! StoreErrors {
    Reader { repo: copy repo, packs: pack.session_open(repo.gitdir)? }
}

/// A reader for a batch that reads inside its own regions (a checkout): opened
/// when its packs load now, otherwise unopened, and then each packed read takes
/// read_object's path, so only a read that needs such a pack fails, and with
/// read_object's error.
pub fn reader_batch(repo: repository.Repo) -> Reader {
    reader_open(repo) else |_| reader(repo)
}

/// read_with's answer through an opened reader, which it never changes, so
/// a caller may read inside its own region (one object's memory at a time).
pub fn read_loaded(r: Reader, id: oid.Oid, max_output: int) -> Object ! StoreErrors {
    if max_output < 0 { return invalid }
    if max_output > 1000000000 { return Unsupported(read_limit()) }
    let input = repository.read_bytes(
        path(r.repo, id)?,
        max_output + max_output / 100 + 65536,
    ) else |e| match e {
        not_found => {
            let value = pack.session_peek(r.packs, oid.hex(id)?, max_output)?
            return Object { kind: value.kind, data: copy value.data }
        },
        denied => { return denied },
        io => { return io },
        invalid => { return invalid },
        exists => { return exists },
        unsupported => { return unsupported },
        limit => { return Unsupported(object_limit(max_output)) },
        Unsupported(name) => {
            if name.starts_with("limit: ") { return Unsupported(object_limit(max_output)) }
            return Unsupported(name)
        },
    }
    decoded(input, id, max_output)?
}

/// read_loaded's answer, packed bases served by the reader's cache
/// (pack.session_cached): for a batch that reads along delta chains, such as
/// a pack writer or a closure walk. Only bytes and ints change in the
/// reader, so a caller may read inside its own region.
pub fn read_cached(mut r: Reader, id: oid.Oid, max_output: int) -> Object ! StoreErrors {
    if max_output < 0 { return invalid }
    if max_output > 1000000000 { return Unsupported(read_limit()) }
    let input = repository.read_bytes(
        path(r.repo, id)?,
        max_output + max_output / 100 + 65536,
    ) else |e| match e {
        not_found => {
            let value = pack.session_cached(mut r.packs, oid.hex(id)?, max_output)?
            return Object { kind: value.kind, data: copy value.data }
        },
        denied => { return denied },
        io => { return io },
        invalid => { return invalid },
        exists => { return exists },
        unsupported => { return unsupported },
        limit => { return Unsupported(object_limit(max_output)) },
        Unsupported(name) => {
            if name.starts_with("limit: ") { return Unsupported(object_limit(max_output)) }
            return Unsupported(name)
        },
    }
    decoded(input, id, max_output)?
}

/// Resolve a loose/packed oid prefix; duplicates share one identity.
/// Full-width ids are returned even when missing (read_object tests presence).
pub fn lookup(repo: repository.Repo, name: str) -> oid.Oid ! StoreErrors {
    let prefix = oid.prefix("sha1", name)?
    if prefix.len == 40 { return oid.parse("sha1", prefix)? }
    let dir = "{repo.gitdir}/objects/{prefix[0..2]}"
    let entries = fs.entries(dir) else |e| match e {
        not_found => { List[fs.Entry]() },
        denied => { return denied },
        io => { return io },
    }
    var found = ""
    for entry in entries {
        let suffix = str_from_utf8(entry.name) else ""
        if suffix.len == 38 {
            let candidate = "{prefix[0..2]}{suffix}"
            let _ = oid.parse("sha1", candidate) else |_| { continue }
            if candidate.starts_with(prefix) && entry.kind == 0 {
                if found != "" { return ambiguous }
                found = candidate
            }
        }
    }
    for candidate in pack.prefix(repo.gitdir, prefix)? {
        if found != "" && candidate != found { return ambiguous }
        found = candidate
    }
    if found == "" { return not_found }
    oid.parse("sha1", found)?
}

/// Resolve HEAD, loose/packed full refs, short branches/tags and object IDs.
/// General revision grammar is a caller layer, not part of the object store.
pub fn resolve(repo: repository.Repo, name: str) -> oid.Oid ! StoreErrors {
    let normalized = oid.prefix("sha1", name) else ""
    if normalized != "" { return lookup(repo, normalized)? }
    if name == "HEAD" || name.starts_with("refs/") { return refs.read(repo, name)? }
    if !refs.valid("refs/heads/{name}") { return invalid_oid }
    let branch = refs.optional(repo, "refs/heads/{name}")?
    let tag = refs.optional(repo, "refs/tags/{name}")?
    if branch.len > 0 && tag.len > 0 { return ambiguous }
    if branch.len > 0 { return copy branch[0] }
    if tag.len > 0 { return copy tag[0] }
    not_found
}

/// Install complete immutable bytes using exclusive temp + fsync + hard link.
/// link is atomic no-replace; unlike rename it cannot clobber another writer.
/// A preexisting object must validate to the same oid. No environment failpoints.
pub fn write_object(repo: repository.Repo, kind: str, data: List[byte]) -> oid.Oid ! StoreErrors {
    write_injected(repo, kind, data, "")?
}

/// Explicit dependency-injection seam for owned-fixture failure tests only.
/// write/sync/install fail before publication; directory-sync fails after a
/// complete object is published. All temp names are removed on ordinary errors.
pub fn write_injected(
    repo: repository.Repo,
    kind: str,
    data: List[byte],
    fail: str,
) -> oid.Oid ! StoreErrors {
    let checked = repository.open(repo.gitdir)?
    let _ = repository.compression(checked)?
    let id = identify(kind, data)?
    let destination = path(checked, id)?
    var present = true
    let existing = read_object(checked, id, data.len) else |e| match e {
        not_found => { present = false; Object { kind: "", data: List[byte]() } },
        invalid => { return invalid },
        invalid_oid => { return invalid_oid },
        unsupported_format => { return unsupported_format },
        bad_header => { return bad_header },
        bad_size => { return bad_size },
        bad_oid => { return bad_oid },
        truncated => { return truncated },
        dictionary => { return dictionary },
        checksum => { return checksum },
        limit => { return limit },
        trailing => { return trailing },
        unsupported_level => { return unsupported_level },
        denied => { return denied },
        io => { return io },
        exists => { return exists },
        unsupported => { return unsupported },
        Unsupported(name) => { return Unsupported(name) },
        ambiguous => { return ambiguous },
        cross_device => { return cross_device },
    }
    if present {
        if existing.kind != kind || existing.data.len != data.len { return bad_oid }
        for i in 0..data.len { if existing.data[i] != data[i] { return bad_oid } }
        return id
    }
    let dir = fs.parent(destination) else |_| { return invalid }
    fs.create_dir_all(dir)?
    let encoded = encode(kind, data, data.len + data.len / 100 + 65536)?
    // Exclusive numbered candidates work across processes without shared state.
    for serial in 0..1024 {
        let temp = "{dir}/tmp_den_{serial}"
        var file = fs.create_new_with_mode(temp, 0o444) else |e| match e {
            exists => { continue },
            not_found => { return not_found },
            denied => { return denied },
            invalid => { return invalid },
            unsupported => { return unsupported },
            io => { return io },
        }
        var temp_owned = true
        defer { if temp_owned { fs.remove(temp) else |_| {} } }
        var closed = false
        defer { if !closed { fs_close(file.fd) else |_| {} } }
        if fail == "write" { return io }
        fs.write_chunk(mut file, encoded)?
        if fail == "sync" { return io }
        fs.sync(mut file)?
        fs_close(file.fd)?
        closed = true
        if fail == "install" { return io }
        fs.link(temp, destination) else |e| match e {
            exists => { let _ = read_object(checked, id, data.len)? },
            not_found => { return not_found },
            denied => { return denied },
            cross_device => { return cross_device },
            io => { return io },
        }
        fs.remove(temp)?
        // Once unlinked, another exclusive writer may reuse this pathname.
        // Our deferred cleanup must never remove that writer's new file.
        temp_owned = false
        if fail == "directory-sync" { return io }
        fs.sync_dir(dir)?
        fs.sync_dir("{checked.gitdir}/objects")?
        return id
    }
    exists
}
