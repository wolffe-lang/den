use std.fs
use commit_format

error ProbeErrors = {
    invalid,
    not_found,
    denied,
    io,
    invalid_date,
    invalid_timezone,
    invalid_identity,
    invalid_cleanup,
    invalid_comment,
    limit,
    Unsupported(str),
}

fn input(path: str) -> List[byte] ! ProbeErrors {
    var file = fs.open(path)?
    defer fs.close(take file) else |_| {}
    var bytes = List[byte]()
    loop {
        region chunk {
            let part = fs.read_chunk(mut file, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > 16777216 - bytes.len { return limit }
            for b in part { (mut bytes).push(b) }
        }
    }
    bytes
}

fn output(bytes: List[byte]) -> () ! ProbeErrors {
    var file = fs.stdout()
    fs.write_chunk(mut file, bytes)?
}

fn edited(text: str) -> bool ! ProbeErrors {
    if text == "1" || text == "true" { return true }
    if text == "0" || text == "false" { return false }
    invalid
}

fn work(args: List[str]) -> int ! ProbeErrors {
    if args.len == 0 { return invalid }
    if args[0] == "date" {
        if args.len != 2 && args.len != 3 { return invalid }
        let offset = if args.len == 3 then args[2] else "+0000"
        print(commit_format.date_text(commit_format.parse_date(args[1], offset)?)?)
    } else if args[0] == "cleanup" || args[0] == "file" || args[0] == "empty" {
        // cleanup|file|empty MODE COMMENT EDITED FILE
        if args.len != 5 { return invalid }
        var message = input(args[4])?
        if args[0] == "file" { message = commit_format.file_message(message)? }
        let result = commit_format.cleanup(message, args[1], args[2], edited(args[3])?)?
        if args[0] == "empty" {
            print(
                if commit_format.message_empty(result, args[1], edited(args[3])?)? {
                    "true"
                } else {
                    "false"
                },
            )
        } else {
            output(result)?
        }
    } else if args[0] == "paragraphs" {
        // paragraphs MODE COMMENT EDITED FILE...; each file is one -m body.
        if args.len < 4 { return invalid }
        var messages = List[List[byte]]()
        for path in args[4..] { (mut messages).push(input(path)?) }
        let message = commit_format.paragraphs(messages)?
        output(commit_format.cleanup(message, args[1], args[2], edited(args[3])?)?)?
    } else if args[0] == "identity" {
        // identity NAME EMAIL DATE [DEFAULT_OFFSET]
        if args.len != 4 && args.len != 5 { return invalid }
        let offset = if args.len == 5 then args[4] else "+0000"
        let date = commit_format.parse_date(args[3], offset)?
        print(commit_format.identity_text(commit_format.make_identity(args[1], args[2], date)?)?)
    } else if args[0] == "author" {
        // author 'Name <email>' DATE [DEFAULT_OFFSET]
        if args.len != 3 && args.len != 4 { return invalid }
        let offset = if args.len == 4 then args[3] else "+0000"
        let date = commit_format.parse_date(args[2], offset)?
        print(commit_format.identity_text(commit_format.parse_author(args[1], date)?)?)
    } else if args[0] == "parse-identity" {
        if args.len != 2 { return invalid }
        print(commit_format.identity_text(commit_format.parse_identity(args[1])?)?)
    } else if args[0] == "comment" {
        // comment CONFIGURED FILE
        if args.len != 3 { return invalid }
        print(commit_format.comment_marker(input(args[2])?, args[1])?)
    } else {
        return invalid
    }
    0
}

fn main() -> int {
    work(env_args()) else |e| { eprint("{e}"); 1 }
}
