use std.fs
use history
use pretty
use walk
use worktree

fn run() -> int ! worktree.WorkErrors {
    let ctx = worktree.discover(".")?
    let head = worktree.head(ctx)?
    let args = env_args()
    let count = if args.len == 1 && args[0] == "zero" then 0 else 100
    let budget = if args.len == 1 && args[0] == "limit" then 1 else 1000
    let values = walk.collect(ctx.repo, head.commits, count, 0, budget, false)?
    var stdout = fs.stdout()
    for value in values {
        var ids = [history.abbreviate(ctx.repo, value.id, 7)?]
        for parent in value.parents { (mut ids).push(history.abbreviate(ctx.repo, parent, 7)?) }
        fs.write_chunk(mut stdout, pretty.render(value, "oneline", "default", ids, true)?)?
    }
    0
}

fn main() -> int { run() else |e| { eprint("{e}"); 1 } }
