use std.fs
use diff
use worktree

fn work(args: List[str]) -> int ! worktree.WorkErrors {
    if args.len == 1 && args[0] == "invalid" {
        let ctx = worktree.discover(".")?
        let _ = diff.render(
            ctx,
            [diff.Change { before: [], after: [], status: "M", percent: 0 }],
            diff.defaults(),
        )?
        return 0
    }
    let ctx = worktree.discover(".")?
    var options = diff.configured(ctx)?
    for arg in args {
        if arg == "--cached" {
            options.cached = true
        } else if arg == "--stat" {
            options.stat = true
            options.patch = false
        } else if arg == "--name-status" {
            options.name_status = true
            options.patch = false
        } else if arg == "-U0" {
            options.context = 0
        } else if arg.starts_with("path=") {
            (mut options.paths).push(arg[5..])
        } else {
            (mut options.revisions).push(arg)
        }
    }
    let changes = diff.collect(ctx, options)?
    let bytes = diff.render(ctx, changes, options)?
    var stdout = fs.stdout()
    fs.write_chunk(mut stdout, bytes)?
    0
}

fn main() -> int { work(env_args()) else |e| { eprint("{e}"); 1 } }
