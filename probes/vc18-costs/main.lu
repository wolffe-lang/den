// Primitive costs behind status on the pinned toolchain; prints ns per phase.
use std.time
use hash

fn main() -> int {
    var data = List[byte]()
    var start = time.monotonic_ns()
    for i in 0..19000000 { (mut data).push((i & 255) as byte) }
    print("push_19mb_ns={time.monotonic_ns() - start}")
    start = time.monotonic_ns()
    let digest = hash.sum1(data)
    let elapsed = time.monotonic_ns() - start
    var text = ""
    for b in digest {
        let digits = "0123456789abcdef"
        text = "{text}{digits[b as int / 16..b as int / 16 + 1]}{digits[b as int % 16..b as int % 16 + 1]}"
    }
    print("sha1_19mb_ns={elapsed} digest={text}")
    // Split updates cross the partial-block buffer at every alignment.
    var state = hash.new1()
    var pos = 0, step = 1
    while pos < data.len {
        let end = if pos + step < data.len then pos + step else data.len
        hash.update1(mut state, data[pos..end])
        pos = end
        step = step % 131 + 7
    }
    let split = hash.final1(take state)
    var same = split.len == digest.len
    for i in 0..digest.len { if split[i] != digest[i] { same = false } }
    print("sha1_split_same={same}")
    for count in [454, 2500] {
        var names = List[str]()
        for i in 0..count { (mut names).push("src/d{i / 30}/f{i}.bin") }
        start = time.monotonic_ns()
        var m = Map[str, int]()
        for i in 0..count { m[names[i]] = i }
        print("map_insert_{count}_ns={time.monotonic_ns() - start}")
        start = time.monotonic_ns()
        var total = 0
        for name in names { total += m[name] else 0 }
        print("map_lookup_{count}_ns={time.monotonic_ns() - start} total={total}")
        var ints = Map[int, int]()
        start = time.monotonic_ns()
        for i in 0..count { ints[i * 977] = i }
        for i in 0..count { total += ints[i * 977] else 0 }
        print("intmap_{count}_ns={time.monotonic_ns() - start} total={total}")
    }
    0
}
