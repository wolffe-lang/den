// Measure public read-only boundaries without changing production status.
use std.time
use worktree

fn measured(root: str, untracked: bool, full: bool) -> () ! worktree.WorkErrors {
    var start = time.monotonic_ns()
    let ctx = worktree.discover(root)?
    print("discover_ns={time.monotonic_ns() - start}")
    start = time.monotonic_ns()
    let value = worktree.read_index(ctx)?
    print("index_ns={time.monotonic_ns() - start} entries={value.entries.len}")
    start = time.monotonic_ns()
    let head = worktree.head(ctx)?
    print("head_ns={time.monotonic_ns() - start}")
    start = time.monotonic_ns()
    if head.commits.len == 1 {
        let entries = worktree.flatten_tree(ctx.repo, head.commits[0])?
        print("tree_ns={time.monotonic_ns() - start} entries={entries.len}")
    }
    // Each scan repeats index/head/tree itself; its inclusive span is not
    // added to the separate measurements above.
    var warnings = List[str]()
    if full {
        start = time.monotonic_ns()
        let snapshot = worktree.scan_index_with_warnings(ctx, value, untracked, mut warnings)?
        print("full_scan_inclusive_ns={time.monotonic_ns() - start} files={snapshot.files.len}")
    }
    start = time.monotonic_ns()
    let status = worktree.scan_status(ctx, untracked, false, mut warnings)?
    print("status_scan_inclusive_ns={time.monotonic_ns() - start} files={status.files.len} rows={status.rows.len}")
    start = time.monotonic_ns()
    let bytes = worktree.render_status(status, worktree.status_options(ctx)?)?
    print("render_ns={time.monotonic_ns() - start} bytes={bytes.len}")
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 { eprint("usage: status-phases ROOT [no-untracked] [full]"); return 2 }
    var untracked = true, full = false
    for i in 1..args.len {
        if args[i] == "no-untracked" { untracked = false }
        if args[i] == "full" { full = true }
    }
    measured(args[0], untracked, full) else |error| { eprint("phase failure: {error}"); return 1 }
    0
}
