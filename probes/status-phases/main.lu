// Measure public read-only boundaries without changing production status.
use std.time
use index
use worktree

// path-work: the tracked stat pass a warm `diff --quiet` makes over the index
// (diff's endpoints: each stage-0 entry that is no gitlink, intent-to-add or
// skip-worktree entry, in index order, with one verified-ancestor list), and
// what it spends on paths: its checks and the path bytes it builds or copies.
fn path_work(root: str) -> () ! worktree.WorkErrors {
    let ctx = worktree.discover(root)?
    let value = worktree.read_index(ctx)?
    let written = worktree.index_written(ctx)
    let filemode = worktree.config_bool(ctx, "core.filemode", true)?
    let symlinks = worktree.config_bool(ctx, "core.symlinks", true)?
    var verified = List[List[byte]](), work = worktree.path_work(), files = 0, clean = 0
    for entry in value.entries {
        if index.stage(entry) != 0 || entry.stat[6] == 0o160000 { continue }
        if entry.flags & 0x8000 != 0 || entry.extended & 0x4000 != 0 { continue }
        let seen = worktree.tracked_stat_counted(
            ctx,
            entry,
            written,
            filemode,
            symlinks,
            mut verified,
            mut work,
        )?
        files += 1
        if seen.clean { clean += 1 }
    }
    print(
        "path_work files={files} clean={clean} checks={work.checks} bytes={work.bytes} root={ctx.root.len}",
    )
}

fn measured(root: str, untracked: bool, full: bool, paths: bool) -> () ! worktree.WorkErrors {
    var start = time.monotonic_ns()
    let ctx = worktree.discover(root)?
    print("discover_ns={time.monotonic_ns() - start}")
    start = time.monotonic_ns()
    let value = worktree.read_index(ctx)?
    print("index_ns={time.monotonic_ns() - start} entries={value.entries.len}")
    start = time.monotonic_ns()
    let head = worktree.head(ctx)?
    print("head_ns={time.monotonic_ns() - start}")
    start = time.monotonic_ns()
    if head.commits.len == 1 {
        let entries = worktree.flatten_tree(ctx.repo, head.commits[0])?
        print("tree_ns={time.monotonic_ns() - start} entries={entries.len}")
    }
    // Each scan repeats index/head/tree itself; its inclusive span is not
    // added to the separate measurements above.
    var warnings = List[str]()
    if full {
        start = time.monotonic_ns()
        let snapshot = worktree.scan_index_with_warnings(ctx, value, untracked, mut warnings)?
        print("full_scan_inclusive_ns={time.monotonic_ns() - start} files={snapshot.files.len}")
    }
    start = time.monotonic_ns()
    let status = worktree.scan_status(ctx, untracked, false, mut warnings)?
    print(
        "status_scan_inclusive_ns={time.monotonic_ns() - start} files={status.files.len} rows={status.rows.len}",
    )
    // The scan's index lookups and the path compares they took: exact counts.
    print(
        "walk_lookups={status.walk_lookups.calls} walk_compares={status.walk_lookups.compares} row_lookups={status.row_lookups.calls} row_compares={status.row_lookups.compares}",
    )
    print("merge_steps={status.merge_counts.calls} merge_compares={status.merge_counts.compares}")
    print("sorted_files={status.sort_counts.calls} sort_compares={status.sort_counts.compares}")
    // paths: the scan's files in its order, one a line (UTF-8 paths only).
    if paths {
        for file in status.files { print("file={str_from_utf8(file.path) else "?"}") }
    }
    start = time.monotonic_ns()
    let bytes = worktree.render_status(status, worktree.status_options(ctx)?)?
    print("render_ns={time.monotonic_ns() - start} bytes={bytes.len}")
}

fn main() -> int {
    let args = env_args()
    if args.len < 1 {
        eprint("usage: status-phases ROOT [no-untracked] [full] [paths] | ROOT path-work")
        return 2
    }
    if args.len == 2 && args[1] == "path-work" {
        path_work(args[0]) else |error| {
            eprint("path-work failure: {error}")
            return 1
        }
        return 0
    }
    var untracked = true, full = false, paths = false
    for i in 1..args.len {
        if args[i] == "no-untracked" { untracked = false }
        if args[i] == "full" { full = true }
        if args[i] == "paths" { paths = true }
    }
    measured(args[0], untracked, full, paths) else |error| {
        eprint("phase failure: {error}")
        return 1
    }
    0
}
