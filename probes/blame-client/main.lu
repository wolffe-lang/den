use std.fs
use blame
use repository
use revision
use revsyntax
use worktree

fn main() -> int {
    let args = env_args()
    let repo = repository.discover(".") else { return 1 }
    var warnings = List[str]()
    let expression = revsyntax.parse(args[1]) else { return 1 }
    let resolved = revision.evaluate_typed(repo, expression.left, "commit", mut warnings) else { return 1 }
    let path = if args[2] == "--raw" then [114 as byte, 97 as byte, 119 as byte, 255 as byte] else args[2].bytes()
    let result = blame.attribute(repo, resolved.id, path, blame.defaults()) else { return 1 }
    var options = blame.defaults()
    options.porcelain = true
    options.line_porcelain = true
    let ctx = worktree.Context { repo: repo, root: "", cwd: ".", prefix: "" }
    let output = blame.render(ctx, result, options) else { return 1 }
    fs_write_chunk(fs.stdout().fd, output) else { return 1 }
    0
}
