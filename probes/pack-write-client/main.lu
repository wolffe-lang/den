use object
use oid
use pack
use repository

fn main() -> int {
    let args = env_args()
    if args.len != 3 && args.len != 4 { return 2 }
    let repo = repository.open(args[0]) else |e| { eprint("{e}"); return 1 }
    let bytes = repository.read_bytes(args[1], 1000000) else |e| { eprint("{e}"); return 1 }
    let input = str_from_utf8(bytes) else |e| { eprint("{e}"); return 1 }
    var bodies = List[pack.Body]()
    for line in input.split("\n") {
        if line == "" { continue }
        let id = oid.parse("sha1", line) else |e| { eprint("{e}"); return 1 }
        let value = object.read_object(repo, id, 16777216) else |e| { eprint("{e}"); return 1 }
        (mut bodies).push(pack.Body { kind: copy value.kind, data: copy value.data })
    }
    var encoded = pack.encode(bodies, args[2]) else |e| { eprint("{e}"); return 1 }
    let fail = if args.len == 4 then args[3] else ""
    if fail == "corrupt-index" {
        encoded.index[encoded.index.len - 1] = (
            encoded.index[encoded.index.len - 1] as int ^ 1
        ) as byte
    }
    if fail == "corrupt-pack" { encoded.data[12] = (encoded.data[12] as int ^ 1) as byte }
    let name = pack.install_injected(repo.gitdir, encoded, fail) else |e| {
        eprint("{e}")
        return 1
    }
    print(name)
    0
}
