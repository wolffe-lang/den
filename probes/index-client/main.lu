// Independent API client. All repository paths are explicit fixture arguments.
use std.fs
use index
use object
use oid
use repository

fn number(text: str) -> int ! index.IndexErrors {
    text.to_int() else |_| { return invalid }
}

fn bytes_hex(bytes: List[byte]) -> str {
    let alphabet = "0123456789abcdef"
    var out = List[byte]()
    for b in bytes {
        (mut out).push(alphabet.bytes()[b as int / 16])
        (mut out).push(alphabet.bytes()[b as int % 16])
    }
    str_from_utf8(out) else ""
}

fn output(path: str, bytes: List[byte]) -> () ! index.IndexErrors {
    var file = fs.create(path)?
    defer fs.close(take file) else |_| {}
    fs.write_chunk(mut file, bytes)?
}

fn inspect(value: index.Index) -> () ! index.IndexErrors {
    print("version {value.version}")
    for entry in value.entries {
        var fields = ""
        for word in entry.stat { fields += " {word}" }
        print(
            "entry {bytes_hex(entry.path)} {index.stage(entry)} {entry.flags} {entry.extended} {oid.hex(entry.id)?}{fields}",
        )
    }
    for extension in value.extensions {
        print("extension {extension.signature} {bytes_hex(extension.data)}")
    }
}

fn read_file(fd: int) -> List[byte] ! index.IndexErrors {
    var bytes = List[byte]()
    loop {
        region chunk {
            let part = fs_read_chunk(fd, 65536) else |e| match e {
                eof => { break },
                io => { return io },
            }
            if part.len > 1000000000 - bytes.len { return limit }
            for b in part { (mut bytes).push(b) }
        }
    }
    bytes
}

fn selected_mode(text: str) -> int ! index.IndexErrors {
    if text == "100644" { return 0o100644 }
    if text == "100755" { return 0o100755 }
    invalid
}

fn add(args: List[str]) -> () ! index.IndexErrors {
    if args.len < 5 || args.len > 8 { return invalid }
    let repo = repository.open(args[1])?
    var tx = index.begin(repo, 1000000000, number(args[2])?)?
    defer index.abort(mut tx)
    // NOFOLLOW + nonblocking read lets metadata reject directories/devices
    // before reading, and never stats a symlink's referent as if it were a link.
    var file = fs.File { fd: fs_open_mode(args[3], 21)? }
    defer fs.close(take file) else |_| {}
    let before = fs_fstat_record(file.fd)?
    let mode = if args.len >= 6 {
        selected_mode(args[5])?
    } else if before[4] & 0o100 != 0 {
        0o100755
    } else {
        0o100644
    }
    let flags = if args.len >= 8 then number(args[7])? else 0
    let extended = if args.len >= 7 then number(args[6])? else 0
    let placeholder = object.identify("blob", [])?
    let _ = index.entry_from_stat(before, args[4].bytes(), placeholder, mode, flags, extended)?
    let bytes = read_file(file.fd)?
    let after = fs_fstat_record(file.fd)?
    for i in [1, 4, 9, 10, 14, 15, 16, 17] {
        if before[i] != after[i] { return invalid }
    }
    let id = object.write_object(
        repo,
        "blob",
        if extended & 0x2000 != 0 then List[byte]() else bytes,
    )?
    var entry = index.fresh_entry(file.fd, args[4].bytes(), id, mode, flags, extended)?
    if extended & 0x2000 != 0 {
        // Git add -N carries no stat cache, but does retain the canonical mode.
        entry.stat = [0, 0, 0, 0, 0, 0, mode, 0, 0, 0]
    }
    tx.value = index.replace_entry(tx.value, entry)?
    index.commit(mut tx)?
}

fn work(args: List[str]) -> int ! index.IndexErrors {
    if args.len == 0 { return invalid }
    if args[0] == "inspect" {
        if args.len != 2 { return invalid }
        inspect(index.parse(repository.read_bytes(args[1], 1000000000)?)?)?
    } else if args[0] == "roundtrip" {
        if args.len < 3 || args.len > 4 { return invalid }
        var value = index.parse(repository.read_bytes(args[1], 1000000000)?)?
        if args.len == 4 { value.version = number(args[3])? }
        output(args[2], index.serialize(value)?)?
    } else if args[0] == "trees" {
        if args.len != 3 { return invalid }
        let value = index.parse(repository.read_bytes(args[1], 1000000000)?)?
        let trees = index.build_trees(value)?
        fs.create_dir_all(args[2])?
        for tree in trees.objects { output("{args[2]}/{oid.hex(tree.id)?}", tree.data)? }
        output("{args[2]}/TREE", trees.cache)?
        print(oid.hex(trees.root)?)
    } else if args[0] == "write-tree" {
        if args.len != 2 { return invalid }
        print(oid.hex(index.write_tree(repository.open(args[1])?, 1000000000)?)?)
    } else if args[0] == "add" {
        add(args)?
    } else if args[0] == "remove" {
        if args.len != 4 { return invalid }
        let repo = repository.open(args[1])?
        var tx = index.begin(repo, 1000000000, number(args[2])?)?
        defer index.abort(mut tx)
        tx.value = index.remove_path(tx.value, args[3].bytes())?
        index.commit(mut tx)?
    } else if args[0] == "rewrite" {
        if args.len < 3 || args.len > 4 { return invalid }
        let repo = repository.open(args[1])?
        var tx = index.begin(repo, 1000000000, number(args[2])?)?
        defer index.abort(mut tx)
        index.commit_injected(mut tx, if args.len == 4 then args[3] else "")?
    } else if args[0] == "prepare-abort" {
        if args.len < 3 || args.len > 4 { return invalid }
        let repo = repository.open(args[1])?
        var tx = index.begin(repo, 1000000000, number(args[2])?)?
        defer index.abort(mut tx)
        index.prepare_injected(mut tx, if args.len == 4 then args[3] else "")?
        let ready = index.parse(repository.read_bytes("{repo.gitdir}/index.lock", 1000000000)?)?
        print("prepared {ready.entries.len}")
    } else if args[0] == "install-unprepared" {
        if args.len != 3 { return invalid }
        let repo = repository.open(args[1])?
        var tx = index.begin(repo, 1000000000, number(args[2])?)?
        defer index.abort(mut tx)
        index.install(mut tx)?
    } else if args[0] == "lock" {
        if args.len != 2 { return invalid }
        var input = fs.open("/dev/stdin")?
        defer fs.close(take input) else |_| {}
        let repo = repository.open(args[1])?
        var tx = index.begin(repo, 1000000000, 0)?
        defer index.abort(mut tx)
        print("locked")
        let _ = fs_read_chunk(input.fd, 1) else |_| { return 0 }
    } else if args[0] == "stat" {
        if args.len != 3 { return invalid }
        var file = fs.File { fd: fs_open_mode(args[1], 21)? }
        defer fs.close(take file) else |_| {}
        let entry = index.fresh_entry(
            file.fd,
            "probe".bytes(),
            object.identify("blob", [])?,
            selected_mode(args[2])?,
            0,
            0,
        )?
        for word in entry.stat { print("{word}") }
    } else if args[0] == "lstat" {
        if args.len != 2 { return invalid }
        let entry = index.entry_from_lstat(
            fs_lstat(args[1])?,
            "probe".bytes(),
            object.identify("blob", [])?,
            0,
            0,
        )?
        for word in entry.stat { print("{word}") }
    } else {
        return invalid
    }
    0
}

fn main() -> int {
    work(env_args()) else |e| { eprint("{e}"); 1 }
}
