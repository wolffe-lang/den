use std.net
use std.time
use std.x.tls.cert
use std.x.tls.client

fn main() -> int {
    let addr = env_get("TLS_PROBE_ADDR") else "127.0.0.1:19443"
    let host = env_get("TLS_PROBE_HOST") else "localhost"
    let anchor = env_get("TLS_PROBE_ROOTS") else "target/tls/anchor.der"
    let clock = time.local(time.unix_ms() / 1000) else |_| { return 1 }
    let now = cert.timestamp(
        clock.year,
        clock.month,
        clock.day,
        clock.hour,
        clock.minute,
        clock.second,
    )
    let roots = fs_read_bytes(anchor) else |e| { eprint("roots={e}"); return 1 }
    var sock = net.connect(addr) else |e| { eprint("connect={e}"); return 1 }
    net.set_deadline(mut sock, 15000) else |_| { return 1 }
    let random = fs_read_bytes("target/tls/random") else |_| { return 1 }
    let scalar = fs_read_bytes("target/tls/scalar") else |_| { return 1 }
    let pending = client.begin(take sock, host, roots, now, random, scalar) else |e| {
        eprint("begin={e}")
        return 1
    }
    var tls = client.complete(take pending) else |e| { eprint("complete={e}"); return 1 }
    print("TLS handshake complete: {host}")
    client.write(mut tls, "GET / HTTP/1.0\r\nHost: {host}\r\n\r\n".bytes()) else |e| {
        eprint("write={e}")
        return 1
    }
    let reply = client.read(mut tls) else |e| { eprint("read={e}"); return 1 }
    print("application bytes={reply.len}")
    client.close(take tls) else |_| {}
    0
}
