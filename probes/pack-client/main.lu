use std.fs
use object
use oid
use repository

fn emit(repo: repository.Repo, id: oid.Oid, cap: int, batch: bool) -> () ! object.StoreErrors {
    let value = object.read_object(repo, id, cap)?
    if batch {
        print("{oid.hex(id)?} {value.kind} {value.data.len}")
    } else {
        print("{value.kind} {value.data.len} {oid.hex(id)?}")
    }
    var stdout = fs.stdout()
    fs.write_chunk(mut stdout, value.data)?
    if batch { fs.write_chunk(mut stdout, "\n".bytes())? }
}

// One read through a batch reader (object.reader_batch), printed as a line.
fn session_line(r: object.Reader, label: str, id: oid.Oid, cap: int) -> () ! object.StoreErrors {
    let value = object.read_loaded(r, id, cap) else |e| {
        print("{label} error {e}")
        return
    }
    print("{label} {value.kind} {value.data.len} {oid.hex(id)?}")
}

// --session REPO NAME CAP [PACK SOURCE]: read NAME through one batch reader;
// with PACK and SOURCE, copy SOURCE over PACK and read NAME again through the
// same reader, as a checkout's reader would see a pack changed under it.
fn session(args: List[str]) -> () ! object.StoreErrors {
    if args.len != 4 && args.len != 6 { return invalid }
    let repo = repository.open(args[1])?
    let id = oid.parse("sha1", args[2])?
    let cap = args[3].to_int() else |_| { return invalid }
    let r = object.reader_batch(repo)
    session_line(r, "first", id, cap)?
    if args.len == 6 {
        fs.copy_file(args[5], args[4]) else |_| { return io }
        session_line(r, "second", id, cap)?
    }
}

// One read through a repository whose packs were opened once (den#101).
fn opened_line(repo: repository.Repo, label: str, name: str, cap: int) -> () ! object.StoreErrors {
    let id = object.lookup(repo, name) else |e| {
        print("{label} error {e}")
        return
    }
    let value = object.read_object(repo, id, cap) else |e| {
        print("{label} error {e}")
        return
    }
    print("{label} {value.kind} {value.data.len} {oid.hex(id)?}")
}

// --opened REPO NAME CAP [DEST SOURCE]...: open REPO's packs once, look NAME
// up (a full or abbreviated name) and read it; with DEST SOURCE pairs, copy
// each SOURCE over its DEST (SOURCE "-" removes DEST) and do it again through
// the same opened repository, as a command that opened its packs would see
// packs changed, added or removed under it.
fn opened(args: List[str]) -> () ! object.StoreErrors {
    if args.len < 4 || args.len % 2 != 0 { return invalid }
    let repo = object.opened(repository.open(args[1])?)
    let cap = args[3].to_int() else |_| { return invalid }
    opened_line(repo, "first", args[2], cap)?
    if args.len > 4 {
        var i = 4
        while i < args.len {
            if args[i + 1] == "-" {
                fs.remove(args[i]) else |_| { return io }
            } else {
                fs.copy_file(args[i + 1], args[i]) else |_| { return io }
            }
            i += 2
        }
        opened_line(repo, "second", args[2], cap)?
    }
}

// --kinds REPO NAME...: type each NAME (object.kind_cached) through one reader
// whose packs are not loaded, each in a region of its own, as a fetch's
// closure walk types the objects it held inside its per-step region. Prints
// whether the reader's packs were loaded before, then each name, its kind and
// whether they are loaded after: typing an object never loads them, since a
// load inside the region would leave the reader holding what the region frees.
fn kinds(args: List[str]) -> () ! object.StoreErrors {
    if args.len < 3 { return invalid }
    let repo = repository.open(args[1])?
    var r = object.reader(repo)
    print("before loaded={r.packs.loaded}")
    for name in args[2..] {
        region step {
            let kind = object.kind_cached(mut r, oid.parse("sha1", name)?)?
            print("{name} {kind} loaded={r.packs.loaded}")
        }
    }
}

fn run(args: List[str]) -> () ! object.StoreErrors {
    if args.len > 0 && args[0] == "--session" { return session(args)? }
    if args.len > 0 && args[0] == "--opened" { return opened(args)? }
    if args.len > 0 && args[0] == "--kinds" { return kinds(args)? }
    if args.len != 3 && args.len != 4 { return invalid }
    let repo = repository.open(args[0])?
    if args.len == 4 {
        if args[1] != "--batch" { return invalid }
        let cap = args[3].to_int() else |_| { return invalid }
        let input = repository.read_bytes(args[2], 1000000)?
        let names = str_from_utf8(input) else |_| { return invalid }
        var count = 0
        for name in names.split("\n") {
            if name == "" { continue }
            count += 1
            if count > 10000 { return limit }
            region object_read {
                let id = oid.parse("sha1", name)?
                emit(repo, id, cap, true)?
            }
        }
        return
    }
    let id = object.lookup(repo, args[1])?
    let cap = args[2].to_int() else |_| { return invalid }
    emit(repo, id, cap, false)?
}

fn main() -> int {
    run(env_args()) else |e| { eprint("{e}"); return 1 }
    0
}
