//! member: false
use http

fn main() -> int {
    let url = env_get("DEN_TEST_HTTP_URL") else { return 2 }
    let count = (env_get("DEN_TEST_HTTP_COUNT") else "1").to_int() else |_| { return 2 }
    var connection = http.open(url) else |e| { eprint("{e}"); return 1 }
    defer http.close(mut connection)
    for i in 0..count {
        let response = http.request(mut connection, "GET", "/probe", "", List[byte]()) else |e| {
            eprint("{e}"); return 1
        }
        print("status={response.status} bytes={response.body.len} round={i}")
        fs_write_chunk(1, response.body) else |_| { return 2 }
    }
    0
}
