# PREPARED, NOT PUBLISHED. Shape: lope bc388673 packaging/PKGBUILD.
# v0.1.0 does not exist yet. Release lane supplies its archive digest.
pkgname=den
pkgver=0.1.0
pkgrel=1
pkgdesc='Git-compatible VCS in wolf (M0 refusal scaffold)'
arch=('x86_64')
url='https://github.com/wolffe-lang/den'
license=('GPL-3.0-only')
depends=('glibc' 'sh')
makedepends=('clang')
_wolf=0.2.36
_std=78b9d3cbc41d51db44d18c40b6694403644d1c83
source=("$pkgname-$pkgver.tar.gz::https://github.com/wolffe-lang/den/archive/refs/tags/v$pkgver.tar.gz"
        "wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz::https://github.com/wolffe-lang/wolf-lang/releases/download/v$_wolf/wolf-$_wolf-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('RELEASE-LANE-FILLS-THIS'
            'd383c74c8cd123b9d9dfaa268271d4f004294f85c2b230237d0ef07027d9500d')
build() {
    cd "$pkgname-$pkgver"
    local tc="$srcdir/wolf-$_wolf-x86_64-unknown-linux-gnu"
    test "$(cat "$tc/std/STD-REV")" = "$_std"
    WOLF_STD="$tc/std" "$tc/wolf" build --release --deny-warnings src/den.lu -o den
}
check() {
    cd "$pkgname-$pkgver"
    test "$(./den --version)" = 'den 0.0.0 (built with wolf 0.2.36)'
}
package() {
    cd "$pkgname-$pkgver"
    install -Dm755 den "$pkgdir/usr/bin/den"
    install -Dm644 README.md "$pkgdir/usr/share/doc/den/README.md"
    for f in LICENSE LICENSE-TRAINING-DATA; do
        install -Dm644 "$f" "$pkgdir/usr/share/licenses/den/$f"
    done
}
