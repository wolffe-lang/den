#!/bin/sh
# Exact stash and notes over loose/packed fixtures, external client and actual checked units.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/runs/vc12-evidence
trap 'status=$?; for f in target/stash-native.json target/stash-release.json target/stash-api-native.json target/stash-api-release.json target/stash-checked.json; do [ ! -f "$f" ] || cp "$f" target/runs/vc12-evidence/; done; exit "$status"' EXIT
for tier in native release; do
    flag=
    [ "$tier" != release ] || flag=--release
    "$WOLF" build $flag --deny-warnings src/stash_test.lu -o "target/$tier/stash-test"
    "target/$tier/stash-test"
    "$WOLF" build $flag --deny-warnings probes/stash-client/main.lu -o "target/$tier/stash-client"
    tools/env python3 -I tools/stash-api-test.py --tier "$tier"
    tools/env python3 -I tools/stash-test.py --tier "$tier"
done
"$WOLF" conform-run src/stash_test.lu --checked --json > target/stash-checked.json
cat target/stash-checked.json
python3 -I -c 'import json; rows=[json.loads(x) for x in open("target/stash-checked.json") if x.startswith("{")]; assert len(rows)==1 and rows[0]["verdict"]=="exit(0)", rows'
echo 'stash/notes: exact loose/packed commands and clients; actual checked exit; zero skips'
