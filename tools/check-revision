#!/bin/sh
# Shared revision grammar, every storage mode, independent API and checked syntax.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/runs/vc10-evidence
trap 'status=$?; for f in target/revision-*.json; do [ ! -f "$f" ] || cp "$f" target/runs/vc10-evidence/; done; exit "$status"' EXIT
for tier in native release; do
    flag=
    [ "$tier" != release ] || flag=--release
    "$WOLF" build $flag --deny-warnings src/revision_test.lu -o "target/$tier/revision-test"
    "target/$tier/revision-test"
    "$WOLF" build $flag --deny-warnings probes/revision-client/main.lu -o "target/$tier/revision-client"
    tools/env python3 -I tools/revision-test.py --tier "$tier"
done
"$WOLF" conform-run src/revision_test.lu --checked --json > target/revision-checked.json
cat target/revision-checked.json
python3 -I tools/revision-verdict.py target/revision-checked.json
echo 'revision: exact loose/packed commands and clients; checked syntax exit; zero skips'
