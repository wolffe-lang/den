#!/bin/sh
# fetch-newest-wolf — stage the newest wolf release den must also build with
# ([wolf-newest] in wolf-toolchain.toml) into .wolf-newest/.
#
# The archive is fetched from the GitHub release (or $DEN_ARCHIVE_DIR, as
# tools/fetch-toolchain takes it) and REFUSED unless its sha256 matches the
# pin. Unlike the pinned toolchain, the std the archive bundles is kept: a
# user or a system that ships this release builds den with that std, and
# its commit must be the pin's std_rev. A stage whose recorded digest
# already matches is left alone.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toml.sh

target=$(host_target) || {
    echo "fetch-newest-wolf: no pinned archive for $(uname -s) $(uname -m)" >&2
    exit 1
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

version=$(toml_value wolf-newest version)
repo=$(toml_value wolf-newest repo)
digest=$(toml_value wolf-newest "$target")
std_rev=$(toml_value wolf-newest std_rev)
[ -n "$version" ] && [ -n "$digest" ] && [ -n "$std_rev" ] || {
    echo "fetch-newest-wolf: wolf-toolchain.toml has no [wolf-newest] pin for $target" >&2
    exit 1
}
want_stamp="$target wolf=$digest std=$std_rev"
if [ -f .wolf-newest/STAMP ] && [ "$(cat .wolf-newest/STAMP)" = "$want_stamp" ]; then
    echo "fetch-newest-wolf: .wolf-newest/ already holds wolf $version ($target)"
    exit 0
fi

mkdir -p "${TMPDIR:-$DEN_ROOT/target/tmp}"
tmp=$(mktemp -d "${TMPDIR:-$DEN_ROOT/target/tmp}/den-newest-wolf.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
rm -rf .wolf-newest
base="wolf-$version-$target"
if [ -n "${DEN_ARCHIVE_DIR:-}" ] && [ -f "$DEN_ARCHIVE_DIR/$base.tar.gz" ]; then
    echo "fetch-newest-wolf: $DEN_ARCHIVE_DIR/$base.tar.gz"
    cp "$DEN_ARCHIVE_DIR/$base.tar.gz" "$tmp/$base.tar.gz"
else
    url="https://github.com/$repo/releases/download/v$version/$base.tar.gz"
    echo "fetch-newest-wolf: $url"
    curl -sSfL --retry 3 --retry-delay 5 -o "$tmp/$base.tar.gz" "$url"
fi
have=$(sha256 "$tmp/$base.tar.gz")
if [ "$have" != "$digest" ]; then
    echo "fetch-newest-wolf: REFUSED — $base.tar.gz sha256 $have, pin wants $digest" >&2
    exit 1
fi
echo "fetch-newest-wolf: sha256 $have OK"
tar -xzf "$tmp/$base.tar.gz" -C "$tmp"
bundled=$(cat "$tmp/$base/std/STD-REV" 2>/dev/null || echo none)
if [ "$bundled" != "$std_rev" ]; then
    echo "fetch-newest-wolf: REFUSED — the archive bundles std $bundled, pin wants $std_rev" >&2
    exit 1
fi
mkdir -p .wolf-newest
cp -R "$tmp/$base/." .wolf-newest/
echo "$want_stamp" >.wolf-newest/STAMP
echo "fetch-newest-wolf: staged wolf $version and its std $std_rev ($target) into .wolf-newest/"
