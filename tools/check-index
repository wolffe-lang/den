#!/bin/sh
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
for tier in native release; do
    flag=
    if [ "$tier" = release ]; then flag=--release; fi
    mkdir -p "target/$tier"
    "$WOLF" build $flag --deny-warnings src/index_test.lu -o "target/$tier/index-test"
    "target/$tier/index-test"
    "$WOLF" build $flag --deny-warnings probes/index-client/main.lu -o "target/$tier/index-client"
    tools/env python3 -I tools/index-test.py --tier "$tier"
    # The index trailer as Git reads, writes and checks it (den#155), beside the pinned Git.
    tools/env python3 -I tools/index-trailer-test.py --tier "$tier"
    # build_trees over an index of a pull's size: its directory comparisons
    # bounded per file and depth, and the trees Git's format gives.
    python3 -I tools/index-trees-test.py --tier "$tier"
done
for part in format flags trees malformed stat; do
    "$WOLF" conform-run "src/index_checked_$part.lu" --checked --json > "target/index-checked-$part.json"
    cat "target/index-checked-$part.json"
    python3 -I - "target/index-checked-$part.json" <<'PYCODE'
import json,sys
rows=[json.loads(line) for line in open(sys.argv[1]) if line.startswith('{')]
assert len(rows)==1 and rows[0]['verdict']=='exit(0)',rows
PYCODE
done
python3 -I tools/index-proof-test.py
# An index of 100,000 entries in 10,000 directories with its cache tree, read
# beside Git; den is bounded relative to Git in the same take (native tier).
tools/env python3 -I tools/index-scale-test.py --tier native
echo 'index: native/release units and independent Git interop; index-trees rows; five bounded actual checked exits; full native test retained; index-scale rows beside Git'
