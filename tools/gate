#!/bin/sh
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
ulimit -c 0
export TMPDIR="$root/target/tmp"
mkdir -p "$TMPDIR"
python3 ci/tiers-test.py
tools/fetch-toolchain
tools/fetch-oracle
DEN_GIT=$(python3 -I - "$root" <<'PY'
import pathlib,sys
p=list(pathlib.Path(sys.argv[1]).glob('target/oracle/*/root/opt/git/bin/git'))
assert len(p)==1,p
print(p[0])
PY
)
export DEN_GIT
tools/check-fmt
tools/build --all
tools/check-test
TLS_PROBE_LOCAL_ONLY=1 tools/probe-tls
tools/corpus target/corpus --prove-twice
tools/check-codec
tools/check-objects
tools/check-config
tools/check-index
tools/check-ignore
tools/check-worktree
tools/check-commit
tools/oracle --selftest
tools/oracle
if tools/oracle --filter diff-symlink --strict; then
    echo "gate: strict not-yet unexpectedly passed" >&2
    exit 1
else
    rc=$?
    [ "$rc" = 1 ] || exit "$rc"
    echo "gate: strict not-yet rejected as intended"
fi
if tools/oracle --filter no-such-case; then
    echo "gate: empty selection unexpectedly passed" >&2
    exit 1
else
    rc=$?
    [ "$rc" = 1 ] || exit "$rc"
    echo "gate: empty selection rejected as intended"
fi
tools/mkden target/dist
