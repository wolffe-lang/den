#!/bin/sh
# check-newest-wolf — den builds with the newest wolf release as well as with
# the pinned toolchain. The newest release ([wolf-newest] in
# wolf-toolchain.toml, staged by tools/fetch-newest-wolf with the std it
# bundles, as a user or a system that ships that release builds den) builds
# what den ships (den and the five index-check programs) on both tiers and
# every test program under src/ (each *_test.lu, nested ones too, named by its
# path there: zlib/huffman_test, found when the leaf runs) on native, with
# warnings denied. A compiler that refuses the tree the pin accepts fails here
# by name, so the gap is seen before anyone builds den with the release. This
# is what the retired next-wolf candidate leaf built. Rows:
#   newest-wolf-version        the staged compiler prints the pin's version line
#   newest-wolf-build-native   src/den.lu builds natively
#   newest-wolf-build-release  src/den.lu builds on the release tier
#   newest-wolf-build-PROGRAM-TIER  each other program, on each tier it builds on
#   newest-wolf-tier-independent    the shipped programs' E1010 counts agree on
#                              both tiers: the checker's diagnostics do not
#                              depend on the tier, which is why the test
#                              programs build on native alone
# A failing build's own compiler lines follow its row, two spaces in.
# The toolchain-pins rows (tools/toolchain-pins-test.py) run first.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toml.sh
# The pins read against each other first (tools/toolchain-pins-test.py): the
# newest release is never older than the pin, and a candidate the pin has
# caught up with is retired. Its rows are this leaf's too.
pins=0
python3 -I tools/toolchain-pins-test.py || pins=1
tools/fetch-newest-wolf
wolf=$DEN_ROOT/.wolf-newest/wolf
want=$(toml_value wolf-newest version_line)
have=$("$wolf" --version 2>/dev/null | head -1)
failed=$pins
if [ "$have" = "$want" ]; then
    echo "PASS newest-wolf-version $have"
else
    echo "FAIL newest-wolf-version: the staged compiler prints '$have', the pin wants '$want'"
    failed=1
fi
shipped='den index_checked_flags index_checked_format index_checked_malformed index_checked_stat index_checked_trees'
tests=$(cd src && find . -name '.?*' -prune -o -type f -name '*_test.lu' -print | sed 's|^\./||; s|\.lu$||' | LC_ALL=C sort | tr '\n' ' ' | sed 's/ *$//')
out=target/newest-wolf
mkdir -p "$out"
ntests=0
for tier in native release; do
    flag=
    [ "$tier" != release ] || flag=--release
    for program in $shipped $tests; do
        case " $tests " in
            *" $program "*) [ "$tier" = native ] || continue; ntests=$((ntests + 1)) ;;
        esac
        row=newest-wolf-build-$program-$tier
        [ "$program" != den ] || row=newest-wolf-build-$tier
        log=$out/$program-$tier.log
        mkdir -p "$(dirname "$log")"
        if WOLF_STD="$DEN_ROOT/.wolf-newest/std" "$wolf" build $flag --error-limit=0 --deny-warnings \
            "src/$program.lu" -o "$out/$program-$tier" >"$log" 2>&1; then
            echo "PASS $row ($have)"
        else
            rc=$?
            echo "FAIL $row: exit $rc ($have)"
            sed 's/^/  /' "$log"
            failed=1
        fi
    done
done
split=0
for program in $shipped; do
    native=$(grep -c '^error\[E1010\]' "$out/$program-native.log" || true)
    release=$(grep -c '^error\[E1010\]' "$out/$program-release.log" || true)
    if [ "$native" != "$release" ]; then
        echo "FAIL newest-wolf-tier-independent: $program E1010 native $native, release $release"
        split=1
        failed=1
    fi
done
[ "$split" = 1 ] || echo "PASS newest-wolf-tier-independent: E1010 counts agree on both tiers for 6 programs"
if [ "$failed" = 0 ]; then
    echo "newest-wolf: den and the five index-check programs on both tiers, and $ntests test programs on native, build with $have, warnings denied"
fi
exit "$failed"
