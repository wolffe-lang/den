#!/bin/sh
# Pure history units, independent client, and complete black-box command/state rows.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/runs/vc05-evidence
trap 'status=$?; for f in target/history-*.json target/history-*.log target/pretty-checked.json target/walk-checked.json; do [ ! -f "$f" ] || cp "$f" target/runs/vc05-evidence/; done; exit "$status"' EXIT
for tier in native release; do
    flag=
    [ "$tier" != release ] || flag=--release
    for unit in pretty walk; do
        "$WOLF" build $flag --deny-warnings "src/${unit}_test.lu" -o "target/$tier/$unit-test"
        "target/$tier/$unit-test"
    done
    "$WOLF" build $flag --deny-warnings probes/history-client/main.lu -o "target/$tier/history-client"
    tools/env python3 -I tools/history-test.py --tier "$tier"
done
for unit in pretty walk; do
    "$WOLF" conform-run "src/${unit}_test.lu" --checked --json > "target/${unit}-checked.json"
    cat "target/${unit}-checked.json"
    python3 -I - "target/${unit}-checked.json" <<'PY'
import json,sys
rows=[json.loads(line) for line in open(sys.argv[1]) if line.startswith('{')]
assert len(rows)==1 and rows[0]['verdict']=='exit(0)',rows
PY
done
echo 'history: native/release exact commands and immutable repository/worktree state; actual checked units; zero skips'
