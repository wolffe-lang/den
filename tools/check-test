#!/bin/sh
# Every stage reads its exit code directly, no pipeline can mask red.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
"$WOLF" build --deny-warnings probes/hash/main.lu -o target/hash-test
target/hash-test
"$WOLF" conform-run probes/hash/main.lu --checked --json >target/hash-checked.json
cat target/hash-checked.json
python3 -I - target/hash-checked.json <<'PY'
import json,sys
rows=[json.loads(line) for line in open(sys.argv[1]) if line.startswith('{')]
assert len(rows)==1 and rows[0]['verdict']=='exit(0)',rows
PY
