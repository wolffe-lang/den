#!/bin/sh
# Native and actual checked machine. Every refusal printed and counted.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
DEN_ROOT=$root
export DEN_ROOT
export TZ=UTC
cd "$root"
. tools/lib-toolchain.sh
mkdir -p target/probes target/tls
truncate -s 100000000 target/100mb
python3 -I tools/probes.py "$@"
