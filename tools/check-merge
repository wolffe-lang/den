#!/bin/sh
# Owned merge boundaries and complete Git 2.56.0 transaction comparisons.
set -eu
DEN_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export DEN_ROOT
cd "$DEN_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/runs/vc07-evidence
trap 'status=$?; for f in target/merge-native.json target/merge-release.json target/merge-file-native.json target/merge-file-release.json target/merge-bases-native.json target/merge-bases-release.json target/merge*-checked.json; do [ ! -f "$f" ] || cp "$f" target/runs/vc07-evidence/; done; exit "$status"' EXIT
for tier in native release; do
    flag=
    [ "$tier" != release ] || flag=--release
    for unit in mergebase mergefile mergeundo; do
        "$WOLF" build $flag --deny-warnings "src/${unit}_test.lu" -o "target/$tier/$unit-test"
        "target/$tier/$unit-test"
    done
    "$WOLF" build $flag --deny-warnings probes/merge-client/main.lu -o "target/$tier/merge-client"
    "$WOLF" build $flag --deny-warnings probes/merge-bases-client/main.lu -o "target/$tier/merge-bases-client"
    tools/env python3 -I tools/merge-bases-test.py --tier "$tier"
    tools/env python3 -I tools/merge-file-test.py --tier "$tier"
    tools/env python3 -I tools/merge-test.py --tier "$tier"
done
for unit in mergebase mergefile mergeundo; do
    "$WOLF" conform-run "src/${unit}_test.lu" --checked --json > "target/${unit}-checked.json"
    cat "target/${unit}-checked.json"
    python3 -I -c 'import json,sys; rows=[json.loads(x) for x in open(sys.argv[1]) if x.startswith("{")]; assert len(rows)==1 and rows[0]["verdict"]=="exit(0)",rows' "target/${unit}-checked.json"
done
echo 'merge: native/release exact matrices, named refusals separate, independent client, three actual checked exits; zero skips'
